            设 aw2 = 0;
            如果(ad.reg < 100){ aw2 = 1; };
            设 adigit = 4;
            如果(mnemonic == "or"){ adigit = 1; };
            如果(mnemonic == "xor"){ adigit = 6; };

            如果(ad.reg >= 200 && ad.reg < 300){
                如果(ab2){ bytes.添加(make_rex(0, 0, 0, 1)); };
                bytes.添加(0x80);
                bytes.添加(0xC0 + adigit * 8 + (adn2 & 7));
                设 av8 = as.imm;
                如果(av8 < 0){ av8 = av8 + 256; };
                bytes.添加(av8 & 255);
