                    emit_modrm(digit, base, dst.imm);
                };
                设 v = src.imm;
                如果(v < 0){ v = v + 4294967296; };
                bytes.添加(v & 255);
                bytes.添加((v / 256) & 255);
                bytes.添加((v / 65536) & 255);
                bytes.添加((v / 16777216) & 255);
            };
            返回值 bytes;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_REG){
            设 s = reg_num(src.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(s >= 8){ r_bit = 1; };
            设 base = reg_num(dst.reg);
            如果(base >= 8){ b_bit = 1; };
            设 aw = 0;
            如果(src.reg < 100){ aw = 1; };
            如果(aw || r_bit || b_bit){
                bytes.添加(make_rex(aw, r_bit, 0, b_bit));
            };
            设 opcode = 0x01;
            如果(mnemonic == "sub"){ opcode = 0x29; };
            bytes.添加(opcode);
            如果(dst.index >= 0){
                emit_modrm_sib(s & 7, base, dst.index, dst.scale, dst.imm);
            }否则{
                emit_modrm(s & 7, base, dst.imm);
            };
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 d = reg_num(dst.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(d >= 8){ r_bit = 1; };
            设 base = reg_num(src.reg);
            如果(base >= 8){ b_bit = 1; };
            设 aw = 0;
            如果(dst.reg < 100){ aw = 1; };
            如果(aw || r_bit || b_bit){
                bytes.添加(make_rex(aw, r_bit, 0, b_bit));
            };
            设 opcode = 0x03;
            如果(mnemonic == "sub"){ opcode = 0x2B; };
            bytes.添加(opcode);
            如果(src.index >= 0){
                emit_modrm_sib(d & 7, base, src.index, src.scale, src.imm);
            }否则{
                emit_modrm(d & 7, base, src.imm);
            };
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_RIPMEM){
            设 d = reg_num(dst.reg);
            设 r_bit = 0;
            如果(d >= 8){ r_bit = 1; };
            bytes.添加(make_rex(1, r_bit, 0, 0));
            设 opcode = 0x03;
            如果(mnemonic == "sub"){ opcode = 0x2B; };
            bytes.添加(opcode);
            emit_modrm_rip(d & 7);
            add_reloc(section, offset + 3, src.label, RELOC_RIP32);
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(s >= 8){ r_bit = 1; };
            如果(d >= 8){ b_bit = 1; };
            设 aw = 0;
            如果(dst.reg < 100){ aw = 1; };
            设 opcode = 0x01;
            如果(mnemonic == "sub"){ opcode = 0x29; };
            如果(aw || r_bit || b_bit){
                bytes.添加(make_rex(aw, r_bit, 0, b_bit));
            };
            bytes.添加(opcode);
            bytes.添加(0xC0 + (s & 7) * 8 + (d & 7));
            返回值 bytes;
        };
        返回值 bytes;
    };

    如果(mnemonic == "xor"){
        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(s >= 8){ r_bit = 1; };
            如果(d >= 8){ b_bit = 1; };
            设 aw = 0;
            如果(dst.reg < 100){ aw = 1; };
            如果(aw || r_bit || b_bit){
                bytes.添加(make_rex(aw, r_bit, 0, b_bit));
            };
            bytes.添加(0x31);
            bytes.添加(0xC0 + (s & 7) * 8 + (d & 7));
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 d = reg_num(dst.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(d >= 8){ r_bit = 1; };
            设 base = reg_num(src.reg);
            如果(base >= 8){ b_bit = 1; };
            设 aw = 0;
            如果(dst.reg < 100){ aw = 1; };
            如果(aw || r_bit || b_bit){
                bytes.添加(make_rex(aw, r_bit, 0, b_bit));
            };
            bytes.添加(0x33);
            如果(src.index >= 0){
                emit_modrm_sib(d & 7, base, src.index, src.scale, src.imm);
            }否则{
                emit_modrm(d & 7, base, src.imm);
            };
            返回值 bytes;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            如果(dst.size == 1){

                如果(b_bit){ bytes.添加(make_rex(0, 0, 0, 1)); };
                bytes.添加(0x80);
                如果(dst.index >= 0){
                    emit_modrm_sib(6, base, dst.index, dst.scale, dst.imm);
                }否则{
                    emit_modrm(6, base, dst.imm);
                };
                设 vb = src.imm;
                如果(vb < 0){ vb = vb + 256; };
                bytes.添加(vb & 255);
                返回值 bytes;
            };
            如果(dst.size == 8 || dst.size == 0){

                bytes.添加(make_rex(1, 0, 0, b_bit));
            }又如果(b_bit){

                bytes.添加(make_rex(0, 0, 0, 1));
            };
            如果(src.imm >= -128 && src.imm <= 127){
                bytes.添加(0x83);
                如果(dst.index >= 0){
                    emit_modrm_sib(6, base, dst.index, dst.scale, dst.imm);
                }否则{
                    emit_modrm(6, base, dst.imm);
                };
                设 v = src.imm;
                如果(v < 0){ v = v + 256; };
                bytes.添加(v & 255);
            }否则{
                bytes.添加(0x81);
                如果(dst.index >= 0){
                    emit_modrm_sib(6, base, dst.index, dst.scale, dst.imm);
                }否则{
                    emit_modrm(6, base, dst.imm);
                };
                设 v = src.imm;
                如果(v < 0){ v = v + 4294967296; };
                bytes.添加(v & 255);
                bytes.添加((v / 256) & 255);
                bytes.添加((v / 65536) & 255);
                bytes.添加((v / 16777216) & 255);
            };
            返回值 bytes;
        };
        返回值 bytes;
    };

    如果(mnemonic == "test"){
        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 is64 = is_reg64(dst.reg);
            设 r_bit = 0;
            设 b_bit = 0;
            如果(s >= 8){ r_bit = 1; };
            如果(d >= 8){ b_bit = 1; };

            如果(dst.reg >= 200 && dst.reg < 300){
                如果(r_bit || b_bit){
                    bytes.添加(make_rex(0, r_bit, 0, b_bit));
                };
                bytes.添加(0x84);
                bytes.添加(0xC0 + (s & 7) * 8 + (d & 7));
                返回值 bytes;
            };
            如果(is64 || r_bit || b_bit){

                bytes.添加(make_rex(is64, r_bit, 0, b_bit));
            };
            bytes.添加(0x85);
            bytes.添加(0xC0 + (s & 7) * 8 + (d & 7));
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d = reg_num(dst.reg);
            设 b_bit = 0;
            如果(d >= 8){ b_bit = 1; };
            如果(dst.reg >= 200 && dst.reg < 300){

                如果(b_bit){ bytes.添加(make_rex(0, 0, 0, 1)); };
                bytes.添加(0xF6);
                bytes.添加(0xC0 + (d & 7));
                设 v8 = src.imm;
                如果(v8 < 0){ v8 = v8 + 256; };
                bytes.添加(v8 & 255);
                返回值 bytes;
            };
            设 cw = 0;
            如果(dst.reg < 100){ cw = 1; };
            如果(cw || b_bit){
                bytes.添加(make_rex(cw, 0, 0, b_bit));
            };
            bytes.添加(0xF7);
            bytes.添加(0xC0 + (d & 7));
            设 v = src.imm;
            如果(v < 0){ v = v + 4294967296; };
            bytes.添加(v & 255);
            bytes.添加((v / 256) & 255);
            bytes.添加((v / 65536) & 255);
            bytes.添加((v / 16777216) & 255);
            返回值 bytes;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            如果(dst.size == 1){

                如果(b_bit){ bytes.添加(make_rex(0, 0, 0, 1)); };
                bytes.添加(0xF6);
                如果(dst.index >= 0){
                    emit_modrm_sib(0, base, dst.index, dst.scale, dst.imm);
                }否则{
                    emit_modrm(0, base, dst.imm);
                };
                设 vb = src.imm;
                如果(vb < 0){ vb = vb + 256; };
                bytes.添加(vb & 255);
                返回值 bytes;
            };
            如果(dst.size == 8 || dst.size == 0){

                bytes.添加(make_rex(1, 0, 0, b_bit));
            }又如果(b_bit){

                bytes.添加(make_rex(0, 0, 0, 1));
            };
            bytes.添加(0xF7);
            如果(dst.index >= 0){
                emit_modrm_sib(0, base, dst.index, dst.scale, dst.imm);
            }否则{
                emit_modrm(0, base, dst.imm);
            };
            设 v = src.imm;
            如果(v < 0){ v = v + 4294967296; };
            bytes.添加(v & 255);
            bytes.添加((v / 256) & 255);
            bytes.添加((v / 65536) & 255);
            bytes.添加((v / 16777216) & 255);
            返回值 bytes;
        };
        返回值 bytes;
    };

    如果(mnemonic == "xchg"){
        创建 Operand:xop1;
        xop1 = parse_operand(g_enc_parts.获取(1));
        创建 Operand:xop2;
        xop2 = parse_operand(g_enc_parts.获取(2));

        设 xmem = xop1;
        设 xreg = xop2;
        如果(xop1.type == OPND_REG){ xmem = xop2; xreg = xop1; };
        如果(xreg.type != OPND_REG){ 返回值 bytes; };
        设 rd = reg_num(xreg.reg);
        设 r_bit = 0;
        如果(rd >= 8){ r_bit = 1; };
        设 w = 0;
        如果(xreg.reg < 100){ w = 1; };

        如果(xmem.type == OPND_RIPMEM){
            设 rex_emit = 0;
            如果(w || r_bit){
                bytes.添加(make_rex(w, r_bit, 0, 0));
                rex_emit = 1;
            };
            bytes.添加(0x87);
            emit_modrm_rip(rd & 7);

            add_reloc(section, offset + 2 + rex_emit, xmem.label, RELOC_RIP32);
            返回值 bytes;
        };

        如果(xmem.type == OPND_MEM){
            设 base = reg_num(xmem.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            设 x_bit = 0;
            如果(xmem.index >= 8){ x_bit = 1; };
            如果(w || r_bit || x_bit || b_bit){
                bytes.添加(make_rex(w, r_bit, x_bit, b_bit));
            };
            bytes.添加(0x87);
            如果(xmem.index >= 0){
                emit_modrm_sib(rd & 7, base, xmem.index, xmem.scale, xmem.imm);
            }否则{
                emit_modrm(rd & 7, base, xmem.imm);
            };
            返回值 bytes;
        };

        如果(xmem.type == OPND_REG){
            设 d1 = reg_num(xmem.reg);
            设 b_bit = 0;
            如果(d1 >= 8){ b_bit = 1; };
            如果(xmem.reg < 100){ w = 1; };
            如果(w || r_bit || b_bit){
                bytes.添加(make_rex(w, r_bit, 0, b_bit));
            };
            bytes.添加(0x87);
            bytes.添加(0xC0 + (rd & 7) * 8 + (d1 & 7));
            返回值 bytes;
        };
        返回值 bytes;
    };

    错误打印("汇编器: 未知指令 [" + mnemonic + "] 编码 0——产物语义可能错误");
    返回值 bytes;
};

声明 assemble(asm_text){
    创建 AsmResult:result;
    创建 ArrayList:p1_offs;
    创建 ArrayList:label_offs;

    设 raw_lines = 分割行(asm_text);
    设 nlines = raw_lines.长度();
    创建 ArrayList:lines;
    设 i = 0;
    循环(i < nlines){

        lines.添加(raw_lines[i]);
        i = i + 1;
    };

    设 nlines = lines.长度();
    内存报告("asm-split");

    设 cur_section = 0;
    设 text_off = 0;
    设 data_off = 0;
    设 bss_off = 0;

    i = 0;
    循环(i < nlines){
        如果((i & 8191) == 0){ 内存报告("asm-p1-line"); };
        设 line = lines.获取(i);

        设 sc = find_char(line, ";", 0);
        设 code = line;
        如果(sc >= 0){ code = line.子字符串(0, sc); };
        code = trim(code);
        如果(code.长度() == 0){ i = i + 1; 继续; };

        如果(starts_with(code, "section .text")){ cur_section = 0; i = i + 1; 继续; };
        如果(starts_with(code, "section .data")){ cur_section = 1; i = i + 1; 继续; };
        如果(starts_with(code, "section .bss")){ cur_section = 2; i = i + 1; 继续; };

        如果(starts_with(code, "default")){ i = i + 1; 继续; };

        如果(starts_with(code, "global ")){
            设 gname = trim(code.子字符串(7, code.长度()));

            i = i + 1;
            继续;
        };

        如果(starts_with(code, "extern ")){
            设 ename = trim(code.子字符串(7, code.长度()));
            创建 AsmSymbol:sym;
            sym.name = ename;
            sym.section = -1;
            sym.is_extern = 1;
            result.symbols.添加(sym);
            i = i + 1;
            继续;
        };

        设 colon = -1;
        如果(!starts_with(code, "db ") && !starts_with(code, "dq ") &&
           !starts_with(code, "resq ") && !starts_with(code, "resb ") &&
           !starts_with(code, "resd ")){
            colon = find_char(code, ":", 0);
        };
        如果(colon >= 0){
            设 label_name = trim(code.子字符串(0, colon));

            如果(label_name.以开始(".")){
                label_name = g_cur_global + label_name;
            }否则{
                g_cur_global = label_name;
            };

            设 rest = trim(code.子字符串(colon + 1, code.长度()));
            如果(rest.长度() == 0){

                创建 AsmSymbol:sym;
                sym.name = label_name;
                sym.section = cur_section;
                如果(cur_section == 0){ sym.offset = text_off; };
                如果(cur_section == 1){ sym.offset = data_off; };
                如果(cur_section == 2){ sym.offset = bss_off; };
                result.symbols.添加(sym);
                label_offs.添加(text_off);
                i = i + 1;
                继续;
            };

            创建 AsmSymbol:sym;
            sym.name = label_name;
            sym.section = cur_section;
            如果(cur_section == 0){ sym.offset = text_off; };
            如果(cur_section == 1){ sym.offset = data_off; };
            如果(cur_section == 2){ sym.offset = bss_off; };
            result.symbols.添加(sym);
            code = rest;
        };

        如果(starts_with(code, "db ")){
            设 vals = trim(code.子字符串(3, code.长度()));

            设 count = 0;
            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                如果(vals.子字符串(idx, idx + 1) == "'"){

                    设 eq = find_char(vals, "'", idx + 1);
                    如果(eq < 0){ eq = vlen; };
                    设 cnts = vals.子字符串(idx + 1, eq);
                    设 bi = 0;
                    循环(bi < 4096){
                        设 bb = cnts.字节(bi);
                        如果(bb == 0){ 跳出; };
                        bi = bi + 1;
                    };
                    count = count + bi;
                    idx = eq + 1;
                    如果(idx < vlen && vals.子字符串(idx, idx + 1) == ","){ idx = idx + 1; };
                }否则{
                    设 cm = find_char(vals, ",", idx);
                    如果(cm < 0){ count = count + 1; 跳出; };
                    count = count + 1;
                    idx = cm + 1;
                };
            };
            如果(cur_section == 0){ text_off = text_off + count; };
            如果(cur_section == 1){ data_off = data_off + count; };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "dw ")){
            设 vals = trim(code.子字符串(3, code.长度()));

            设 count = 0;
            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                设 comma = find_char(vals, ",", idx);
                如果(comma < 0){
                    count = count + 1;
                    跳出;
                }否则{
                    count = count + 1;
                    idx = comma + 1;
                };
            };
            count = count * 2;
            如果(cur_section == 0){ text_off = text_off + count; };
            如果(cur_section == 1){ data_off = data_off + count; };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "dq ")){
            设 vals = trim(code.子字符串(3, code.长度()));

            设 count = 0;
            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                设 comma = find_char(vals, ",", idx);
                如果(comma < 0){
                    count = count + 1;
                    跳出;
                }否则{
                    count = count + 1;
                    idx = comma + 1;
                };
            };
            count = count * 8;
            如果(cur_section == 0){ text_off = text_off + count; };
            如果(cur_section == 1){ data_off = data_off + count; };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "resq ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            设 sz = cnt * 8;
            如果(cur_section == 2){ bss_off = bss_off + sz; };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "resb ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            如果(cur_section == 2){ bss_off = bss_off + cnt; };
            i = i + 1;
            继续;
        };
        如果(starts_with(code, "resd ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            设 sz = cnt * 4;
            如果(cur_section == 2){ bss_off = bss_off + sz; };
            i = i + 1;
            继续;
        };

        g_enc_parts = parse_insn_line(code);
        如果(g_enc_parts.长度() > 0){
            设 ilen = insn_length();
            如果(cur_section == 0){ text_off = text_off + ilen; };
            如果(g_debug_mode == 1){
                如果((i % 500) == 0){ 错误打印("P1@" + i + ":" + code); };
            };
        };
        如果((i & 8191) == 0){ 内存报告("asm-p1-insn"); };
        p1_offs.添加(text_off);

        i = i + 1;
    };
    内存报告("asm-p1dbg-insn-block");
    内存报告("asm-p1");

    i = 0;
    循环(i < nlines){
        设 line = lines.获取(i);
        设 sc = find_char(line, ";", 0);
        设 code = line;
        如果(sc >= 0){ code = line.子字符串(0, sc); };
        code = trim(code);
        如果(starts_with(code, "global ")){
            设 gname = trim(code.子字符串(7, code.长度()));

            设 j = 0;
            循环(j < result.symbols.长度()){
                创建 AsmSymbol:sym;
                sym = result.symbols.获取(j);
                如果(sym.name == gname){
                    sym.is_global = 1;
                };
                j = j + 1;
            };
        };
        i = i + 1;
    };

    cur_section = 0;
    text_off = 0;
    data_off = 0;
    bss_off = 0;
    设 p2n = 0;
    设 label_idx = 0;

    i = 0;
    循环(i < nlines){
        如果((i & 8191) == 0){ 内存报告("asm-p2-line"); };
        设 line = lines.获取(i);
        设 sc = find_char(line, ";", 0);
        设 code = line;
        如果(sc >= 0){ code = line.子字符串(0, sc); };
        code = trim(code);
        如果(code.长度() == 0){ i = i + 1; 继续; };

        如果(starts_with(code, "section .text")){ cur_section = 0; i = i + 1; 继续; };
        如果(starts_with(code, "section .data")){ cur_section = 1; i = i + 1; 继续; };
        如果(starts_with(code, "section .bss")){ cur_section = 2; i = i + 1; 继续; };

        如果(starts_with(code, "default")){ i = i + 1; 继续; };
        如果(starts_with(code, "global ")){ i = i + 1; 继续; };
        如果(starts_with(code, "extern ")){ i = i + 1; 继续; };

        设 colon = -1;
        如果(!starts_with(code, "db ") && !starts_with(code, "dq ") &&
           !starts_with(code, "resq ") && !starts_with(code, "resb ") &&
           !starts_with(code, "resd ")){
            colon = find_char(code, ":", 0);
        };
        如果(colon >= 0){
            设 rest = trim(code.子字符串(colon + 1, code.长度()));
            如果(rest.长度() == 0){

                设 lb_name = trim(code.子字符串(0, colon));

                如果(lb_name.以开始(".")){
                    lb_name = g_cur_global + lb_name;
                }否则{
                    g_cur_global = lb_name;
                };

                设 best_off = -1;
                如果(label_idx < label_offs.长度()){ best_off = label_offs.获取(label_idx); };
                label_idx = label_idx + 1;
                如果(best_off >= 0 && best_off != text_off && cur_section == 0){
                    错误打印("P1P2-DIFF L" + i + " [" + lb_name + "] p1=" + best_off + " p2=" + text_off);
                };
                i = i + 1;
                继续;
            };

        设 lb2 = trim(code.子字符串(0, colon));
        如果(lb2.以开始(".")){
            lb2 = g_cur_global + lb2;
        }否则{
            g_cur_global = lb2;
        };
        code = rest;
        };

        如果(starts_with(code, "db ")){
            设 vals = trim(code.子字符串(3, code.长度()));

            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                如果(vals.子字符串(idx, idx + 1) == "'"){

                    设 end_q = find_char(vals, "'", idx + 1);
                    如果(end_q < 0){ end_q = vlen; };
                    设 content = vals.子字符串(idx + 1, end_q);

                    设 ci2 = 0;
                    循环(ci2 < 4096){
                        设 cb2 = content.字节(ci2);
                        如果(cb2 == 0){ 跳出; };
                        ci2 = ci2 + 1;
                    };
                    设 clen = ci2;
                    设 ci = 0;
                    循环(ci < clen){
                        设 cb = content.字节(ci);
                        如果(cur_section == 0){ result.text_bytes.添加(cb); text_off = text_off + 1; };
                        如果(cur_section == 1){ result.data_bytes.添加(cb); data_off = data_off + 1; };
                        ci = ci + 1;
                    };
                    idx = end_q + 1;
                    如果(idx < vlen && vals.子字符串(idx, idx + 1) == ","){ idx = idx + 1; };
                    继续;
                };

                设 comma = find_char(vals, ",", idx);
                设 val_str = "";
                如果(comma < 0){
                    val_str = trim(vals.子字符串(idx, vlen));
                    idx = vlen;
                }否则{
                    val_str = trim(vals.子字符串(idx, comma));
                    idx = comma + 1;
                };
                设 b = parse_int(val_str);
                如果(b < 0){ b = b + 256; };
                如果(cur_section == 0){ result.text_bytes.添加(b); text_off = text_off + 1; };
                如果(cur_section == 1){ result.data_bytes.添加(b); data_off = data_off + 1; };
            };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "dw ")){
            设 vals = trim(code.子字符串(3, code.长度()));
            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                设 comma = find_char(vals, ",", idx);
                设 val_str = "";
                如果(comma < 0){
                    val_str = trim(vals.子字符串(idx, vlen));
                    idx = vlen;
                }否则{
                    val_str = trim(vals.子字符串(idx, comma));
                    idx = comma + 1;
                };
                设 wv = 0;
                如果(trim(val_str).以开始("0x") || trim(val_str).以开始("0X")){
                    wv = parse_hex64(trim(val_str));
                }否则{
                    wv = parse_int(val_str);
                };
                如果(cur_section == 0){
                    result.text_bytes.添加(wv & 255);
                    result.text_bytes.添加((wv / 256) & 255);
                    text_off = text_off + 2;
                };
                如果(cur_section == 1){
                    result.data_bytes.添加(wv & 255);
                    result.data_bytes.添加((wv / 256) & 255);
                    data_off = data_off + 2;
                };
            };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "dq ")){
            设 vals = trim(code.子字符串(3, code.长度()));

            设 idx = 0;
            设 vlen = vals.长度();
            循环(idx < vlen){
                设 comma = find_char(vals, ",", idx);
                设 val_str = "";
                如果(comma < 0){
                    val_str = trim(vals.子字符串(idx, vlen));
                    idx = vlen;
                }否则{
                    val_str = trim(vals.子字符串(idx, comma));
                    idx = comma + 1;
                };
                设 ch0 = trim(val_str).子字符串(0, 1);
                设 is_num = 0;
                如果(ch0 == "0" || ch0 == "1" || ch0 == "2" || ch0 == "3" || ch0 == "4" ||
                   ch0 == "5" || ch0 == "6" || ch0 == "7" || ch0 == "8" || ch0 == "9" ||
                   ch0 == "-" || ch0 == "+"){ is_num = 1; };

                如果(trim(val_str).以开始("0x") || trim(val_str).以开始("0X")){
                    设 hexv = parse_hex64(trim(val_str));
                    如果(cur_section == 0){
                        result.text_bytes.添加(hexv & 255);
                        result.text_bytes.添加((hexv / 256) & 255);
                        result.text_bytes.添加((hexv / 65536) & 255);
                        result.text_bytes.添加((hexv / 16777216) & 255);
                        result.text_bytes.添加((hexv / 4294967296) & 255);
                        result.text_bytes.添加((hexv / 1099511627776) & 255);
                        result.text_bytes.添加((hexv / 281474976710656) & 255);
                        result.text_bytes.添加((hexv / 72057594037927936) & 255);
                        text_off = text_off + 8;
                    };
                    如果(cur_section == 1){
                        result.data_bytes.添加(hexv & 255);
                        result.data_bytes.添加((hexv / 256) & 255);
                        result.data_bytes.添加((hexv / 65536) & 255);
                        result.data_bytes.添加((hexv / 16777216) & 255);
                        result.data_bytes.添加((hexv / 4294967296) & 255);
                        result.data_bytes.添加((hexv / 1099511627776) & 255);
                        result.data_bytes.添加((hexv / 281474976710656) & 255);
                        result.data_bytes.添加((hexv / 72057594037927936) & 255);
                        data_off = data_off + 8;
                    };
                    继续;
                };

                设 dot_pos = find_char(trim(val_str), ".", 0);
                如果(dot_pos >= 0){
                    设 fv = parse_float_dq(trim(val_str));
                    如果(fv < 0){ fv = fv + 18446744073709551616; };
                    设 fb0 = fv & 255;
                    设 fb1 = (fv / 256) & 255;
                    设 fb2 = (fv / 65536) & 255;
                    设 fb3 = (fv / 16777216) & 255;
                    设 fb4 = (fv / 4294967296) & 255;
                    设 fb5 = (fv / 1099511627776) & 255;
                    设 fb6 = (fv / 281474976710656) & 255;
                    设 fb7 = (fv / 72057594037927936) & 255;
                    如果(cur_section == 0){
                        result.text_bytes.添加(fb0); result.text_bytes.添加(fb1);
                        result.text_bytes.添加(fb2); result.text_bytes.添加(fb3);
                        result.text_bytes.添加(fb4); result.text_bytes.添加(fb5);
                        result.text_bytes.添加(fb6); result.text_bytes.添加(fb7);
                        text_off = text_off + 8;
                    };
                    如果(cur_section == 1){
                        result.data_bytes.添加(fb0); result.data_bytes.添加(fb1);
                        result.data_bytes.添加(fb2); result.data_bytes.添加(fb3);
                        result.data_bytes.添加(fb4); result.data_bytes.添加(fb5);
                        result.data_bytes.添加(fb6); result.data_bytes.添加(fb7);
                        data_off = data_off + 8;
                    };
                    继续;
                };
                如果(is_num == 0){

                    创建 AsmReloc:rel;
                    rel.section = cur_section;
                    rel.offset = data_off;
                    如果(cur_section == 0){ rel.offset = text_off; };
                    rel.sym_name = trim(val_str);
                    rel.type = RELOC_ADDR64;
                    result.relocs.添加(rel);
                    如果(cur_section == 0){
                        result.text_bytes.添加(0); result.text_bytes.添加(0);
                        result.text_bytes.添加(0); result.text_bytes.添加(0);
                        result.text_bytes.添加(0); result.text_bytes.添加(0);
                        result.text_bytes.添加(0); result.text_bytes.添加(0);
                        text_off = text_off + 8;
                    };
                    如果(cur_section == 1){
                        result.data_bytes.添加(0); result.data_bytes.添加(0);
                        result.data_bytes.添加(0); result.data_bytes.添加(0);
                        result.data_bytes.添加(0); result.data_bytes.添加(0);
                        result.data_bytes.添加(0); result.data_bytes.添加(0);
                        data_off = data_off + 8;
                    };
                    继续;
                };
                设 v = parse_int(val_str);
                如果(v < 0){ v = v + 18446744073709551616; };
                设 b0 = v & 255;
                设 b1 = (v / 256) & 255;
                设 b2 = (v / 65536) & 255;
                设 b3 = (v / 16777216) & 255;
                设 b4 = (v / 4294967296) & 255;
                设 b5 = (v / 1099511627776) & 255;
                设 b6 = (v / 281474976710656) & 255;
                设 b7 = (v / 72057594037927936) & 255;
                如果(cur_section == 0){
                    result.text_bytes.添加(b0); result.text_bytes.添加(b1);
                    result.text_bytes.添加(b2); result.text_bytes.添加(b3);
                    result.text_bytes.添加(b4); result.text_bytes.添加(b5);
                    result.text_bytes.添加(b6); result.text_bytes.添加(b7);
                    text_off = text_off + 8;
                };
                如果(cur_section == 1){
                    result.data_bytes.添加(b0); result.data_bytes.添加(b1);
                    result.data_bytes.添加(b2); result.data_bytes.添加(b3);
                    result.data_bytes.添加(b4); result.data_bytes.添加(b5);
                    result.data_bytes.添加(b6); result.data_bytes.添加(b7);
                    data_off = data_off + 8;
                };
            };
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "resq ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            bss_off = bss_off + cnt * 8;
            i = i + 1;
            继续;
        };

        如果(starts_with(code, "resb ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            bss_off = bss_off + cnt;
            i = i + 1;
            继续;
        };
        如果(starts_with(code, "resd ")){
            设 cnt = parse_int(trim(code.子字符串(5, code.长度())));
            bss_off = bss_off + cnt * 4;
            i = i + 1;
            继续;
        };

        g_enc_parts = parse_insn_line(code);
        g_enc_symbols = result.symbols;
        g_enc_relocs = result.relocs;
        设 plen = g_enc_parts.长度();
        如果(plen > 0){
            创建 ArrayList:encoded;
            设 cur_off = text_off;
            如果(cur_section == 0){
                设 chk_len = insn_length();
                encoded = encode_insn(cur_section, cur_off);
                如果(chk_len != encoded.长度()){
                    错误打印("LENMISMATCH @" + cur_off + " L" + i + " [" + code + "] il=" + chk_len + " enc=" + encoded.长度());
                };
                设 j = 0;
                循环(j < encoded.长度()){
                    result.text_bytes.添加(encoded.获取(j));
                    j = j + 1;
                };
                text_off = text_off + encoded.长度();
            };
        };

        如果(p2n < p1_offs.长度() && p1_offs.获取(p2n) != text_off){
            错误打印("P12-DIFF L" + i + " [" + code + "] p1=" + p1_offs.获取(p2n) + " p2=" + text_off);
        };
        p2n = p2n + 1;

        i = i + 1;
    };

    result.bss_size = bss_off;
    返回值 result;
};

声明 write_coff(result, filename){

    创建 AsmResult:rr;
    rr = result;
    如果(g_debug_mode == 1){ 打印("WC-ENTER"); };

    设 text_len = rr.text_bytes.长度();
    设 data_len = rr.data_bytes.长度();
    设 bss_len = rr.bss_size;

    创建 ArrayList:sym_names;
    创建 ArrayList:sym_secs;
    创建 ArrayList:sym_vals;
    创建 ArrayList:sym_cls;
    设 sym_dict = [];
    sym_names.添加(".text"); sym_secs.添加(1); sym_vals.添加(0); sym_cls.添加(3);
    字典设置(sym_dict, ".text", 0);
    sym_names.添加(".data"); sym_secs.添加(2); sym_vals.添加(0); sym_cls.添加(3);
    字典设置(sym_dict, ".data", 1);
    sym_names.添加(".bss");  sym_secs.添加(3); sym_vals.添加(0); sym_cls.添加(3);
    字典设置(sym_dict, ".bss", 2);
    设 n_syms = rr.symbols.长度();
    设 si = 0;
    循环(si < n_syms){
        创建 AsmSymbol:asym;
        asym = rr.symbols.获取(si);
        如果(sym_dict.存在键(asym.name) == 0){
            设 nidx = sym_names.长度();
            sym_names.添加(asym.name);
            如果(asym.is_extern == 1){
                sym_secs.添加(0); sym_vals.添加(0); sym_cls.添加(2);
            }否则{
                sym_secs.添加(asym.section + 1); sym_vals.添加(asym.offset);

                如果(asym.is_global == 1){
                    sym_cls.添加(2);
                }否则{
                    sym_cls.添加(3);
                };
            };
            字典设置(sym_dict, asym.name, nidx);
        };
        si = si + 1;
    };
    设 nsyms = sym_names.长度();

    设 strtab_len = 4;
    设 si2 = 0;
    循环(si2 < nsyms){
        设 nm = sym_names.获取(si2);
        如果(nm.长度() > 8){
            strtab_len = strtab_len + nm.长度() + 1;
        };
        si2 = si2 + 1;
    };

    设 nrel_text = 0;
    设 nrel_data = 0;
    设 nr = rr.relocs.长度();
    设 ri = 0;
    循环(ri < nr){
        创建 AsmReloc:arel;
        arel = rr.relocs.获取(ri);
        如果(arel.section == 0){ nrel_text = nrel_text + 1; };
        如果(arel.section == 1){ nrel_data = nrel_data + 1; };
        ri = ri + 1;
    };

    设 ovf_text = 0;
    如果(nrel_text >= 0xFFFF){ ovf_text = 1; };
    设 ovf_data = 0;
    如果(nrel_data >= 0xFFFF){ ovf_data = 1; };

    设 total = 20 + 120 + text_len + data_len + (nrel_text + nrel_data + ovf_text + ovf_data) * 10 + nsyms * 18 + strtab_len;
    设 buf = 分配(total);
    设 raw_off = 140;

    内存.写字节(buf, 0, 0x64); 内存.写字节(buf, 1, 0x86);
    内存.写字节(buf, 2, 3); 内存.写字节(buf, 3, 0);
    内存.写字节(buf, 4, 0); 内存.写字节(buf, 5, 0);
    内存.写字节(buf, 6, 0); 内存.写字节(buf, 7, 0);
    内存.写字节(buf, 16, 0); 内存.写字节(buf, 17, 0);
    内存.写字节(buf, 18, 0); 内存.写字节(buf, 19, 0);

    内存.写字节(buf, 20, 46); 内存.写字节(buf, 21, 116);
    内存.写字节(buf, 22, 101); 内存.写字节(buf, 23, 120);
    内存.写字节(buf, 24, 116); 内存.写字节(buf, 25, 0);
    内存.写字节(buf, 26, 0); 内存.写字节(buf, 27, 0);
    write_u32_asm(buf, 28, text_len);
    write_u32_asm(buf, 32, 0);
    write_u32_asm(buf, 36, text_len);
    write_u32_asm(buf, 40, raw_off);
    设 text_reloc_ptr = raw_off + text_len + data_len;
    write_u32_asm(buf, 44, text_reloc_ptr);
    write_u32_asm(buf, 48, 0);
    如果(ovf_text == 1){
        内存.写字节(buf, 52, 0xFF); 内存.写字节(buf, 53, 0xFF);
        内存.写字节(buf, 54, 0); 内存.写字节(buf, 55, 0);
        write_u32_asm(buf, 56, 0x61000020);
    }否则{
        内存.写字节(buf, 52, nrel_text & 255); 内存.写字节(buf, 53, (nrel_text / 256) & 255);
        内存.写字节(buf, 54, 0); 内存.写字节(buf, 55, 0);
        write_u32_asm(buf, 56, 0x60000020);
    };

    设 data_raw_off = raw_off + text_len;
    内存.写字节(buf, 60, 46); 内存.写字节(buf, 61, 100);
    内存.写字节(buf, 62, 97); 内存.写字节(buf, 63, 116);
    内存.写字节(buf, 64, 97); 内存.写字节(buf, 65, 0);
    内存.写字节(buf, 66, 0); 内存.写字节(buf, 67, 0);
    write_u32_asm(buf, 68, data_len);
    write_u32_asm(buf, 72, 0);
    write_u32_asm(buf, 76, data_len);
    write_u32_asm(buf, 80, data_raw_off);
    write_u32_asm(buf, 84, text_reloc_ptr + (nrel_text + ovf_text) * 10);
    write_u32_asm(buf, 88, 0);
    如果(ovf_data == 1){
        内存.写字节(buf, 92, 0xFF); 内存.写字节(buf, 93, 0xFF);
        内存.写字节(buf, 94, 0); 内存.写字节(buf, 95, 0);
        write_u32_asm(buf, 96, 0xD0000040);
    }否则{
        内存.写字节(buf, 92, nrel_data & 255); 内存.写字节(buf, 93, (nrel_data / 256) & 255);
        内存.写字节(buf, 94, 0); 内存.写字节(buf, 95, 0);
        write_u32_asm(buf, 96, 0xC0000040);
    };

    内存.写字节(buf, 100, 46); 内存.写字节(buf, 101, 98);
    内存.写字节(buf, 102, 115); 内存.写字节(buf, 103, 115);
    内存.写字节(buf, 104, 0); 内存.写字节(buf, 105, 0);
    内存.写字节(buf, 106, 0); 内存.写字节(buf, 107, 0);
    write_u32_asm(buf, 108, bss_len);
    write_u32_asm(buf, 112, 0);
    write_u32_asm(buf, 116, 0);
    write_u32_asm(buf, 120, 0);
    write_u32_asm(buf, 124, 0);
    write_u32_asm(buf, 128, 0);
    内存.写字节(buf, 132, 0); 内存.写字节(buf, 133, 0);
    内存.写字节(buf, 134, 0); 内存.写字节(buf, 135, 0);
    write_u32_asm(buf, 136, 0xC0000080);

    设 ti = 0;
    循环(ti < text_len){
        内存.写字节(buf, raw_off + ti, rr.text_bytes.获取(ti));
        ti = ti + 1;
    };
    设 di = 0;
    循环(di < data_len){
        内存.写字节(buf, data_raw_off + di, rr.data_bytes.获取(di));
        di = di + 1;
    };

    设 reloc_off = text_reloc_ptr;
    如果(ovf_text == 1){

        write_u32_asm(buf, reloc_off, nrel_text);
        write_u32_asm(buf, reloc_off + 4, 0);
        内存.写字节(buf, reloc_off + 8, 0); 内存.写字节(buf, reloc_off + 9, 0);
        reloc_off = reloc_off + 10;
    };
    设 ri2 = 0;
    循环(ri2 < nr){
        创建 AsmReloc:r2;
        r2 = rr.relocs.获取(ri2);
        如果(r2.section == 0){
            write_u32_asm(buf, reloc_off, r2.offset);
            设 sfound = -1;
            设 sidx = 字典获取(sym_dict, r2.sym_name);
            如果(sidx == 空){

                错误打印("RELOC 符号缺失: [" + r2.sym_name + "] @" + r2.offset + " keylen=" + r2.sym_name.长度() + " dictlen=" + sym_dict.长度());
                sfound = 0;
            }否则{
                sfound = sidx;
            };
            write_u32_asm(buf, reloc_off + 4, sfound);
            设 rtype = 4;
            如果(r2.type == 2){ rtype = 1; };
            又如果(r2.type == 3){ rtype = 5; };
            又如果(r2.type == 4){ rtype = 8; };
            内存.写字节(buf, reloc_off + 8, rtype & 255);
            内存.写字节(buf, reloc_off + 9, (rtype / 256) & 255);
            reloc_off = reloc_off + 10;
        };
        ri2 = ri2 + 1;
    };
    如果(ovf_data == 1){
        write_u32_asm(buf, reloc_off, nrel_data);
        write_u32_asm(buf, reloc_off + 4, 0);
        内存.写字节(buf, reloc_off + 8, 0); 内存.写字节(buf, reloc_off + 9, 0);
        reloc_off = reloc_off + 10;
    };
    设 ri3 = 0;
    循环(ri3 < nr){
        创建 AsmReloc:r3;
        r3 = rr.relocs.获取(ri3);
        如果(r3.section == 1){
            write_u32_asm(buf, reloc_off, r3.offset);
            设 sfound2 = -1;
            设 sidx2 = 字典获取(sym_dict, r3.sym_name);
            如果(sidx2 == 空){
                错误打印("RELOC 符号缺失: [" + r3.sym_name + "] @" + r3.offset);
                sfound2 = 0;
            }否则{
                sfound2 = sidx2;
            };
            write_u32_asm(buf, reloc_off + 4, sfound2);
            设 rtype2 = 4;
            如果(r3.type == 2){ rtype2 = 1; };
            又如果(r3.type == 3){ rtype2 = 5; };
            又如果(r3.type == 4){ rtype2 = 8; };
            内存.写字节(buf, reloc_off + 8, rtype2 & 255);
            内存.写字节(buf, reloc_off + 9, (rtype2 / 256) & 255);
            reloc_off = reloc_off + 10;
        };
        ri3 = ri3 + 1;
    };

    设 sym_off = reloc_off;
    设 sym_start = sym_off;
    设 str_off = 4;
    设 si3 = 0;
    循环(si3 < nsyms){
        设 nm = sym_names.获取(si3);
        设 nm_len = nm.长度();
        如果(nm_len <= 8){
            设 c = 0;
            循环(c < 8){
                如果(c < nm_len){
                    内存.写字节(buf, sym_off + c, nm.字节(c));
                }否则{
                    内存.写字节(buf, sym_off + c, 0);
                };
                c = c + 1;
            };
        }否则{
            write_u32_asm(buf, sym_off, 0);
            write_u32_asm(buf, sym_off + 4, str_off);
            str_off = str_off + nm_len + 1;
        };
        write_u32_asm(buf, sym_off + 8, sym_vals.获取(si3));
        内存.写字节(buf, sym_off + 12, sym_secs.获取(si3) & 255);
        内存.写字节(buf, sym_off + 13, (sym_secs.获取(si3) / 256) & 255);
        内存.写字节(buf, sym_off + 14, 0); 内存.写字节(buf, sym_off + 15, 0);
        内存.写字节(buf, sym_off + 16, sym_cls.获取(si3));
        内存.写字节(buf, sym_off + 17, 0);
        sym_off = sym_off + 18;
        si3 = si3 + 1;
    };

    write_u32_asm(buf, sym_off, strtab_len);
    设 sti = 0;
    设 stw = 0;
    循环(sti < nsyms){
        设 nm2 = sym_names.获取(sti);
        设 nl2 = nm2.长度();
        如果(nl2 > 8){
            设 ci2 = 0;
            循环(ci2 < nl2){
                内存.写字节(buf, sym_off + 4 + stw, nm2.字节(ci2));
                stw = stw + 1;
                ci2 = ci2 + 1;
            };
            内存.写字节(buf, sym_off + 4 + stw, 0);
            stw = stw + 1;
        };
        sti = sti + 1;
    };

    write_u32_asm(buf, 8, sym_start);
    write_u32_asm(buf, 12, nsyms);

    设 h = win_create_file(filename);
    如果(h == 0){ 释放(buf); 返回值 -1; };
    设 wr = win_write_file(h, buf, total);
    win_close_handle(h);
    释放(buf);
    返回值 wr;
};

声明 write_u32_asm(buf, off, val){
    内存.写字节(buf, off, val & 255);
    内存.写字节(buf, off + 1, (val / 256) & 255);
    内存.写字节(buf, off + 2, (val / 65536) & 255);
    内存.写字节(buf, off + 3, (val / 16777216) & 255);
    返回值 0;
};

声明 parse_hex64(s0){
    设 t = trim(s0);
    设 start = 2;
    如果(t.长度() >= 3 && (t.子字符串(0, 2) == "0x" || t.子字符串(0, 2) == "0X")){
        start = 2;
    }否则{
        返回值 0;
    };
    设 acc = 0;
    设 i = start;
    设 len = t.长度();
    循环(i < len){
        acc = acc * 16;
        设 ch = t.字节(i);
        如果(ch >= 48 && ch <= 57){ acc = acc + (ch - 48); };
        又如果(ch >= 65 && ch <= 70){ acc = acc + (ch - 55); };
        又如果(ch >= 97 && ch <= 102){ acc = acc + (ch - 87); };
        i = i + 1;
    };
    返回值 acc;
};