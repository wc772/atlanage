    如果(starts_with(mnemonic, "lock ")){
        设 inner_m = mnemonic.子字符串(5, mnemonic.长度());

        如果(inner_m == "cmpxchg"){
            创建 Operand:lxl;
            lxl = parse_operand(g_enc_parts.获取(1));
