    如果(mnemonic == "lea"){

        如果(dst.type == OPND_REG && src.type == OPND_RIPMEM){
            设 d = reg_num(dst.reg);
            设 r_bit = 0;
            如果(d >= 8){ r_bit = 1; };
            bytes.添加(make_rex(1, r_bit, 0, 0));
            bytes.添加(0x8D);
            emit_modrm_rip(d & 7);
            add_reloc(section, offset + 3, src.label, RELOC_RIP32);
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 d = reg_num(dst.reg);
            设 r_bit = 0;
            设 b_bit = 0;
