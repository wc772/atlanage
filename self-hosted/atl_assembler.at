            如果(r >= 8){ b2 = 1; };
            bytes.添加(make_rex(1, 0, 0, b2));
            bytes.添加(0xB8 + (r & 7));
            bytes.添加(v & 255);
            bytes.添加((v / 256) & 255);
            bytes.添加((v / 65536) & 255);
            bytes.添加((v / 16777216) & 255);
            设 hi = v / 4294967296;
            bytes.添加(hi & 255);
            bytes.添加((hi / 256) & 255);
            bytes.添加((hi / 65536) & 255);
            bytes.添加((hi / 16777216) & 255);
            返回值 bytes;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
