        创建 Operand:as;
        as = parse_operand(g_enc_parts.获取(2));
        如果(ad.type == OPND_REG && as.type == OPND_REG){
            设 adn = reg_num(ad.reg);
            设 asn = reg_num(as.reg);
            设 ar_bit = 0;
            设 ab_bit = 0;
            如果(asn >= 8){ ar_bit = 1; };
            如果(adn >= 8){ ab_bit = 1; };
            设 aw = 0;
            如果(ad.reg < 100){ aw = 1; };
            设 aopc = 0x21;
            如果(mnemonic == "or"){ aopc = 0x09; };
            如果(mnemonic == "xor"){ aopc = 0x31; };
            如果(aw || ar_bit || ab_bit){
                bytes.添加(make_rex(aw, ar_bit, 0, ab_bit));
