设 RELOC_REL32 = 0;
设 RELOC_RIP32 = 1;
设 RELOC_ADDR64 = 2;
设 RELOC_RIP32_IMM1 = 3;
设 RELOC_RIP32_IMM4 = 4;

声明 parse_float_dq(s0){
    设 s = trim(s0);
    设 neg = 0;
    如果(s.子字符串(0, 1) == "-"){
        neg = 1;
        s = s.子字符串(1, s.长度());
    };

    设 dot = find_char(s, ".", 0);
    设 ip_str = s;
    设 fp_str = "";
    如果(dot >= 0){
        ip_str = s.子字符串(0, dot);
        fp_str = s.子字符串(dot + 1, s.长度());
    };
    设 ip = parse_int(ip_str);

    设 fp = 0;
    设 nd = fp_str.长度();
    设 j = 0;
    循环(j < nd){
        fp = fp * 10 + (fp_str.字节(j) - 48);
        j = j + 1;
    };

    设 num = ip;
    设 den = 1;
    j = 0;
    循环(j < nd){
        num = num * 10;
        den = den * 10;
        j = j + 1;
    };
    num = num + fp;

    如果(num == 0){ 返回值 0; };

    设 e = 0;
    循环(1 == 1){
        如果(num < den){
            num = num * 2;
            e = e - 1;
        }又如果(num >= den * 2){
            den = den * 2;
            e = e + 1;
        }否则{
            跳出;
        };
    };

    设 m = 0;
    设 frac = num - den;
    设 bit = 51;
    设 pow2 = 2251799813685248;
    循环(bit >= 0){
        frac = frac * 2;
        如果(frac >= den){
            m = m + pow2;
            frac = frac - den;
        };
        pow2 = pow2 / 2;
        bit = bit - 1;
    };

    设 exp_field = e + 1023;
    设 bits = exp_field * 4503599627370496 + m;
    如果(neg == 1){

        bits = bits - 9223372036854775808;
    };
    返回值 bits;
};

设 g_enc_parts = 空;
设 g_enc_symbols = 空;
设 g_enc_relocs = 空;
设 g_enc_out_bytes = 空;
设 g_cur_global = "";

声明 init_asm_globals(){
    创建 ArrayList:g_enc_parts;
    创建 ArrayList:g_enc_symbols;
    创建 ArrayList:g_enc_relocs;
    创建 ArrayList:g_enc_out_bytes;
    返回值 0;
};
init_asm_globals();

类 AsmSymbol {
公开:
    设 name 存在;
    设 section 存在;
    设 offset 存在;
    设 is_global 存在;
    设 is_extern 存在;

    构造(){
        name = 空;
        section = 0;
        offset = 0;
        is_global = 0;
        is_extern = 0;
    };
};

类 AsmReloc {
公开:
    设 section 存在;
    设 offset 存在;
    设 sym_name 存在;
    设 type 存在;

    构造(){
        section = 0;
        offset = 0;
        sym_name = 空;
        type = 0;
    };
};

类 AsmResult {
公开:
    设 text_bytes 存在;
    设 data_bytes 存在;
    设 bss_size 存在;
    设 symbols 存在;
    设 relocs 存在;

    构造(){
        text_bytes = 创建 ArrayList;
        data_bytes = 创建 ArrayList;
        bss_size = 0;
        symbols = 创建 ArrayList;
        relocs = 创建 ArrayList;
    };
};

声明 reg_lookup(name){
    如果(name == "rax"){ 返回值 0; };
    如果(name == "rcx"){ 返回值 1; };
    如果(name == "cl"){ 返回值 201; };
    如果(name == "rdx"){ 返回值 2; };
    如果(name == "rbx"){ 返回值 3; };
    如果(name == "rsp"){ 返回值 4; };
    如果(name == "rbp"){ 返回值 5; };
    如果(name == "rsi"){ 返回值 6; };
    如果(name == "rdi"){ 返回值 7; };
    如果(name == "r8"){ 返回值 8; };
    如果(name == "r9"){ 返回值 9; };
    如果(name == "r10"){ 返回值 10; };
    如果(name == "r11"){ 返回值 11; };
    如果(name == "r12"){ 返回值 12; };
    如果(name == "r13"){ 返回值 13; };
    如果(name == "r14"){ 返回值 14; };
    如果(name == "r15"){ 返回值 15; };
    如果(name == "eax"){ 返回值 100; };
    如果(name == "ecx"){ 返回值 101; };
    如果(name == "edx"){ 返回值 102; };
    如果(name == "ebx"){ 返回值 103; };
    如果(name == "esp"){ 返回值 104; };
    如果(name == "ebp"){ 返回值 105; };
    如果(name == "esi"){ 返回值 106; };
    如果(name == "edi"){ 返回值 107; };
    如果(name == "r8d"){ 返回值 108; };
    如果(name == "r9d"){ 返回值 109; };
    如果(name == "r10d"){ 返回值 110; };
    如果(name == "r11d"){ 返回值 111; };
    如果(name == "r12d"){ 返回值 112; };
    如果(name == "r13d"){ 返回值 113; };
    如果(name == "r14d"){ 返回值 114; };
    如果(name == "r15d"){ 返回值 115; };

    如果(name == "al"){ 返回值 200; };
    如果(name == "cl"){ 返回值 201; };
    如果(name == "dl"){ 返回值 202; };
    如果(name == "bl"){ 返回值 203; };
    如果(name == "spl"){ 返回值 204; };
    如果(name == "bpl"){ 返回值 205; };
    如果(name == "sil"){ 返回值 206; };
    如果(name == "dil"){ 返回值 207; };
    如果(name == "r8b"){ 返回值 208; };
    如果(name == "r9b"){ 返回值 209; };
    如果(name == "r10b"){ 返回值 210; };
    如果(name == "r11b"){ 返回值 211; };
    如果(name == "r12b"){ 返回值 212; };
    如果(name == "r13b"){ 返回值 213; };
    如果(name == "r14b"){ 返回值 214; };
    如果(name == "r15b"){ 返回值 215; };

    如果(name == "ax"){ 返回值 300; };
    如果(name == "cx"){ 返回值 301; };
    如果(name == "dx"){ 返回值 302; };
    如果(name == "bx"){ 返回值 303; };
    如果(name == "sp"){ 返回值 304; };
    如果(name == "bp"){ 返回值 305; };
    如果(name == "si"){ 返回值 306; };
    如果(name == "di"){ 返回值 307; };
    如果(name == "r8w"){ 返回值 308; };
    如果(name == "r9w"){ 返回值 309; };
    如果(name == "r10w"){ 返回值 310; };
    如果(name == "r11w"){ 返回值 311; };
    如果(name == "r12w"){ 返回值 312; };
    如果(name == "r13w"){ 返回值 313; };
    如果(name == "r14w"){ 返回值 314; };
    如果(name == "r15w"){ 返回值 315; };
    返回值 -1;
};

声明 is_reg64(r){
    返回值 (r >= 0 && r < 100);
};

声明 parse_xmm(s){
    设 t = trim(s);
    如果(t.以开始("xmm")){
        设 num = parse_int(t.子字符串(3, t.长度()));
        如果(num >= 0 && num <= 15){ 返回值 num; };
    };
    返回值 -1;
};

声明 reg_num(r){
    如果(r >= 300){ 返回值 r - 300; };
    如果(r >= 200){ 返回值 r - 200; };
    如果(r >= 100){ 返回值 r - 100; };
    返回值 r;
};

声明 find_char(s, ch, from){
    返回值 检索从(s, ch, from);
};

声明 trim(s){
    返回值 s.去除空白();
};

声明 parse_int(s){
    设 t = trim(s);
    设 len = t.长度();
    如果(len == 0){ 返回值 0; };

    如果(len >= 3 && (t.子字符串(0, 2) == "0x" || t.子字符串(0, 2) == "0X")){
        设 hexv = 0;
        设 hi = 2;
        循环(hi < len){
            hexv = hexv * 16;
            设 hb = t.字节(hi);
            如果(hb >= 48 && hb <= 57){ hexv = hexv + (hb - 48); };
            又如果(hb >= 65 && hb <= 70){ hexv = hexv + (hb - 55); };
            又如果(hb >= 97 && hb <= 102){ hexv = hexv + (hb - 87); };
            hi = hi + 1;
        };
        返回值 hexv;
    };
    设 neg = 0;
    设 idx = 0;
    设 b0 = t.字节(0);
    如果(b0 == 45){
        neg = 1;
        idx = 1;
    }又如果(b0 == 43){
        idx = 1;
    };
    设 val = 0;
    循环(idx < len){
        设 b = t.字节(idx);
        如果(b >= 48 && b <= 57){
            val = val * 10 + (b - 48);
        }否则{
            跳出;
        };
        idx = idx + 1;
    };
    如果(neg){ val = -val; };
    返回值 val;
};

声明 eval_disp(s){
    设 t = trim(s);
    设 len = t.长度();
    设 i = 0;
    设 total = 0;
    设 term = 0;
    设 sign = 1;
    循环(i < len){
        设 c = t.字节(i);
        如果(c == 43){
            total = total + sign * term;
            term = 0;
            sign = 1;
            i = i + 1;
        }又如果(c == 45){
            total = total + sign * term;
            term = 0;
            sign = -1;
            i = i + 1;
        }又如果(c == 42){

            设 j = i + 1;
            设 v2 = 0;
            循环(j < len){
                设 b2 = t.字节(j);
                如果(b2 >= 48 && b2 <= 57){
                    v2 = v2 * 10 + (b2 - 48);
                    j = j + 1;
                }否则{
                    跳出;
                };
            };
            term = term * v2;
            i = j;
        }又如果(c >= 48 && c <= 57){

            如果(c == 48 && i + 1 < len){
                设 nx = t.字节(i + 1);
                如果(nx == 120 || nx == 88){
                    i = i + 2;
                    设 hv = 0;
                    循环(i < len){
                        设 hb = t.字节(i);
                        如果(hb >= 48 && hb <= 57){ hv = hv * 16 + (hb - 48); }
                        又如果(hb >= 65 && hb <= 70){ hv = hv * 16 + (hb - 55); }
                        又如果(hb >= 97 && hb <= 102){ hv = hv * 16 + (hb - 87); }
                        否则{ 跳出; };
                        i = i + 1;
                    };
                    term = hv;
                    继续;
                };
            };
            term = term * 10 + (c - 48);
            i = i + 1;
        }否则{
            i = i + 1;
        };
    };
    total = total + sign * term;
    返回值 total;
};

声明 is_int_str(s){
    设 t = trim(s);
    设 len = t.长度();
    如果(len == 0){ 返回值 0; };

    如果(len >= 3 && (t.子字符串(0, 2) == "0x" || t.子字符串(0, 2) == "0X")){
        设 hi = 2;
        循环(hi < len){
            设 hb = t.字节(hi);
            如果(!((hb >= 48 && hb <= 57) || (hb >= 65 && hb <= 70) || (hb >= 97 && hb <= 102))){
                返回值 0;
            };
            hi = hi + 1;
        };
        返回值 1;
    };
    设 idx = 0;
    设 b0 = t.字节(0);
    如果(b0 == 45 || b0 == 43){
        idx = 1;
        如果(len == 1){ 返回值 0; };
    };
    循环(idx < len){
        设 b = t.字节(idx);
        如果(b < 48 || b > 57){ 返回值 0; };
        idx = idx + 1;
    };
    返回值 1;
};

声明 starts_with(s, prefix){
    返回值 s.以开始(prefix);
};

声明 is_label_char(ch){
    设 cp = 码点(ch);
    如果(cp >= 48 && cp <= 57){ 返回值 1; };
    如果(cp >= 65 && cp <= 90){ 返回值 1; };
    如果(cp >= 97 && cp <= 122){ 返回值 1; };
    如果(cp == 95){ 返回值 1; };
    如果(cp == 46){ 返回值 1; };
    返回值 0;
};

设 OPND_REG = 1;
设 OPND_IMM = 2;
设 OPND_MEM = 3;
设 OPND_LABEL = 4;
设 OPND_RIPMEM = 5;

类 Operand {
公开:
    设 type 存在;
    设 reg 存在;
    设 imm 存在;
    设 label 存在;
    设 is_global 存在;
    设 index 存在;
    设 scale 存在;
    设 size 存在;

    构造(){
        type = 0;
        reg = -1;
        imm = 0;
        label = 空;
        is_global = 0;
        index = -1;
        scale = 1;
        size = 0;
    };
};

声明 parse_operand(s){
    创建 Operand:opnd;
    设 t = trim(s);

    如果(t.以开始("qword ")){ opnd.size = 8; t = trim(t.子字符串(6, t.长度())); }
    又如果(t.以开始("dword ")){ opnd.size = 4; t = trim(t.子字符串(6, t.长度())); }
    又如果(t.以开始("word ")){ opnd.size = 2; t = trim(t.子字符串(5, t.长度())); }
    又如果(t.以开始("byte ")){ opnd.size = 1; t = trim(t.子字符串(5, t.长度())); };
    设 len = t.长度();
    如果(len == 0){ 返回值 opnd; };

    如果(t.子字符串(0, 1) == "["){

        设 rb = find_char(t, "]", 1);
        如果(rb < 0){ 返回值 opnd; };
        设 inner = trim(t.子字符串(1, rb));

        设 r = reg_lookup(inner);
        如果(r < 0){

            设 plus_pos = find_char(inner, "+", 0);
            设 minus_pos = find_char(inner, "-", 0);
            设 sep = -1;
            如果(plus_pos >= 0){ sep = plus_pos; };
            如果(minus_pos >= 0){
                如果(sep < 0 || minus_pos < sep){ sep = minus_pos; };
            };

            如果(sep < 0){

                设 lbl1 = inner;
                如果(lbl1.以开始("rel ")){
                    lbl1 = lbl1.子字符串(4, lbl1.长度());
                };

                如果(lbl1.以开始(".") && g_cur_global.长度() > 0){
                    lbl1 = g_cur_global + lbl1;
                };
                opnd.type = OPND_RIPMEM;
                opnd.label = lbl1;
                opnd.is_global = 1;
            }否则{

                设 base_str = trim(inner.子字符串(0, sep));
                设 rest = trim(inner.子字符串(sep + 1, len));
                设 base_reg = reg_lookup(base_str);
                如果(base_reg >= 0){
                    opnd.type = OPND_MEM;
                    opnd.reg = base_reg;

                    设 star_pos = find_char(rest, "*", 0);
                    如果(star_pos >= 0){
                        设 idx_str = trim(rest.子字符串(0, star_pos));
                        设 sc_str = trim(rest.子字符串(star_pos + 1, len));
                        设 idx_reg = reg_lookup(idx_str);
                        如果(idx_reg >= 0){
                            opnd.index = idx_reg;
                            opnd.scale = parse_int(sc_str);
                            opnd.imm = 0;
                        }否则{
                            opnd.imm = eval_disp(rest);
                        };
                    }否则{

                        设 rest_reg = reg_lookup(rest);
                        如果(rest_reg >= 0 && sep == plus_pos){
                            opnd.index = rest_reg;
                            opnd.scale = 1;
                            opnd.imm = 0;
                        }否则{

                            设 sep2 = -1;
                            设 plus2 = find_char(rest, "+", 1);
                            设 minus2 = find_char(rest, "-", 1);
                            如果(plus2 >= 0){ sep2 = plus2; };
                            如果(minus2 >= 0){
                                如果(sep2 < 0 || minus2 < sep2){ sep2 = minus2; };
                            };
                            如果(sep2 > 0){
                                设 disp_str = trim(rest.子字符串(0, sep2));
                                设 idx_str = trim(rest.子字符串(sep2 + 1, rest.长度()));
                                设 idx_reg2 = reg_lookup(idx_str);
                                如果(idx_reg2 >= 0){

                                    设 dv2 = parse_int(disp_str);
                                    如果(sep == minus_pos){ opnd.imm = -dv2; }
                                    否则{ opnd.imm = dv2; };
                                    opnd.index = idx_reg2;
                                    opnd.scale = 1;
                                }否则{

                                    设 idx_reg3 = reg_lookup(disp_str);
                                    如果(idx_reg3 >= 0){
                                        opnd.index = idx_reg3;
                                        opnd.scale = 1;
                                        设 dv3 = parse_int(idx_str);
                                        如果(sep2 == minus2){ opnd.imm = -dv3; }
                                        否则{ opnd.imm = dv3; };
                                    }否则{
                                        如果(sep == minus_pos){ opnd.imm = -eval_disp(rest); }
                                        否则{ opnd.imm = eval_disp(rest); };
                                    };
                                };
                            }否则{

                                如果(sep == minus_pos){
                                    opnd.imm = -eval_disp(rest);
                                }否则{
                                    opnd.imm = eval_disp(rest);
                                };
                            };
                        };
                    };
                }否则{

                    设 lbl2 = inner;
                    如果(lbl2.以开始("rel ")){
                        lbl2 = lbl2.子字符串(4, lbl2.长度());
                    };
                    opnd.type = OPND_RIPMEM;
                    opnd.label = lbl2;
                    opnd.is_global = 1;
                };
            };
        }否则{

            opnd.type = OPND_MEM;
            opnd.reg = r;
            opnd.imm = 0;
        };
        返回值 opnd;
    };

    如果(is_int_str(t)){
        opnd.type = OPND_IMM;
        opnd.imm = parse_int(t);
        返回值 opnd;
    };

    设 r2 = reg_lookup(t);
    如果(r2 >= 0){
        opnd.type = OPND_REG;
        opnd.reg = r2;
        返回值 opnd;
    };

    opnd.type = OPND_LABEL;
    opnd.label = t;

    如果(opnd.label.以开始(".") && g_cur_global.长度() > 0){
        opnd.label = g_cur_global + opnd.label;
    };
    opnd.is_global = 1;
    返回值 opnd;
};

声明 parse_insn_line(line){
    创建 ArrayList:parts;
    设 t = trim(line);
    设 len = t.长度();
    如果(len == 0){ 返回值 parts; };

    设 sp = find_char(t, " ", 0);
    设 tab = find_char(t, "\t", 0);
    设 sep = sp;
    如果(tab >= 0){
        如果(sep < 0 || tab < sep){ sep = tab; };
    };

    如果(sep < 0){

        parts.添加(t);
        返回值 parts;
    };

    设 mnemonic = trim(t.子字符串(0, sep));
    parts.添加(mnemonic);

    设 rest = trim(t.子字符串(sep + 1, len));

    如果(mnemonic == "lock"){
        设 sp2 = find_char(rest, " ", 0);
        设 tab2 = find_char(rest, "\t", 0);
        设 sep2 = sp2;
        如果(tab2 >= 0){
            如果(sep2 < 0 || tab2 < sep2){ sep2 = tab2; };
        };
        如果(sep2 > 0){
            mnemonic = "lock " + trim(rest.子字符串(0, sep2));
            rest = trim(rest.子字符串(sep2 + 1, rest.长度()));
            parts.设置(0, mnemonic);
        };
    };

    设 idx = 0;
    设 rlen = rest.长度();
    循环(idx < rlen){
        设 comma = find_char(rest, ",", idx);
        如果(comma < 0){
            parts.添加(trim(rest.子字符串(idx, rlen)));
            跳出;
        }否则{
            parts.添加(trim(rest.子字符串(idx, comma)));
            idx = comma + 1;
        };
    };

    返回值 parts;
};

声明 insn_length(){
    设 mnemonic = g_enc_parts.获取(0);
    设 nops = g_enc_parts.长度() - 1;

    如果(mnemonic == "ret"){ 返回值 1; };
    如果(mnemonic == "hlt"){ 返回值 1; };

    如果(mnemonic == "push" || mnemonic == "pop"){
        创建 Operand:op_pp;
        op_pp = parse_operand(g_enc_parts.获取(1));
        如果(op_pp.reg >= 100){ 返回值 2; };
        如果(op_pp.reg >= 8){ 返回值 2; };
        返回值 1;
    };

    如果(mnemonic == "call" || mnemonic == "jmp"){
        创建 Operand:cop;
        cop = parse_operand(g_enc_parts.获取(1));
        如果(cop.type == OPND_REG){ 返回值 2; };

        如果(cop.type == OPND_MEM){
            设 base = reg_num(cop.reg);
            设 len_ = 2;
            如果(base >= 8){ len_ = len_ + 1; };
            如果(base == 4 || cop.index >= 0){ len_ = len_ + 1; };
            如果(cop.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(cop.imm >= -128 && cop.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 5;
    };

    如果(mnemonic == "jz" || mnemonic == "je"){
        返回值 6;
    };

    如果(mnemonic == "jnz"){
        返回值 6;
    };

    如果(mnemonic == "jne" || mnemonic == "jl" || mnemonic == "jge" ||
       mnemonic == "jle" || mnemonic == "jg" || mnemonic == "jc" ||
       mnemonic == "jb" || mnemonic == "jnc" || mnemonic == "jae" ||
       mnemonic == "jbe" || mnemonic == "ja" || mnemonic == "js" ||
       mnemonic == "jns"){
        返回值 6;
    };

    如果(mnemonic == "inc" || mnemonic == "dec"){
        设 iop2s = trim(g_enc_parts.获取(1));
        设 iop2r = reg_lookup(iop2s);
        如果(iop2r >= 0){
            设 d = reg_num(iop2r);
            设 need_rex = 0;
            如果(iop2r < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };
        创建 Operand:iopm;
        iopm = parse_operand(iop2s);
        如果(iopm.type == OPND_MEM){

            设 base = reg_num(iopm.reg);
            设 len_ = 3;
            如果(iopm.size == 4){ len_ = 2; };
            如果(base == 4){ len_ = len_ + 1; };
            如果(iopm.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(iopm.imm >= -128 && iopm.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 3;
    };

    如果(mnemonic == "xchg"){
        创建 Operand:xop1;
        xop1 = parse_operand(g_enc_parts.获取(1));
        创建 Operand:xop2;
        xop2 = parse_operand(g_enc_parts.获取(2));

        设 xmem = xop1;
        设 xreg = xop2;
        如果(xop1.type == OPND_REG){ xmem = xop2; xreg = xop1; };
        如果(xreg.type != OPND_REG){ 返回值 0; };
        如果(xmem.type == OPND_RIPMEM){
            设 rd = reg_num(xreg.reg);
            设 need_rex = 0;
            如果(xreg.reg < 100){ need_rex = 1; };
            如果(rd >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 7; };
            返回值 6;
        };
        如果(xmem.type == OPND_MEM){
            设 base = reg_num(xmem.reg);
            设 len_ = 2;
            如果(xreg.reg < 100){ len_ = len_ + 1; };
            如果(reg_num(xreg.reg) >= 8 || base >= 8 || xmem.index >= 8){ len_ = len_ + 1; };
            如果(base == 4 || xmem.index >= 0){ len_ = len_ + 1; };
            如果(xmem.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(xmem.imm >= -128 && xmem.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        如果(xmem.type == OPND_REG){
            设 d1 = reg_num(xmem.reg);
            设 d2 = reg_num(xreg.reg);
            设 need_rex = 0;
            如果(xmem.reg < 100 || xreg.reg < 100){ need_rex = 1; };
            如果(d1 >= 8 || d2 >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };
        返回值 0;
    };

    如果(starts_with(mnemonic, "lock ")){
        设 inner_m2 = mnemonic.子字符串(5, mnemonic.长度());
        如果(inner_m2 == "cmpxchg"){

            创建 Operand:cxl;
            cxl = parse_operand(g_enc_parts.获取(1));
            创建 Operand:cxr;
            cxr = parse_operand(g_enc_parts.获取(2));
            如果(cxl.type == OPND_RIPMEM){
                如果(reg_num(cxr.reg) >= 8){ 返回值 10; };
                返回值 9;
            };
            如果(cxl.type == OPND_MEM){
                设 base = reg_num(cxl.reg);
                设 len_ = 5;
                如果(base == 4 || cxl.index >= 0){ len_ = len_ + 1; };
                如果(cxl.imm == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(cxl.imm >= -128 && cxl.imm <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
            返回值 9;
        };
        如果(inner_m2 == "inc" || inner_m2 == "dec"){

            创建 Operand:lxd;
            lxd = parse_operand(g_enc_parts.获取(1));
            如果(lxd.type == OPND_RIPMEM){ 返回值 8; };
            如果(lxd.type == OPND_MEM){
                设 base = reg_num(lxd.reg);
                设 len_ = 4;
                如果(base == 4 || lxd.index >= 0){ len_ = len_ + 1; };
                如果(lxd.imm == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(lxd.imm >= -128 && lxd.imm <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
            返回值 8;
        };
        返回值 0;
    };

    如果(mnemonic == "cqo"){
        返回值 2;
    };

    如果(mnemonic == "cpuid" || mnemonic == "rdtsc"){
        返回值 2;
    };

    如果(mnemonic == "movsd"){

        如果(nops >= 2){
            创建 Operand:msp1;
            msp1 = parse_operand(g_enc_parts.获取(1));
            如果(msp1.type == OPND_MEM){

                设 base = reg_num(msp1.reg);
                设 len_ = 4;
                如果(base >= 8){ len_ = len_ + 1; };
                如果(base == 4 || msp1.index >= 0){ len_ = len_ + 1; };
                如果(msp1.imm == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(msp1.imm >= -128 && msp1.imm <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
            创建 Operand:msp2;
            msp2 = parse_operand(g_enc_parts.获取(2));
            如果(msp2.type == OPND_MEM){
                设 base = reg_num(msp2.reg);
                设 disp = msp2.imm;
                设 len_ = 4;
                如果(base >= 8){ len_ = len_ + 1; };
                如果(base == 4 || msp2.index >= 0){ len_ = len_ + 1; };
                如果(disp == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(disp >= -128 && disp <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
        };

        设 xd1 = parse_xmm(g_enc_parts.获取(1));
        设 xs1 = parse_xmm(g_enc_parts.获取(2));
        如果(xd1 >= 0 && xs1 >= 0){ 返回值 4; };
        返回值 8;
    };

    如果(mnemonic == "movups"){
        如果(nops >= 2){
            创建 Operand:usp1;
            usp1 = parse_operand(g_enc_parts.获取(1));
            如果(usp1.type == OPND_MEM){

                设 uxs = parse_xmm(g_enc_parts.获取(2));
                如果(uxs < 0){ uxs = 0; };
                设 base = reg_num(usp1.reg);
                设 len_ = 3;
                如果(uxs >= 8){ len_ = len_ + 1; };
                如果(base >= 8){ len_ = len_ + 1; };
                如果(base == 4 || usp1.index >= 0){ len_ = len_ + 1; };
                如果(usp1.imm == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(usp1.imm >= -128 && usp1.imm <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
            创建 Operand:usp2;
            usp2 = parse_operand(g_enc_parts.获取(2));
            如果(usp2.type == OPND_MEM){

                设 uxd = parse_xmm(g_enc_parts.获取(1));
                如果(uxd < 0){ uxd = 0; };
                设 base = reg_num(usp2.reg);
                设 len_ = 3;
                如果(uxd >= 8){ len_ = len_ + 1; };
                如果(base >= 8){ len_ = len_ + 1; };
                如果(base == 4 || usp2.index >= 0){ len_ = len_ + 1; };
                如果(usp2.imm == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(usp2.imm >= -128 && usp2.imm <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_;
            };
        };

        设 uxd1 = parse_xmm(g_enc_parts.获取(1));
        设 uxs1 = parse_xmm(g_enc_parts.获取(2));
        如果(uxd1 >= 0 && uxs1 >= 0){
            设 len_ = 3;
            如果(uxd1 >= 8 || uxs1 >= 8){ len_ = len_ + 1; };
            返回值 len_;
        };
        返回值 7;
    };

    如果(mnemonic == "stmxcsr" || mnemonic == "ldmxcsr"){
        创建 Operand:mxc;
        mxc = parse_operand(g_enc_parts.获取(1));
        如果(mxc.type == OPND_MEM){
            设 base = reg_num(mxc.reg);
            设 len_ = 3;
            如果(base >= 8){ len_ = len_ + 1; };
            如果(base == 4 || mxc.index >= 0){ len_ = len_ + 1; };
            如果(mxc.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(mxc.imm >= -128 && mxc.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 7;
    };

    如果(mnemonic == "movq"){
        如果(nops >= 2){
            创建 Operand:qop1;
            qop1 = parse_operand(g_enc_parts.获取(1));
            如果(qop1.type == OPND_RIPMEM){
                返回值 9;
            };
            创建 Operand:qmem;
            qmem = qop1;
            如果(qop1.type != OPND_MEM){
            创建 Operand:qop2;
            qop2 = parse_operand(g_enc_parts.获取(2));
            如果(qop2.type == OPND_MEM){ qmem = qop2; }
            又如果(qop2.type == OPND_RIPMEM){
                返回值 9;
            }
            否则{

                设 xa1 = parse_xmm(g_enc_parts.获取(1));
                设 xa2 = parse_xmm(g_enc_parts.获取(2));
                如果(xa1 >= 0 && xa2 >= 0){
                    如果(xa1 >= 8 || xa2 >= 8){ 返回值 5; };
                    返回值 4;
                };
                返回值 5;
            };
            };
            设 base = reg_num(qmem.reg);
            设 len_ = 5;
            如果(base >= 8){ len_ = len_ + 1; };
            如果(base == 4 || qmem.index >= 0){ len_ = len_ + 1; };
            如果(qmem.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(qmem.imm >= -128 && qmem.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 5;
    };

    如果(mnemonic == "addsd" || mnemonic == "subsd" ||
       mnemonic == "mulsd" || mnemonic == "divsd"){
        创建 Operand:fso2;
        fso2 = parse_operand(g_enc_parts.获取(2));
        如果(fso2.type == OPND_RIPMEM){ 返回值 8; };
        如果(fso2.type == OPND_MEM){
            设 base = reg_num(fso2.reg);
            设 len_ = 4;
            如果(base >= 8){ len_ = len_ + 1; };
            如果(base == 4 || fso2.index >= 0){ len_ = len_ + 1; };
            如果(fso2.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(fso2.imm >= -128 && fso2.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 4;
    };

    如果(mnemonic == "comisd"){
        返回值 4;
    };

    如果(mnemonic == "xorpd"){
        返回值 4;
    };

    如果(mnemonic == "cvtsi2sd" || mnemonic == "cvttsd2si"){
        返回值 5;
    };

    如果(mnemonic == "not" || mnemonic == "neg" || mnemonic == "idiv" || mnemonic == "div"){
        返回值 3;
    };

    如果(mnemonic == "imul" && nops == 1){
        返回值 3;
    };

    如果(mnemonic == "sete" || mnemonic == "setne" || mnemonic == "setl" ||
       mnemonic == "setge" || mnemonic == "setle" || mnemonic == "setg"){
        返回值 3;
    };

    如果(mnemonic == "shl" || mnemonic == "shr"){
        设 shl_s = trim(g_enc_parts.获取(1));
        创建 Operand:shm;
        shm = parse_operand(shl_s);
        如果(shm.type == OPND_MEM){

            设 base = reg_num(shm.reg);
            设 len_ = 2;
            如果(shm.size == 8 || shm.size == 0){
                len_ = len_ + 1;
            }又如果(base >= 8 || shm.index >= 8){
                len_ = len_ + 1;
            };
            如果(base == 4 || shm.index >= 0){ len_ = len_ + 1; };
            如果(shm.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(shm.imm >= -128 && shm.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_ + 1;
        };
        设 shl_r = reg_lookup(shl_s);
        设 shn = reg_num(shl_r);
        设 need_rex = 0;
        如果(shl_r < 100){ need_rex = 1; };
        如果(shn >= 8){ need_rex = 1; };
        如果(nops >= 2){
            设 shs2s = trim(g_enc_parts.获取(2));
            如果(is_int_str(shs2s)){
                如果(need_rex){ 返回值 4; };
                返回值 3;
            };
        };
        如果(need_rex){ 返回值 3; };
        返回值 2;
    };

    如果(nops < 2){
        错误打印("汇编器: 未知指令 [" + mnemonic + "] 长度 0——产物语义可能错误");
        返回值 0;
    };

    创建 Operand:dst;
    dst = parse_operand(g_enc_parts.获取(1));
    创建 Operand:src;
    src = parse_operand(g_enc_parts.获取(2));

    如果(mnemonic == "mov"){

        如果(dst.type == OPND_RIPMEM && src.type == OPND_IMM){
            如果(dst.size == 1){ 返回值 7; };
            如果(dst.size == 4){ 返回值 10; };
            返回值 11;
        };

        如果(dst.type == OPND_RIPMEM && src.type == OPND_REG){
            设 s3 = reg_num(src.reg);
            设 need_rex3 = 0;
            如果(src.reg < 100){ need_rex3 = 1; };
            如果(s3 >= 8){ need_rex3 = 1; };
            如果(need_rex3){ 返回值 7; };
            返回值 6;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 disp = dst.imm;
            如果(dst.size == 1){

                设 len_ = 2;
                如果(base >= 8 || dst.index >= 8){ len_ = len_ + 1; };
                如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
                如果(disp == 0 && base != 5){
                    如果(base == 5){ len_ = len_ + 1; };
                }又如果(disp >= -128 && disp <= 127){
                    len_ = len_ + 1;
                }否则{
                    len_ = len_ + 4;
                };
                返回值 len_ + 1;
            };

            设 len_ = 2;
            如果(dst.size != 4){ len_ = len_ + 1; };
            又如果(base >= 8 || dst.index >= 8){ len_ = len_ + 1; };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(disp == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(disp >= -128 && disp <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_ + 4;
        };

        如果(src.type == OPND_IMM){
            设 r = reg_num(dst.reg);
            设 v = src.imm;

            如果(dst.reg >= 200 && dst.reg < 300){
                如果(r >= 8){ 返回值 3; };
                返回值 2;
            };

            设 imm_txt = trim(g_enc_parts.获取(2));
            设 is_hex = 0;
            如果(imm_txt.以开始("0x") || imm_txt.以开始("0X")){ is_hex = 1; };
            如果(is_hex && v < 0){ 返回值 10; };

            如果(v >= 0 && v <= 4294967295){
                如果(r >= 8){ 返回值 6; };
                返回值 5;
            };

            如果(v < 0){
                如果(dst.reg >= 100 && dst.reg < 200){
                    如果(r >= 8){ 返回值 6; };
                    返回值 5;
                };
                返回值 7;
            };

            返回值 10;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d2 = reg_num(dst.reg);
            设 s2 = reg_num(src.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d2 >= 8){ need_rex = 1; };
            如果(s2 >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };

        如果(dst.type == OPND_MEM || src.type == OPND_MEM){
            设 base_reg = dst.reg;
            如果(src.type == OPND_MEM){ base_reg = src.reg; };
            设 base = reg_num(base_reg);
            设 disp = dst.imm;
            如果(src.type == OPND_MEM){ disp = src.imm; };
            设 len_ = 2;

            设 w_op = dst.reg;
            如果(src.type == OPND_REG){ w_op = src.reg; };

            如果(w_op >= 300 && w_op < 400){ len_ = len_ + 1; };
            设 need_rex = 0;
            如果(w_op < 100){ need_rex = 1; };
            设 w_opn = reg_num(w_op);
            如果(w_opn >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(dst.index >= 8 || src.index >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };

            如果(base == 4){ len_ = len_ + 1; };
            如果(src.type == OPND_MEM && src.index >= 0){ len_ = len_ + 1; };
            如果(dst.type == OPND_MEM && dst.index >= 0){ len_ = len_ + 1; };

            如果(disp == 0 && base != 5){

                如果(base == 5){ len_ = len_ + 1; };
            }又如果(disp >= -128 && disp <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_RIPMEM || src.type == OPND_RIPMEM){
            设 w_op2 = dst.reg;
            如果(src.type == OPND_REG){ w_op2 = src.reg; };
            设 need_rex2 = 0;
            如果(w_op2 < 100){ need_rex2 = 1; };
            设 d3 = reg_num(w_op2);
            如果(d3 >= 8){ need_rex2 = 1; };
            如果(need_rex2){ 返回值 7; };
            返回值 6;
        };
        返回值 7;
    };

    如果(mnemonic == "movsxd"){

        如果(dst.type == OPND_REG && src.type == OPND_RIPMEM){ 返回值 7; };
        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 len_ = 3;
            如果(base == 4){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        如果(dst.type == OPND_REG && src.type == OPND_REG){ 返回值 3; };
        返回值 7;
    };

    如果(mnemonic == "lea"){

        如果(src.type == OPND_RIPMEM){ 返回值 7; };

        如果(src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 len_ = 3;
            如果(base == 4){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };
        返回值 7;
    };

    如果(mnemonic == "add" || mnemonic == "sub"){

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d = reg_num(dst.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(dst.reg >= 200 && dst.reg < 300){ 如果(d >= 8){ 返回值 4; }; 返回值 3; };
            如果(src.imm >= -128 && src.imm <= 127){
                如果(need_rex){ 返回值 4; };
                返回值 3;
            }否则{
                如果(need_rex){ 返回值 7; };
                返回值 6;
            };
        };

        如果(dst.type == OPND_RIPMEM && src.type == OPND_IMM){
            如果(src.imm >= -128 && src.imm <= 127){ 返回值 8; };
            返回值 11;
        };

        如果(dst.type == OPND_RIPMEM && src.type == OPND_REG){
            返回值 7;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            如果(dst.size == 1){

                如果(base >= 8 || dst.index >= 8){ len_ = len_ + 1; };
            }又如果(dst.size == 4){

                如果(base >= 8 || dst.index >= 8){ len_ = len_ + 1; };
            }否则{

                len_ = len_ + 1;
            };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            如果(dst.size == 1){ 返回值 len_ + 1; };
            如果(src.imm >= -128 && src.imm <= 127){
                返回值 len_ + 1;
            };
            返回值 len_ + 4;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_REG){
            设 s = reg_num(src.reg);
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            设 need_rex = 0;
            如果(src.reg < 100){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 d = reg_num(dst.reg);
            设 base = reg_num(src.reg);
            设 len_ = 2;
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || src.index >= 0){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_RIPMEM){
            返回值 7;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };
        返回值 3;
    };

    如果(mnemonic == "xor"){

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 d = reg_num(dst.reg);
            设 base = reg_num(src.reg);
            设 len_ = 2;
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || src.index >= 0){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d4 = reg_num(dst.reg);
            设 need_rex4 = 0;
            如果(dst.reg < 100){ need_rex4 = 1; };
            如果(d4 >= 8){ need_rex4 = 1; };

            如果(dst.reg >= 200 && dst.reg < 300){ 如果(d4 >= 8){ 返回值 4; }; 返回值 3; };
            如果(src.imm >= -128 && src.imm <= 127){
                如果(need_rex4){ 返回值 4; };
                返回值 3;
            }否则{
                如果(need_rex4){ 返回值 7; };
                返回值 6;
            };
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            如果(dst.size == 1){
                如果(base >= 8){ len_ = len_ + 1; };
            }又如果(dst.size == 4){
                如果(base >= 8){ len_ = len_ + 1; };
            }否则{
                len_ = len_ + 1;
            };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            如果(dst.size == 1){ 返回值 len_ + 1; };
            如果(src.imm >= -128 && src.imm <= 127){
                返回值 len_ + 1;
            };
            返回值 len_ + 4;
        };
        返回值 3;
    };

    如果(mnemonic == "test"){

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 is64t = is_reg64(dst.reg);
            如果(is64t){ 返回值 3; };
            设 d8 = reg_num(dst.reg);
            如果(dst.reg >= 200 && dst.reg < 300 && d8 >= 8){ 返回值 3; };
            如果(dst.reg >= 100 && d8 >= 8){ 返回值 3; };
            返回值 2;
        };

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d = reg_num(dst.reg);
            如果(dst.reg >= 200 && dst.reg < 300){
                如果(d >= 8){ 返回值 4; };
                返回值 3;
            };
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 7; };
            返回值 6;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            如果(dst.size == 1){
                如果(base >= 8){ len_ = len_ + 1; };
            }又如果(dst.size == 4){
                如果(base >= 8){ len_ = len_ + 1; };
            }否则{
                len_ = len_ + 1;
            };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            如果(dst.size == 1){ 返回值 len_ + 1; };
            返回值 len_ + 4;
        };
        返回值 3;
    };

    如果(mnemonic == "cmp"){

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d = reg_num(dst.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(dst.reg >= 200 && dst.reg < 300){ 如果(d >= 8){ 返回值 4; }; 返回值 3; };
            如果(src.imm >= -128 && src.imm <= 127){
                如果(need_rex){ 返回值 4; };
                返回值 3;
            }否则{
                如果(need_rex){ 返回值 7; };
                返回值 6;
            };
        };

        如果(dst.type == OPND_RIPMEM && src.type == OPND_IMM){
            如果(src.imm >= -128 && src.imm <= 127){ 返回值 8; };
            返回值 11;
        };

        如果(dst.type == OPND_REG && src.type == OPND_RIPMEM){
            返回值 7;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            如果(dst.size == 1){

                如果(base >= 8){ len_ = len_ + 1; };
            }又如果(dst.size == 4){

                如果(base >= 8){ len_ = len_ + 1; };
            }否则{

                len_ = len_ + 1;
            };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            如果(dst.size == 1){
                返回值 len_ + 1;
            };
            如果(src.imm >= -128 && src.imm <= 127){
                返回值 len_ + 1;
            };
            返回值 len_ + 4;
        };

        如果(src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 len_ = 2;
            设 need_rex = 0;
            设 d4 = reg_num(dst.reg);
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d4 >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_REG){
            设 s = reg_num(src.reg);
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            设 need_rex = 0;
            如果(src.reg < 100){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };
        返回值 3;
    };

    如果(mnemonic == "and" || mnemonic == "or"){

        如果(dst.type == OPND_REG && src.type == OPND_IMM){
            设 d = reg_num(dst.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(dst.reg >= 200 && dst.reg < 300){ 如果(d >= 8){ 返回值 4; }; 返回值 3; };
            如果(src.imm >= -128 && src.imm <= 127){
                如果(need_rex){ 返回值 4; };
                返回值 3;
            }否则{
                如果(need_rex){ 返回值 7; };
                返回值 6;
            };
        };

        如果(dst.type == OPND_MEM && src.type == OPND_IMM){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            如果(dst.size == 1){
                如果(base >= 8){ len_ = len_ + 1; };
            }又如果(dst.size == 4){
                如果(base >= 8){ len_ = len_ + 1; };
            }否则{
                len_ = len_ + 1;
            };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            如果(dst.size == 1){ 返回值 len_ + 1; };
            如果(src.imm >= -128 && src.imm <= 127){
                返回值 len_ + 1;
            };
            返回值 len_ + 4;
        };

        如果(dst.type == OPND_MEM && src.type == OPND_REG){
            设 base = reg_num(dst.reg);
            设 len_ = 2;
            设 s_opn = reg_num(src.reg);
            设 need_rex = 0;
            如果(src.reg < 100){ need_rex = 1; };
            如果(s_opn >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || dst.index >= 0){ len_ = len_ + 1; };
            如果(dst.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(dst.imm >= -128 && dst.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 len_ = 2;
            设 w_opn = reg_num(dst.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(w_opn >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || src.index >= 0){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(d >= 8){ need_rex = 1; };
            如果(s >= 8){ need_rex = 1; };
            如果(need_rex){ 返回值 3; };
            返回值 2;
        };
        返回值 3;
    };

    如果(mnemonic == "movzx" || mnemonic == "imul"){

        如果(mnemonic == "imul" && dst.type == OPND_REG && src.type == OPND_IMM){
            如果(src.imm >= -128 && src.imm <= 127){ 返回值 4; };
            返回值 7;
        };

        如果(mnemonic == "imul" && dst.type == OPND_REG && src.type == OPND_REG && nops >= 3){
            设 iml_s = trim(g_enc_parts.获取(3));
            设 iml_base = 3;
            如果(dst.reg < 100){ iml_base = iml_base + 1; };
            又如果(reg_num(dst.reg) >= 8 || reg_num(src.reg) >= 8){ iml_base = iml_base + 1; };
            如果(is_int_str(iml_s)){
                设 iml_v = parse_int(iml_s);
                如果(iml_v >= -128 && iml_v <= 127){ 返回值 iml_base; };
            };
            返回值 iml_base + 3;
        };

        如果(mnemonic == "imul" && dst.type == OPND_REG && src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 len_ = 4;
            如果(base == 4 || src.index >= 0){ len_ = len_ + 1; };
            如果(src.imm == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(src.imm >= -128 && src.imm <= 127){                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(mnemonic == "imul" && dst.type == OPND_REG && src.type == OPND_REG && nops == 2){
            返回值 4;
        };

        如果(mnemonic == "movzx" && src.type == OPND_MEM){
            设 base = reg_num(src.reg);
            设 disp = src.imm;
            设 len_ = 3;

            设 w_opn = reg_num(dst.reg);
            设 need_rex = 0;
            如果(dst.reg < 100){ need_rex = 1; };
            如果(w_opn >= 8){ need_rex = 1; };
            如果(base >= 8){ need_rex = 1; };
            如果(need_rex){ len_ = len_ + 1; };
            如果(base == 4 || src.index >= 0){ len_ = len_ + 1; };
            如果(disp == 0 && base != 5){
                如果(base == 5){ len_ = len_ + 1; };
            }又如果(disp >= -128 && disp <= 127){
                len_ = len_ + 1;
            }否则{
                len_ = len_ + 4;
            };
            返回值 len_;
        };

        如果(mnemonic == "movzx" && dst.type == OPND_REG && src.type == OPND_REG){
            设 d = reg_num(dst.reg);
            设 s = reg_num(src.reg);
            如果(dst.reg >= 100 && d < 8 && s < 8){ 返回值 3; };
            返回值 4;
        };
        返回值 4;
    };

    如果(mnemonic == "sar"){

        如果(src.type == OPND_IMM){ 返回值 4; };
        返回值 3;
    };

    错误打印("汇编器: 未知指令 [" + mnemonic + "] 长度 0——产物语义可能错误");
    返回值 0;
};

声明 emit_modrm(reg_field, base_reg, disp){
    设 base = reg_num(base_reg);
    设 need_sib = 0;
    如果(base == 4){ need_sib = 1; };

    设 mod = 0;
    设 disp_size = 0;
    如果(disp == 0 && base != 5){
        mod = 0;
        disp_size = 0;
    }又如果(disp == 0 && base == 5){
        mod = 1;
        disp_size = 1;
    }又如果(disp >= -128 && disp <= 127){
        mod = 1;
        disp_size = 1;
    }否则{
        mod = 2;
        disp_size = 4;
    };

    设 modrm = mod * 64 + reg_field * 8 + (base & 7);
    g_enc_out_bytes.添加(modrm);

    如果(need_sib){
        g_enc_out_bytes.添加(0x24);
    };

    如果(disp_size == 1){
        设 d = disp;
        如果(d < 0){ d = d + 256; };
        g_enc_out_bytes.添加(d);
    }又如果(disp_size == 4){
        设 d = disp;
        如果(d < 0){ d = d + 4294967296; };
        g_enc_out_bytes.添加(d & 255);
        g_enc_out_bytes.添加((d / 256) & 255);
        g_enc_out_bytes.添加((d / 65536) & 255);
        g_enc_out_bytes.添加((d / 16777216) & 255);
    };

    返回值 0;
};

声明 emit_modrm_sib(reg_field, base_reg, index_reg, scale, disp){
    设 base = reg_num(base_reg);
    设 idx = reg_num(index_reg);

    设 mod = 0;
    设 disp_size = 0;
    如果(disp == 0 && base != 5){
        mod = 0;
        disp_size = 0;
    }又如果(disp == 0 && base == 5){
        mod = 1;
        disp_size = 1;
    }又如果(disp >= -128 && disp <= 127){
        mod = 1;
        disp_size = 1;
    }否则{
        mod = 2;
        disp_size = 4;
    };

    设 modrm = mod * 64 + reg_field * 8 + 4;
    g_enc_out_bytes.添加(modrm);

    设 scale_code = 0;
    如果(scale == 2){ scale_code = 1; };
    如果(scale == 4){ scale_code = 2; };
    如果(scale == 8){ scale_code = 3; };
    设 sib = scale_code * 64 + (idx & 7) * 8 + (base & 7);
    g_enc_out_bytes.添加(sib);

    如果(disp_size == 1){
        设 d = disp;
        如果(d < 0){ d = d + 256; };
        g_enc_out_bytes.添加(d);
    }又如果(disp_size == 4){
        设 d = disp;
        如果(d < 0){ d = d + 4294967296; };
        g_enc_out_bytes.添加(d & 255);
        g_enc_out_bytes.添加((d / 256) & 255);
        g_enc_out_bytes.添加((d / 65536) & 255);
        g_enc_out_bytes.添加((d / 16777216) & 255);
    };

    返回值 0;
};

声明 add_reloc(section, offset, sym_name, rtype){
    创建 AsmReloc:relx;
    relx.section = section;
    relx.offset = offset;
    relx.sym_name = sym_name;
    relx.type = rtype;
    g_enc_relocs.添加(relx);
    返回值 0;
};

声明 emit_modrm_rip(reg_field){

    设 modrm = 0 * 64 + reg_field * 8 + 5;
    g_enc_out_bytes.添加(modrm);

    g_enc_out_bytes.添加(0);
    g_enc_out_bytes.添加(0);
    g_enc_out_bytes.添加(0);
    g_enc_out_bytes.添加(0);
    返回值 0;
};

声明 make_rex(w, r, x, b){
    设 rex = 0x40;
    如果(w){ rex = rex + 8; };
    如果(r){ rex = rex + 4; };
    如果(x){ rex = rex + 2; };
    如果(b){ rex = rex + 1; };
    返回值 rex;
};

声明 encode_insn(section, offset){
    创建 ArrayList:bytes;
    g_enc_out_bytes = bytes;
    设 mnemonic = g_enc_parts.获取(0);
    设 nops = g_enc_parts.长度() - 1;

    如果(mnemonic == "ret"){
        bytes.添加(0xC3);
        返回值 bytes;
    };
    如果(mnemonic == "hlt"){
        bytes.添加(0xF4);
        返回值 bytes;
    };

    如果(mnemonic == "push" || mnemonic == "pop"){
        创建 Operand:op_pp2;
        op_pp2 = parse_operand(g_enc_parts.获取(1));
        设 r = reg_num(op_pp2.reg);
        设 base = 0x50;
        如果(mnemonic == "pop"){ base = 0x58; };
        如果(r >= 8){
            bytes.添加(0x41);
            bytes.添加(base + (r & 7));
        }否则{
            bytes.添加(base + r);
        };
        返回值 bytes;
    };

    如果(mnemonic == "call"){
        创建 Operand:op_call;
        op_call = parse_operand(g_enc_parts.获取(1));
        如果(op_call.type == OPND_REG){
            bytes.添加(0xFF);
            bytes.添加(0xD0 + op_call.reg);
            返回值 bytes;
        };
        如果(op_call.type == OPND_MEM){

            设 base = reg_num(op_call.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            如果(b_bit){ bytes.添加(0x41); };
            bytes.添加(0xFF);
            如果(op_call.index >= 0){
                emit_modrm_sib(2, base, op_call.index, op_call.scale, op_call.imm);
            }否则{
                emit_modrm(2, base, op_call.imm);
            };
            返回值 bytes;
        };
        bytes.添加(0xE8);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        add_reloc(section, offset + 1, op_call.label, RELOC_REL32);
        返回值 bytes;
    };

    如果(mnemonic == "jmp"){
        创建 Operand:op_jmp;
        op_jmp = parse_operand(g_enc_parts.获取(1));
        如果(op_jmp.type == OPND_REG){
            bytes.添加(0xFF);
            bytes.添加(0xE0 + op_jmp.reg);
            返回值 bytes;
        };
        如果(op_jmp.type == OPND_MEM){

            设 base = reg_num(op_jmp.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            如果(b_bit){ bytes.添加(0x41); };
            bytes.添加(0xFF);
            如果(op_jmp.index >= 0){
                emit_modrm_sib(4, base, op_jmp.index, op_jmp.scale, op_jmp.imm);
            }否则{
                emit_modrm(4, base, op_jmp.imm);
            };
            返回值 bytes;
        };
        bytes.添加(0xE9);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        add_reloc(section, offset + 1, op_jmp.label, RELOC_REL32);
        返回值 bytes;
    };

    如果(mnemonic == "jz" || mnemonic == "je"){
        bytes.添加(0x0F);
        bytes.添加(0x84);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        创建 Operand:op_jz;
        op_jz = parse_operand(g_enc_parts.获取(1));
        add_reloc(section, offset + 2, op_jz.label, RELOC_REL32);
        返回值 bytes;
    };
    如果(mnemonic == "jnz"){
        bytes.添加(0x0F);
        bytes.添加(0x85);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        创建 Operand:op_jnz;
        op_jnz = parse_operand(g_enc_parts.获取(1));
        add_reloc(section, offset + 2, op_jnz.label, RELOC_REL32);
        返回值 bytes;
    };

    如果(mnemonic == "jne"){
        bytes.添加(0x0F);
        bytes.添加(0x85);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        创建 Operand:op_jne;
        op_jne = parse_operand(g_enc_parts.获取(1));
        add_reloc(section, offset + 2, op_jne.label, RELOC_REL32);
        返回值 bytes;
    };
    如果(mnemonic == "jl"){
        bytes.添加(0x0F);
        bytes.添加(0x8C);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        创建 Operand:op_jl;
        op_jl = parse_operand(g_enc_parts.获取(1));
        add_reloc(section, offset + 2, op_jl.label, RELOC_REL32);
        返回值 bytes;
    };
    如果(mnemonic == "jge"){
        bytes.添加(0x0F);
        bytes.添加(0x8D);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
        创建 Operand:op_jge;
        op_jge = parse_operand(g_enc_parts.获取(1));
        add_reloc(section, offset + 2, op_jge.label, RELOC_REL32);
        返回值 bytes;
    };
    如果(mnemonic == "jle"){
        bytes.添加(0x0F);
        bytes.添加(0x8E);
        bytes.添加(0); bytes.添加(0); bytes.添加(0); bytes.添加(0);
