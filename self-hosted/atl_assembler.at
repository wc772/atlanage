                如果(rb){ bytes.添加(make_rex(0, 0, 0, 1)); };
                bytes.添加(0xB0 + (r & 7));
                bytes.添加(v & 255);
                返回值 bytes;
            };

            设 imm_txt = trim(g_enc_parts.获取(2));
            设 is_hex = 0;
            如果(imm_txt.以开始("0x") || imm_txt.以开始("0X")){ is_hex = 1; };
            如果(is_hex && v < 0){
                设 b = 0;
                如果(r >= 8){ b = 1; };
                bytes.添加(make_rex(1, 0, 0, b));
                bytes.添加(0xB8 + (r & 7));
                bytes.添加(v & 255);
                bytes.添加((v / 256) & 255);
                bytes.添加((v / 65536) & 255);
                bytes.添加((v / 16777216) & 255);
