            如果(as.imm >= -128 && as.imm <= 127){
                bytes.添加(0x83);
                bytes.添加(0xC0 + adigit * 8 + (adn2 & 7));
                设 av2 = as.imm;
                如果(av2 < 0){ av2 = av2 + 256; };
                bytes.添加(av2 & 255);
            }否则{
                bytes.添加(0x81);
                bytes.添加(0xC0 + adigit * 8 + (adn2 & 7));
                设 av2 = as.imm;
                如果(av2 < 0){ av2 = av2 + 4294967296; };
                bytes.添加(av2 & 255);
                bytes.添加((av2 / 256) & 255);
                bytes.添加((av2 / 65536) & 255);
                bytes.添加((av2 / 16777216) & 255);
            };
            返回值 bytes;
        };
    };

    如果(mnemonic == "not"){
        创建 Operand:nn;
        nn = parse_operand(g_enc_parts.获取(1));
        设 nn_ = reg_num(nn.reg);
        设 nb = 0;
        如果(nn_ >= 8){ nb = 1; };
        bytes.添加(make_rex(1, 0, 0, nb));
        bytes.添加(0xF7);
        bytes.添加(0xD0 + (nn_ & 7));
        返回值 bytes;
    };

    如果(mnemonic == "neg"){
        创建 Operand:nn2;
        nn2 = parse_operand(g_enc_parts.获取(1));
        设 nn2_ = reg_num(nn2.reg);
        设 nb2 = 0;
        如果(nn2_ >= 8){ nb2 = 1; };
        bytes.添加(make_rex(1, 0, 0, nb2));
        bytes.添加(0xF7);
        bytes.添加(0xD8 + (nn2_ & 7));
        返回值 bytes;
    };

    如果(mnemonic == "imul" && nops == 1){
        创建 Operand:im1;
        im1 = parse_operand(g_enc_parts.获取(1));
        如果(im1.type == OPND_REG){
            设 d1 = reg_num(im1.reg);
            设 b1 = 0;
            如果(d1 >= 8){ b1 = 1; };
            bytes.添加(make_rex(1, 0, 0, b1));
            bytes.添加(0xF7);
            bytes.添加(0xE8 + (d1 & 7));
            返回值 bytes;
        };
        返回值 bytes;
    };

    如果(mnemonic == "sete" || mnemonic == "setne" || mnemonic == "setl" ||
       mnemonic == "setge" || mnemonic == "setle" || mnemonic == "setg"){
        设 opc = 0x94;
        如果(mnemonic == "setne"){ opc = 0x95; };
        如果(mnemonic == "setl"){ opc = 0x9C; };
        如果(mnemonic == "setge"){ opc = 0x9D; };
        如果(mnemonic == "setle"){ opc = 0x9E; };
        如果(mnemonic == "setg"){ opc = 0x9F; };
        创建 Operand:scd;
        scd = parse_operand(g_enc_parts.获取(1));
        如果(scd.type == OPND_REG){
            设 d3 = reg_num(scd.reg);
            如果(d3 >= 4){
                bytes.添加(0x40);
            };
            bytes.添加(0x0F);
            bytes.添加(opc);
            bytes.添加(0xC0 + (d3 & 7));
            返回值 bytes;
        };
        返回值 bytes;
    };

    如果(mnemonic == "shl" || mnemonic == "shr"){
        创建 Operand:sh;
        sh = parse_operand(g_enc_parts.获取(1));
        设 shn = reg_num(sh.reg);
        设 shb = 0;
        如果(shn >= 8){ shb = 1; };
        设 shw = 0;
        如果(sh.reg < 100){ shw = 1; };
        创建 Operand:shs;
        shs = parse_operand(g_enc_parts.获取(2));

        如果(sh.type == OPND_MEM){
            设 base = reg_num(sh.reg);
            设 b_bit = 0;
            如果(base >= 8){ b_bit = 1; };
            设 x_bit = 0;
            如果(sh.index >= 8){ x_bit = 1; };
            如果(sh.size == 8 || sh.size == 0){
                bytes.添加(make_rex(1, 0, x_bit, b_bit));
            }又如果(b_bit || x_bit){
                bytes.添加(make_rex(0, 0, x_bit, b_bit));
            };
            bytes.添加(0xC1);
            设 shop1 = 0xE0;
            如果(mnemonic == "shr"){ shop1 = 0xE8; };
            如果(sh.index >= 0){
                emit_modrm_sib((shop1 >> 3) & 7, base, sh.index, sh.scale, sh.imm);
            }否则{
                emit_modrm((shop1 >> 3) & 7, base, sh.imm);
            };
            bytes.添加(shs.imm & 255);
            返回值 bytes;
        };
        如果(shs.type == OPND_IMM){
            如果(shw || shb){
                bytes.添加(make_rex(shw, 0, 0, shb));
            };
            bytes.添加(0xC1);
            设 shop1 = 0xE0;
            如果(mnemonic == "shr"){ shop1 = 0xE8; };
            bytes.添加(shop1 + (shn & 7));
            bytes.添加(shs.imm & 255);
            返回值 bytes;
        };
        如果(shw || shb){
            bytes.添加(make_rex(shw, 0, 0, shb));
        };
        bytes.添加(0xD3);
        设 shop = 0xE0;
        如果(mnemonic == "shr"){ shop = 0xE8; };
        bytes.添加(shop + (shn & 7));
        返回值 bytes;
    };

    如果(mnemonic == "idiv"){
