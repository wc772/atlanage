                bytes.添加(v & 255);
                bytes.添加((v / 256) & 255);
                bytes.添加((v / 65536) & 255);
                bytes.添加((v / 16777216) & 255);
                add_reloc(section, offset + 2, dst.label, RELOC_RIP32_IMM4);
