    汇编("test rax, rax");
    汇编("jz .ti_insert");
    汇编("mov r9, [rax + 96]");
    汇编("mov r10, [rcx + 96]");
    汇编("cmp r9, r10");
    汇编("jle .ti_next");
    汇编("jmp .ti_insert");
    汇编(".ti_next:");
    汇编("mov rdx, rax");
    汇编("mov rax, [rax + 88]");
    汇编("jmp .ti_loop");
    汇编(".ti_insert:");
    汇编("mov [rcx + 88], rax");
    汇编("test rdx, rdx");
    汇编("jz .ti_head");
    汇编("mov [rdx + 88], rcx");
