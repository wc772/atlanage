    汇编("sub rsp, 32");
    汇编("call gc_alloc_big");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov [rax], rcx");
    汇编("mov rcx, [rbp - 16]");
    汇编("mov [rcx + 8], rax");
    汇编("mov rax, rcx");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_func_wrap");
