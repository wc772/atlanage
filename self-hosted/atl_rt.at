    汇编("; ===== P2 字符串容器（静态状态）===== ");
    汇编("section .bss");
    汇编("rt_sb_ptr: resq 1");
    汇编("rt_sb_len: resq 1");
    汇编("rt_sb_cap: resq 1");
    汇编("rt_sb_init: resq 1");
    汇编("rt_bc_str: resq 1");
    汇编("rt_bc_len: resq 1");
    汇编("section .text");
    汇编("; ===== P2 共享子程序 ===== ");
    汇编("rt_utf8_strlen:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("xor rax, rax");
    汇编(".usl_loop:");
    汇编("mov dl, [rcx]");
    汇编("test dl, dl");
    汇编("jz .usl_done");
    汇编("cmp dl, 0x80");
    汇编("jb .usl_1");
    汇编("mov r9b, dl");
    汇编("and r9b, 0xE0");
    汇编("cmp r9b, 0xC0");
    汇编("je .usl_2");
    汇编("mov r9b, dl");
    汇编("and r9b, 0xF0");
    汇编("cmp r9b, 0xE0");
    汇编("je .usl_3");
    汇编("add rcx, 4");
    汇编("jmp .usl_next");
    汇编(".usl_1:");
    汇编("add rcx, 1");
    汇编("jmp .usl_next");
    汇编(".usl_2:");
    汇编("add rcx, 2");
    汇编("jmp .usl_next");
    汇编(".usl_3:");
    汇编("add rcx, 3");
    汇编(".usl_next:");
    汇编("inc rax");
    汇编("jmp .usl_loop");
    汇编(".usl_done:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("rt_utf8_byte_off:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("xor rax, rax");
    汇编("xor r8, r8");
    汇编(".ubo_loop:");
    汇编("cmp r8, rdx");
    汇编("jae .ubo_done");
    汇编("mov r10b, [rcx + rax]");
    汇编("test r10b, r10b");
    汇编("jz .ubo_done");
    汇编("cmp r10b, 0x80");
    汇编("jb .ubo_1");
    汇编("mov r11b, r10b");
    汇编("and r11b, 0xE0");
    汇编("cmp r11b, 0xC0");
    汇编("je .ubo_2");
    汇编("mov r11b, r10b");
    汇编("and r11b, 0xF0");
    汇编("cmp r11b, 0xE0");
    汇编("je .ubo_3");
    汇编("add rax, 4");
    汇编("jmp .ubo_next");
    汇编(".ubo_1:");
    汇编("add rax, 1");
    汇编("jmp .ubo_next");
    汇编(".ubo_2:");
    汇编("add rax, 2");
    汇编("jmp .ubo_next");
    汇编(".ubo_3:");
    汇编("add rax, 3");
    汇编(".ubo_next:");
    汇编("inc r8");
    汇编("jmp .ubo_loop");
    汇编(".ubo_done:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("; rt_str_obj: rcx=源 C 串（可 NULL）→ rax=字符串对象；缓冲走 GC 大对象区");
    汇编("rt_str_obj:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("add qword [s_stat_str_count], 1");
    汇编("test rcx, rcx");
    汇编("jz .so_len0");
    汇编("sub rsp, 32");
    汇编("call atl_strlen");
    汇编("add rsp, 32");
    汇编("jmp .so_len_done");
    汇编(".so_len0:");
    汇编("xor eax, eax");
    汇编(".so_len_done:");
    汇编("mov [rbp - 16], rax");
    汇编("add qword [s_stat_str_bytes], rax");
    汇编("add qword [s_stat_str_bytes], 1");
    汇编("mov rcx, 4");
    汇编("xor edx, edx");
    汇编("sub rsp, 32");
    汇编("call atl_pool_alloc");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .so_ret0");
    汇编("mov [rbp - 24], rax");
    汇编("mov rcx, [rbp - 16]");
    汇编("inc rcx");
    汇编("sub rsp, 32");
    汇编("call gc_alloc_big");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .so_ret0");
    汇编("mov [rbp - 32], rax");
    汇编("mov rcx, rax");
    汇编("mov rdx, [rbp - 8]");
    汇编("test rdx, rdx");
    汇编("jnz .so_copy");
    汇编("lea rdx, [rt_empty]");
    汇编(".so_copy:");
    汇编("mov r8, [rbp - 16]");
    汇编("inc r8");
    汇编("sub rsp, 32");
    汇编("call atl_memcpy");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 24]");
    汇编("mov [rcx + 8], rax");
    汇编("mov eax, [rbp - 16]");
    汇编("inc eax");
    汇编("mov [rcx + 4], eax");
    汇编("mov rax, rcx");
    汇编("jmp .so_ret");
    汇编(".so_ret0:");
    汇编("xor eax, eax");
    汇编(".so_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_str");
    汇编("atl_str:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 32");
