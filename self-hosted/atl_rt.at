    汇编("test rcx, rcx");
    汇编("jz .iid_bad");
    汇编("mov eax, [rcx]");
    汇编("sub eax, 7");
    汇编("jnz .iid_bad");
    汇编("mov rax, [rcx + 8]");
    汇编("ret");
    汇编(".iid_bad:");
    汇编("xor eax, eax");
    汇编("ret");
