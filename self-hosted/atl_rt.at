    汇编(".chm_loop:");
    汇编("test rax, rax");
    汇编("jz .chm_ret");
    汇编("and dword [rax + 8], 0xFFFFFFFE");
    汇编("mov rax, [rax + 16]");
    汇编("jmp .chm_loop");
    汇编(".chm_ret:");
    汇编("mov rsp, rbp");
