    汇编("sub rsp, 32");
    汇编("call atl_sys_write_stdout");
    汇编("add rsp, 32");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_input");
    汇编("atl_input:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 96");
    汇编("mov [rbp - 8], rcx");
    汇编("test rcx, rcx");
    汇编("jz .in_read");
    汇编("sub rsp, 32");
    汇编("call atl_to_cstr");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .in_read");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_strlen");
    汇编("add rsp, 32");
    汇编("mov rdx, rax");
    汇编("mov rcx, [rbp - 16]");
    汇编("sub rsp, 32");
    汇编("call atl_sys_write_stdout");
    汇编("add rsp, 32");
    汇编(".in_read:");
    汇编("mov rcx, 4096");
    汇编("sub rsp, 32");
    汇编("call atl_malloc");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .in_empty");
    汇编("mov [rbp - 24], rax");
    汇编("mov rcx, rax");
    汇编("mov rdx, 4095");
    汇编("sub rsp, 32");
    汇编("call atl_sys_read_stdin");
    汇编("add rsp, 32");
    汇编("mov [rbp - 32], rax");
    汇编("mov rcx, [rbp - 24]");
    汇编("mov byte [rcx + rax], 0");
    汇编(".in_strip:");
    汇编("mov rax, [rbp - 32]");
    汇编("test rax, rax");
    汇编("jle .in_str");
    汇编("mov rcx, [rbp - 24]");
    汇编("lea rdx, [rcx + rax - 1]");
    汇编("movzx eax, byte [rdx]");
    汇编("cmp eax, 10");
    汇编("je .in_chop");
    汇编("cmp eax, 13");
    汇编("jne .in_str");
    汇编(".in_chop:");
    汇编("mov rax, [rbp - 32]");
    汇编("dec rax");
    汇编("mov [rbp - 32], rax");
    汇编("mov rcx, [rbp - 24]");
    汇编("mov byte [rcx + rax], 0");
    汇编("jmp .in_strip");
    汇编(".in_str:");
    汇编("mov rcx, [rbp - 24]");
    汇编("sub rsp, 32");
    汇编("call atl_str");
    汇编("add rsp, 32");
    汇编("mov [rbp - 40], rax");
    汇编("mov rcx, [rbp - 24]");
    汇编("sub rsp, 32");
    汇编("call atl_free");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 40]");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".in_empty:");
    汇编("sub rsp, 32");
    汇编("call atl_str");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_input_ref");
    汇编("atl_input_ref:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("sub rsp, 32");
    汇编("call atl_input");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 16]");
    汇编("test rcx, rcx");
    汇编("jz .ir_ret");
    汇编("mov [rcx], rax");
    汇编(".ir_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_games_tick");
    汇编("atl_games_tick:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_int");
    汇编("add rsp, 32");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_gfx_present");
    汇编("add rsp, 32");
    汇编("sub rsp, 32");
    汇编("call atl_gfx_pump");
    汇编("add rsp, 32");
    汇编("mov rcx, 16");
    汇编("sub rsp, 32");
    汇编("call atl_sleep_ms");
    汇编("add rsp, 32");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_key_pressed");
    汇编("atl_key_pressed:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("test rcx, rcx");
    汇编("jz .kp_false");
    汇编("sub rsp, 32");
    汇编("call atl_to_cstr");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .kp_false");
    汇编("movzx eax, byte [rax]");
    汇编("test eax, eax");
    汇编("jz .kp_false");
    汇编("mov [rbp - 16], eax");
    汇编("sub rsp, 32");
    汇编("call atl_gfx_pump");
    汇编("add rsp, 32");
    汇编("mov eax, [rbp - 16]");
    汇编("cmp eax, 97");
    汇编("jl .kp_up");
    汇编("cmp eax, 122");
    汇编("jg .kp_up");
    汇编("sub eax, 32");
    汇编("jmp .kp_call");
    汇编(".kp_up:");
    汇编("mov eax, [rbp - 16]");
    汇编("cmp eax, 48");
    汇编("jl .kp_done_chk");
    汇编("cmp eax, 57");
    汇编("jg .kp_done_chk");
    汇编("jmp .kp_call");
    汇编(".kp_done_chk:");
    汇编("mov eax, [rbp - 16]");
    汇编("cmp eax, 65");
    汇编("jl .kp_false");
    汇编("cmp eax, 90");
    汇编("jg .kp_false");
    汇编(".kp_call:");
    汇编("mov ecx, eax");
    汇编("sub rsp, 32");
    汇编("call atl_gfx_key_pressed");
    汇编("add rsp, 32");
    汇编("test eax, eax");
    汇编("jz .kp_false");
    汇编("mov ecx, 1");
    汇编("sub rsp, 32");
    汇编("call atl_bool");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".kp_false:");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_bool");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("extern RegisterClassExA");
    汇编("extern CreateWindowExA");
    汇编("extern CreateWindowExW");
    汇编("extern SetWindowTextW");
    汇编("extern GetWindowTextW");
    汇编("extern ShowWindow");
    汇编("extern UpdateWindow");
    汇编("extern GetMessageA");
    汇编("extern PeekMessageA");
    汇编("extern IsDialogMessageA");
    汇编("extern TranslateMessage");
    汇编("extern DispatchMessageA");
    汇编("extern DefWindowProcA");
    汇编("extern DestroyWindow");
    汇编("extern GetModuleHandleA");
    汇编("extern WideCharToMultiByte");
    汇编("section .bss");
    汇编("g_input_buf: resb 4096");
    汇编("g_input_prompt: resb 8192");

    汇编("g_input_done: resd 1");
    汇编("g_input_edit: resq 1");
    汇编("g_input_dlg: resq 1");
    汇编("g_input_cls_reg: resd 1");
    汇编("g_input_wc: resb 96");
    汇编("rt_thr_lo: resq 1");
    汇编("rt_thr_hi: resq 1");
    汇编("section .data");
    汇编("rt_wstr_ok: dw 0x786E, 0x5B9A, 0");
    汇编("rt_wstr_empty: dw 0");
    汇编("rt_input_title: db 'ATRI', 0");
    汇编("rt_wstr_atri: dw 0x41, 0x54, 0x52, 0x49, 0");
    汇编("rt_input_cls: db 'AtlanageInputDlg', 0");
    汇编("rt_a_static: db 'STATIC', 0");
    汇编("rt_a_edit: db 'EDIT', 0");
    汇编("rt_a_button: db 'BUTTON', 0");
    汇编("rt_str_stackovf: db '栈溢出: 递归过深或栈帧过大(任务栈 256KB)', 10, 0");
    汇编("section .text");

    汇编("rt_utf8_to_wstr:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov ecx, 65001");
    汇编("xor edx, edx");
    汇编("mov r8, [rbp - 8]");
    汇编("mov r9, -1");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 0");
    汇编("mov qword [rsp + 40], 0");
    汇编("call MultiByteToWideChar");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .u2w0");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, rax");
    汇编("shl rcx, 1");
    汇编("sub rsp, 32");
    汇编("call atl_malloc");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .u2w0");
    汇编("mov [rbp - 24], rax");
    汇编("mov ecx, 65001");
    汇编("xor edx, edx");
    汇编("mov r8, [rbp - 8]");
    汇编("mov r9, -1");
    汇编("sub rsp, 32");
    汇编("mov rax, [rbp - 24]");
    汇编("mov [rsp + 32], rax");
    汇编("mov rax, [rbp - 16]");
    汇编("mov [rsp + 40], rax");
    汇编("call MultiByteToWideChar");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 24]");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".u2w0:");
    汇编("xor eax, eax");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("rt_wstr_to_utf8:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov ecx, 65001");
    汇编("xor edx, edx");
    汇编("mov r8, [rbp - 8]");
    汇编("mov r9, -1");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 0");
    汇编("mov qword [rsp + 40], 0");
    汇编("mov qword [rsp + 48], 0");
    汇编("mov qword [rsp + 56], 0");
    汇编("call WideCharToMultiByte");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .w2u0");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_malloc");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .w2u0");
    汇编("mov [rbp - 24], rax");
    汇编("mov ecx, 65001");
    汇编("xor edx, edx");
    汇编("mov r8, [rbp - 8]");
    汇编("mov r9, -1");
    汇编("sub rsp, 32");
    汇编("mov rax, [rbp - 24]");
    汇编("mov [rsp + 32], rax");
    汇编("mov rax, [rbp - 16]");
    汇编("mov [rsp + 40], rax");
    汇编("mov qword [rsp + 48], 0");
    汇编("mov qword [rsp + 56], 0");
    汇编("call WideCharToMultiByte");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 24]");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".w2u0:");
