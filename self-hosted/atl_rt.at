声明 __rt_defs_p3b(){
    汇编("; ===== P3 批次2: 注册表（.bss 静态区）===== ");
    汇编("section .bss");
    汇编("rt_class_tab: resb 4096");
    汇编("rt_class_tab_n: resq 1");
    汇编("rt_method_tab: resb 49152");
    汇编("rt_method_tab_n: resq 1");
    汇编("rt_field_tab: resb 6144");
    汇编("rt_field_tab_n: resq 1");
    汇编("rt_null_obj: resq 2");
    汇编("section .text");
    汇编("global atl_class_register");
    汇编("atl_class_register:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("test rcx, rcx");
    汇编("jz .cr_ret");
    汇编("mov rax, [rt_class_tab_n]");
    汇编("cmp rax, 256");
    汇编("jae .cr_ret");
    汇编("imul rax, rax, 16");
    汇编("lea r9, [rt_class_tab]");
    汇编("add r9, rax");
    汇编("mov [r9], rcx");
    汇编("mov [r9 + 8], rdx");
    汇编("add qword [rt_class_tab_n], 1");
    汇编(".cr_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_method_register");
    汇编("atl_method_register:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("test rcx, rcx");
    汇编("jz .mr_ret");
    汇编("test rdx, rdx");
    汇编("jz .mr_ret");
    汇编("test r8, r8");
    汇编("jz .mr_ret");
    汇编("mov rax, [rt_method_tab_n]");
    汇编("cmp rax, 2048");
    汇编("jae .mr_ret");
    汇编("imul rax, rax, 24");
    汇编("lea r9, [rt_method_tab]");
    汇编("add r9, rax");
    汇编("mov [r9], rcx");
    汇编("mov [r9 + 8], rdx");
    汇编("mov [r9 + 16], r8");
    汇编("add qword [rt_method_tab_n], 1");
    汇编(".mr_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_class_fields_register");
    汇编("atl_class_fields_register:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("test rcx, rcx");
    汇编("jz .fr_ret");
