    汇编("sub eax, 1");
    汇编("jz .eq_both_int");
    汇编("jmp .eq_magic");
    汇编(".eq_both_int:");
    汇编("mov rax, [rcx + 8]");
    汇编("sub rax, [rdx + 8]");
    汇编("jz .eq_true");
    汇编("jmp .eq_false");
    汇编(".eq_magic:");
    汇编("; ---- 运算符重载: lhs 是类实例且有 _等_ 魔术方法 → rt_magic_try 分派 ----");
    汇编("lea r8, [rt_magic_eq]");
    汇编("sub rsp, 32");
