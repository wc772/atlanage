    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("mov rcx, 7");
    汇编("call rt_alloc_tag");
    汇编("mov [rbp - 24], rax");
    汇编("mov rcx, 32");
    汇编("sub rsp, 32");
    汇编("call gc_alloc_big");
    汇编("add rsp, 32");
    汇编("mov [rbp - 32], rax");
    汇编("mov qword [rax], 0");
    汇编("mov rcx, [rbp - 16]");
    汇编("test rcx, rcx");
    汇编("jnz .in_sz_ok");
    汇编("mov rcx, 1");
