    汇编("rt_gc_sweep_heap:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov qword [rbp - 16], 0");
    汇编("mov rax, [rcx]");
    汇编("mov [rbp - 24], rax");
    汇编(".sh_loop:");
    汇编("mov rax, [rbp - 24]");
    汇编("test rax, rax");
    汇编("jz .sh_done");
    汇编("mov [rbp - 32], rax");
    汇编("mov rax, [rax + 16]");
    汇编("mov [rbp - 40], rax");
    汇编("mov rax, [rbp - 32]");
    汇编("mov eax, [rax + 8]");
    汇编("test eax, 1");
    汇编("jnz .sh_live");
    汇编("mov rax, [rbp - 32]");
    汇编("mov rcx, [rbp - 16]");
    汇编("test rcx, rcx");
    汇编("jnz .sh_dead_prev");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rdx, [rbp - 40]");
    汇编("mov [rcx], rdx");
    汇编("jmp .sh_dead_unlinked");
    汇编(".sh_dead_prev:");
    汇编("mov rcx, [rbp - 16]");
    汇编("mov rdx, [rbp - 40]");
    汇编("mov [rcx + 16], rdx");
    汇编(".sh_dead_unlinked:");
    汇编("mov rax, [rbp - 32]");
    汇编("mov qword [rax + 16], 0");
    汇编("mov dword [rax + 8], 0");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rdx, [rcx + 8]");
    汇编("mov [rax + 24], rdx");
    汇编("mov [rcx + 8], rax");
    汇编("jmp .sh_next");
    汇编(".sh_live:");
    汇编("mov rax, [rbp - 32]");
    汇编("and dword [rax + 8], 0xFFFFFFFE");
    汇编("mov [rbp - 16], rax");
    汇编(".sh_next:");
    汇编("mov rax, [rbp - 40]");
    汇编("mov [rbp - 24], rax");
    汇编("jmp .sh_loop");
    汇编(".sh_done:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_gc_collect");
    汇编("atl_gc_collect:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 96");
    汇编("mov rax, [rt_gc_enabled]");
    汇编("test rax, rax");
    汇编("jz .gc_ret0");
    汇编("mov rax, [rt_gc_nblocks]");
    汇编("test rax, rax");
    汇编("jz .gc_ret0");
    汇编("mov [rbp - 8], rax");
    汇编("; ===== STW 停车: 在发起权锁内记录 tid + 置 pending, 后到者等 pending 清除 =====");
    汇编("mov rax, 1");
    汇编(".gc_claim_spin:");
    汇编("xchg rax, qword [rt_gc_collect_lock]");
    汇编("test rax, rax");
    汇编("jnz .gc_claim_spin");
    汇编("mov rax, [rt_gc_pending]");
    汇编("test rax, rax");
    汇编("jnz .gc_claim_reentrant");
    汇编("; ===== 止血补丁: 扫描被保留(非易失)寄存器, 兜住未 spill 到栈的活对象指针 =====");
    汇编("; MS x64 非易失寄存器 = rbx, rdi, rsi, r12, r13, r14, r15");
    汇编("; 这些寄存器里的活引用只活在 CPU 寄存器里: 影子帧(按掩码扫栈槽)和保守栈扫描(扫已落栈内容)都抓不到");
    汇编("; 一旦跨过触发 GC 的分配调用, 该引用被判不可达→回收→悬空指针→字段写 0xC0000005(M2 构造期崩溃根因)");
    汇编("; rt_gc_scan_value 与其内部 rt_gc_mark_box 均保留非易失寄存器, 可安全逐个扫描");
    汇编("mov rax, rbx");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, rdi");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, rsi");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, r12");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, r13");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, r14");
    汇编("call rt_gc_scan_value");
    汇编("mov rax, r15");
    汇编("call rt_gc_scan_value");
    汇编("sub rsp, 32");
    汇编("call GetCurrentThreadId");
    汇编("add rsp, 32");
    汇编("mov [rt_gc_initiator_tid], eax");
    汇编("; pending 修改与主线程等待点同用 g_sched_cs, 避免漏唤醒")
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call EnterCriticalSection");
    汇编("add rsp, 32");
    汇编("mov qword [rt_gc_pending], 1");
    汇编("lea rcx, [g_main_cv]");
    汇编("sub rsp, 32");
    汇编("call WakeConditionVariable");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("mov qword [rt_gc_collect_lock], 0");
    汇编("sub rsp, 32");
    汇编("call rt_cur_card");
    汇编("add rsp, 32");
    汇编("mov [rbp - 72], rax");
    汇编("test rax, rax");
    汇编("jz .gc_stw_main");
    汇编("mov qword [rbp - 48], 1");
    汇编("jmp .gc_stw_wait");
    汇编(".gc_stw_main:");
    汇编("mov qword [rbp - 48], 0");
    汇编(".gc_stw_wait:");
    汇编("mov rax, [rt_gc_in_at]");
    汇编("cmp rax, [rbp - 48]");
    汇编("jg .gc_stw_sleep");
    汇编("mov rax, [rbp - 72]");
    汇编("test rax, rax");
    汇编("jz .gc_stw_ok");
    汇编("mov rax, [rt_gc_main_active]");
    汇编("test rax, rax");
    汇编("jz .gc_stw_ok");
    汇编("mov rax, [rt_gc_main_parked]");
    汇编("test rax, rax");
    汇编("jnz .gc_stw_ok");
    汇编(".gc_stw_sleep:");
    汇编("mov ecx, 1");
    汇编("sub rsp, 32");
    汇编("call Sleep");
    汇编("add rsp, 32");
    汇编("jmp .gc_stw_wait");
    汇编(".gc_claim_reentrant:");
    汇编("mov qword [rt_gc_collect_lock], 0");
    汇编("jmp .gc_reentrant");
    汇编(".gc_reentrant:");
    汇编("sub rsp, 32");
    汇编("call GetCurrentThreadId");
    汇编("add rsp, 32");
    汇编("cmp eax, [rt_gc_initiator_tid]");
    汇编("je .gc_ret0");
    汇编("sub rsp, 32");
    汇编("call rt_cur_card");
    汇编("add rsp, 32");
    汇编("mov [rbp - 56], rax");
    汇编("mov qword [rbp - 88], 0");
    汇编("test rax, rax");
    汇编("jnz .gc_reentrant_worker");
    汇编("mov rcx, [rt_thr_lo]");
    汇编("test rcx, rcx");
    汇编("jz .gc_reentrant_wait");
    汇编("cmp rsp, rcx");
    汇编("jb .gc_reentrant_wait");
    汇编("mov rcx, [rt_thr_hi]");
    汇编("cmp rsp, rcx");
    汇编("jae .gc_reentrant_wait");
    汇编("mov qword [rbp - 88], 1");
    汇编("mov qword [rt_gc_main_parked], 1");
    汇编("jmp .gc_reentrant_wait");
    汇编(".gc_reentrant_worker:");
    汇编("lock dec qword [rt_gc_in_at]");
    汇编(".gc_reentrant_wait:");
    汇编("mov rax, [rt_gc_pending]");
    汇编("test rax, rax");
    汇编("jz .gc_reentrant_done");
    汇编("mov ecx, 1");
    汇编("sub rsp, 32");
    汇编("call Sleep");
    汇编("add rsp, 32");
    汇编("jmp .gc_reentrant_wait");
    汇编(".gc_reentrant_done:");
    汇编("mov rax, [rbp - 56]");
    汇编("test rax, rax");
    汇编("jnz .gc_reentrant_inc");
    汇编("cmp qword [rbp - 88], 0");
    汇编("je .gc_ret0");
    汇编("mov qword [rt_gc_main_parked], 0");
    汇编("jmp .gc_ret0");
    汇编(".gc_reentrant_inc:");
    汇编("lock inc qword [rt_gc_in_at]");
    汇编("jmp .gc_ret0");
    汇编(".gc_stw_ok:");
    汇编("mov rax, [rbp - 8]");
    汇编("dec rax");
    汇编("imul rax, 43690");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, [rt_gc_arena]");
    汇编("mov rdx, [rbp - 8]");
    汇编("dec rdx");
    汇编("shl rdx, 20");
    汇编("add rcx, rdx");
    汇编("mov rdx, [rt_gc_bump]");
    汇编("sub rdx, rcx");
    汇编("mov rax, rdx");
    汇编("xor edx, edx");
    汇编("mov r9, 24");
    汇编("div r9");
    汇编("add rax, [rbp - 16]");
    汇编("mov [rt_gc_total_slots], rax");
    汇编("add rax, 63");
    汇编("shr rax, 6");
    汇编("shl rax, 3");
    汇编("mov [rbp - 24], rax");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_malloc");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .gc_abort");
    汇编("mov [rt_gc_mark_bits], rax");
    汇编("xor r8, r8");
    汇编(".gc_zero:");
    汇编("cmp r8, [rbp - 24]");
    汇编("jae .gc_zero_done");
    汇编("mov rcx, [rt_gc_mark_bits]");
    汇编("mov qword [rcx + r8], 0");
    汇编("add r8, 8");
    汇编("jmp .gc_zero");
    汇编(".gc_zero_done:");
    汇编("lea rcx, [rt_gc_obj_heap]");
    汇编("call rt_gc_clear_heap_marks");
    汇编("lea rcx, [rt_gc_big_heap]");
    汇编("call rt_gc_clear_heap_marks");
    汇编("mov qword [rt_gc_ws_top], 0");
    汇编("mov qword [rt_gc_ws_overflow], 0");
    汇编("; ---- 根集 1: 主线程影子栈帧 ----");
    汇编("mov qword [rbp - 80], 0");
    汇编(".gc_frameloop:");
    汇编("mov rax, [rbp - 80]");
    汇编("cmp rax, [rt_gc_nframes]");
    汇编("jae .gc_frames_done");
    汇编("imul rax, rax, 16");
    汇编("lea r10, [rt_gc_frames]");
    汇编("add r10, rax");
    汇编("mov rcx, [r10]");
    汇编("mov rdx, [r10 + 8]");
    汇编("call rt_gc_scan_frame");
    汇编("add qword [rbp - 80], 1");
    汇编("jmp .gc_frameloop");
    汇编(".gc_frames_done:");
    汇编("; ---- 根集 2: codegen 发射的全局/静态槽区间表 ----");
    汇编("mov qword [rbp - 80], 0");
    汇编(".gc_rootloop:");
    汇编("lea r10, [__atl_gc_roots]");
    汇编("mov rcx, [rbp - 80]");
    汇编("mov rax, [r10 + rcx*8]");
    汇编("test rax, rax");
    汇编("jz .gc_roots_done");
    汇编("mov rcx, rax");
    汇编("mov rdx, [rbp - 80]");
    汇编("mov rdx, [r10 + rdx*8 + 8]");
    汇编("add rdx, rcx");
    汇编("call rt_gc_scan_range");
    汇编("add qword [rbp - 80], 2");
    汇编("jmp .gc_rootloop");
    汇编(".gc_roots_done:");
    汇编("; ---- 根集 3: 全部任务卡(注册表)的 fn/result/上下文 GPR/内嵌影子栈 ----");
    汇编("mov r8, [rt_gc_task_head]");
    汇编(".gc_taskloop:");
    汇编("test r8, r8");
    汇编("jz .gc_tasks_done");
    汇编("mov [rbp - 80], r8");
    汇编("mov rax, [r8 + 8]");
    汇编("call rt_gc_scan_value");
    汇编("mov r8, [rbp - 80]");
    汇编("mov rax, [r8 + 24]");
    汇编("call rt_gc_scan_value");
    汇编("mov r8, [rbp - 80]");
    汇编("mov rax, [r8 + 40]");
    汇编("test rax, rax");
    汇编("jz .gc_task_next");
    汇编("mov rax, [r8 + 536]");
    汇编("test rax, rax");
    汇编("jz .gc_task_next");
    汇编("mov r8, [rbp - 80]");
    汇编("add r8, 112");
    汇编("mov [rbp - 88], r8");
    汇编("mov r9, [rbp - 80]");
    汇编("add r9, 232");
    汇编("mov [rbp - 96], r9");
    汇编(".gc_ctxloop:");
    汇编("mov r8, [rbp - 88]");
    汇编("cmp r8, [rbp - 96]");
    汇编("jae .gc_ctx_done");
    汇编("mov rax, [r8]");
    汇编("call rt_gc_scan_value");
    汇编("add qword [rbp - 88], 8");
    汇编("jmp .gc_ctxloop");
    汇编(".gc_ctx_done:");
    汇编("mov r8, [rbp - 80]");
    汇编("lea r9, [r8 + 640]");
    汇编("mov [rbp - 88], r9");
    汇编("mov r10, [r8 + 536]");
    汇编("mov [rbp - 96], r10");
    汇编(".gc_cardshadow:");
    汇编("mov r9, [rbp - 88]");
    汇编("cmp r9, [rbp - 96]");
    汇编("jae .gc_cardshadow_done");
    汇编("mov rcx, [r9]");
    汇编("mov rdx, [r9 + 8]");
    汇编("call rt_gc_scan_frame");
    汇编("add qword [rbp - 88], 16");
    汇编("jmp .gc_cardshadow");
    汇编(".gc_cardshadow_done:");
    汇编("mov r8, [rbp - 80]");
    汇编(".gc_task_next:");
    汇编("mov r8, [r8 + 552]");
    汇编("jmp .gc_taskloop");
    汇编(".gc_tasks_done:");
    汇编("; ---- 根集 4: 堆外 GC 对象(ERROR/RESULT/CHAN)注册表 ----");
    汇编("mov r8, [rt_gc_aux_head]");
    汇编(".gc_auxloop:");
    汇编("test r8, r8");
    汇编("jz .gc_aux_done");
    汇编("mov [rbp - 80], r8");
    汇编("mov eax, [r8]");
    汇编("cmp eax, 10");
    汇编("je .gc_aux_err");
    汇编("cmp eax, 11");
    汇编("je .gc_aux_result");
    汇编("cmp eax, 13");
    汇编("je .gc_aux_chan");
    汇编("jmp .gc_aux_next");
