    汇编("; ===== GC 影子栈压帧/弹帧（AT 原生，供 atl_codegen 生成的函数调用）===== ");
    汇编("; 主线程 → 全局 rt_gc_frames/rt_gc_nframes; 任务卡 → 卡尾内嵌 16KB 影子栈(+536=ptr,+544=end,base=card+640)");
    汇编("global gc_push_frame");
    汇编("gc_push_frame:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("call rt_cur_card");
    汇编("test rax, rax");
    汇编("jz .gpf_main");
    汇编("mov r8, [rax + 536]");
    汇编("test r8, r8");
    汇编("jz .gpf_ret");
    汇编("mov r9, r8");
    汇编("add r9, 16");
    汇编("cmp r9, [rax + 544]");
    汇编("ja .gpf_ret");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rdx, [rbp - 16]");
    汇编("mov [r8], rcx");
    汇编("mov [r8 + 8], rdx");
    汇编("mov [rax + 536], r9");
    汇编("jmp .gpf_ret");
    汇编(".gpf_main:");
    汇编("mov rax, [rt_gc_nframes]");
    汇编("cmp rax, 1024");
    汇编("jae .gpf_ret");
    汇编("imul rax, rax, 16");
    汇编("lea r8, [rt_gc_frames]");
    汇编("add r8, rax");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rdx, [rbp - 16]");
    汇编("mov [r8], rcx");
    汇编("mov [r8 + 8], rdx");
    汇编("add qword [rt_gc_nframes], 1");
    汇编(".gpf_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global gc_pop_frame");
    汇编("gc_pop_frame:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 32");
    汇编("call rt_cur_card");
    汇编("test rax, rax");
    汇编("jnz .gpop_task");
    汇编("mov rax, [rt_gc_nframes]");
    汇编("test rax, rax");
    汇编("jz .gpop_ret");
    汇编("sub qword [rt_gc_nframes], 1");
    汇编("jmp .gpop_ret");
    汇编(".gpop_task:");
    汇编("mov r8, [rax + 536]");
    汇编("test r8, r8");
    汇编("jz .gpop_ret");
    汇编("lea rcx, [rax + 640]");
    汇编("cmp r8, rcx");
    汇编("jbe .gpop_ret");
    汇编("sub r8, 16");
    汇编("mov [rax + 536], r8");
    汇编(".gpop_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("; ===== 堆外 GC 对象(ERROR/RESULT/CHAN)注册表无锁头插: rcx=obj, rdx=gc_next 偏移 =====");
    汇编("rt_gc_aux_push:");
    汇编("mov rax, [rt_gc_aux_head]");
    汇编(".aux_push_loop:");
    汇编("mov [rcx + rdx], rax");
    汇编("lock cmpxchg qword [rt_gc_aux_head], rcx");
    汇编("jne .aux_push_loop");
    汇编("ret");
