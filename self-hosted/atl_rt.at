    汇编("global rt_timer_insert");
    汇编("rt_timer_insert:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 48");
    汇编("mov [rbp - 8], rcx");
    汇编("mov rax, [g_timer_head]");
    汇编("xor rdx, rdx");
