    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call EnterCriticalSection");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 8]");
    汇编("mov qword [rax + 32], 3");
    汇编("mov rax, [rbp - 8]");
    汇编("add rax, 72");
    汇编("mov rcx, rax");
    汇编("mov rax, [rbp - 8]");
    汇编("add rax, 80");
    汇编("mov rdx, rax");
    汇编("sub rsp, 32");
    汇编("call rt_wake_all");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global worker_loop");
    汇编("worker_loop:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov qword [rcx + 416], 0");
    汇编("mov ecx, [g_tls_slot]");
    汇编("mov rdx, [rbp - 8]");
    汇编("sub rsp, 32");
    汇编("call TlsSetValue");
    汇编("add rsp, 32");
    汇编(".wl_loop:");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call EnterCriticalSection");
    汇编("add rsp, 32");
    汇编(".wl_wait:");
    汇编("mov rax, [g_ready_head]");
    汇编("test rax, rax");
    汇编("jnz .wl_pop");
    汇编("lea rcx, [g_ready_cv]");
    汇编("lea rdx, [g_sched_cs]");
    汇编("mov r8, -1");
    汇编("sub rsp, 32");
    汇编("call SleepConditionVariableCS");
    汇编("add rsp, 32");
    汇编("jmp .wl_wait");
    汇编(".wl_pop:");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, [rax + 64]");
    汇编("mov [g_ready_head], rcx");
    汇编("test rcx, rcx");
    汇编("jnz .wl_have_tail");
    汇编("mov qword [g_ready_tail], 0");
    汇编(".wl_have_tail:");
    汇编("mov rax, [rt_gc_pending]");
    汇编("test rax, rax");
    汇编("jz .wl_run");
    汇编("mov rax, [rbp - 16]");
    汇编("mov rcx, [g_ready_head]");
    汇编("mov [rax + 64], rcx");
    汇编("mov [g_ready_head], rax");
    汇编("test rcx, rcx");
    汇编("jnz .wl_park_wait");
    汇编("mov [g_ready_tail], rax");
    汇编(".wl_park_wait:");
    汇编("mov rax, [rt_gc_pending]");
    汇编("test rax, rax");
    汇编("jz .wl_park_done");
    汇编("lea rcx, [g_ready_cv]");
    汇编("lea rdx, [g_sched_cs]");
    汇编("mov r8, -1");
    汇编("sub rsp, 32");
    汇编("call SleepConditionVariableCS");
    汇编("add rsp, 32");
    汇编("jmp .wl_park_wait");
    汇编(".wl_park_done:");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("jmp .wl_loop");
    汇编(".wl_run:");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 16]");
    汇编("mov qword [rax + 64], 0");
    汇编("mov qword [rax + 32], 1");
    汇编("mov rdx, [rbp - 8]");
    汇编("mov [rdx + 416], rax");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rax, [rbp - 16]");
    汇编("add rax, 112");
    汇编("mov rdx, rax");
    汇编("lock inc qword [rt_gc_in_at]");
    汇编("sub rsp, 32");
    汇编("call rt_switch");
    汇编("add rsp, 32");
    汇编("lock dec qword [rt_gc_in_at]");
    汇编("mov rax, [rbp - 8]");
    汇编("mov qword [rax + 416], 0");
    汇编("mov rax, [rbp - 16]");
    汇编("cmp qword [rax + 32], 3");
    汇编("jne .wl_loop");
    汇编("mov rcx, [rax + 40]");
    汇编("test rcx, rcx");
    汇编("jz .wl_loop");
    汇编("mov rax, [rbp - 16]");
    汇编("cmp qword [rax + 528], 0");
    汇编("jne .wl_heap");
    汇编("sub rsp, 32");
    汇编("xor rdx, rdx");
    汇编("mov r8, 0x8000");
    汇编("call VirtualFree");
    汇编("add rsp, 32");
    汇编("jmp .wl_clear");
