    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_str_take");
    汇编("atl_str_take:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 48");
    汇编("mov [rbp - 8], rcx");
    汇编("call rt_str_obj");
    汇编("mov [rbp - 16], rax");
    汇编("mov rcx, [rbp - 8]");
    汇编("test rcx, rcx");
    汇编("jz .st_ret");
    汇编("sub rsp, 32");
    汇编("call atl_free");
    汇编("add rsp, 32");
    汇编(".st_ret:");
    汇编("mov rax, [rbp - 16]");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_str_len");
    汇编("atl_str_len:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 32");
    汇编("test rcx, rcx");
    汇编("jnz .sl_ok");
    汇编("xor eax, eax");
    汇编("jmp .sl_mk");
    汇编(".sl_ok:");
    汇编("mov eax, [rcx]");
    汇编("sub eax, 4");
    汇编("jz .sl_str");
    汇编("sub eax, 1");
    汇编("jz .sl_list");
    汇编("xor eax, eax");
    汇编("jmp .sl_mk");
    汇编(".sl_str:");
    汇编("mov rcx, [rcx + 8]");
    汇编("call rt_utf8_strlen");
    汇编("jmp .sl_mk");
    汇编(".sl_list:");
    汇编("mov rdx, [rcx + 8]");
    汇编("mov rax, [rdx + 8]");
    汇编(".sl_mk:");
    汇编("call rt_make_int");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_str_contains");
    汇编("atl_str_contains:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("test rcx, rcx");
    汇编("jnz .sc_ok");
    汇编("xor eax, eax");
    汇编("jmp .sc_bool");
    汇编(".sc_ok:");
    汇编("mov eax, [rcx]");
    汇编("sub eax, 4");
    汇编("jz .sc_str");
    汇编("xor eax, eax");
    汇编("jmp .sc_bool");
    汇编(".sc_str:");
    汇编("mov rdx, [rcx + 8]");
    汇编("mov [rbp - 24], rdx");
    汇编("mov rcx, [rbp - 16]");
    汇编("test rcx, rcx");
    汇编("jnz .sc_cstr");
    汇编("xor eax, eax");
    汇编("jmp .sc_haveb");
    汇编(".sc_cstr:");
    汇编("sub rsp, 32");
    汇编("call atl_to_cstr");
    汇编("add rsp, 32");
    汇编(".sc_haveb:");
    汇编("mov [rbp - 32], rax");
    汇编("mov rcx, [rbp - 24]");
    汇编("mov rdx, [rbp - 32]");
    汇编("sub rsp, 32");
    汇编("call atl_strstr");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .sc_false");
    汇编("mov eax, 1");
    汇编("jmp .sc_bool");
    汇编(".sc_false:");
    汇编("xor eax, eax");
    汇编(".sc_bool:");
    汇编("mov rcx, rax");
    汇编("call rt_make_bool");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_str_starts");
