    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rax");
    汇编("test rax, rax");
    汇编("jz .mc_fail");
    汇编("js .mc_fail");
    汇编("cmp rax, 4096");
    汇编("jb .mc_fail");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rax, [rbp - 16]");
    汇编("call rt_gc_heap_contains");
    汇编("test eax, eax");
    汇编("jz .mc_fail");
    汇编("mov rax, [rbp - 16]");
    汇编("lea rax, [rax - 32]");
    汇编("mov [rbp - 24], rax");
    汇编("mov eax, [rax]");
    汇编("cmp eax, 0xC0A7C0A7");
    汇编("jne .mc_fail");
    汇编("mov rax, [rbp - 24]");
    汇编("mov eax, [rax + 8]");
    汇编("test eax, 4");
    汇编("jz .mc_fail");
    汇编("mov rax, [rbp - 24]");
    汇编("mov eax, [rax + 8]");
    汇编("test eax, 1");
    汇编("jnz .mc_old");
    汇编("mov rax, [rbp - 24]");
    汇编("or dword [rax + 8], 1");
    汇编("mov eax, 1");
    汇编("jmp .mc_ret");
    汇编(".mc_old:");
    汇编("xor eax, eax");
    汇编("jmp .mc_ret");
    汇编(".mc_fail:");
