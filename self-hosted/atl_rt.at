    汇编("shl rcx, 3");
    汇编("sub rsp, 32");
    汇编("call gc_alloc_big");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 32]");
    汇编("mov [rcx + 8], rax");
    汇编("mov rdx, [rbp - 16]");
    汇编("mov [rcx + 16], rdx");
    汇编("mov rax, [rbp - 8]");
    汇编("test rax, rax");
    汇编("jz .in_no_cls");
    汇编("mov [rbp - 48], rax");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_strlen");
    汇编("add rsp, 32");
    汇编("mov [rbp - 56], rax");
    汇编("add rax, 1");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call gc_alloc_big");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .in_no_cls");
    汇编("mov [rbp - 64], rax");
    汇编("mov rcx, rax");
    汇编("mov rdx, [rbp - 48]");
    汇编("mov r8, [rbp - 56]");
    汇编("inc r8");
    汇编("sub rsp, 32");
    汇编("call atl_memcpy");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 64]");
    汇编("jmp .in_cls_ok");
    汇编(".in_no_cls:");
    汇编("xor eax, eax");
    汇编(".in_cls_ok:");
    汇编("mov rcx, [rbp - 32]");
    汇编("mov [rcx + 24], rax");
    汇编("mov qword [rbp - 40], 0");
    汇编(".in_loop:");
    汇编("mov rax, [rbp - 40]");
    汇编("mov rcx, [rbp - 16]");
    汇编("cmp rax, rcx");
    汇编("jae .in_done");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 32]");
    汇编("mov rdx, [rbp - 40]");
    汇编("mov rcx, [rcx + 8]");
    汇编("mov [rcx + rdx * 8], rax");
    汇编("add qword [rbp - 40], 1");
    汇编("jmp .in_loop");
    汇编(".in_done:");
    汇编("add qword [s_stat_inst_count], 1");
    汇编("mov rcx, [rbp - 24]");
    汇编("mov rax, [rbp - 32]");
    汇编("mov [rcx + 8], rax");
    汇编("mov rax, rcx");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
