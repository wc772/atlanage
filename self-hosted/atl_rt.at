    汇编("mov [rbp - 24], rdx");
    汇编("mov rcx, [rbp - 16]");
    汇编("call rt_to_double");
    汇编("movq rdx, xmm0");
    汇编("movq xmm1, rdx");
    汇编("mov rdx, [rbp - 24]");
