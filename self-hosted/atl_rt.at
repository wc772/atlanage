    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_input_wndproc");
    汇编("atl_input_wndproc:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 0x2000");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("mov [rbp - 24], r8");
    汇编("mov [rbp - 32], r9");
    汇编("cmp rdx, 0x111");
    汇编("jne .iw_dest");
    汇编("mov rax, [rbp - 24]");
    汇编("shr rax, 16");
    汇编("test eax, eax");
    汇编("jnz .iw_def");
    汇编("mov eax, [rbp - 24]");
    汇编("and eax, 0xFFFF");
    汇编("cmp eax, 1002");
    汇编("jne .iw_def");
    汇编("mov rcx, [g_input_edit]");
    汇编("lea rdx, [rbp - 0x2000]");
    汇编("mov r8, 4095");
    汇编("sub rsp, 32");
    汇编("call GetWindowTextW");
    汇编("add rsp, 32");
    汇编("lea rcx, [rbp - 0x2000]");
    汇编("sub rsp, 32");
    汇编("call rt_wstr_to_utf8");
    汇编("add rsp, 32");
    汇编("mov [rbp - 40], rax");
    汇编("test rax, rax");
    汇编("jz .iw_zero");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call atl_strlen");
    汇编("add rsp, 32");
    汇编("mov rdx, rax");
    汇编("cmp rdx, 4095");
    汇编("jle .iw_cpy");
    汇编("mov rdx, 4095");
    汇编(".iw_cpy:");
    汇编("mov [rbp - 48], rdx");
    汇编("lea rcx, [g_input_buf]");
    汇编("mov rdx, [rbp - 40]");
    汇编("mov r8, [rbp - 48]");
    汇编("sub rsp, 32");
    汇编("call atl_memcpy");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 48]");
    汇编("lea rcx, [g_input_buf]");
    汇编("mov byte [rcx + rax], 0");
    汇编("mov rcx, [rbp - 40]");
    汇编("sub rsp, 32");
    汇编("call atl_free");
    汇编("add rsp, 32");
    汇编("jmp .iw_ok");
    汇编(".iw_zero:");
    汇编("mov byte [g_input_buf], 0");
    汇编(".iw_ok:");
    汇编("mov dword [g_input_done], 1");
    汇编("mov rcx, [rbp - 8]");
    汇编("sub rsp, 32");
    汇编("call DestroyWindow");
    汇编("add rsp, 32");
    汇编("xor eax, eax");
    汇编("jmp .iw_ret");
    汇编(".iw_dest:");
    汇编("cmp qword [rbp - 16], 2");
    汇编("jne .iw_def");
    汇编("mov eax, [g_input_done]");
    汇编("test eax, eax");
    汇编("jnz .iw_done_set");
    汇编("mov byte [g_input_buf], 0");
    汇编(".iw_done_set:");
    汇编("mov dword [g_input_done], 1");
    汇编("xor eax, eax");
    汇编("jmp .iw_ret");
    汇编(".iw_def:");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov rdx, [rbp - 16]");
    汇编("mov r8, [rbp - 24]");
    汇编("mov r9, [rbp - 32]");
    汇编("sub rsp, 32");
    汇编("call DefWindowProcA");
    汇编("add rsp, 32");
    汇编(".iw_ret:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global atl_show_input");
    汇编("atl_show_input:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 0x4000");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("mov [rbp - 24], r8");
    汇编("; 1. 拼接提示");
    汇编("lea rax, [g_input_prompt]");
    汇编("mov [rbp - 32], rax");
    汇编("mov [rbp - 40], rax");
    汇编("mov rax, [rbp - 8]");
    汇编("test rax, rax");
    汇编("jz .si_size");
    汇编("mov eax, [rax]");
    汇编("cmp eax, 5");
    汇编("jne .si_size");
    汇编("mov rax, [rbp - 8]");
    汇编("mov rax, [rax + 8]");
    汇编("mov [rbp - 112], rax");
    汇编("mov rcx, [rax + 8]");
    汇编("mov [rbp - 48], rcx");
    汇编("mov rax, [rbp - 112]");
    汇编("mov rax, [rax]");
    汇编("mov [rbp - 56], rax");
    汇编("xor r9d, r9d");
    汇编(".si_join:");
    汇编("mov rax, [rbp - 48]");
    汇编("cmp r9, rax");
    汇编("jge .si_size");
    汇编("mov rax, [rbp - 56]");
    汇编("mov rcx, [rax + r9*8]");
    汇编("test rcx, rcx");
    汇编("jz .si_next");
    汇编("sub rsp, 32");
    汇编("call atl_to_cstr");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .si_next");
    汇编("mov [rbp - 64], rax");
    汇编("mov rcx, [rbp - 64]");
    汇编("sub rsp, 32");
    汇编("call atl_strlen");
    汇编("add rsp, 32");
    汇编("mov [rbp - 72], rax");
    汇编("; 复制 s 到 out（截断 0x3FFF）");
    汇编("lea rcx, [g_input_prompt]");
    汇编("mov rdx, [rbp - 40]");
    汇编("sub rdx, rcx");
    汇编("mov rax, 0x3FFF");
    汇编("sub rax, rdx");
    汇编("cmp rax, [rbp - 72]");
    汇编("jge .si_room");
    汇编("mov [rbp - 72], rax");
    汇编(".si_room:");
    汇编("mov rcx, [rbp - 40]");
    汇编("mov rdx, [rbp - 64]");
    汇编("mov r8, [rbp - 72]");
    汇编("sub rsp, 32");
    汇编("call atl_memcpy");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 40]");
    汇编("mov rcx, [rbp - 72]");
    汇编("add rax, rcx");
    汇编("mov [rbp - 40], rax");
    汇编("mov byte [rax], 0");
    汇编(".si_next:");
    汇编("inc r9");
    汇编("jmp .si_join");
    汇编(".si_size:");
    汇编("; 2. 默认尺寸");
    汇编("mov rax, [rbp - 16]");
    汇编("test rax, rax");
    汇编("jg .si_wok");
    汇编("mov rax, 400");
    汇编("mov [rbp - 16], rax");
    汇编(".si_wok:");
    汇编("mov rax, [rbp - 24]");
    汇编("test rax, rax");
    汇编("jg .si_hok");
    汇编("mov rax, 200");
    汇编("mov [rbp - 24], rax");
    汇编(".si_hok:");
    汇编("; 获取 hInstance(GetModuleHandle(NULL))——系统类(STATIC/EDIT/BUTTON)与");
    汇编("; RegisterClassExA 都要求有效实例句柄, 0 会导致创建失败 err=1407(找不到类)");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call GetModuleHandleA");
    汇编("add rsp, 32");
    汇编("mov [rbp - 128], rax");
    汇编("; 3. 注册窗口类（一次）");
    汇编("mov eax, [g_input_cls_reg]");
    汇编("test eax, eax");
    汇编("jnz .si_reg_done");
    汇编("lea rax, [g_input_wc]");
    汇编("mov [rbp - 80], rax");
    汇编("mov rcx, rax");
    汇编("xor edx, edx");
    汇编("mov r8, 96");
    汇编("sub rsp, 32");
    汇编("call atl_memset");
    汇编("add rsp, 32");
    汇编("mov rax, [rbp - 80]");
    汇编("mov dword [rax], 80");
    汇编("lea rcx, [atl_input_wndproc]");
    汇编("mov [rax + 8], rcx");
    汇编("mov rcx, [rbp - 128]");
    汇编("mov [rax + 24], rcx");
    汇编("mov qword [rax + 48], 6");
    汇编("lea rcx, [rt_input_cls]");
    汇编("mov [rax + 64], rcx");
    汇编("mov rcx, [rbp - 80]");
    汇编("sub rsp, 32");
    汇编("call RegisterClassExA");
    汇编("add rsp, 32");
    汇编("mov dword [g_input_cls_reg], 1");
    汇编(".si_reg_done:");
    汇编("; 4. 重置状态");
    汇编("mov dword [g_input_done], 0");
    汇编("mov byte [g_input_buf], 0");
    汇编("mov qword [g_input_edit], 0");
    汇编("mov qword [g_input_dlg], 0");
    汇编("; 5. CreateWindowExA 主窗口");
    汇编("xor ecx, ecx");
    汇编("lea rdx, [rt_input_cls]");
    汇编("lea r8, [rt_input_title]");
    汇编("mov r9, 0xD0CF0000");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 0x80000000");
    汇编("mov qword [rsp + 40], 0x80000000");
    汇编("mov rax, [rbp - 16]");
    汇编("mov [rsp + 48], rax");
    汇编("mov rax, [rbp - 24]");
    汇编("mov [rsp + 56], rax");
    汇编("mov qword [rsp + 64], 0");
    汇编("mov qword [rsp + 72], 0");
    汇编("mov rax, [rbp - 128]");
    汇编("mov [rsp + 80], rax");
    汇编("mov qword [rsp + 88], 0");
    汇编("; shadow 已前移(见上方)")
    汇编("call CreateWindowExA");
    汇编("add rsp, 32");
    汇编("mov [rbp - 88], rax");
    汇编("mov [g_input_dlg], rax");
    汇编("test rax, rax");
    汇编("jz .si_done");
    汇编("; 静态控件 + Edit + 按钮（CreateWindowExA/ANSI 类名——W 版系统类 1407, A 版正常）");
    汇编("xor ecx, ecx");
    汇编("lea rdx, [rt_a_static]");
    汇编("lea r8, [rt_wstr_empty]");
    汇编("mov r9, 0x50000000");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 10");
    汇编("mov qword [rsp + 40], 10");
    汇编("mov rax, [rbp - 16]");
    汇编("sub rax, 40");
    汇编("mov [rsp + 48], rax");
    汇编("mov qword [rsp + 56], 30");
    汇编("mov rax, [rbp - 88]");
    汇编("mov [rsp + 64], rax");
    汇编("mov qword [rsp + 72], 0");
    汇编("mov rax, [rbp - 128]");
    汇编("mov [rsp + 80], rax");
    汇编("mov qword [rsp + 88], 0");
    汇编("; shadow 已前移(见上方)")
    汇编("call CreateWindowExA");
    汇编("add rsp, 32");
    汇编("mov [rbp - 96], rax");
    汇编("; 提示文本");
    汇编("lea rcx, [g_input_prompt]");
    汇编("mov al, [rcx]");
    汇编("test al, al");
    汇编("jz .si_edit");
    汇编("lea rcx, [g_input_prompt]");
    汇编("sub rsp, 32");
    汇编("call rt_utf8_to_wstr");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .si_edit");
    汇编("mov [rbp - 104], rax");
    汇编("mov rcx, [rbp - 96]");
    汇编("mov rdx, rax");
    汇编("sub rsp, 32");
    汇编("call SetWindowTextW");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 104]");
    汇编("sub rsp, 32");
    汇编("call atl_free");
    汇编("add rsp, 32");
    汇编(".si_edit:");
    汇编("; Edit 控件");
    汇编("mov rcx, 0x200");
    汇编("lea rdx, [rt_a_edit]");
    汇编("lea r8, [rt_wstr_empty]");
    汇编("mov r9, 0x50000080");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 10");
    汇编("mov qword [rsp + 40], 50");
    汇编("mov rax, [rbp - 16]");
    汇编("sub rax, 40");
    汇编("mov [rsp + 48], rax");
    汇编("mov qword [rsp + 56], 24");
    汇编("mov rax, [rbp - 88]");
    汇编("mov [rsp + 64], rax");
    汇编("mov qword [rsp + 72], 1001");
    汇编("mov rax, [rbp - 128]");
    汇编("mov [rsp + 80], rax");
    汇编("mov qword [rsp + 88], 0");
    汇编("; shadow 已前移(见上方)")
    汇编("call CreateWindowExA");
    汇编("add rsp, 32");
    汇编("mov [g_input_edit], rax");
    汇编("; 确定按钮");
    汇编("xor ecx, ecx");
    汇编("lea rdx, [rt_a_button]");
    汇编("lea r8, [rt_wstr_empty]");
    汇编("mov r9, 0x50000001");
    汇编("mov rax, [rbp - 16]");
    汇编("sar rax, 1");
    汇编("sub rax, 40");
    汇编("sub rsp, 32");
    汇编("mov [rsp + 32], rax");
    汇编("mov qword [rsp + 40], 90");
    汇编("mov qword [rsp + 48], 80");
    汇编("mov qword [rsp + 56], 28");
    汇编("mov rax, [rbp - 88]");
    汇编("mov [rsp + 64], rax");
    汇编("mov qword [rsp + 72], 1002");
    汇编("mov rax, [rbp - 128]");
    汇编("mov [rsp + 80], rax");
    汇编("mov qword [rsp + 88], 0");
    汇编("; shadow 已前移(见上方)")
    汇编("call CreateWindowExA");
    汇编("add rsp, 32");
    汇编("; 按钮文本 确定");
    汇编("mov rdx, rax");
    汇编("mov rcx, rdx");
    汇编("lea rdx, [rt_wstr_ok]");
    汇编("sub rsp, 32");
    汇编("call SetWindowTextW");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 88]");
    汇编("mov rdx, 5");
    汇编("sub rsp, 32");
    汇编("call ShowWindow");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 88]");
    汇编("sub rsp, 32");
    汇编("call UpdateWindow");
    汇编("add rsp, 32");
    汇编("; 7. 消息循环——PeekMessage 轮询 + g_input_done 优先检查");
    汇编("; 原 GetMessageA 阻塞: 确定点击 DestroyWindow 后队列可能空 → GetMessageA 挂起,");
    汇编("; 程序卡住直到下一条鼠标/键盘消息才退出(用户观察到的等待现象真因)");
    汇编(".si_msg:");
    汇编("mov eax, [g_input_done]");
    汇编("test eax, eax");
    汇编("jnz .si_done");
    汇编("lea rcx, [rbp - 0x2000]");
    汇编("sub rcx, 32");
    汇编("xor edx, edx");
    汇编("xor r8d, r8d");
    汇编("xor r9d, r9d");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 1");
    汇编("call PeekMessageA");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .si_idle");
    汇编("; IsDialogMessageA(hwnd, &msg)");
    汇编("mov rcx, [rbp - 88]");
    汇编("lea rdx, [rbp - 0x2000]");
    汇编("sub rdx, 32");
    汇编("sub rsp, 32");
    汇编("call IsDialogMessageA");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jnz .si_msg");
    汇编("lea rcx, [rbp - 0x2000 - 32]");
    汇编("sub rsp, 32");
    汇编("call TranslateMessage");
    汇编("add rsp, 32");
    汇编("lea rcx, [rbp - 0x2000 - 32]");
    汇编("sub rsp, 32");
    汇编("call DispatchMessageA");
    汇编("add rsp, 32");
    汇编("jmp .si_msg");
    汇编(".si_idle:");
    汇编("mov rcx, 10");
    汇编("sub rsp, 32");
    汇编("call atl_sleep_ms");
    汇编("add rsp, 32");
    汇编("jmp .si_msg");
    汇编(".si_done:");
    汇编("lea rcx, [g_input_buf]");
    汇编("sub rsp, 32");
    汇编("call atl_str");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    返回值 0;
};

