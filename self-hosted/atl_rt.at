    汇编("global atl_lt");
    汇编("atl_lt:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 48");
    汇编("mov [rbp - 8], rcx");
    汇编("mov [rbp - 16], rdx");
    汇编("test rcx, rcx");
    汇编("jnz .lt_a_ok");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov [rbp - 8], rax");
    汇编("mov rcx, rax");
    汇编(".lt_a_ok:");
    汇编("mov rdx, [rbp - 16]");
    汇编("test rdx, rdx");
    汇编("jnz .lt_b_ok");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov [rbp - 16], rax");
    汇编("mov rdx, rax");
    汇编("mov rcx, [rbp - 8]");
    汇编(".lt_b_ok:");
    汇编("; ---- 整数快路径(前移: 免 to_int 链) ----");
    汇编("mov eax, [rcx]");
    汇编("sub eax, 1");
    汇编("jz .lt_i_a");
    汇编("sub eax, 1");
