    汇编("mov [rbp - 16], rdx");
    汇编("mov rcx, 6");
    汇编("mov rdx, [rbp - 8]");
    汇编("sub rsp, 32");
    汇编("call atl_pool_alloc");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 16]");
    汇编("mov [rax + 16], rcx");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_deref_set");
    汇编("atl_deref_set:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("test rcx, rcx");
    汇编("jz .ds_bad");
    汇编("mov eax, [rcx]");
    汇编("sub eax, 8");
    汇编("jnz .ds_bad");
    汇编("mov rax, [rcx + 8]");
    汇编("test rax, rax");
    汇编("jz .ds_bad");
    汇编("mov rax, [rax]");
    汇编("mov [rax], rdx");
    汇编("mov rax, rdx");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".ds_bad:");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_instance_get");
    汇编("atl_instance_get:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("call rt_inst_data");
    汇编("test rax, rax");
    汇编("jz .ig_bad");
    汇编("cmp rdx, [rax + 16]");
    汇编("jae .ig_bad");
    汇编("mov rax, [rax + 8]");
    汇编("mov rax, [rax + rdx * 8]");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".ig_bad:");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编("global atl_instance_set");
    汇编("atl_instance_set:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 48");
    汇编("mov [rbp - 8], r8");
    汇编("call rt_inst_data");
    汇编("test rax, rax");
    汇编("jz .is_bad");
    汇编("cmp rdx, [rax + 16]");
    汇编("jae .is_bad");
    汇编("mov rax, [rax + 8]");
    汇编("mov rcx, [rbp - 8]");
    汇编("mov [rax + rdx * 8], rcx");
    汇编("mov rax, rcx");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");
    汇编(".is_bad:");
    汇编("xor ecx, ecx");
    汇编("sub rsp, 32");
    汇编("call atl_null");
    汇编("add rsp, 32");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
