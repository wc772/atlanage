    汇编("sub rsp, 32");
    汇编("call atl_free");
    汇编("add rsp, 32");
    汇编(".wl_clear:");
    汇编("mov rax, [rbp - 16]");
    汇编("mov qword [rax + 40], 0");
    汇编("mov qword [rax + 536], 0");
    汇编("mov qword [rax + 544], 0");
    汇编("jmp .wl_loop");

    汇编("global timer_loop");
    汇编("timer_loop:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编(".tl_loop:");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call EnterCriticalSection");
    汇编("add rsp, 32");
    汇编(".tl_wait:");
    汇编("mov rax, [g_timer_head]");
    汇编("test rax, rax");
    汇编("jnz .tl_have");
    汇编("lea rcx, [g_timer_cv]");
    汇编("lea rdx, [g_sched_cs]");
    汇编("mov r8, -1");
    汇编("sub rsp, 32");
    汇编("call SleepConditionVariableCS");
    汇编("add rsp, 32");
    汇编("jmp .tl_wait");
    汇编(".tl_have:");
    汇编("mov [rbp - 8], rax");
    汇编("sub rsp, 32");
    汇编("call GetTickCount64");
    汇编("add rsp, 32");
    汇编("mov [rbp - 16], rax");
    汇编("mov rax, [rbp - 8]");
    汇编("mov rcx, [rax + 96]");
    汇编("cmp rcx, [rbp - 16]");
    汇编("jg .tl_sleep");
    汇编("mov rax, [rbp - 8]");
    汇编("mov rcx, [rax + 88]");
    汇编("mov [g_timer_head], rcx");
    汇编("mov qword [rax + 88], 0");
    汇编("mov rcx, [rbp - 8]");
    汇编("sub rsp, 32");
    汇编("call rt_push_ready");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("jmp .tl_loop");
    汇编(".tl_sleep:");
    汇编("mov rax, [rbp - 8]");
    汇编("mov rcx, [rax + 96]");
    汇编("mov rdx, [rbp - 16]");
    汇编("sub rcx, rdx");
    汇编("cmp rcx, 60000");
    汇编("jle .tl_ok");
    汇编("mov rcx, 60000");
    汇编(".tl_ok:");
    汇编("lea rdx, [g_sched_cs]");
    汇编("lea r8, [g_timer_cv]");
    汇编("mov r9, rcx");
    汇编("mov rcx, r8");
    汇编("mov r8, r9");
    汇编("sub rsp, 32");
    汇编("call SleepConditionVariableCS");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call LeaveCriticalSection");
    汇编("add rsp, 32");
    汇编("jmp .tl_loop");

    汇编("global atl_sched_init");
    汇编("atl_sched_init:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("; 2026-08-10 timeBeginPeriod(1): 系统定时器分辨率 15.6ms → 1ms");
    汇编("; （timer 线程/主线程 Sleep 粒度, 200×1ms 并行 15ms→~2ms, 对等玄铁）");
    汇编("mov ecx, 1");
    汇编("sub rsp, 32");
    汇编("call timeBeginPeriod");
    汇编("add rsp, 32");
    汇编("; 缓存主线程栈底/顶（atl_stack_guard 用——每函数入口反复调 GetCurrentThreadStackLimits");
    汇编("; 会破坏网络链路(22_包与模块崩), 此处查一次即可: 主线程栈生命周期内不变）");
    汇编("lea rcx, [rt_thr_lo]");
    汇编("lea rdx, [rt_thr_hi]");
    汇编("sub rsp, 32");
    汇编("call GetCurrentThreadStackLimits");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_sched_cs]");
    汇编("sub rsp, 32");
    汇编("call InitializeCriticalSection");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_ready_cv]");
    汇编("sub rsp, 32");
    汇编("call InitializeConditionVariable");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_main_cv]");
    汇编("sub rsp, 32");
    汇编("call InitializeConditionVariable");
    汇编("add rsp, 32");
    汇编("lea rcx, [g_timer_cv]");
    汇编("sub rsp, 32");
    汇编("call InitializeConditionVariable");
    汇编("add rsp, 32");
    汇编("sub rsp, 32");
    汇编("call TlsAlloc");
    汇编("add rsp, 32");
    汇编("mov [g_tls_slot], eax");
    汇编("lea rax, [g_main_card_buf]");
    汇编("mov [g_main_card], rax");
    汇编("mov qword [rax], 12");
    汇编("mov qword [rax + 32], 0");
    汇编("mov qword [rax + 56], 0");
    汇编("mov qword [rax + 48], 0");
    汇编("mov qword [rax + 40], 0");
    汇编("sub rsp, 32");
    汇编("lea rcx, [g_sysinfo]");
    汇编("call GetSystemInfo");
    汇编("add rsp, 32");
    汇编("lea rax, [g_sysinfo]");
    汇编("mov eax, [rax + 32]");
    汇编("test eax, eax");
    汇编("jle .si_n1");
    汇编("jmp .si_have_n");
    汇编(".si_n1:");
    汇编("mov eax, 1");
    汇编(".si_have_n:");
    汇编("cmp eax, 64");
    汇编("jle .si_ok");
    汇编("mov eax, 64");
    汇编(".si_ok:");
    汇编("mov [g_nworkers], eax");
    汇编("; 定时器线程");
    汇编("xor ecx, ecx");
    汇编("xor edx, edx");
    汇编("lea r8, [timer_loop]");
    汇编("xor r9, r9");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 0");
    汇编("mov qword [rsp + 40], 0");
    汇编("call CreateThread");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .si_workers");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call CloseHandle");
    汇编("add rsp, 32");
    汇编(".si_workers:");
    汇编("mov dword [rbp - 28], 0");
    汇编(".si_wloop:");
    汇编("mov eax, [rbp - 28]");
    汇编("cmp eax, [g_nworkers]");
    汇编("jge .si_done");
    汇编("mov eax, 424");
    汇编("mov ecx, [rbp - 28]");
    汇编("imul ecx, eax");
    汇编("lea rax, [g_worker_slots]");
    汇编("add rax, rcx");
    汇编("mov [rbp - 24], rax");
    汇编("xor ecx, ecx");
    汇编("xor edx, edx");
    汇编("lea r8, [worker_loop]");
    汇编("mov r9, [rbp - 24]");
    汇编("sub rsp, 32");
    汇编("mov qword [rsp + 32], 0");
    汇编("mov qword [rsp + 40], 0");
    汇编("call CreateThread");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .si_next");
    汇编("mov rcx, rax");
    汇编("sub rsp, 32");
    汇编("call CloseHandle");
    汇编("add rsp, 32");
    汇编(".si_next:");
    汇编("mov eax, [rbp - 28]");
    汇编("inc eax");
    汇编("mov [rbp - 28], eax");
    汇编("jmp .si_wloop");
    汇编(".si_done:");
    汇编("mov rsp, rbp");
    汇编("pop rbp");
    汇编("ret");

    汇编("global rt_switch");
    汇编("global rt_task_done");
    汇编("rt_switch:");
    汇编("mov [rcx + 0*8],  rax");
    汇编("mov [rcx + 1*8],  rbx");
    汇编("mov [rcx + 2*8],  rcx");
    汇编("mov [rcx + 3*8],  rdx");
    汇编("mov [rcx + 4*8],  rsi");
    汇编("mov [rcx + 5*8],  rdi");
    汇编("mov [rcx + 6*8],  rbp");
    汇编("mov [rcx + 7*8],  r8");
    汇编("mov [rcx + 8*8],  r9");
    汇编("mov [rcx + 9*8],  r10");
    汇编("mov [rcx + 10*8], r11");
    汇编("mov [rcx + 11*8], r12");
    汇编("mov [rcx + 12*8], r13");
    汇编("mov [rcx + 13*8], r14");
    汇编("mov [rcx + 14*8], r15");
    汇编("lea rax, [rsp + 8]");
    汇编("mov [rcx + 120], rax");
    汇编("mov rax, [rsp]");
    汇编("mov [rcx + 128], rax");
    汇编("movups [rcx + 144 + 0*16],  xmm0");
    汇编("movups [rcx + 144 + 1*16],  xmm1");
    汇编("movups [rcx + 144 + 2*16],  xmm2");
    汇编("movups [rcx + 144 + 3*16],  xmm3");
    汇编("movups [rcx + 144 + 4*16],  xmm4");
    汇编("movups [rcx + 144 + 5*16],  xmm5");
    汇编("movups [rcx + 144 + 6*16],  xmm6");
    汇编("movups [rcx + 144 + 7*16],  xmm7");
    汇编("movups [rcx + 144 + 8*16],  xmm8");
    汇编("movups [rcx + 144 + 9*16],  xmm9");
    汇编("movups [rcx + 144 + 10*16], xmm10");
    汇编("movups [rcx + 144 + 11*16], xmm11");
    汇编("movups [rcx + 144 + 12*16], xmm12");
    汇编("movups [rcx + 144 + 13*16], xmm13");
    汇编("movups [rcx + 144 + 14*16], xmm14");
    汇编("movups [rcx + 144 + 15*16], xmm15");
    汇编("stmxcsr [rcx + 400]");
    汇编("mov rax, [rdx + 120]    ; 目标 rsp");
    汇编("mov rsp, rax");
    汇编("mov rax, [rdx + 128]    ; 目标返回地址");
    汇编("push rax                ; 压入返回地址, 随后 ret 跳转");
    汇编("mov rbx, [rdx + 1*8]");
    汇编("mov rsi, [rdx + 4*8]");
    汇编("mov rdi, [rdx + 5*8]");
    汇编("mov rbp, [rdx + 6*8]");
    汇编("mov r8,  [rdx + 7*8]");
    汇编("mov r9,  [rdx + 8*8]");
    汇编("mov r10, [rdx + 9*8]");
    汇编("mov r11, [rdx + 10*8]");
    汇编("mov r12, [rdx + 11*8]");
    汇编("mov r13, [rdx + 12*8]");
    汇编("mov r14, [rdx + 13*8]");
    汇编("mov r15, [rdx + 14*8]");
    汇编("movups xmm0,  [rdx + 144 + 0*16]");
    汇编("movups xmm1,  [rdx + 144 + 1*16]");
    汇编("movups xmm2,  [rdx + 144 + 2*16]");
    汇编("movups xmm3,  [rdx + 144 + 3*16]");
    汇编("movups xmm4,  [rdx + 144 + 4*16]");
    汇编("movups xmm5,  [rdx + 144 + 5*16]");
    汇编("movups xmm6,  [rdx + 144 + 6*16]");
    汇编("movups xmm7,  [rdx + 144 + 7*16]");
    汇编("movups xmm8,  [rdx + 144 + 8*16]");
    汇编("movups xmm9,  [rdx + 144 + 9*16]");
    汇编("movups xmm10, [rdx + 144 + 10*16]");
    汇编("movups xmm11, [rdx + 144 + 11*16]");
    汇编("movups xmm12, [rdx + 144 + 12*16]");
    汇编("movups xmm13, [rdx + 144 + 13*16]");
    汇编("movups xmm14, [rdx + 144 + 14*16]");
    汇编("movups xmm15, [rdx + 144 + 15*16]");
    汇编("ldmxcsr [rdx + 400]");
    汇编("mov rax, [rdx + 0*8]");
    汇编("mov rcx, [rdx + 2*8]");
    汇编("mov rdx, [rdx + 3*8]");
    汇编("ret");
    汇编("rt_task_done:");
    汇编("mov [rsp - 8], rax          ; 暂存 result（任务栈顶槽, 任务已结束, 安全）");
    汇编("mov ecx, [rel g_tls_slot]");
    汇编("sub rsp, 32                 ; 入口 rsp ≡ 0 → sub 32(≡0) → call 前 ≡ 0 ✓");
    汇编("call TlsGetValue            ; rax = 当前工人槽");
    汇编("add rsp, 32");
    汇编("mov [rsp - 16], rax         ; 暂存工人槽");
    汇编("mov rcx, [rax + 416]        ; 卡指针（工人槽.cur_card）");
    汇编("mov rdx, [rsp - 8]          ; 取回 result");
    汇编("mov [rcx + 24], rdx         ; 存 result");
    汇编("sub rsp, 32");
    汇编("call rt_task_complete");
    汇编("add rsp, 32");
    汇编("mov rdx, [rsp - 16]         ; 工人槽（to_ctx, Context@0）");
    汇编("mov rcx, [rdx + 416]        ; 卡");
    汇编("add rcx, 112                ; from_ctx = 卡 + 112");
    汇编("sub rsp, 8                  ; ⚠️ rsp 收回栈内——任务 ret 后 rsp=top 越界 8B, rt_switch 保存段读 [rsp] 会崩");
    汇编("jmp rt_switch");
    汇编("global atl_sleep_ms");
    汇编("atl_sleep_ms:");
    汇编("push rbp");
    汇编("mov rbp, rsp");
    汇编("sub rsp, 64");
    汇编("mov [rbp - 8], rcx");
    汇编("cmp rcx, 0");
    汇编("jle .sm_done");
    汇编("sub rsp, 32");
    汇编("call rt_cur_card");
    汇编("add rsp, 32");
    汇编("test rax, rax");
    汇编("jz .sm_main");
    汇编("mov [rbp - 16], rax");
    汇编("sub rsp, 32");
    汇编("call GetTickCount64");
    汇编("add rsp, 32");
    汇编("mov rcx, [rbp - 8]");
    汇编("add rax, rcx");
