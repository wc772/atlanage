设 TOK_DECLARE = 22;
设 TOK_FUNC = 23;
设 TOK_CLASS = 24;
设 TOK_EXTENDS = 25;
设 TOK_CREATE = 26;
设 TOK_PUBLIC = 27;
设 TOK_PRIVATE = 28;
设 TOK_PROTECTED = 29;
