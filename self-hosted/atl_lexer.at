设 TOK_EOF = 0;
设 TOK_INT = 1;
设 TOK_FLOAT = 2;
设 TOK_STRING = 3;
设 TOK_IDENT = 4;

设 TOK_SET = 10;
设 TOK_EXIST = 11;
设 TOK_IF = 12;
设 TOK_ELIF = 13;
设 TOK_ELSE = 14;
设 TOK_SELECT = 15;
设 TOK_CASE = 16;
