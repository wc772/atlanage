设 TOK_ARRAY = 31;
设 TOK_GROUP = 32;
设 TOK_PACKAGE = 33;
设 TOK_CTOR = 34;
设 TOK_HOOK = 35;
设 TOK_ASM = 36;
设 TOK_SHOW = 37;
