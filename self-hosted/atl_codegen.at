        如果(tsm == 空){
            设 tfi = 0;
            循环(tfi < g_sem_funcs.长度()){
                创建 SemMethod:tm3;
                tm3 = g_sem_funcs.获取(tfi);
                如果(tm3.id == s.target_id){ tsm = tm3; 跳出; };
                tfi = tfi + 1;
            };
        };
        如果(tsm == 空){
            设 thi = 0;
            循环(thi < g_sem_hooks.长度()){
