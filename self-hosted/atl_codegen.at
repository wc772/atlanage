        如果(s.modcall_id == MC_GPU_MEM_PUTS){ fn = "atl_gpu_mem_puts"; };

        如果(s.modcall_id == MC_VK_LOAD){ fn = "atl_vk_load"; };
        如果(s.modcall_id == MC_VK_VERSION){ fn = "atl_vk_version"; };
        如果(s.modcall_id == MC_VK_GETPROC){ fn = "atl_vk_getproc"; };
        如果(s.modcall_id == MC_VK_GETPROC_LDR){ fn = "atl_vk_getproc_ldr"; };
        如果(s.modcall_id == MC_VK_MODULE_HANDLE){ fn = "atl_vk_module_handle"; };
        如果(s.modcall_id == MC_VK_CALL){ fn = "atl_vk_call"; };
        如果(s.modcall_id == MC_VK_CALL_RAW){ fn = "atl_vk_call_raw"; };
        如果(s.modcall_id == MC_VK_CALL_ADDR){ fn = "atl_vk_call_addr"; };
        如果(s.modcall_id == MC_VK_WIN_CREATE){ fn = "atl_vk_window_create"; };
        如果(s.modcall_id == MC_VK_WIN_CLOSE){ fn = "atl_vk_window_close"; };
        如果(s.modcall_id == MC_VK_WIN_SHOW){ fn = "atl_vk_window_show"; };
        如果(s.modcall_id == MC_VK_POLL){ fn = "atl_vk_poll"; };
        如果(s.modcall_id == MC_STR_FROM_MEM){ fn = "atl_str_from_mem"; };
        如果(s.modcall_id == MC_GL_TEXT_DRAW){ fn = "atl_gl_text_draw"; };
        如果(s.modcall_id == MC_GL_SET_CURRENT){ fn = "atl_gl_set_current"; };
        如果(s.modcall_id == MC_GL_SET_VSYNC){ fn = "atl_gl_set_vsync"; };
        如果(s.modcall_id == MC_GL_PRESENT_GDI){ fn = "atl_gl_present_gdi"; };
        如果(s.modcall_id == MC_STR_CONTAINS){ fn = "atl_contains"; };
        如果(s.modcall_id == MC_GL_WIN_SIZE){ fn = "atl_gl_window_size"; };
        如果(s.modcall_id == MC_GL_MSG_PUMP){ fn = "atl_gl_msg_pump"; };
        如果(s.modcall_id == MC_GL_EVENT_TAKE){ fn = "atl_gl_event_take"; };

        如果(s.modcall_id == MC_INPUT_KEY_DOWN){ fn = "atl_input_key_down"; };
        如果(s.modcall_id == MC_INPUT_KEY_PRESSED){ fn = "atl_input_key_pressed"; };
        如果(s.modcall_id == MC_INPUT_MOUSE_POS){ fn = "atl_input_mouse_pos"; };
        如果(s.modcall_id == MC_INPUT_MOUSE_BUTTON){ fn = "atl_input_mouse_button"; };
        如果(s.modcall_id == MC_INPUT_SYNC){ fn = "atl_input_sync"; };
        设 nslots = slots.长度();
        如果(fn != 空){

            如果(s.modcall_id == MC_SYS_CALL || s.modcall_id == MC_GL_CALL || s.modcall_id == MC_GL_CALL_RAW ||
               s.modcall_id == MC_VK_CALL || s.modcall_id == MC_VK_CALL_RAW || s.modcall_id == MC_VK_CALL_ADDR){
                设 want = 7;
                如果(s.modcall_id == MC_GL_CALL || s.modcall_id == MC_VK_CALL || s.modcall_id == MC_VK_CALL_ADDR){ want = 13; };
                如果(s.modcall_id == MC_GL_CALL_RAW || s.modcall_id == MC_VK_CALL_RAW){ want = 14; };
                设 have = nslots;
                设 stack_args = 0;
                如果(want > 4){ stack_args = want - 4; };
                设 total = align16(32 + stack_args * 8);
                emit("    sub rsp, " + total);
                设 si = 4;
                循环(si < want){
                    如果(si < have){
                        emit("    mov rax, [rbp + " + slots.获取(si) + "]");
                    }否则{
                        emit("    xor rax, rax  ; pad arg");
                    };
                    emit("    mov [rsp + " + (32 + (si - 4) * 8) + "], rax");
                    si = si + 1;
                };
                设 ri = 0;
                循环(ri < want && ri < 4){
                    如果(ri < have){
                        emit("    mov " + reg_name(ri) + ", [rbp + " + slots.获取(ri) + "]");
                    }否则{
                        emit("    xor " + reg_name(ri) + ", " + reg_name(ri) + "  ; pad arg");
                    };
                    ri = ri + 1;
                };
                设 ri2 = want;
                循环(ri2 < 4){
                    emit("    xor " + reg_name(ri2) + ", " + reg_name(ri2) + "  ; unused arg = NULL");
                    ri2 = ri2 + 1;
                };
                emit("    call " + fn);
                emit("    add rsp, " + total);
            }又如果(s.modcall_id == MC_MATH_AVG || s.modcall_id == MC_MATH_MAX || s.modcall_id == MC_MATH_MIN ||
               s.modcall_id == MC_PROC_CREATE){
                emit("    sub rsp, 32");
                emit("    call atl_list_new");
                emit("    add rsp, 32");
                设 t_vl = temp_alloc(ctx);
                emit("    mov [rbp + " + t_vl + "], rax  ; args list");
                设 pack_first = 0;
                如果(s.modcall_id == MC_PROC_CREATE){ pack_first = 1; };
                设 vi = pack_first;
                循环(vi < nslots){
                    emit("    mov rdx, [rbp + " + slots.获取(vi) + "]  ; arg " + vi);
                    emit("    mov rcx, [rbp + " + t_vl + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_add");
                    emit("    add rsp, 32");
                    vi = vi + 1;
                };
                如果(s.modcall_id == MC_PROC_CREATE){
                    emit("    mov rcx, [rbp + " + slots.获取(0) + "]  ; fn name");
                    emit("    mov rdx, [rbp + " + t_vl + "]  ; args list");
                }否则{
                    emit("    mov rcx, [rbp + " + t_vl + "]");
                };
                emit("    sub rsp, 32");
                emit("    call " + fn);
                emit("    add rsp, 32");
                temp_free(ctx, 1);
                设 nslots2 = 0;
            }否则{
                gen_pos_call(ctx, fn, nslots, slots, 0);
            };
        }否则{
            emit("    xor rax, rax  ; modcall not implemented: " + s.modcall_id);
        };

        如果(n.block_arg != 空){
            设 saved_ret = temp_alloc(ctx);
