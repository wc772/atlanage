        设 i = 0;
        循环(i < nslots){
            temp_free(ctx, 1);
            i = i + 1;
        };
        返回值 0;
    };

    如果(s == 空){
        emit("    xor rax, rax  ; call no sem");
        返回值 0;
    };

    设 has_this = 0;
    如果(s.kind == SN_METHOD){
        has_this = 1;
    };
    设 total_args = n_args;
    如果(has_this == 1){
        total_args = total_args + 1;
    };
    创建 ArrayList:slots;
