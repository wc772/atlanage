            emit("    call " + fn);
            emit("    add rsp, " + total);
            temp_free(ctx, 1);
        }否则{
            emit("    xor rax, rax  ; strmethod not implemented: " + s.strmethod_id);
        };
        temp_free(ctx, total_args);
        返回值 0;
    };

    如果(s.kind == SN_LAMBDA){
        emit("    mov rax, [rbp + " + s.offset + "]  ; lambda var");
        emit("    mov rax, [rax + 8]   ; fn_addr");
        设 stack_args = 0;
        如果(n_args > 4){
            stack_args = n_args - 4;
        };
        设 total = align16(32 + stack_args * 8);
        emit("    sub rsp, " + total);
        设 i = 4;
        循环(i < n_args){
            emit("    mov rax, [rbp + " + slots.获取(i) + "]");
            emit("    mov [rsp + " + (32 + (i - 4) * 8) + "], rax");
            i = i + 1;
        };
        设 j = 0;
        循环(j < n_args && j < 4){
            emit("    mov " + reg_name(j) + ", [rbp + " + slots.获取(j) + "]");
            j = j + 1;
        };
        emit("    mov rax, [rbp + " + s.offset + "]  ; lambda var");
        emit("    mov rax, [rax + 8]   ; fn_addr");
        emit("    call rax");
        emit("    add rsp, " + total);
        temp_free(ctx, total_args);
        返回值 0;
    };

    如果(s.kind == SN_RESULT_CHAIN){
        设 rc_obj = 空;
        如果(n.type == AST_METHODCALL){
            rc_obj = n.obj;
        }否则{
            rc_obj = n.callee;
        };
        gen_expr(rc_obj, ctx);
        设 t_obj = temp_alloc(ctx);
        emit("    mov [rbp + " + t_obj + "], rax  ; result obj");
        emit("    mov rax, [rbp + " + t_obj + "]");
        emit("    mov eax, [rax]");
        emit("    cmp eax, 11");
        设 l_skip = new_label();
        设 l_done = new_label();
        emit("    jne __atl_L" + l_skip + "  ; 非结果对象 → 原样返回");
        emit("    mov rax, [rbp + " + t_obj + "]");
        emit("    cmp qword [rax + 8], 0  ; is_success");
        如果(n.method_name == "接着"){

            emit("    je __atl_L" + l_skip);
            emit("    mov rax, [rbp + " + t_obj + "]");
            emit("    mov rcx, [rax + 16]  ; value");
        }否则{

            emit("    jne __atl_L" + l_skip);
            emit("    mov rax, [rbp + " + t_obj + "]");
            emit("    mov rcx, [rax + 24]  ; error");
        };
        emit("    mov rax, [rbp + " + slots.获取(0) + "]  ; callback");
        emit("    mov rax, [rax + 8]   ; fn_addr");
        emit("    sub rsp, 32");
        emit("    call rax");
        emit("    add rsp, 32");
        emit("    jmp __atl_L" + l_done);
        emit("__atl_L" + l_skip + ":");
        emit("    mov rax, [rbp + " + t_obj + "]");
        emit("__atl_L" + l_done + ":");
        temp_free(ctx, 1);
        返回值 0;
    };

    如果(s.kind == SN_DISPATCH){

        创建 ASTNode:obj_node;
        如果(n.type == AST_METHODCALL){
            obj_node = n.obj;
        }否则{
            obj_node = n.callee;
        };

        如果(n.is_null_safe == 1){
            设 l_skip = new_label();
            设 l_end = new_label();
            gen_expr(obj_node, ctx);
            设 t_obj = temp_alloc(ctx);
            emit("    mov [rbp + " + t_obj + "], rax  ; ?. obj");
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_is_null");
            emit("    add rsp, 32");
            emit("    test eax, eax");
            emit("    jnz __atl_L" + l_skip);
            设 mid = -1;
            如果(n.type == AST_METHODCALL && n.method_name != 空){
                mid = add_strlit(n.method_name);
            };
            emit("    sub rsp, 32");
            emit("    call atl_list_new");
            emit("    add rsp, 32");
            设 t_args = temp_alloc(ctx);
            emit("    mov [rbp + " + t_args + "], rax");
            设 i = 0;
            循环(i < n_args){
                emit("    mov rdx, [rbp + " + slots.获取(i) + "]  ; arg " + i);
                emit("    mov rcx, [rbp + " + t_args + "]");
                emit("    sub rsp, 32");
                emit("    call atl_list_add");
                emit("    add rsp, 32");
                i = i + 1;
            };
            emit("    mov r8, [rbp + " + t_args + "]  ; args_list");
            如果(mid >= 0){
                emit("    lea rdx, [__atl_str_" + mid + "_data]  ; method name");
            }否则{
                emit("    xor rdx, rdx");
            };
            emit("    mov rcx, [rbp + " + t_obj + "]  ; obj");
            temp_free(ctx, 2);
            emit("    sub rsp, 32");
            emit("    call atl_method_call");
            emit("    add rsp, 32");
            temp_free(ctx, total_args);
            emit("    jmp __atl_L" + l_end);
            emit("__atl_L" + l_skip + ":");
            emit("    sub rsp, 32");
            emit("    call atl_null");
            emit("    add rsp, 32");
            emit("__atl_L" + l_end + ":");
            返回值 0;
        };
        gen_expr(obj_node, ctx);
        设 t_obj = temp_alloc(ctx);
        emit("    mov [rbp + " + t_obj + "], rax");
        设 mid = -1;
        如果(n.type == AST_METHODCALL && n.method_name != 空){
            mid = add_strlit(n.method_name);
        };

        emit("    sub rsp, 32");
        emit("    call atl_list_new");
        emit("    add rsp, 32");
        设 t_args = temp_alloc(ctx);
        emit("    mov [rbp + " + t_args + "], rax");
        设 i = 0;
        循环(i < n_args){

            emit("    mov rdx, [rbp + " + slots.获取(i) + "]  ; arg " + i);
            emit("    mov rcx, [rbp + " + t_args + "]");
            emit("    sub rsp, 32");
            emit("    call atl_list_add");
            emit("    add rsp, 32");
            i = i + 1;
        };
        emit("    mov r8, [rbp + " + t_args + "]  ; args_list");
        如果(mid >= 0){
            emit("    lea rdx, [__atl_str_" + mid + "_data]  ; method name");
        }否则{
            emit("    xor rdx, rdx");
        };
        emit("    mov rcx, [rbp + " + t_obj + "]  ; obj");
        temp_free(ctx, 2);
        emit("    sub rsp, 32");
        emit("    call atl_method_call");
        emit("    add rsp, 32");
        temp_free(ctx, total_args);
        返回值 0;
    };

    如果(s.kind == SN_METHOD || s.kind == SN_FUNC || s.kind == SN_PKGFUNC){
        创建 SemMethod:target_m;
        target_m = 空;

        设 i = 0;
        循环(i < g_sem_classes.长度()){
            创建 SemClass:cls;
            cls = g_sem_classes.获取(i);
            设 j = 0;
            循环(j < cls.methods.长度()){
                创建 SemMethod:m;
                m = cls.methods.获取(j);
                如果(m.id == s.target_id){
                    target_m = m;
                    跳出;
                };
                j = j + 1;
            };
            如果(target_m != 空){
                跳出;
            };
            i = i + 1;
        };

        如果(target_m == 空){
            设 i = 0;
            循环(i < g_sem_funcs.长度()){
                创建 SemMethod:m;
                m = g_sem_funcs.获取(i);
                如果(m.id == s.target_id){
                    target_m = m;
                    跳出;
                };
                i = i + 1;
            };
        };

        如果(target_m == 空){
            设 i = 0;
            循环(i < g_sem_hooks.长度()){
                创建 SemMethod:m;
                m = g_sem_hooks.获取(i);
                如果(m.id == s.target_id){
                    target_m = m;
                    跳出;
                };
                i = i + 1;
            };
        };
        如果(target_m != 空){
            gen_call_seq(ctx, method_label(target_m), total_args, slots, has_this);
        }否则{
            emit("    xor rax, rax  ; call target not found: kind=" + s.kind + " id=" + s.target_id);
        };

        如果(n.block_arg != 空){
            gen_stmt(n.block_arg, ctx);
        };
        temp_free(ctx, total_args);
        返回值 0;
    };

    emit("    xor rax, rax  ; call unhandled kind " + s.kind);
    temp_free(ctx, total_args);
    返回值 0;
};

声明 gen_find_local(func, name){
    如果(func == 空){ 返回值 空; };
    创建 SemFunc:f;
    f = func;
    设 i = 0;
    循环(i < f.locals.长度()){
        创建 SemLocal:l;
        l = f.locals.获取(i);
        如果(l.name == name){
            返回值 l;
        };
        i = i + 1;
    };
    返回值 空;
};

声明 gen_input_ref_slot(arg, ctx, callee, idx){
    如果(callee == 空){ 返回值 0; };
    创建 SemNode:cs0;
    cs0 = callee;
    如果(cs0.builtin_id != B_INPUT || idx != 1){ 返回值 0; };
    如果(arg == 空){ 返回值 0; };
    创建 ASTNode:a0;
    a0 = arg;
    如果(a0.type != AST_REF){ 返回值 0; };
    如果(a0.operand == 空){ 返回值 0; };
    创建 ASTNode:rop;
    rop = a0.operand;
    如果(rop.type != AST_VAR || rop.sval == 空){ 返回值 0; };
    设 roff = 0;
    设 rglobal = 0;
    设 rfound = 0;
    如果(rop.sem != 空){
        如果(rop.sem.kind == SN_LOCAL){
            roff = rop.sem.offset;
            rfound = 1;
        }又如果(rop.sem.kind == SN_GLOBAL){
            roff = rop.sem.offset;
            rglobal = 1;
            rfound = 1;
        };
    }否则{

        创建 SemLocal:rl;
        rl = gen_find_local(ctx.func, rop.sval);
        如果(rl != 空){
            roff = rl.offset;
            rfound = 1;
        };
    };
    如果(rfound == 0){ 返回值 0; };
    如果(rglobal == 1){
        emit("    lea rax, [" + global_label(roff) + "]  ; &" + rop.sval);
    }否则{
        emit("    lea rax, [rbp + " + roff + "]  ; &" + rop.sval);
    };
    返回值 1;
};

声明 gen_stmt(node, c){
    如果(node == 空){
        返回值 0;
    };
    创建 ASTNode:n;
    n = node;
    创建 Ctx:ctx;
    ctx = c;

    如果(n.type == AST_BLOCK){
        如果(n.children != 空){
            设 i = 0;
            循环(i < n.children.长度()){
                gen_stmt(n.children.获取(i), ctx);
                i = i + 1;
            };
        };
        返回值 0;
    };

    如果(n.type == AST_VARDECL){
        如果(n.var_names != 空){
            设 i = 0;
            循环(i < n.var_names.长度()){
                设 vn = n.var_names.获取(i);
                如果(i < n.var_inits.长度()){
                    创建 ASTNode:init;
                    init = n.var_inits.获取(i);
                    如果(init != 空){

                        创建 SemLocal:l;
                        l = gen_find_local(ctx.func, vn);
                        设 use_raw = 0;
                        如果(l != 空 && l.type_kind == T_INT && init.sem != 空){
                            创建 SemNode:in;
                            in = init.sem;
                            如果(in.type_kind == T_INT){ use_raw = 1; };
                        };
                        设 use_raw_float = 0;
                        如果(l != 空 && l.type_kind == T_FLOAT && init.sem != 空){
                            创建 SemNode:inf;
                            inf = init.sem;
                            如果(inf.type_kind == T_FLOAT){ use_raw_float = 1; };
                        };
                        如果(use_raw == 1){
                            gen_int_value(init, ctx);
                            emit("    mov [rbp + " + l.offset + "], rax  ; var " + vn + " (raw int)");
                        }又如果(use_raw_float == 1){
                            gen_float_value(init, ctx);
                            emit("    movsd [rbp + " + l.offset + "], xmm0  ; var " + vn + " (raw double)");
                        }否则{
                            gen_expr(init, ctx);
                            如果(l != 空){
                                emit("    mov [rbp + " + l.offset + "], rax  ; var " + vn);
                            }又如果(ctx.cls != 空){
                                设 fi = sem_find_field(ctx.cls, vn);
                                如果(fi >= 0){
                                    emit("    mov rdx, rax  ; save val");
                                    emit("    mov rax, [rbp + " + ctx.this_offset + "]  ; this");
                                    emit("    mov rax, [rax + 8]   ; inst");
                                    emit("    mov rax, [rax + 8]   ; field_vals");
                                    emit("    mov [rax + " + (fi * 8) + "], rdx  ; field " + vn);
                                };
                            };
                        };
                    };
                }又如果(n.is_exist == 1){
                    创建 SemLocal:l;
                    l = gen_find_local(ctx.func, vn);
                    如果(l != 空){
                        emit("    sub rsp, 32");
                        emit("    call atl_null");
                        emit("    add rsp, 32");
                        emit("    mov [rbp + " + l.offset + "], rax  ; var " + vn + " exist");
                    };
                };
                i = i + 1;
            };
        };
        返回值 0;
    };

    如果(n.type == AST_ASSIGN){
        设 op = n.op;
        如果(op == TOK_ASSIGN){

            如果(n.lhs != 空 && n.lhs.type == AST_VAR && n.rhs != 空 && n.rhs.type == AST_BINARY &&
               n.rhs.op == TOK_PLUS && n.rhs.lhs != 空 && n.rhs.lhs.type == AST_VAR &&
               n.rhs.lhs.sval == n.lhs.sval && n.rhs.rhs != 空 && n.rhs.rhs.type == AST_LITERAL &&
               n.rhs.rhs.op == LIT_STRING){
                创建 SemLocal:sacc;
                sacc = gen_find_local(ctx.func, n.lhs.sval);
                如果(sacc != 空 && sacc.type_kind != T_INT && sacc.type_kind != T_FLOAT){
                    如果(g_cur_func_body != 空 && str_acc_safe_stmt(g_cur_func_body, n.lhs.sval) == 1){
                        gen_expr(n.rhs.rhs, ctx);
                        emit("    mov rdx, rax  ; suffix");
                        emit("    mov rcx, [rbp + " + sacc.offset + "]  ; s (累加器)");
                        emit("    sub rsp, 32");
                        emit("    call atl_str_append_self");
                        emit("    add rsp, 32");
                        emit("    mov [rbp + " + sacc.offset + "], rax  ; s = 追加后");
                        返回值 0;
                    };
                };
            };

            创建 ASTNode:lhs_node;
            lhs_node = n.lhs;
            如果(lhs_node != 空 && (lhs_node.type == AST_HOOKCALL || lhs_node.type == AST_MODCALL || lhs_node.type == AST_CALL)){
                gen_expr(n.lhs, ctx);

                创建 ASTNode:rhs_node2;
                rhs_node2 = n.rhs;
                创建 SemLocal:rl2;
                rl2 = 空;
                如果(rhs_node2 != 空 && rhs_node2.type == AST_VAR){
                    rl2 = gen_find_local(ctx.func, rhs_node2.sval);
                    如果(rl2 != 空 && rl2.type_kind == T_INT && lhs_node.type != AST_CALL){
                        emit("    mov rcx, rax");
                        emit("    sub rsp, 32");
                        emit("    call atl_toint");
                        emit("    add rsp, 32");
                        emit("    mov rax, [rax + 8]  ; unbox int");
                    };
                };
                gen_store(n.rhs, ctx);
            }否则{

                设 use_raw = 0;
                创建 ASTNode:asgn_lhs;
                asgn_lhs = n.lhs;
                创建 SemLocal:al;
                al = 空;
                如果(asgn_lhs != 空 && asgn_lhs.type == AST_VAR){
                    al = gen_find_local(ctx.func, asgn_lhs.sval);
                    如果(al != 空 && al.type_kind == T_INT && n.rhs != 空 && n.rhs.sem != 空){
                        创建 SemNode:arn;
                        arn = n.rhs.sem;
                        如果(arn.type_kind == T_INT){ use_raw = 1; };
                    };
                };
                设 use_raw_float = 0;
                如果(al != 空 && al.type_kind == T_FLOAT && n.rhs != 空 && n.rhs.sem != 空){
                    创建 SemNode:arnf;
                    arnf = n.rhs.sem;
                    如果(arnf.type_kind == T_FLOAT){ use_raw_float = 1; };
                };
                如果(use_raw_float == 1){
                    gen_float_value(n.rhs, ctx);
                    emit("    movsd [rbp + " + al.offset + "], xmm0  ; " + asgn_lhs.sval + " (raw double)");
                }又如果(use_raw == 1){
                    如果(al.offset == ctx.loop_counter_off){

                        创建 ASTNode:cr;
                        cr = n.rhs;
                        如果(cr.type == AST_BINARY && (cr.op == TOK_PLUS || cr.op == TOK_MINUS) &&
                           cr.rhs != 空 && cr.rhs.type == AST_LITERAL && cr.rhs.op == LIT_INT){
                            如果(cr.op == TOK_PLUS){
                                emit("    add r12, " + cr.rhs.ival + "  ; " + asgn_lhs.sval + " (counter)");
                            }否则{
                                emit("    sub r12, " + cr.rhs.ival + "  ; " + asgn_lhs.sval + " (counter)");
                            };
                            emit("    mov [rbp + " + al.offset + "], r12  ; 保存点");
                            返回值 0;
                        };
                    };
                    gen_int_value(n.rhs, ctx);
                    emit("    mov [rbp + " + al.offset + "], rax  ; " + asgn_lhs.sval + " (raw int)");
                }否则{

                    创建 ASTNode:wrhs;
                    wrhs = n.rhs;
                    如果(wrhs != 空 && wrhs.type == AST_CALL && wrhs.args != 空 &&
                       wrhs.args.长度() == 1 && wrhs.callee != 空 && wrhs.callee.sval == "写入文件"){
                        gen_expr(wrhs.args.获取(0), ctx);
                        设 t_p2 = temp_alloc(ctx);
                        emit("    mov [rbp + " + t_p2 + "], rax  ; 路径");
                        emit("    mov rcx, rax");
                        emit("    sub rsp, 32");
                        emit("    call atl_file_create");
                        emit("    add rsp, 32");
                        设 t_h2 = temp_alloc(ctx);
                        emit("    mov [rbp + " + t_h2 + "], rax  ; 句柄");
                        gen_expr(n.lhs, ctx);
                        emit("    mov rcx, [rbp + " + t_h2 + "]");
                        emit("    mov rdx, rax");
                        emit("    sub rsp, 32");
                        emit("    call atl_file_write");
                        emit("    add rsp, 32");
                        设 t_w2 = temp_alloc(ctx);
                        emit("    mov [rbp + " + t_w2 + "], rax  ; 写入返回值");
                        emit("    mov rcx, [rbp + " + t_h2 + "]");
                        emit("    sub rsp, 32");
                        emit("    call atl_file_close");
                        emit("    add rsp, 32");
                        emit("    mov rax, [rbp + " + t_w2 + "]");
                        temp_free(ctx, 3);
                        gen_store(n.lhs, ctx);
                        返回值 0;
                    };
                    gen_expr(n.rhs, ctx);
                    gen_store(n.lhs, ctx);
                };
            };
        }又如果(op == TOK_PLUSEQ || op == TOK_MINUSEQ){

            设 use_raw = 0;
            创建 ASTNode:plhs;
            plhs = n.lhs;
            创建 SemLocal:pl;
            pl = 空;
            如果(plhs != 空 && plhs.type == AST_VAR){
                pl = gen_find_local(ctx.func, plhs.sval);
                如果(pl != 空 && pl.type_kind == T_INT){ use_raw = 1; };
            };
            如果(use_raw == 1){
                如果(pl.offset == ctx.loop_counter_off && n.rhs != 空 &&
                   n.rhs.type == AST_LITERAL && n.rhs.op == LIT_INT){

                    如果(op == TOK_PLUSEQ){
                        emit("    add r12, " + n.rhs.ival + "  ; " + plhs.sval + " (counter)");
                    }否则{
                        emit("    sub r12, " + n.rhs.ival + "  ; " + plhs.sval + " (counter)");
                    };
                    emit("    mov [rbp + " + pl.offset + "], r12  ; 保存点");
                    返回值 0;
                };
                gen_int_value(n.lhs, ctx);
                gen_int_value(n.rhs, ctx);
                emit("    mov rcx, rax");
                emit("    mov rax, [rbp + " + pl.offset + "]");
                如果(op == TOK_PLUSEQ){
                    emit("    add rax, rcx");
                }否则{
                    emit("    sub rax, rcx");
                };
                emit("    mov [rbp + " + pl.offset + "], rax  ; " + plhs.sval + " (raw int)");
            }否则{
                gen_expr(n.lhs, ctx);
                设 t_lhs = temp_alloc(ctx);
                emit("    mov [rbp + " + t_lhs + "], rax");
                gen_expr(n.rhs, ctx);
                emit("    mov rdx, rax");
                emit("    mov rcx, [rbp + " + t_lhs + "]");
                temp_free(ctx, 1);
                设 fn = "atl_add";
                如果(op == TOK_MINUSEQ){
                    fn = "atl_sub";
                };
                emit("    sub rsp, 32");
                emit("    call " + fn);
                emit("    add rsp, 32");
                gen_store(n.lhs, ctx);
            };
        };
        返回值 0;
    };

    如果(n.type == AST_IF){
        设 l_else = new_label();
        设 l_end = new_label();

        如果(gen_cond_jmp_false(n.cond, ctx, l_else) == 0){
            gen_expr(n.cond, ctx);
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_truthy");
            emit("    add rsp, 32");
            emit("    test eax, eax");
            emit("    jz __atl_L" + l_else);
        };
        gen_stmt(n.then_block, ctx);
        emit("    jmp __atl_L" + l_end);
        emit("__atl_L" + l_else + ":");
        如果(n.else_block != 空){
            gen_stmt(n.else_block, ctx);
        };
        emit("__atl_L" + l_end + ":");
        返回值 0;
    };

    如果(n.type == AST_SELECT){
        设 l_end = new_label();
        如果(n.obj != 空){

            gen_expr(n.obj, ctx);
            设 t_subj = temp_alloc(ctx);
            emit("    mov [rbp + " + t_subj + "], rax");

            创建 ArrayList:sel_ch;
            sel_ch = n.children;
            如果(sel_ch != 空){
                设 i = 0;
                循环(i < sel_ch.长度()){
                    创建 ASTNode:cs;
                    cs = sel_ch.获取(i);
                    设 l_next = new_label();
                    如果(cs.is_default == 1){
                        创建 ArrayList:case_bodies;
                        case_bodies = cs.children;
                        如果(case_bodies != 空){
                            设 j = 0;
                            循环(j < case_bodies.长度()){
                                gen_stmt(case_bodies.获取(j), ctx);
                                j = j + 1;
                            };
                        };
                        emit("    jmp __atl_L" + l_end);
                        跳出;
                    };
                    如果(cs.case_cond != 空 || cs.case_kind == 2 || cs.case_kind == 1 || cs.case_kind == 4){

                        如果(cs.case_kind == 1){
                            创建 ArrayList:case_bodies_w;
                            case_bodies_w = cs.children;
                            如果(case_bodies_w != 空){
                                设 j = 0;
                                循环(j < case_bodies_w.长度()){
                                    gen_stmt(case_bodies_w.获取(j), ctx);
                                    j = j + 1;
                                };
                            };
                            emit("    jmp __atl_L" + l_end);
                            emit("__atl_L" + l_next + ":");
                        }又如果(cs.case_kind == 2){

                            创建 ArrayList:tn_l;
                            tn_l = cs.case_type_names;
                            设 tn_count = 0;
                            如果(tn_l != 空){ tn_count = tn_l.长度(); };
                            设 l_hit = new_label();
                            设 tni = 0;
                            循环(tni < tn_count){
                                设 tname = tn_l.获取(tni);
                                emit("    mov rax, [rbp + " + t_subj + "]");
                                emit("    mov eax, [rax]  ; tag");
                                如果(tname == "整"){
                                    emit("    cmp eax, 2");
                                    emit("    je __atl_L" + l_hit);
                                }又如果(tname == "小数"){
                                    emit("    cmp eax, 3");
                                    emit("    je __atl_L" + l_hit);
                                }又如果(tname == "字"){
                                    emit("    cmp eax, 4");
                                    emit("    je __atl_L" + l_hit);
                                }又如果(tname == "列表"){
                                    emit("    cmp eax, 5");
                                    emit("    je __atl_L" + l_hit);
                                }又如果(tname == "函数"){
                                    emit("    cmp eax, 6");
                                    emit("    je __atl_L" + l_hit);
                                }又如果(tname == "结果"){
                                    emit("    cmp eax, 11");
                                    emit("    je __atl_L" + l_hit);
                                }否则{

                                    设 l_tnskip = new_label();
                                    emit("    cmp eax, 7");
                                    emit("    jne __atl_L" + l_tnskip);
                                    emit("    mov rax, [rbp + " + t_subj + "]");
                                    emit("    mov rax, [rax + 8]  ; inst");
                                    emit("    mov rcx, [rax + 24]  ; cls_name");
                                    设 cid2 = add_strlit(tname);
                                    emit("    lea rdx, [__atl_str_" + cid2 + "_data]");
                                    emit("    sub rsp, 32");
                                    emit("    call atl_strcmp");
                                    emit("    add rsp, 32");
                                    emit("    test eax, eax");
                                    emit("    jz __atl_L" + l_hit);
                                    emit("__atl_L" + l_tnskip + ":");
                                };
                                tni = tni + 1;
                            };
                            emit("    jmp __atl_L" + l_next);
                            emit("__atl_L" + l_hit + ":");
                            创建 ArrayList:case_bodies_t;
                            case_bodies_t = cs.children;
                            如果(case_bodies_t != 空){
                                设 j = 0;
                                循环(j < case_bodies_t.长度()){
                                    gen_stmt(case_bodies_t.获取(j), ctx);
                                    j = j + 1;
                                };
                            };
                            emit("    jmp __atl_L" + l_end);
                            emit("__atl_L" + l_next + ":");
                        }又如果(cs.case_kind == 4){

                            设 l_dskip = new_label();
                            设 l_dhit = new_label();
                            emit("    mov rax, [rbp + " + t_subj + "]");
                            emit("    mov eax, [rax]  ; tag");
                            emit("    cmp eax, 7");
                            emit("    jne __atl_L" + l_dskip);
                            emit("    mov rax, [rbp + " + t_subj + "]");
                            emit("    mov rax, [rax + 8]  ; inst");
                            emit("    mov rcx, [rax + 24]  ; cls_name");
                            设 cid3 = add_strlit(cs.case_destruct_cls);
                            emit("    lea rdx, [__atl_str_" + cid3 + "_data]");
                            emit("    sub rsp, 32");
                            emit("    call atl_strcmp");
                            emit("    add rsp, 32");
                            emit("    test eax, eax");
                            emit("    jnz __atl_L" + l_dskip);
                            emit("__atl_L" + l_dhit + ":");

                            创建 ArrayList:dv_c;
                            dv_c = cs.case_destruct_vars;
                            设 dc = 0;
                            循环(dc < dv_c.长度()){
                                设 dvn_c = dv_c.获取(dc);
                                设 dl2 = sem_find_local(ctx.func, dvn_c);
                                如果(dl2 != 空){
                                    创建 SemLocal:dl3;
                                    dl3 = dl2;
                                    emit("    mov rax, [rbp + " + t_subj + "]");
                                    emit("    mov rax, [rax + 8]  ; inst");
                                    emit("    mov rcx, [rax + 8]  ; field_vals");
                                    emit("    mov rdx, [rcx + " + (dc * 8) + "]  ; field " + dc);
                                    emit("    mov [rbp + " + dl3.offset + "], rdx");
                                };
                                dc = dc + 1;
                            };
                            创建 ArrayList:case_bodies_d;
                            case_bodies_d = cs.children;
                            如果(case_bodies_d != 空){
                                设 j = 0;
                                循环(j < case_bodies_d.长度()){
                                    gen_stmt(case_bodies_d.获取(j), ctx);
                                    j = j + 1;
                                };
                            };
                            emit("    jmp __atl_L" + l_end);
                            emit("__atl_L" + l_dskip + ":");
                        }否则{

                            gen_expr(cs.case_cond, ctx);
                            emit("    mov rdx, rax");
                            emit("    mov rcx, [rbp + " + t_subj + "]");
                            emit("    sub rsp, 32");
                            emit("    call atl_eq");
                            emit("    add rsp, 32");
                            emit("    mov rcx, rax");
                            emit("    sub rsp, 32");
                            emit("    call atl_truthy");
                            emit("    add rsp, 32");
                            emit("    test eax, eax");
                            emit("    jnz __atl_L" + l_next + "_m");

                            如果(cs.case_alt != 空){
                                创建 ArrayList:alt_l;
                                alt_l = cs.case_alt;
                                设 ai = 0;
                                循环(ai < alt_l.长度()){
                                    创建 ASTNode:alt_e;
                                    alt_e = alt_l.获取(ai);
                                    如果(alt_e != 空){
                                        gen_expr(alt_e, ctx);
                                        emit("    mov rdx, rax");
                                        emit("    mov rcx, [rbp + " + t_subj + "]");
                                        emit("    sub rsp, 32");
                                        emit("    call atl_eq");
                                        emit("    add rsp, 32");
                                        emit("    mov rcx, rax");
                                        emit("    sub rsp, 32");
                                        emit("    call atl_truthy");
                                        emit("    add rsp, 32");
                                        emit("    test eax, eax");
                                        emit("    jnz __atl_L" + l_next + "_m");
                                    };
                                    ai = ai + 1;
                                };
                            };
                            emit("    jmp __atl_L" + l_next);
                            emit("__atl_L" + l_next + "_m:");

                            如果(cs.case_kind == 3 && cs.lhs != 空){
                                gen_expr(cs.lhs, ctx);
                                emit("    mov rcx, rax");
                                emit("    sub rsp, 32");
                                emit("    call atl_truthy");
                                emit("    add rsp, 32");
                                emit("    test eax, eax");
                                emit("    jz __atl_L" + l_next);
                            };
                            创建 ArrayList:case_bodies2;
                            case_bodies2 = cs.children;
                            如果(case_bodies2 != 空){
                                设 j = 0;
                                循环(j < case_bodies2.长度()){
                                    gen_stmt(case_bodies2.获取(j), ctx);
                                    j = j + 1;
                                };
                            };
                            emit("    jmp __atl_L" + l_end);
                            emit("__atl_L" + l_next + ":");
                        };
                    };
                    i = i + 1;
                };
            };
            temp_free(ctx, 1);
        }否则{

            创建 ArrayList:sel_ch2;
            sel_ch2 = n.children;
            如果(sel_ch2 != 空){
                设 i = 0;
                循环(i < sel_ch2.长度()){
                    创建 ASTNode:cs;
                    cs = sel_ch2.获取(i);
                    设 l_next = new_label();
                    如果(cs.is_default == 1){
                        创建 ArrayList:case_bodies3;
                        case_bodies3 = cs.children;
                        如果(case_bodies3 != 空){
                            设 j = 0;
                            循环(j < case_bodies3.长度()){
                                gen_stmt(case_bodies3.获取(j), ctx);
                                j = j + 1;
                            };
                        };
                        emit("    jmp __atl_L" + l_end);
                        跳出;
                    };
                    如果(cs.case_cond != 空){
                        gen_expr(cs.case_cond, ctx);
                        emit("    mov rcx, rax");
                        emit("    sub rsp, 32");
                        emit("    call atl_truthy");
                        emit("    add rsp, 32");
                        emit("    test eax, eax");
                        emit("    jz __atl_L" + l_next);
                        创建 ArrayList:case_bodies4;
                        case_bodies4 = cs.children;
                        如果(case_bodies4 != 空){
                            设 j = 0;
                            循环(j < case_bodies4.长度()){
                                gen_stmt(case_bodies4.获取(j), ctx);
                                j = j + 1;
                            };
                        };
                        emit("    jmp __atl_L" + l_end);
                        emit("__atl_L" + l_next + ":");
                    };
                    i = i + 1;
                };
            };
        };
        emit("__atl_L" + l_end + ":");
        返回值 0;
    };

    如果(n.type == AST_LOOP){
        设 l_break = new_label();
        设 l_continue = new_label();
        设 l_start = new_label();
        设 saved_break = ctx.loop_break;
        设 saved_continue = ctx.loop_continue;
        ctx.loop_break = l_break;
        ctx.loop_continue = l_continue;

        设 saved_counter = ctx.loop_counter_off;
        如果(saved_counter != 0){
            emit("    mov [rbp + " + saved_counter + "], r12  ; spill outer counter");
        };
        创建 SemLocal:ctr;
        ctr = find_loop_counter(n, ctx);
        如果(ctr != 空){
            ctx.loop_counter_off = ctr.offset;
            g_func_uses_r12 = 1;
        }否则{
            ctx.loop_counter_off = 0;
        };

        如果(n.loop_kind == LOOP_INFINITE){
            emit("__atl_L" + l_start + ":");
            gen_stmt(n.loop_body, ctx);
            emit("    jmp __atl_L" + l_start);
            emit("__atl_L" + l_continue + ":");
            emit("__atl_L" + l_break + ":");
        }又如果(n.loop_kind == LOOP_COUNT){

            gen_expr(n.loop_count, ctx);
            emit("    mov rax, [rax + 8]  ; unbox int");
            设 t_count = temp_alloc(ctx);
            emit("    mov [rbp + " + t_count + "], rax");
            emit("    xor rax, rax  ; i = 0");
            设 t_i = temp_alloc(ctx);
            emit("    mov [rbp + " + t_i + "], rax");
            emit("__atl_L" + l_start + ":");
            emit("    mov rax, [rbp + " + t_i + "]");
            emit("    cmp rax, [rbp + " + t_count + "]");
            emit("    jge __atl_L" + l_break);
            gen_stmt(n.loop_body, ctx);
            emit("__atl_L" + l_continue + ":");
            emit("    mov rax, [rbp + " + t_i + "]");
            emit("    inc rax");
            emit("    mov [rbp + " + t_i + "], rax");
            emit("    jmp __atl_L" + l_start);
            emit("__atl_L" + l_break + ":");
            temp_free(ctx, 2);
        }又如果(n.loop_kind == LOOP_COND){

            如果(ctx.loop_counter_off != 0){
                emit("    mov r12, [rbp + " + ctx.loop_counter_off + "]  ; load counter");
            };
            emit("__atl_L" + l_start + ":");

            如果(gen_cond_jmp_false(n.loop_cond, ctx, l_break) == 0){
                gen_expr(n.loop_cond, ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_truthy");
                emit("    add rsp, 32");
                emit("    test eax, eax");
                emit("    jz __atl_L" + l_break);
            };
            gen_stmt(n.loop_body, ctx);
            emit("__atl_L" + l_continue + ":");
            emit("    jmp __atl_L" + l_start);
            emit("__atl_L" + l_break + ":");
        }又如果(n.loop_kind == LOOP_CFOR){
            如果(n.loop_init != 空){
                gen_stmt(n.loop_init, ctx);
            };

            如果(ctx.loop_counter_off != 0){
                emit("    mov r12, [rbp + " + ctx.loop_counter_off + "]  ; load counter");
            };
            emit("__atl_L" + l_start + ":");
            如果(n.loop_cond != 空){
                如果(gen_cond_jmp_false(n.loop_cond, ctx, l_break) == 0){
                    gen_expr(n.loop_cond, ctx);
                    emit("    mov rcx, rax");
                    emit("    sub rsp, 32");
                    emit("    call atl_truthy");
                    emit("    add rsp, 32");
                    emit("    test eax, eax");
                    emit("    jz __atl_L" + l_break);
                };
            };
            gen_stmt(n.loop_body, ctx);
            emit("__atl_L" + l_continue + ":");
            如果(n.loop_step != 空){
                gen_stmt(n.loop_step, ctx);
            };
            emit("    jmp __atl_L" + l_start);
            emit("__atl_L" + l_break + ":");
        }又如果(n.loop_kind == LOOP_FOREACH){

            gen_expr(n.loop_cond, ctx);
            设 t_list = temp_alloc(ctx);
            emit("    mov [rbp + " + t_list + "], rax");
            emit("    mov rcx, [rbp + " + t_list + "]");
            emit("    sub rsp, 32");
            emit("    call atl_str_len");
            emit("    add rsp, 32");
            emit("    mov rax, [rax + 8]  ; unbox int");
            设 t_len = temp_alloc(ctx);
            emit("    mov [rbp + " + t_len + "], rax");
            emit("    xor rax, rax");
            设 t_idx = temp_alloc(ctx);
            emit("    mov [rbp + " + t_idx + "], rax");
            emit("__atl_L" + l_start + ":");
            emit("    mov rax, [rbp + " + t_idx + "]");
            emit("    cmp rax, [rbp + " + t_len + "]");
            emit("    jge __atl_L" + l_break);

            emit("    mov rax, [rbp + " + t_idx + "]");
            emit("    mov rcx, rax  ; idx for atl_int");
            emit("    sub rsp, 32");
            emit("    call atl_int");
            emit("    add rsp, 32");
            emit("    mov rdx, rax  ; idx");
            emit("    mov rcx, [rbp + " + t_list + "]  ; list");
            emit("    sub rsp, 32");
            emit("    call atl_list_get");
            emit("    add rsp, 32");

            如果(n.loop_item != 空){
                创建 ASTNode:item_node;
                item_node = n.loop_item;
                如果(item_node.sval != 空){
                    设 iname = item_node.sval;
                    创建 SemLocal:l;
                    l = gen_find_local(ctx.func, iname);
                    如果(l != 空){
                        如果(n.loop_item2 != 空){

                            设 t_pair = temp_alloc(ctx);
                            emit("    mov [rbp + " + t_pair + "], rax  ; pair");
                            emit("    mov rax, [rax + 8]   ; pair->as.list");
                            emit("    mov rax, [rax]       ; items (AtlObj**)");
                            emit("    mov rax, [rax]       ; items[0] = key");
                            emit("    mov [rbp + " + l.offset + "], rax  ; " + iname + " (key)");
                            创建 ASTNode:item2_node;
                            item2_node = n.loop_item2;
                            如果(item2_node.sval != 空){
                                设 iname2 = item2_node.sval;
                                创建 SemLocal:l2;
                                l2 = gen_find_local(ctx.func, iname2);
                                如果(l2 != 空){
                                    emit("    mov rax, [rbp + " + t_pair + "]");
                                    emit("    mov rax, [rax + 8]   ; pair->as.list");
                                    emit("    mov rax, [rax]       ; items (AtlObj**)");
                                    emit("    mov rax, [rax + 8]   ; items[1] = value");
                                    emit("    mov [rbp + " + l2.offset + "], rax  ; " + iname2 + " (value)");
                                };
                            };
                            temp_free(ctx, 1);
                        }否则{
                            emit("    mov [rbp + " + l.offset + "], rax  ; " + iname);
                        };
                    };
                };
            };
            gen_stmt(n.loop_body, ctx);
            emit("__atl_L" + l_continue + ":");
            emit("    mov rax, [rbp + " + t_idx + "]");
            emit("    inc rax");
            emit("    mov [rbp + " + t_idx + "], rax");
            emit("    jmp __atl_L" + l_start);
            emit("__atl_L" + l_break + ":");
            temp_free(ctx, 3);
        }又如果(n.loop_kind == LOOP_UNTIL){

            emit("__atl_L" + l_start + ":");
            gen_stmt(n.loop_body, ctx);
            emit("__atl_L" + l_continue + ":");
            如果(n.loop_cond != 空){
                如果(gen_cond_jmp_false(n.loop_cond, ctx, l_start) == 0){

                    gen_expr(n.loop_cond, ctx);
                    emit("    mov rcx, rax");
                    emit("    sub rsp, 32");
                    emit("    call atl_truthy");
                    emit("    add rsp, 32");
                    emit("    test eax, eax");
                    emit("    jz __atl_L" + l_start);
                };
            }否则{
                emit("    jmp __atl_L" + l_start);
            };
            emit("    jmp __atl_L" + l_break);
            emit("__atl_L" + l_break + ":");
        };

        如果(ctx.loop_counter_off != 0){
            emit("    mov [rbp + " + ctx.loop_counter_off + "], r12  ; counter writeback");
        };
        如果(saved_counter != 0){
            emit("    mov r12, [rbp + " + saved_counter + "]  ; restore outer counter");
            ctx.loop_counter_off = saved_counter;
        }否则{
            ctx.loop_counter_off = 0;
        };

        ctx.loop_break = saved_break;
        ctx.loop_continue = saved_continue;
        返回值 0;
    };

    如果(n.type == AST_RETURN){

        如果(n.ret_value != 空){
            如果(ctx.func != 空 && ctx.func.ret_type_kind == T_INT){
                gen_int_value(n.ret_value, ctx);
            }否则{
                gen_expr(n.ret_value, ctx);
            };
        }否则{
            emit("    sub rsp, 32");
            emit("    call atl_null");
            emit("    add rsp, 32");
        };

        如果(g_func_is_leaf == 0){

            设 t_ret = temp_alloc(ctx);
            emit("    mov [rbp + " + t_ret + "], rax  ; save return value");
            emit("    sub rsp, 32");
            emit("    call gc_pop_frame");
            emit("    add rsp, 32");
            emit("    mov rax, [rbp + " + t_ret + "]  ; restore return value");
            temp_free(ctx, 1);
        };
        emit("    mov rsp, rbp");

        如果(g_func_uses_r12 == 1){
            emit("    sub rsp, 8");
            emit("    pop r12  ; T3 counter restore");
        };
        emit("    pop rbp");
        emit("    ret");
        返回值 0;
    };

    如果(n.type == AST_BREAK){
        emit("    jmp __atl_L" + ctx.loop_break);
        返回值 0;
    };

    如果(n.type == AST_CONTINUE){
        emit("    jmp __atl_L" + ctx.loop_continue);
        返回值 0;
    };

    如果(n.type == AST_WAIT){

        gen_expr(n.ret_value, ctx);
        设 mul = 1000;
        如果(n.wait_unit == TOK_SEC){ mul = 1000; };
        如果(n.wait_unit == TOK_MIN){ mul = 60000; };
        如果(n.wait_unit == TOK_HOUR){ mul = 3600000; };
        设 wid = new_label();
        设 mid = add_fplit(mul);
        emit("    mov rcx, [rax]  ; tag");
        emit("    cmp rcx, 3  ; 浮点 tag=3");
        emit("    jne .w_int_" + wid);
        emit("    mov rax, [rax + 8]  ; double 秒值");
        emit("    movq xmm0, rax");
        emit("    mulsd xmm0, [__atl_fp_" + mid + "]  ; ×" + mul + " → 毫秒");
        emit("    cvttsd2si rcx, xmm0  ; 截断转 int 毫秒");
        emit("    jmp .w_done_" + wid);
        emit(".w_int_" + wid + ":");
        emit("    mov rax, [rax + 8]  ; int 值");
        emit("    imul rcx, rax, " + mul);
        emit(".w_done_" + wid + ":");
        emit("    sub rsp, 32");
        emit("    call atl_sleep_ms");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_WAIT_TASK){
        gen_expr(n.ret_value, ctx);
        emit("    mov rcx, rax");
        emit("    sub rsp, 32");
        emit("    call atl_task_wait");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_SHOW){
        gen_show_node(n, ctx);
        返回值 0;
    };

    如果(n.type == AST_READFILE){

        如果(n.rf_path == 空 || n.rf_body == 空){ 返回值 0; };
        设 path_id = add_strlit(n.rf_path);
        emit("    lea rcx, [__atl_str_" + path_id + "_data]");
        emit("    sub rsp, 32");
        emit("    call atl_str");
        emit("    add rsp, 32");
        emit("    mov rcx, rax  ; path (AtlObj*)");
        emit("    sub rsp, 32");
        emit("    call atl_file_read");
        emit("    add rsp, 32");
        设 t_content = temp_alloc(ctx);
        emit("    mov [rbp + " + t_content + "], rax");

        emit("    mov rcx, [rbp + " + t_content + "]");
        emit("    sub rsp, 32");
        emit("    call atl_str_split_lines");
        emit("    add rsp, 32");
        设 t_list = temp_alloc(ctx);
        emit("    mov [rbp + " + t_list + "], rax");

        emit("    mov rcx, [rbp + " + t_list + "]");
        emit("    sub rsp, 32");
        emit("    call atl_list_len");
        emit("    add rsp, 32");
        emit("    mov rax, [rax + 8]  ; unbox int");
        设 t_len = temp_alloc(ctx);
        emit("    mov [rbp + " + t_len + "], rax");

        emit("    xor rax, rax");
        设 t_idx = temp_alloc(ctx);
        emit("    mov [rbp + " + t_idx + "], rax");

        设 l_start = new_label();
        设 l_break = new_label();
        设 l_continue = new_label();
        设 saved_break = ctx.loop_break;
        设 saved_continue = ctx.loop_continue;
        ctx.loop_break = l_break;
        ctx.loop_continue = l_continue;
        emit("__atl_L" + l_start + ":");
        emit("    mov rax, [rbp + " + t_idx + "]");
        emit("    cmp rax, [rbp + " + t_len + "]");
        emit("    jge __atl_L" + l_break);

        emit("    mov rax, [rbp + " + t_idx + "]");
        emit("    mov rcx, rax");
        emit("    sub rsp, 32");
        emit("    call atl_int");
        emit("    add rsp, 32");
        emit("    mov rdx, rax  ; idx");
        emit("    mov rcx, [rbp + " + t_list + "]  ; list");
        emit("    sub rsp, 32");
        emit("    call atl_list_get");
        emit("    add rsp, 32");

        如果(ctx.func != 空){
            设 l = gen_find_local(ctx.func, "s");
            如果(l != 空){
                emit("    mov [rbp + " + l.offset + "], rax  ; s");
            };
        };

        gen_stmt(n.rf_body, ctx);
        emit("__atl_L" + l_continue + ":");
        emit("    mov rax, [rbp + " + t_idx + "]");
        emit("    inc rax");
        emit("    mov [rbp + " + t_idx + "], rax");
        emit("    jmp __atl_L" + l_start);
        emit("__atl_L" + l_break + ":");
        ctx.loop_break = saved_break;
        ctx.loop_continue = saved_continue;
        temp_free(ctx, 4);
        返回值 0;
    };

    如果(n.type == AST_DESTROY){

        创建 SemNode:s_dst;
        s_dst = n.sem;
        如果(n.operand != 空){
            gen_expr(n.operand, ctx);
        }否则{
            emit("    xor rax, rax");
        };
        设 t_obj = temp_alloc(ctx);
        emit("    mov [rbp + " + t_obj + "], rax  ; destroy target");

        如果(s_dst != 空 && s_dst.target_id != 0){
            emit("    mov rcx, [rbp + " + t_obj + "]  ; this");
            emit("    sub rsp, 32");
            emit("    call " + method_label_by_id(s_dst.target_id));
            emit("    add rsp, 32");
        };

        emit("    mov rcx, [rbp + " + t_obj + "]");
        emit("    sub rsp, 32");
        emit("    call atl_instance_destroy");
        emit("    add rsp, 32");

        如果(n.operand != 空 && n.operand.type == AST_VAR && n.operand.sem != 空){
            创建 SemNode:os;
            os = n.operand.sem;
            如果(os.kind == SN_LOCAL && os.offset != 0){
                emit("    mov qword [rbp + " + os.offset + "], 0  ; " + n.operand.sval + " = 空");
            }又如果(os.kind == SN_GLOBAL){
                emit("    mov qword [" + global_label(os.offset) + "], 0  ; " + n.operand.sval + " = 空");
            };
        };
        temp_free(ctx, 1);
        返回值 0;
    };

    如果(n.type == AST_THROW){

        如果(n.operand != 空){
            gen_expr(n.operand, ctx);
        }否则{
            emit("    xor rax, rax  ; 抛出 空");
        };
        emit("    mov rcx, rax");
        emit("    mov rdx, " + n.line + "  ; 抛出行号");
        emit("    sub rsp, 32");
        emit("    call atl_throw");
        emit("    add rsp, 32");
        emit("    xor rax, rax  ; 不可达（atl_throw 不返回）");
        返回值 0;
    };

    如果(n.type == AST_TRY){

        设 t_jb = temp_alloc(ctx);
        设 i2 = 1;
        循环(i2 < 4){
            temp_alloc(ctx);
            i2 = i2 + 1;
        };
        设 t_flag = temp_alloc(ctx);
        设 l_ret = new_label();
        设 l_branch = new_label();
        设 l_catch = new_label();
        设 l_fin = new_label();
        设 l_done = new_label();

        emit("    lea rax, [rbp + " + t_jb + "]  ; ExcFrame");
        emit("    mov [rax + 0], rsp");
        emit("    lea rcx, [__atl_L" + l_ret + "]");
        emit("    mov [rax + 8], rcx");
        emit("    mov [rax + 16], rbp");
        emit("    mov rdx, [rel atl_exc_top]");
        emit("    mov [rax + 24], rdx");
        emit("    mov [rel atl_exc_top], rax");
        emit("    xor eax, eax  ; 首次进入");
        emit("    jmp __atl_L" + l_branch + "  ; → 分支点");
        emit("__atl_L" + l_ret + ":  ; 异常返回点（atl_throw 恢复后跳回这里）");
        emit("    mov eax, 1  ; 异常到达");
        emit("__atl_L" + l_branch + ":  ; 分支点");
        如果(n.catch_block != 空){

            emit("    test eax, eax");
            emit("    jnz __atl_L" + l_catch + "  ; 异常 → 捕获");
        }否则{

            emit("    mov [rbp + " + t_flag + "], eax  ; exc flag");
            emit("    test eax, eax");
            emit("    jnz __atl_L" + l_catch + "  ; 异常 → 跳过 body");
        };
        如果(n.then_block != 空){
            gen_stmt(n.then_block, ctx);
        };
        emit("    sub rsp, 32");
        emit("    call atl_exc_pop  ; 正常退出 try");
        emit("    add rsp, 32");
        如果(n.catch_block != 空){
            如果(n.finally_block != 空){
                emit("    jmp __atl_L" + l_fin + "  ; 正常路径 → 最终");
            }否则{
                emit("    jmp __atl_L" + l_done + "  ; 正常路径 → 结束");
            };
        };
        emit("__atl_L" + l_catch + ":  ; 捕获/异常路径");
        如果(n.catch_block != 空){

            如果(n.catch_var != 空 && n.sem != 空){
                创建 SemNode:ts;
                ts = n.sem;
                如果(ts.kind == SN_LOCAL){
                    emit("    sub rsp, 32");
                    emit("    call atl_exc_value");
                    emit("    add rsp, 32");
                    emit("    mov [rbp + " + ts.offset + "], rax  ; " + n.catch_var + " = 错误对象");
                };
            };
            如果(n.catch_block != 空){
                gen_stmt(n.catch_block, ctx);
            };
        };
        如果(n.finally_block != 空){
            emit("__atl_L" + l_fin + ":  ; 最终");
            gen_stmt(n.finally_block, ctx);
        };
        如果(n.catch_block == 空){

            emit("    mov eax, [rbp + " + t_flag + "]");
            emit("    test eax, eax");
            emit("    jz __atl_L" + l_done + "  ; 正常路径");
            emit("    sub rsp, 32");
            emit("    call atl_rethrow  ; 异常 → 重抛");
            emit("    add rsp, 32");
        };
        emit("__atl_L" + l_done + ":  ; try 语句结束");
        temp_free(ctx, 5);
        返回值 0;
    };

    如果(n.type == AST_LISTEN){

        如果(n.cond != 空 && n.cond.type == AST_LIST_LIT){

            创建 ArrayList:keys;
            keys = n.cond.children;
            如果(keys != 空 && keys.长度() >= 1){
                gen_expr(keys.获取(0), ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_key_pressed");
                emit("    add rsp, 32");
            }否则{
                emit("    xor rax, rax");
            };
        }又如果(n.cond != 空){
            gen_expr(n.cond, ctx);
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_truthy");
            emit("    add rsp, 32");
        }否则{
            emit("    mov eax, 1  ; 无条件监听恒真");
        };

        设 l_skip = new_label();
        emit("    test rax, rax");
        emit("    jz __atl_L" + l_skip + "  ; 条件为假跳过 body");
        如果(n.then_block != 空){
            gen_stmt(n.then_block, ctx);
        };
        emit("__atl_L" + l_skip + ":");
        返回值 0;
    };

    如果(n.type == AST_LISTEN_EVENT){

        如果(n.call_node != 空){
            创建 ASTNode:cc3;
            cc3 = n.call_node;
            创建 ArrayList:cc_args3;
            cc_args3 = cc3.args;
            创建 ArrayList:slots3;
            设 ai3 = 0;
            循环(ai3 < cc_args3.长度()){
                创建 ASTNode:arg3;
                arg3 = cc_args3.获取(ai3);

                如果(ai3 == 3 && g_gfx_block_win_off != 0){
                    emit("    mov rax, [rbp + " + g_gfx_block_win_off + "]  ; block window id");
                }否则{
                    gen_expr(arg3, ctx);
                };
                设 off3 = temp_alloc(ctx);
                emit("    mov [rbp + " + off3 + "], rax");
                slots3.添加(off3);
                ai3 = ai3 + 1;
            };

            创建 SemNode:cs3;
            cs3 = cc3.sem;
            创建 SemMethod:tm3;
            tm3 = 空;
            如果(cs3 != 空 && cs3.kind == SN_FUNC){
                设 fk3 = 0;
                循环(fk3 < g_sem_funcs.长度()){
                    创建 SemMethod:tm4;
                    tm4 = g_sem_funcs.获取(fk3);
                    如果(tm4.id == cs3.target_id){
                        tm3 = tm4;
                        跳出;
                    };
                    fk3 = fk3 + 1;
                };
            };
            如果(tm3 != 空){
                gen_call_seq(ctx, method_label(tm3), 4, slots3, 0);
            }否则{
                emit("    xor rax, rax  ; 事件订阅目标 __事件订阅 未找到");
            };
            设 ns3 = slots3.长度();
            设 si3 = 0;
            循环(si3 < ns3){
                temp_free(ctx, 1);
                si3 = si3 + 1;
            };
        }否则{
            emit("    xor rax, rax  ; listen event no call node");
        };
        返回值 0;
    };

    如果(n.type == AST_WHEN){

        如果(n.call_node != 空){
            创建 ASTNode:cw;
            cw = n.call_node;
            创建 ArrayList:cw_args;
            cw_args = cw.args;
            创建 ArrayList:slots_w;
            设 aiw = 0;
            循环(aiw < cw_args.长度()){
                创建 ASTNode:argw;
                argw = cw_args.获取(aiw);
                gen_expr(argw, ctx);
                设 offw = temp_alloc(ctx);
                emit("    mov [rbp + " + offw + "], rax");
                slots_w.添加(offw);
                aiw = aiw + 1;
            };
            创建 SemNode:csw;
            csw = cw.sem;
            创建 SemMethod:tmw;
            tmw = 空;
            如果(csw != 空 && csw.kind == SN_FUNC){
                设 fkw = 0;
                循环(fkw < g_sem_funcs.长度()){
                    创建 SemMethod:tm5;
                    tm5 = g_sem_funcs.获取(fkw);
                    如果(tm5.id == csw.target_id){
                        tmw = tm5;
                        跳出;
                    };
                    fkw = fkw + 1;
                };
            };
            如果(tmw != 空){
                gen_call_seq(ctx, method_label(tmw), 2, slots_w, 0);
            }否则{
                emit("    xor rax, rax  ; 控件事件目标 __控件事件 未找到");
            };
            设 nsw = slots_w.长度();
            设 siw = 0;
            循环(siw < nsw){
                temp_free(ctx, 1);
                siw = siw + 1;
            };
        }否则{
            emit("    xor rax, rax  ; when no call node");
        };
        返回值 0;
    };

    如果(n.type == AST_GAMES){

        设 l_start = new_label();
        设 saved_break = ctx.loop_break;
        设 saved_continue = ctx.loop_continue;

        ctx.loop_break = l_start + 1;
        ctx.loop_continue = l_start;
        emit("__atl_L" + l_start + ":  ; games frame loop");
        如果(n.then_block != 空){
            gen_stmt(n.then_block, ctx);
        };
        ctx.loop_break = saved_break;
        ctx.loop_continue = saved_continue;
        emit("    sub rsp, 32");
        emit("    call atl_games_tick");
        emit("    add rsp, 32");
        emit("    jmp __atl_L" + l_start);
        emit("__atl_L" + (l_start + 1) + ":  ; games end");
        返回值 0;
    };

    如果(n.type == AST_ASM){
        如果(n.asm_stmts != 空){

            创建 ArrayList:stmts;
            stmts = n.asm_stmts;
            设 i = 0;
            循环(i < stmts.长度()){
                设 s = stmts.获取(i);
                如果(s != 空){
                    如果(s == "cpu"){
                        emit("    cpuid");
                    }又如果(s == "time"){
                        emit("    rdtsc");
                    }否则{
                        emit("    " + s);
                    };
                };
                i = i + 1;
            };
        };
        返回值 0;
    };

    如果(n.type == AST_EXPRSTMT){

        如果(n.operand != 空 && (n.operand.type == AST_CALL || n.operand.type == AST_METHODCALL || n.operand.type == AST_HOOKCALL)){
            如果(n.operand.sem != 空 && n.operand.sem.type_kind == T_INT){
                gen_call(n.operand, ctx);
                返回值 0;
            };
        };
        gen_expr(n.operand, ctx);
        返回值 0;
    };

    如果(n.type == AST_HOOKCALL){
        创建 SemMethod:h;
        h = 空;
        设 i = 0;
        循环(i < g_sem_hooks.长度()){
            创建 SemMethod:m;
            m = g_sem_hooks.获取(i);
            如果(m.name == n.method_name){
                h = m;
                跳出;
            };
            i = i + 1;
        };
        如果(h != 空){
            设 h_nargs = 0;
            如果(n.args != 空){
                h_nargs = n.args.长度();
            };
            创建 ArrayList:slots;
            设 j = 0;
            循环(j < h_nargs){
                gen_expr(n.args.获取(j), ctx);
                设 off = temp_alloc(ctx);
                emit("    mov [rbp + " + off + "], rax");
                slots.添加(off);
                j = j + 1;
            };
            gen_call_seq(ctx, method_label(h), h_nargs, slots, 0);
            gen_store(n.lhs, ctx);
        };
        返回值 0;
    };

    如果(n.type == AST_LIST_DECL || n.type == AST_ARRAY_DECL || n.type == AST_GROUP_DECL){
        如果(n.arr_init != 空){
            gen_expr(n.arr_init, ctx);
        }否则{
            emit("    sub rsp, 32");
            emit("    call atl_list_new");
            emit("    add rsp, 32");
        };
        如果(n.sval != 空){
            创建 SemLocal:l;
            l = gen_find_local(ctx.func, n.sval);
            如果(l != 空){
                emit("    mov [rbp + " + l.offset + "], rax  ; " + n.sval);
            }又如果(ctx.cls != 空){
                设 fi = sem_find_field(ctx.cls, n.sval);
                如果(fi >= 0){
                    emit("    mov rdx, rax  ; save val");
                    emit("    mov rax, [rbp + " + ctx.this_offset + "]  ; this");
                    emit("    mov rax, [rax + 8]   ; inst");
                    emit("    mov rax, [rax + 8]   ; field_vals");
                    emit("    mov [rax + " + (fi * 8) + "], rdx  ; field " + n.sval);
                };
            };
        };
        返回值 0;
    };

    如果(n.type == AST_BUTTON_HANDLER){
        设 btn_id = n.button_id;
        设 text_id = -1;
        如果(n.sval != 空){
            如果(n.sval.长度() > 0){
                text_id = add_strlit(n.sval);
                emit("    mov rcx, " + btn_id + "  ; button id");
                emit("    lea rdx, [__atl_str_" + text_id + "]  ; text");
                emit("    sub rsp, 32");
                emit("    call atl_gfx_button_set_text");
                emit("    add rsp, 32");
            };
        };
        设 lbl_id = new_label(ctx);
        设 lbl_skip = new_label(ctx);
        emit("    jmp __atl_btn_skip_" + lbl_skip + "  ; skip handler body");
        emit("__atl_btn_handler_" + btn_id + "_:");
        如果(n.fn_body != 空){
            gen_stmt(n.fn_body, ctx);
        };
        emit("    ret  ; button handler end");
        emit("__atl_btn_skip_" + lbl_skip + ":");
        返回值 0;
    };

    如果(n.type == AST_CALL || n.type == AST_METHODCALL || n.type == AST_HOOKCALL){
        如果(n.sem != 空 && n.sem.type_kind == T_INT){
            gen_call(node, ctx);
            返回值 0;
        };
    };
    gen_expr(node, ctx);
    返回值 0;
};

声明 stmt_is_leaf(node){
    如果(node == 空){ 返回值 1; };
    创建 ASTNode:n;
    n = node;
    如果(n.type == AST_BLOCK){
        如果(n.children != 空){
            设 i = 0;
            循环(i < n.children.长度()){
                如果(stmt_is_leaf(n.children.获取(i)) != 1){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };
    如果(n.type == AST_VARDECL){
        如果(n.var_inits != 空){
            设 i = 0;
            循环(i < n.var_inits.长度()){
                如果(stmt_is_leaf(n.var_inits.获取(i)) != 1){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };
    如果(n.type == AST_ASSIGN){
        如果(stmt_is_leaf(n.lhs) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.rhs) != 1){ 返回值 0; };
        返回值 1;
    };
    如果(n.type == AST_VAR || n.type == AST_LITERAL){
        返回值 1;
    };
    如果(n.type == AST_UNARY){
        如果(n.op != TOK_MINUS && n.op != TOK_NOT && n.op != TOK_AMP){
            返回值 0;
        };
        返回值 stmt_is_leaf(n.operand);
    };
    如果(n.type == AST_BINARY){
        设 op = n.op;
        如果(op == TOK_EQ || op == TOK_NE || op == TOK_LT || op == TOK_GT || op == TOK_LE || op == TOK_GE){
            如果(stmt_is_leaf(n.lhs) != 1){ 返回值 0; };
            如果(stmt_is_leaf(n.rhs) != 1){ 返回值 0; };
            返回值 1;
        };

        如果(n.sem != 空 && n.sem.type_kind != 1){
            返回值 0;
        };
        如果(stmt_is_leaf(n.lhs) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.rhs) != 1){ 返回值 0; };
        返回值 1;
    };
    如果(n.type == AST_IF){
        如果(stmt_is_leaf(n.cond) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.then_block) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.else_block) != 1){ 返回值 0; };
        返回值 1;
    };
    如果(n.type == AST_LOOP){
        如果(stmt_is_leaf(n.loop_init) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.loop_cond) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.loop_step) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.loop_count) != 1){ 返回值 0; };
        如果(stmt_is_leaf(n.loop_body) != 1){ 返回值 0; };
        返回值 1;
    };
    如果(n.type == AST_RETURN){
        返回值 stmt_is_leaf(n.ret_value);
    };
    如果(n.type == AST_EXPRSTMT){
        返回值 stmt_is_leaf(n.operand);
    };

    返回值 0;
};

声明 gen_function(sm){
    创建 SemMethod:m;
    m = sm;
    创建 ASTNode:func;
    func = m.func;
    创建 SemFunc:sf;
    sf = m.sem_func;
    如果(sf == 空){

        如果(func != 空 && func.sem != 空){
            创建 SemFunc:f2;
            f2 = func.sem;
            sf = f2;
        };
    };
    如果(sf == 空){
        返回值 0;
    };

    g_func_uses_r12 = 0;

    创建 Ctx:c;
    c.func = sf;
    c.cls = m.owner;
    c.is_method = 0;
    如果(m.kind == 0){
        c.is_method = 1;
    };
    c.locals_bytes = sf.locals.长度() * 8;

    如果(c.is_method == 1){
        c.this_offset = -(c.locals_bytes + 8);
        c.temp_base = c.this_offset - 8;
    }否则{
        c.this_offset = 0;
        c.temp_base = -(c.locals_bytes + 8);
    };

    设 old_silent = g_silent;
    g_silent = 1;
    g_temp_peak = 0;
    创建 Ctx:mc;
    mc.func = c.func;
    mc.cls = c.cls;
    mc.is_method = c.is_method;
    mc.this_offset = c.this_offset;
    mc.locals_bytes = c.locals_bytes;
    mc.temp_base = c.temp_base;
    mc.loop_break = c.loop_break;
    mc.loop_continue = c.loop_continue;
    gen_stmt(func.then_block, mc);
    g_silent = old_silent;
    g_func_is_leaf = stmt_is_leaf(func.then_block);
    g_cur_func_body = func.then_block;
    设 temp_slots = g_temp_peak;
    如果(temp_slots < 1){ temp_slots = 1; };
    如果(temp_slots > 4096){
        报错("函数 " + func.name + " 表达式嵌套过深 (temp_slots=" + temp_slots + " > 4096)");
    };
    设 method_extra = 0;
    如果(c.is_method == 1){
        method_extra = 8;
    };
    设 frame = c.locals_bytes + method_extra + temp_slots * 8;
    frame = align16(frame);
    c.frame_size = frame;

    设 total_slots = frame / 8;
    如果(g_func_uses_r12 == 1){
        total_slots = total_slots + 1;
    };
    设 nwords = (total_slots + 63) / 64;
    emit("section .data");
    emit("global __gc_mask_" + m.id);
    emit("__gc_mask_" + m.id + ": dq " + nwords + "  ; 保守掩码 (" + total_slots + " slots)");
    设 wi = 0;
    循环(wi < nwords){
        emit("    dq 0xFFFFFFFFFFFFFFFF");
        wi = wi + 1;
    };
    emit("section .text");

    设 kind_name = "method";
    如果(m.kind == 1){ kind_name = "func"; };
    如果(m.kind == 2){ kind_name = "hook"; };
    如果(m.kind == 3){ kind_name = "lambda"; };
    设 mname = m.name;
    如果(mname == 空){ mname = "<anon>"; };
    emit("; ===== " + kind_name + " " + mname + " =====");
    emit("global " + method_label(m));
    emit(method_label(m) + ":");
    emit("    push rbp");
    emit("    mov rbp, rsp");

    设 frame_alloc = c.frame_size;
    如果(g_func_uses_r12 == 1){
        emit("    push r12  ; T3 counter save");

        frame_alloc = frame_alloc + 8;
    };
    emit("    sub rsp, " + frame_alloc);

    设 nparams = sf.nparams;
    如果(c.is_method == 1){

        emit("    mov [rbp + " + c.this_offset + "], rcx  ; this");

        设 i = 0;
        循环(i < nparams && i < 3){
            创建 SemLocal:l;
            l = sf.locals.获取(i);
            设 reg = "rdx";
            如果(i == 1){ reg = "r8"; };
            如果(i == 2){ reg = "r9"; };
            emit("    mov [rbp + " + l.offset + "], " + reg + "  ; param " + l.name);
            i = i + 1;
        };

        设 i = 3;
        循环(i < nparams){
            创建 SemLocal:l;
            l = sf.locals.获取(i);
            设 stack_off = 48 + (i - 3) * 8;
            emit("    mov rax, [rbp + " + stack_off + "]");
            emit("    mov [rbp + " + l.offset + "], rax  ; param " + l.name);
            i = i + 1;
        };
    }否则{

        设 i = 0;
        循环(i < nparams && i < 4){
            创建 SemLocal:l;
            l = sf.locals.获取(i);
            设 reg = "rcx";
            如果(i == 1){ reg = "rdx"; };
            如果(i == 2){ reg = "r8"; };
            如果(i == 3){ reg = "r9"; };
            emit("    mov [rbp + " + l.offset + "], " + reg + "  ; param " + l.name);
            i = i + 1;
        };

        设 i = 4;
        循环(i < nparams){
            创建 SemLocal:l;
            l = sf.locals.获取(i);
            设 stack_off = 48 + (i - 4) * 8;
            emit("    mov rax, [rbp + " + stack_off + "]");
            emit("    mov [rbp + " + l.offset + "], rax  ; param " + l.name);
            i = i + 1;
        };
    };

    如果(g_func_is_leaf == 0){
        emit("    call atl_stack_guard");
        emit("    mov rcx, rbp");
        emit("    lea rdx, [__gc_mask_" + m.id + "]");
        emit("    sub rsp, 32");
        emit("    call gc_push_frame");
        emit("    add rsp, 32");
    };

    gen_stmt(func.then_block, c);

    如果(sf.ret_type_kind == T_INT){
        emit("    xor rax, rax  ; default return 0 (int)");
    }否则{
        emit("    sub rsp, 32");
        emit("    call atl_null");
        emit("    add rsp, 32");
    };
    如果(g_func_is_leaf == 0){
        emit("    sub rsp, 32");
        emit("    call gc_pop_frame");
        emit("    add rsp, 32");
    };
    emit("    mov rsp, rbp");

    如果(g_func_uses_r12 == 1){
        emit("    sub rsp, 8");
        emit("    pop r12  ; T3 counter restore");
    };
    emit("    pop rbp");
    emit("    ret");
    emit("");
    返回值 0;
};

声明 gen_task_func(node, seq){
    创建 ASTNode:an;
    an = node;
    设 tlbl = "__atl_task_" + seq;
    创建 ArrayList:tc;
    tc = an.children;

    创建 SemFunc:tf;
    tf = an.async_func;
    如果(tf == 空){
        tf.locals = 创建 ArrayList;
    };
    设 toff = tf.locals.长度();
    g_func_uses_r12 = 0;

    设 old_silent = g_silent;
    g_silent = 1;
    g_temp_peak = 0;
    创建 Ctx:amctx;
    amctx.func = tf;
    amctx.temp_base = -(toff * 8 + 8);
    设 ai = 0;
    循环(ai < tc.长度()){
        gen_stmt(tc.获取(ai), amctx);
        ai = ai + 1;
    };
    g_silent = old_silent;
    设 aframe = toff * 8 + (g_temp_peak + 1) * 8 + 8;

    如果(aframe % 16 != 0){ aframe = aframe + 8; };

    emit(tlbl + ":");
    emit("    push rbp");
    emit("    mov rbp, rsp");

    设 task_frame_alloc = aframe;
    如果(g_func_uses_r12 == 1){
        emit("    push r12  ; T3 counter save");
        task_frame_alloc = task_frame_alloc + 8;
    };
    emit("    sub rsp, " + task_frame_alloc);
    emit("    call atl_stack_guard");
    创建 Ctx:actx;
    actx.func = tf;
    actx.temp_base = -(toff * 8 + 8);
    actx.frame_size = aframe;
    设 aj = 0;
    循环(aj < tc.长度()){
        gen_stmt(tc.获取(aj), actx);
        aj = aj + 1;
    };
    emit("    lea rax, [__atl_int_0]  ; task default ret 0 (boxed)");
    emit("    mov rsp, rbp");

    如果(g_func_uses_r12 == 1){
        emit("    sub rsp, 8");
        emit("    pop r12  ; T3 counter restore");
    };
    emit("    pop rbp");
    emit("    ret");
    返回值 0;
};

声明 gen_main(){
    emit("; ===== __atl_main =====");
    emit("global __atl_main");
    emit("__atl_main:");
    emit("    push rbp");
    emit("    mov rbp, rsp");

    设 ri = 0;
    循环(ri < g_sem_funcs.长度()){
        创建 SemMethod:rm;
        rm = g_sem_funcs.获取(ri);
        如果(rm.name != 空){
            设 rid = add_strlit(rm.name);
            emit("    lea rcx, [__atl_str_" + rid + "_data]  ; func name " + rm.name);
            emit("    lea rdx, [" + method_label(rm) + "]");
            emit("    sub rsp, 32");
            emit("    call atl_func_register");
            emit("    add rsp, 32");
        };
        ri = ri + 1;
    };

    设 top_locals = g_sem_top_locals_n;
    设 frame = 32 + top_locals * 8;
    设 need_measure = 0;
    如果(g_sem_global_decls.长度() > 0){ need_measure = 1; };
    如果(g_sem_top_exprs.长度() > 0){ need_measure = 1; };
    如果(need_measure == 1){
        设 old_silent = g_silent;
        g_silent = 1;
        g_temp_peak = 0;
        创建 Ctx:mctx;
        mctx.temp_base = -(top_locals * 8 + 8);
        设 mi = 0;
        循环(mi < g_sem_global_decls.长度()){
            创建 ASTNode:mdecl;
            mdecl = g_sem_global_decls.获取(mi);
            如果(mdecl.var_names != 空){
                设 mj = 0;
                循环(mj < mdecl.var_inits.长度()){
                    创建 ASTNode:minit;
                    minit = mdecl.var_inits.获取(mj);
                    如果(minit != 空){
                        gen_expr(minit, mctx);
                    };
                    mj = mj + 1;
                };
            };
            mi = mi + 1;
        };
        设 mt = 0;
        循环(mt < g_sem_top_exprs.长度()){
            gen_stmt(g_sem_top_exprs.获取(mt), mctx);
            mt = mt + 1;
        };
        g_silent = old_silent;
        如果(g_temp_peak > 0){

            frame = top_locals * 8 + (g_temp_peak + 1) * 8 + 8;
        };
    };

    如果(g_sem_entries.长度() > 0){
        frame = frame + 8;
    };
    frame = align16(frame);
    emit("    sub rsp, " + frame);

    设 i = 0;
    循环(i < g_sem_classes.长度()){
        创建 SemClass:cls;
        cls = g_sem_classes.获取(i);
        如果(cls.is_interface != 0){ i = i + 1; 继续; };
        设 sid = add_strlit(cls.name);
        emit("    lea rcx, [__atl_str_" + sid + "_data]  ; " + cls.name);
        emit("    mov rdx, " + cls.nfields + "  ; nfields");
        emit("    call atl_instance_new");
        emit("    mov [" + singleton_label(cls) + "], rax");
        i = i + 1;
    };

    设 i1 = 0;
    循环(i1 < g_sem_classes.长度()){
        创建 SemClass:cls;
        cls = g_sem_classes.获取(i1);
        如果(cls.is_interface != 0){ i1 = i1 + 1; 继续; };
        设 cid = add_strlit(cls.name);
        emit("    lea rcx, [__atl_str_" + cid + "_data]  ; class " + cls.name);
        如果(cls.parent != 空){
            设 pid = add_strlit(cls.parent);
            emit("    lea rdx, [__atl_str_" + pid + "_data]  ; parent " + cls.parent);
        }否则{
            emit("    xor rdx, rdx  ; no parent");
        };
        emit("    sub rsp, 32");
        emit("    call atl_class_register");
        emit("    add rsp, 32");

        设 j = 0;
        循环(j < cls.methods.长度()){
            创建 SemMethod:m;
            m = cls.methods.获取(j);
            如果(m == 空 || m.name == 空){ j = j + 1; 继续; };
            设 mid = add_strlit(m.name);
            emit("    lea rcx, [__atl_str_" + cid + "_data]");
            emit("    lea rdx, [__atl_str_" + mid + "_data]  ; method " + m.name);
            emit("    lea r8, [" + method_label(m) + "]");
            emit("    sub rsp, 32");
            emit("    call atl_method_register");
            emit("    add rsp, 32");
            j = j + 1;
        };

        如果(cls.nfields > 0){
            emit("    lea rcx, [__atl_str_" + cid + "_data]");
            emit("    lea rdx, [__atl_fields_" + i1 + "]");
            emit("    mov r8, " + cls.nfields + "  ; nfields");
            emit("    sub rsp, 32");
            emit("    call atl_class_fields_register");
            emit("    add rsp, 32");
        };
        i1 = i1 + 1;
    };

    如果(g_sem_global_decls.长度() > 0){
        创建 Ctx:gctx;
        gctx.temp_base = -8;
        gctx.frame_size = frame;
        设 i2 = 0;
        循环(i2 < g_sem_global_decls.长度()){
            创建 ASTNode:decl;
            decl = g_sem_global_decls.获取(i2);
            如果(decl.var_names != 空){
                设 j = 0;
                循环(j < decl.var_names.长度()){
                    设 vn = decl.var_names.获取(j);
                    设 gi = sem_find_global(vn);
                    如果(gi >= 0){
                        如果(j < decl.var_inits.长度()){
                            创建 ASTNode:init;
                            init = decl.var_inits.获取(j);
                            如果(init != 空){
                                gen_expr(init, gctx);
                                emit("    mov [" + global_label(gi) + "], rax  ; global " + vn);
                            };
                        };
                    };
                    j = j + 1;
                };
            };
            i2 = i2 + 1;
        };
    };

    设 i3 = 0;
    循环(i3 < g_sem_entries.长度()){
        创建 SemEntry:e;
        e = g_sem_entries.获取(i3);
        如果(e == 空){ i3 = i3 + 1; 继续; };
        如果(e.cls == 空 || e.method == 空){ i3 = i3 + 1; 继续; };
        emit("    mov rcx, [" + singleton_label(e.cls) + "]  ; this");
        emit("    call " + method_label(e.method));
        emit("    mov [rbp - " + (frame - 8) + "], rax  ; entry retval");
        i3 = i3 + 1;
    };

    如果(g_sem_top_exprs.长度() > 0){
        创建 Ctx:tctx;
        tctx.func = g_sem_top_func;
        tctx.locals_bytes = top_locals * 8;
        tctx.temp_base = -(top_locals * 8 + 8);
        tctx.frame_size = frame;
        设 i4 = 0;
        循环(i4 < g_sem_top_exprs.长度()){
            gen_stmt(g_sem_top_exprs.获取(i4), tctx);
            i4 = i4 + 1;
        };
    };

    如果(g_sem_entries.长度() > 0){
        emit("    mov rax, [rbp - " + (frame - 8) + "]  ; entry retval -> exit code");
    }否则{
        emit("    xor eax, eax  ; no entries -> exit 0");
    };
    emit("    add rsp, " + frame);
    emit("    pop rbp");
    emit("    ret");
    emit("");
    返回值 0;
};

声明 codegen_emit(){

    emit("; Atlanage v1.0 generated assembly (NASM win64)");
    emit("default rel");
    emit("");

    emit("section .text");
    emit("");

    设 i = 0;
    循环(i < g_sem_classes.长度()){
        创建 SemClass:cls;
        cls = g_sem_classes.获取(i);
        如果(cls.is_interface != 0){ i = i + 1; 继续; };
        如果(cls.methods != 空){
            设 j = 0;
            循环(j < cls.methods.长度()){
                创建 SemMethod:m;
                m = cls.methods.获取(j);
                gen_function(m);
                j = j + 1;
            };
        };
        i = i + 1;
    };

    设 i2 = 0;
    循环(i2 < g_sem_funcs.长度()){
        创建 SemMethod:m;
        m = g_sem_funcs.获取(i2);
        gen_function(m);
        i2 = i2 + 1;
    };

    设 i3 = 0;
    循环(i3 < g_sem_hooks.长度()){
        创建 SemMethod:m;
        m = g_sem_hooks.获取(i3);
        gen_function(m);
        i3 = i3 + 1;
    };

    设 i4 = 0;
    循环(i4 < g_sem_lambdas.长度()){
        创建 SemMethod:m;
        m = g_sem_lambdas.获取(i4);
        gen_function(m);
        i4 = i4 + 1;
    };

    设 i5 = 0;
    循环(i5 < g_task_funcs.长度()){
        创建 ASTNode:tn;
        tn = g_task_funcs.获取(i5);
        gen_task_func(tn, i5);
        i5 = i5 + 1;
    };

    gen_main();

    设 pr = 0;
    循环(pr < g_sem_classes.长度()){
        创建 SemClass:prcls;
        prcls = g_sem_classes.获取(pr);
        设 pj = 0;
        循环(pj < prcls.fields.长度()){
            设 pfn = prcls.fields.获取(pj);
            如果(pfn != 空){
                add_strlit(pfn);
            };
            pj = pj + 1;
        };
        pr = pr + 1;
    };

    emit("section .data");
    设 si = 0;
    循环(si < g_strlits.长度()){
        设 s = g_strlits.获取(si);
        emit("__atl_str_" + si + ": dq 4, __atl_str_" + si + "_data  ; ATL_STRING tag=4");
        emit_no_nl("__atl_str_" + si + "_data: db ");

        设 first = 1;
        设 k = 0;
        设 maxlen = 10000000;
        循环(k < maxlen){
            设 b = s.字节(k);
            如果(b == 0){ 跳出; };
            如果(first == 1){
                first = 0;
            }否则{
                emit_no_nl(", ");
            };
            emit_no_nl("" + b);
            k = k + 1;
        };
        如果(first == 1){
            emit_no_nl("0");
        };
        emit_no_nl(", 0");
        追加("\n");
        si = si + 1;
    };

    emit("__atl_int_0: dq 2, 0  ; ATL_INT tag=2, value=0");
    emit("__atl_int_1: dq 2, 1  ; ATL_INT tag=2, value=1");

    设 fi = 0;
    循环(fi < g_fplits.长度()){
        创建 ArrayList:fp;
        fp = g_fplits.获取(fi);
        设 v = fp.获取(0);
        设 id = fp.获取(1);
        设 vstr = "" + v;
        设 has_e = 0;
        设 ei = 0;
        循环(ei < vstr.长度()){
            设 ec = vstr.字节(ei);
            如果(ec == 101 || ec == 69){ has_e = 1; 跳出; };
            ei = ei + 1;
        };
        如果(has_e == 1){

            设 bits = 浮点位数(v);
            设 hexs = 格式化("%x", bits);
            设 pad = 16 - hexs.长度();
            循环(pad > 0){
                hexs = "0" + hexs;
                pad = pad - 1;
            };
            emit("__atl_fp_" + id + ": dq 0x" + hexs + "  ; float literal (large)");
        }否则{
            设 vi = 整数(v);
            如果(vi == v){
                vstr = vstr + ".0";
            };
            emit("__atl_fp_" + id + ": dq " + vstr + "  ; float literal");
        };
        fi = fi + 1;
    };
    emit("");

    设 fc = 0;
    循环(fc < g_sem_classes.长度()){
        创建 SemClass:cls;
        cls = g_sem_classes.获取(fc);
        如果(cls.nfields > 0){
            emit("__atl_fields_" + fc + ":");
            设 fj = 0;
            循环(fj < cls.fields.长度()){
                设 fn = cls.fields.获取(fj);
                如果(fn != 空){
                    设 fid = add_strlit(fn);
                    emit("    dq __atl_str_" + fid + "_data  ; field " + fn);
                }否则{
                    emit("    dq 0  ; field ?");
                };
                fj = fj + 1;
            };
            emit("    dq 0  ; 表尾");
        };
        fc = fc + 1;
    };
    emit("");

    emit("section .bss");
    emit("__atl_global_0: resq 1  ; fallback global (null)");
    设 gi = 0;
    循环(gi < g_sem_globals.长度()){
        设 gn = g_sem_globals.获取(gi);
        emit("__atl_global_" + (gi + 1) + ": resq 1  ; global var " + gn);
        gi = gi + 1;
    };
    设 ci = 0;
    循环(ci < g_sem_classes.长度()){
        创建 SemClass:cls;
        cls = g_sem_classes.获取(ci);
        如果(cls.is_interface != 0){ ci = ci + 1; 继续; };
        emit(singleton_label(cls) + ": resq 1  ; singleton " + cls.name);

        如果(cls.static_fields != 空){
            设 si = 0;
            循环(si < cls.static_fields.长度()){
                设 sfn = cls.static_fields.获取(si);
                emit("__atl_static_" + cls.id + "_" + si + ": resq 1  ; static field " + cls.name + "." + sfn);
                si = si + 1;
            };
        };
        ci = ci + 1;
    };
    emit("");

    emit("section .data");
    emit("global __atl_gc_roots");
    emit("__atl_gc_roots:");
    emit("    dq __atl_global_0, " + ((g_sem_globals.长度() + 1) * 8) + "  ; 全局槽区间");
    设 rci = 0;
    循环(rci < g_sem_classes.长度()){
        创建 SemClass:rcls;
        rcls = g_sem_classes.获取(rci);
        如果(rcls.is_interface == 0){
            emit("    dq " + singleton_label(rcls) + ", 8  ; singleton " + rcls.name);
        };
        如果(rcls.static_fields != 空 && rcls.static_fields.长度() > 0){
            emit("    dq __atl_static_" + rcls.id + "_0, " + (rcls.static_fields.长度() * 8) + "  ; static fields " + rcls.name);
        };
        rci = rci + 1;
    };
    emit("    dq 0, 0  ; 表尾");
    emit("section .bss");

    emit("extern atl_null");
    emit("extern atl_is_null");
    emit("extern atl_bool");
    emit("extern atl_int");
    emit("extern atl_float");
    emit("extern atl_tofloat");
    emit("extern atl_str_append_self");
    emit("extern atl_str");
    emit("extern atl_str_take");
    emit("extern atl_list_new");
    emit("extern atl_instance_new");
    emit("extern atl_class_register");
    emit("extern atl_method_register");
    emit("extern atl_class_fields_register");
    emit("extern atl_ref_new");
    emit("extern atl_func_wrap");
    emit("extern atl_truthy");
    emit("extern atl_to_cstr");
    emit("extern atl_to_str");
    emit("extern atl_add");
    emit("extern atl_sub");
    emit("extern atl_mul");
    emit("extern atl_div");
    emit("extern atl_mod");
    emit("extern atl_neg");
    emit("extern atl_not");
    emit("extern atl_band");
    emit("extern atl_bor");
    emit("extern atl_bxor");
    emit("extern atl_bnot");
    emit("extern atl_shl");
    emit("extern atl_shr");
    emit("extern atl_eq");
    emit("extern atl_ne");
    emit("extern atl_lt");
    emit("extern atl_gt");
    emit("extern atl_le");
    emit("extern atl_ge");
    emit("extern atl_deref");
    emit("extern atl_deref_set");
    emit("extern atl_list_get");
    emit("extern atl_list_set");
    emit("extern atl_list_add");
    emit("extern atl_list_add_kv");
    emit("extern atl_list_len");
    emit("extern atl_instance_get");
    emit("extern atl_instance_set");
    emit("extern atl_print");
    emit("extern atl_errprint");
    emit("extern atl_result_new");
    emit("extern atl_result_ok");
    emit("extern atl_result_fail");
    emit("extern atl_strcmp");
    emit("extern atl_input");
    emit("extern atl_input_ref");
    emit("extern atl_num");
    emit("extern atl_chr");
    emit("extern atl_codepoint");
    emit("extern atl_toint");
    emit("extern atl_str_split_lines");
    emit("extern atl_format");
    emit("extern atl_millis");
    emit("extern atl_micros");
    emit("extern atl_time_str");
    emit("extern atl_instance_destroy");
    emit("extern atl_key_pressed");
    emit("extern atl_games_tick");
    emit("extern atl_show_one");
    emit("extern atl_show_end");
    emit("extern atl_show_input");
    emit("extern atl_sleep_ms");
    emit("extern atl_stack_guard");
    emit("extern gc_push_frame");
    emit("extern gc_pop_frame");
    emit("extern atl_str_len");
    emit("extern atl_str_contains");
    emit("extern atl_str_sub");
    emit("extern atl_str_starts");
    emit("extern atl_str_ends");
    emit("extern atl_str_find_count");
    emit("extern atl_str_find_line");
    emit("extern atl_str_find_pos");
    emit("extern atl_str_byte");
    emit("extern atl_str_byte_sub");

    emit("extern atl_str_upper");
    emit("extern atl_str_lower");
    emit("extern atl_str_replace");
    emit("extern atl_str_split");
    emit("extern atl_str_trim");
    emit("extern atl_str_repeat");
    emit("extern atl_str_equals");

    emit("extern atl_list_delete");
    emit("extern atl_list_dedup");
    emit("extern atl_list_clear");
    emit("extern atl_list_sort");
    emit("extern atl_list_reverse");
    emit("extern atl_list_contains");
    emit("extern atl_list_find");
    emit("extern atl_dict_has_key");
    emit("extern atl_dict_delete_key");
    emit("extern atl_dict_keys");
    emit("extern atl_dict_values");
    emit("extern atl_list_map");
    emit("extern atl_list_filter");
    emit("extern atl_list_reduce");
    emit("extern atl_exc_top");
    emit("extern atl_exc_pop");
    emit("extern atl_exc_value");
    emit("extern atl_throw");
    emit("extern atl_rethrow");
    emit("extern atl_contains");
    emit("extern atl_sb_clear");
