设 g_in_gfx_block = 0;

类 Ctx {
公开:
    设 func 存在;
    设 cls 存在;
    设 is_method 存在;
    设 this_offset 存在;
    设 locals_bytes 存在;
    设 temp_base 存在;
    设 temp_depth 存在;
    设 frame_size 存在;
    设 loop_break 存在;
    设 loop_continue 存在;
    设 loop_counter_off 存在;

    构造(){
        func = 空;
        cls = 空;
        is_method = 0;
        this_offset = 0;
        locals_bytes = 0;
        temp_base = 0;
        temp_depth = 0;
        frame_size = 0;
        loop_break = 0;
        loop_continue = 0;
        loop_counter_off = 0;
    };
};

设 g_strlits = 空;
设 g_fplits = 空;
设 g_label_id = 0;
设 g_silent = 0;
设 g_func_uses_r12 = 0;
设 g_func_is_leaf = 1;
设 g_cur_func_body = 空;
设 g_temp_peak = 0;
设 g_task_seq = 0;
设 g_task_funcs = 创建 ArrayList;

声明 init_codegen(){
    清空();
    创建 ArrayList:g_strlits;
    创建 ArrayList:g_fplits;
    g_label_id = 0;
    g_silent = 0;
    g_temp_peak = 0;
    g_gfx_used = 0;
    g_gl_used = 0;
    g_vk_used = 0;
    g_input_used = 0;
    g_gfx_block_win_off = 0;
    返回值 0;
};

init_codegen();

设 g_gfx_used = 0;
设 g_gl_used = 0;
设 g_vk_used = 0;
设 g_input_used = 0;
设 g_gfx_block_win_off = 0;

声明 emit(s){
    如果(g_silent == 1){
        返回值 0;
    };
    如果(g_gfx_used == 0 && s.包含("atl_gfx_")){
        g_gfx_used = 1;
    };
    如果(g_gl_used == 0 && s.包含("atl_gl_")){
        g_gl_used = 1;
    };
    如果(g_vk_used == 0 && s.包含("atl_vk_")){
        g_vk_used = 1;
    };
    如果(g_input_used == 0 && (s.包含("atl_input_key") || s.包含("atl_input_mouse") || s.包含("atl_input_sync"))){
        g_input_used = 1;
    };
    追加(s + "\n");
    返回值 0;
};

声明 emit_no_nl(s){
    追加(s);
    返回值 0;
};

声明 add_strlit(s){
    设 i = 0;
    循环(i < g_strlits.长度()){
        如果(g_strlits.获取(i) == s){
            返回值 i;
        };
        i = i + 1;
    };
    g_strlits.添加(s);
    返回值 g_strlits.长度() - 1;
};

声明 add_fplit(v){
    设 i = 0;
    循环(i < g_fplits.长度()){
        创建 ArrayList:fp;
        fp = g_fplits.获取(i);
        如果(fp.获取(0) == v){
            返回值 fp.获取(1);
        };
        i = i + 1;
    };
    设 id = g_strlits.长度() + g_fplits.长度();
    创建 ArrayList:entry;
    entry.添加(v);
    entry.添加(id);
    g_fplits.添加(entry);
    返回值 id;
};

声明 temp_alloc(c){
    创建 Ctx:ctx;
    ctx = c;
    设 off = ctx.temp_base - ctx.temp_depth * 8;
    ctx.temp_depth = ctx.temp_depth + 1;
    如果(ctx.temp_depth > g_temp_peak){
        g_temp_peak = ctx.temp_depth;
    };
    返回值 off;
};

声明 temp_free(c, n){
    创建 Ctx:ctx;
    ctx = c;
    ctx.temp_depth = ctx.temp_depth - n;
    如果(ctx.temp_depth < 0){
        ctx.temp_depth = 0;
    };
    返回值 0;
};

声明 new_label(){
    设 id = g_label_id;
    g_label_id = g_label_id + 1;
    返回值 id;
};

声明 singleton_label(cls){
    创建 SemClass:c;
    c = cls;
    返回值 "__atl_singleton_" + c.id;
};

声明 global_label(idx){
    返回值 "__atl_global_" + idx;
};

声明 method_label(m){
    创建 SemMethod:sm;
    sm = m;
    设 prefix = "__atl_method_";
    如果(sm.kind == 1){
        prefix = "__atl_func_";
    };
    如果(sm.kind == 2){
        prefix = "__atl_hook_";
    };
    如果(sm.kind == 3){
        prefix = "__atl_lambda_";
    };
    返回值 prefix + sm.id;
};

声明 method_label_by_id(id){
    返回值 "__atl_method_" + id;
};

声明 align16(n){
    设 r = n;
    如果(r % 16 != 0){
        r = (r + 15) / 16 * 16;
    };
    返回值 r;
};

声明 reg_name(idx){
    如果(idx == 0){ 返回值 "rcx"; };
    如果(idx == 1){ 返回值 "rdx"; };
    如果(idx == 2){ 返回值 "r8"; };
    返回值 "r9";
};

声明 utf8_encode(cp){
    创建 ArrayList:bytes;
    如果(cp < 128){
        bytes.添加(cp);
    }否则{
        如果(cp < 2048){
            bytes.添加((cp >> 6) | 192);
            bytes.添加((cp & 63) | 128);
        }否则{
            如果(cp < 65536){
                bytes.添加((cp >> 12) | 224);
                bytes.添加(((cp >> 6) & 63) | 128);
                bytes.添加((cp & 63) | 128);
            }否则{
                bytes.添加((cp >> 18) | 240);
                bytes.添加(((cp >> 12) & 63) | 128);
                bytes.添加(((cp >> 6) & 63) | 128);
                bytes.添加((cp & 63) | 128);
            };
        };
    };
    返回值 bytes;
};

声明 gen_show_node(node, c){
    创建 ASTNode:n;
    n = node;
    创建 Ctx:ctx;
    ctx = c;
    如果(n.show_end == 1){

        emit("    sub rsp, 32");
        emit("    call atl_list_new");
        emit("    add rsp, 32");
        设 t_list = temp_alloc(ctx);
        emit("    mov [rbp + " + t_list + "], rax");
        如果(n.show_args != 空){
            设 i = 0;
            循环(i < n.show_args.长度()){
                gen_expr(n.show_args.获取(i), ctx);
                设 t_arg = temp_alloc(ctx);
                emit("    mov [rbp + " + t_arg + "], rax");
                emit("    mov rcx, [rbp + " + t_list + "]");
                emit("    mov rdx, [rbp + " + t_arg + "]");
                emit("    sub rsp, 32");
                emit("    call atl_list_add");
                emit("    add rsp, 32");
                temp_free(ctx, 1);
                i = i + 1;
            };
        };

        设 t_w = temp_alloc(ctx);
        设 t_h = temp_alloc(ctx);
        emit("    mov qword [rbp + " + t_w + "], 0");
        emit("    mov qword [rbp + " + t_h + "], 0");
        如果(n.show_has_size == 1 && n.show_w_expr != 空){
            gen_expr(n.show_w_expr, ctx);
            emit("    mov rax, [rax + 8]");
            emit("    mov [rbp + " + t_w + "], rax");
        };
        如果(n.show_has_size == 1 && n.show_h_expr != 空){
            gen_expr(n.show_h_expr, ctx);
            emit("    mov rax, [rax + 8]");
            emit("    mov [rbp + " + t_h + "], rax");
        };

        emit("    mov rcx, [rbp + " + t_list + "]");
        emit("    mov rdx, [rbp + " + t_w + "]");
        emit("    mov r8, [rbp + " + t_h + "]");
        emit("    sub rsp, 32");
        emit("    call atl_show_input");
        emit("    add rsp, 32");
        temp_free(ctx, 3);
    }否则{

        如果(n.show_args != 空){
            设 i = 0;
            循环(i < n.show_args.长度()){
                gen_expr(n.show_args.获取(i), ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_show_one");
                emit("    add rsp, 32");
                i = i + 1;
            };
        };
        emit("    sub rsp, 32");
        emit("    call atl_null");
        emit("    add rsp, 32");
    };
    返回值 0;
};

声明 check_expr_uses(e, name){
    如果(e == 空){ 返回值 1; };
    创建 ASTNode:x;
    x = e;
    如果(x.type == AST_VAR){
        返回值 1;
    };
    如果(x.type == AST_LITERAL){
        返回值 1;
    };
    如果(x.type == AST_INDEX){

        返回值 0;
    };
    如果(x.type == AST_BINARY || x.type == AST_UNARY){
        如果(x.sem != 空 && x.sem.type_kind == T_INT){
            设 r1 = check_expr_uses(x.lhs, name);
            如果(r1 == 0){ 返回值 0; };
            如果(x.rhs != 空){
                设 r2 = check_expr_uses(x.rhs, name);
                如果(r2 == 0){ 返回值 0; };
            };
            返回值 1;
        };
        设 is_cmp = 0;
        如果(x.type == AST_BINARY && (x.op == TOK_EQ || x.op == TOK_NE || x.op == TOK_LT ||
           x.op == TOK_GT || x.op == TOK_LE || x.op == TOK_GE)){
            is_cmp = 1;

        };
        如果(is_cmp == 0){
            如果(x.lhs != 空 && x.lhs.type == AST_VAR && x.lhs.sval == name){ 返回值 0; };
            如果(x.rhs != 空 && x.rhs.type == AST_VAR && x.rhs.sval == name){ 返回值 0; };
        };
        设 r3 = check_expr_uses(x.lhs, name);
        如果(r3 == 0){ 返回值 0; };
        如果(x.rhs != 空){
            设 r4 = check_expr_uses(x.rhs, name);
            如果(r4 == 0){ 返回值 0; };
        };
        返回值 1;
    };
    如果(x.type == AST_CALL){

        返回值 0;
    };
    如果(x.type == AST_MODCALL){

        返回值 0;
    };
    如果(x.type == AST_METHODCALL){

        返回值 0;
    };
    如果(x.type == AST_REF){

        如果(x.lhs != 空 && x.lhs.type == AST_VAR && x.lhs.sval == name){ 返回值 0; };
        如果(x.lhs != 空){
            设 r8 = check_expr_uses(x.lhs, name);
            如果(r8 == 0){ 返回值 0; };
        };
        返回值 1;
    };
    返回值 1;
};

声明 check_stmt_uses(s, name){
    如果(s == 空){ 返回值 1; };
    创建 ASTNode:st;
    st = s;
    如果(st.type == AST_ASSIGN){
        如果(st.lhs != 空 && st.lhs.type == AST_VAR && st.lhs.sval == name){
            创建 ASTNode:rr;
            rr = st.rhs;
            如果(rr != 空 && rr.type == AST_BINARY){
                如果(rr.op == TOK_PLUS || rr.op == TOK_MINUS){
                    如果(rr.lhs != 空 && rr.lhs.type == AST_VAR && rr.lhs.sval == name){
                        如果(rr.rhs != 空 && rr.rhs.type == AST_LITERAL && rr.rhs.op == LIT_INT){
                            返回值 1;
                        };
                    };
                };
            };
            返回值 0;
        };
        如果(st.rhs != 空){ 返回值 check_expr_uses(st.rhs, name); };
        返回值 1;
    };
    如果(st.type == AST_IF){
        设 r1 = check_expr_uses(st.cond, name);
        如果(r1 == 0){ 返回值 0; };
        设 r2 = check_stmt_uses(st.then_block, name);
        如果(r2 == 0){ 返回值 0; };
        如果(st.else_block != 空){
            设 r3 = check_stmt_uses(st.else_block, name);
            如果(r3 == 0){ 返回值 0; };
        };
        返回值 1;
    };
    如果(st.type == AST_BLOCK){
        如果(st.children != 空){
            设 i = 0;
            循环(i < st.children.长度()){
                设 r4 = check_stmt_uses(st.children.获取(i), name);
                如果(r4 == 0){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };
    如果(st.type == AST_EXPRSTMT){
        如果(st.operand != 空){
            设 r5 = check_expr_uses(st.operand, name);
            如果(r5 == 0){ 返回值 0; };
        };
        返回值 1;
    };
    如果(st.type == AST_LOOP){
        如果(st.loop_cond != 空){
            设 r6 = check_expr_uses(st.loop_cond, name);
            如果(r6 == 0){ 返回值 0; };
        };
        设 r7 = check_stmt_uses(st.loop_body, name);
        如果(r7 == 0){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_RETURN || st.type == AST_VARDECL){
        返回值 0;
    };
    返回值 1;
};

声明 str_acc_mentions(e, name){
    如果(e == 空){ 返回值 0; };
    创建 ASTNode:x;
    x = e;
    如果(x.type == AST_VAR && x.sval == name){ 返回值 1; };
    如果(x.type == AST_BINARY){
        如果(str_acc_mentions(x.lhs, name) == 1){ 返回值 1; };
        如果(x.rhs != 空 && str_acc_mentions(x.rhs, name) == 1){ 返回值 1; };
        返回值 0;
    };
    如果(x.type == AST_UNARY){
        返回值 str_acc_mentions(x.operand, name);
    };
    如果(x.type == AST_CALL || x.type == AST_METHODCALL || x.type == AST_HOOKCALL){
        如果(x.obj != 空 && str_acc_mentions(x.obj, name) == 1){ 返回值 1; };
        如果(x.args != 空){
            设 i = 0;
            循环(i < x.args.长度()){
                如果(str_acc_mentions(x.args.获取(i), name) == 1){ 返回值 1; };
                i = i + 1;
            };
        };
        返回值 0;
    };
    如果(x.type == AST_INDEX){
        如果(str_acc_mentions(x.obj, name) == 1){ 返回值 1; };
        如果(x.index != 空 && str_acc_mentions(x.index, name) == 1){ 返回值 1; };
        返回值 0;
    };
    如果(x.type == AST_MEMBER){
        返回值 str_acc_mentions(x.obj, name);
    };
    返回值 0;
};

声明 str_acc_escape_expr(e, name){
    如果(e == 空){ 返回值 0; };
    创建 ASTNode:x;
    x = e;
    如果(x.type == AST_VAR || x.type == AST_LITERAL){
        返回值 0;
    };
    如果(x.type == AST_BINARY){
        如果(str_acc_escape_expr(x.lhs, name) == 1){ 返回值 1; };
        如果(x.rhs != 空 && str_acc_escape_expr(x.rhs, name) == 1){ 返回值 1; };
        返回值 0;
    };
    如果(x.type == AST_UNARY){
        如果(x.op == TOK_AMP && x.operand != 空 && x.operand.type == AST_VAR && x.operand.sval == name){
            返回值 1;
        };
        返回值 str_acc_escape_expr(x.operand, name);
    };
    如果(x.type == AST_METHODCALL){
        如果(x.obj != 空 && str_acc_escape_expr(x.obj, name) == 1){ 返回值 1; };
        如果(x.args != 空){
            设 i = 0;
            循环(i < x.args.长度()){

                创建 ASTNode:argm;
                argm = x.args.获取(i);
                如果(argm != 空 && argm.type == AST_VAR && argm.sval == name){ 返回值 1; };
                i = i + 1;
            };
        };
        返回值 0;
    };
    如果(x.type == AST_CALL || x.type == AST_HOOKCALL){
        如果(x.args != 空){
            设 i = 0;
            循环(i < x.args.长度()){

                创建 ASTNode:argc;
                argc = x.args.获取(i);
                如果(argc != 空 && argc.type == AST_VAR && argc.sval == name){ 返回值 1; };
                i = i + 1;
            };
        };
        返回值 0;
    };
    如果(x.type == AST_INDEX){
        如果(str_acc_escape_expr(x.obj, name) == 1){ 返回值 1; };
        如果(x.index != 空 && str_acc_escape_expr(x.index, name) == 1){ 返回值 1; };
        返回值 0;
    };
    如果(x.type == AST_MEMBER){
        返回值 str_acc_escape_expr(x.obj, name);
    };
    返回值 1;
};

声明 str_acc_safe_stmt(s, name){
    如果(s == 空){ 返回值 1; };
    创建 ASTNode:st;
    st = s;
    如果(st.type == AST_ASSIGN){
        如果(st.lhs != 空 && st.lhs.type == AST_VAR && st.lhs.sval == name){
            创建 ASTNode:rr;
            rr = st.rhs;
            如果(rr != 空 && rr.type == AST_BINARY && rr.op == TOK_PLUS &&
               rr.lhs != 空 && rr.lhs.type == AST_VAR && rr.lhs.sval == name){
                返回值 1;
            };
            如果(rr != 空 && rr.type == AST_LITERAL && rr.op == LIT_STRING){
                返回值 1;
            };
            返回值 0;
        };

        如果(st.lhs != 空 && st.lhs.type == AST_VAR){
            如果(st.rhs != 空 && str_acc_mentions(st.rhs, name) == 1){ 返回值 0; };
            返回值 1;
        };
        如果(str_acc_escape_expr(st.lhs, name) == 1){ 返回值 0; };
        如果(str_acc_escape_expr(st.rhs, name) == 1){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_IF){
        如果(str_acc_escape_expr(st.cond, name) == 1){ 返回值 0; };
        如果(str_acc_safe_stmt(st.then_block, name) == 0){ 返回值 0; };
        如果(st.else_block != 空 && str_acc_safe_stmt(st.else_block, name) == 0){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_BLOCK){
        如果(st.children != 空){
            设 i = 0;
            循环(i < st.children.长度()){
                如果(str_acc_safe_stmt(st.children.获取(i), name) == 0){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };
    如果(st.type == AST_EXPRSTMT){
        如果(str_acc_escape_expr(st.operand, name) == 1){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_LOOP){
        如果(st.loop_cond != 空 && str_acc_escape_expr(st.loop_cond, name) == 1){ 返回值 0; };
        如果(st.loop_init != 空 && str_acc_escape_expr(st.loop_init, name) == 1){ 返回值 0; };
        如果(st.loop_step != 空 && str_acc_escape_expr(st.loop_step, name) == 1){ 返回值 0; };
        如果(str_acc_safe_stmt(st.loop_body, name) == 0){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_RETURN){

        如果(st.ret_value != 空 && st.ret_value.type == AST_VAR && st.ret_value.sval == name){
            返回值 0;
        };
        如果(str_acc_escape_expr(st.ret_value, name) == 1){ 返回值 0; };
        返回值 1;
    };
    如果(st.type == AST_VARDECL){

        如果(st.var_inits != 空){
            设 i = 0;
            循环(i < st.var_inits.长度()){
                如果(str_acc_mentions(st.var_inits.获取(i), name) == 1){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };

    如果(st.type == AST_SHOW){
        如果(st.show_args != 空){
            设 i = 0;
            循环(i < st.show_args.长度()){
                如果(str_acc_escape_expr(st.show_args.获取(i), name) == 1){ 返回值 0; };
                i = i + 1;
            };
        };
        返回值 1;
    };
    emit("; T6DBG escape stmt type=" + st.type + " name=" + name);
    返回值 0;
};

声明 find_loop_counter(n, ctx){
    如果(ctx.func == 空){ 返回值 空; };
    创建 ASTNode:ln;
    ln = n;
    如果(ln.loop_kind != LOOP_COND && ln.loop_kind != LOOP_CFOR){
        返回值 空;
    };
    设 cand_name = 空;
    如果(ln.loop_cond != 空 && ln.loop_cond.type == AST_BINARY && ln.loop_cond.lhs != 空 &&
       ln.loop_cond.lhs.type == AST_VAR){

        设 cond_int = 0;
        如果(ln.loop_cond.sem != 空){
            创建 SemNode:cs;
            cs = ln.loop_cond.sem;
            如果(cs.type_kind == T_INT){ cond_int = 1; };
        };
        如果(cond_int == 0){
            如果(ln.loop_cond.op == TOK_EQ || ln.loop_cond.op == TOK_NE || ln.loop_cond.op == TOK_LT ||
               ln.loop_cond.op == TOK_GT || ln.loop_cond.op == TOK_LE || ln.loop_cond.op == TOK_GE){
                cond_int = 1;
            };
        };
        如果(cond_int == 1){
            cand_name = ln.loop_cond.lhs.sval;
        };
    };
    如果(cand_name == 空){ 返回值 空; };
    创建 SemLocal:cand;
    cand = gen_find_local(ctx.func, cand_name);
    如果(cand == 空 || cand.type_kind != T_INT){ 返回值 空; };

    设 r1 = check_expr_uses(ln.loop_cond, cand_name);
    如果(r1 == 0){ 返回值 空; };
    设 r2 = check_stmt_uses(ln.loop_body, cand_name);
    如果(r2 == 0){ 返回值 空; };
    如果(ln.loop_step != 空){
        设 r3 = check_stmt_uses(ln.loop_step, cand_name);
        如果(r3 == 0){ 返回值 空; };
    };
    返回值 cand;
};

声明 gen_float_value(node, ctx){
    如果(node == 空){
        emit("    xorps xmm0, xmm0  ; null (float 0)");
        返回值 0;
    };
    创建 ASTNode:n;
    n = node;
    如果(n.type == AST_LITERAL){
        如果(n.op == LIT_FLOAT){
            设 id = add_fplit(n.fval);
            emit("    movsd xmm0, [__atl_fp_" + id + "]  ; float literal");
            返回值 0;
        };
        如果(n.op == LIT_INT){
            emit("    mov rax, " + n.ival);
            emit("    cvtsi2sd xmm0, rax  ; int literal -> double");
            返回值 0;
        };
    };
    如果(n.type == AST_VAR && n.sem != 空){
        创建 SemNode:s;
        s = n.sem;
        如果(s.kind == SN_LOCAL && s.type_kind == T_FLOAT){
            emit("    movsd xmm0, [rbp + " + s.offset + "]  ; " + n.sval + " (float local)");
            返回值 0;
        };
    };
    如果(n.type == AST_BINARY && n.sem != 空){
        创建 SemNode:bs;
        bs = n.sem;
        如果(bs.type_kind == T_FLOAT){
            设 op = n.op;
            gen_float_value(n.lhs, ctx);
            设 t = temp_alloc(ctx);
            emit("    movsd [rbp + " + t + "], xmm0  ; lhs double");
            gen_float_value(n.rhs, ctx);
            emit("    movsd xmm1, [rbp + " + t + "]  ; reload lhs");
            temp_free(ctx, 1);
            如果(op == TOK_PLUS){
                emit("    addsd xmm1, xmm0");
            }又如果(op == TOK_MINUS){
                emit("    subsd xmm1, xmm0");
            }又如果(op == TOK_STAR){
                emit("    mulsd xmm1, xmm0");
            }又如果(op == TOK_SLASH){
                emit("    pxor xmm2, xmm2");
                emit("    comisd xmm0, xmm2");
                设 lz = new_label();
                设 le2 = new_label();
                emit("    jz __atl_L" + lz);
                emit("    divsd xmm1, xmm0");
                emit("    jmp __atl_L" + le2);
                emit("__atl_L" + lz + ":");
                emit("    pxor xmm1, xmm1  ; div by zero -> 0.0");
                emit("__atl_L" + le2 + ":");
            };
            emit("    movsd xmm0, xmm1  ; result");
            返回值 0;
        };
    };

    gen_expr(node, ctx);
    emit("    mov rcx, rax");
    emit("    sub rsp, 32");
    emit("    call atl_tofloat");
    emit("    add rsp, 32");
    emit("    movq xmm0, [rax + 8]  ; unbox double");
    返回值 0;
};

声明 gen_int_value(node, ctx){
    如果(node == 空){
        emit("    xor rax, rax  ; null node (int)");
        返回值 0;
    };
    创建 ASTNode:n;
    n = node;
    如果(n.type == AST_LITERAL){
        如果(n.op == LIT_INT){
            emit("    mov rax, " + n.ival + "  ; int literal");
        }又如果(n.op == LIT_TRUE){
            emit("    mov rax, 1  ; true as int");
        }又如果(n.op == LIT_FALSE){
            emit("    xor rax, rax  ; false as int");
        }否则{
            gen_expr(node, ctx);
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_toint");
            emit("    add rsp, 32");
            emit("    mov rax, [rax + 8]  ; unbox int");
        };
        返回值 0;
    };
    如果(n.type == AST_VAR && n.sem != 空){
        创建 SemNode:s;
        s = n.sem;
        如果(s.kind == SN_LOCAL && s.type_kind == T_INT){
            如果(s.offset == ctx.loop_counter_off){
                emit("    mov rax, r12  ; " + n.sval + " (counter)");
            }否则{
                emit("    mov rax, [rbp + " + s.offset + "]  ; " + n.sval + " (unboxed int)");
            };
            返回值 0;
        };
        gen_expr(node, ctx);
        emit("    mov rcx, rax");
        emit("    sub rsp, 32");
        emit("    call atl_toint");
        emit("    add rsp, 32");
        emit("    mov rax, [rax + 8]  ; unbox int");
        返回值 0;
    };
    如果(n.type == AST_BINARY && n.sem != 空){
        创建 SemNode:bs;
        bs = n.sem;
        如果(bs.type_kind == T_INT){
            gen_int_binary_raw(n, ctx);
            返回值 0;
        };
    };
    如果(n.type == AST_CALL && n.sem != 空){
        创建 SemNode:cs;
        cs = n.sem;
        如果(cs.type_kind == T_INT){

            gen_call(n, ctx);
            返回值 0;
        };
    };
    gen_expr(node, ctx);
    emit("    mov rcx, rax");
    emit("    sub rsp, 32");
    emit("    call atl_toint");
    emit("    add rsp, 32");
    emit("    mov rax, [rax + 8]  ; unbox int");
    返回值 0;
};

声明 gen_int_binary_raw(node, ctx){
    创建 ASTNode:n;
    n = node;
    设 op = n.op;
    设 rhs_kind = 0;
    如果(n.rhs != 空){
        如果(n.rhs.type == AST_LITERAL && n.rhs.op == LIT_INT){
            rhs_kind = 1;
        }又如果(n.rhs.type == AST_VAR && n.rhs.sem != 空){
            创建 SemNode:rs;
            rs = n.rhs.sem;
            如果(rs.kind == SN_LOCAL && rs.type_kind == T_INT){
                rhs_kind = 2;
            };
        };
    };
    如果(rhs_kind != 0){
        gen_int_value(n.lhs, ctx);

        如果(rhs_kind == 2 && n.lhs != 空 && n.lhs.type == AST_VAR && n.lhs.sem != 空){
            创建 SemNode:ls;
            ls = n.lhs.sem;
            创建 SemNode:rs2;
            rs2 = n.rhs.sem;
            如果(ls.kind == rs2.kind && ls.offset == rs2.offset && ls.type_kind == rs2.type_kind){
                如果(op == TOK_PLUS){
                    emit("    add rax, rax  ; self-add");
                    返回值 0;
                };
                如果(op == TOK_STAR){
                    emit("    imul rax, rax  ; self-mul");
                    返回值 0;
                };
            };
        };

        设 skip_rcx = 0;
        如果((op == TOK_SLASH || op == TOK_PERCENT) && rhs_kind == 1){
            skip_rcx = 1;
        };
        如果(skip_rcx == 0){
            如果(rhs_kind == 1){
                emit("    mov rcx, " + n.rhs.ival);
            }又如果(rhs_kind == 2){
                创建 SemNode:r2;
                r2 = n.rhs.sem;
                如果(r2.offset == ctx.loop_counter_off){
                    emit("    mov rcx, r12  ; " + n.rhs.sval + " (counter)");
                }否则{
                    emit("    mov rcx, [rbp + " + r2.offset + "]  ; " + n.rhs.sval);
                };
            };
        };
    }否则{
        gen_int_value(n.lhs, ctx);
        设 t = temp_alloc(ctx);
        emit("    mov [rbp + " + t + "], rax");
        gen_int_value(n.rhs, ctx);
        emit("    mov rcx, rax");
        emit("    mov rax, [rbp + " + t + "]");
        temp_free(ctx, 1);
    };
    如果(op == TOK_PLUS){
        emit("    add rax, rcx");
    }又如果(op == TOK_MINUS){
        emit("    sub rax, rcx");
    }又如果(op == TOK_STAR){
        emit("    imul rax, rcx");
    }又如果(op == TOK_SLASH){

        设 div_const = 0;
        如果(rhs_kind == 1){ div_const = n.rhs.ival; };
        如果(div_const > 0 && ((div_const & (div_const - 1)) == 0)){
            设 shift = 0;
            设 v = div_const;
            循环(v > 1){
                shift = shift + 1;
                v = v >> 1;
            };
            如果(shift == 1){
                emit("    sar rax, 1");
            }否则{
                emit("    sar rax, " + shift);
            };
        }又如果(div_const > 1){
            设 l0 = new_label();
            设 l1 = new_label();
            emit("    mov rcx, " + div_const);
            emit("    test rcx, rcx");
            emit("    jz __atl_L" + l0);
            emit("    cqo");
            emit("    idiv rcx");
            emit("    jmp __atl_L" + l1);
            emit("__atl_L" + l0 + ":");
            emit("    xor rax, rax  ; div by zero -> 0");
            emit("__atl_L" + l1 + ":");
        }否则{
            设 l0 = new_label();
            设 l1 = new_label();
            emit("    test rcx, rcx");
            emit("    jz __atl_L" + l0);
            emit("    cqo");
            emit("    idiv rcx");
            emit("    jmp __atl_L" + l1);
            emit("__atl_L" + l0 + ":");
            emit("    xor rax, rax  ; div by zero -> 0");
            emit("__atl_L" + l1 + ":");
        };
    }又如果(op == TOK_PERCENT){
        设 mod_const = 0;
        如果(rhs_kind == 1){ mod_const = n.rhs.ival; };
        如果(mod_const > 0 && ((mod_const & (mod_const - 1)) == 0)){
            emit("    and rax, " + (mod_const - 1));
        }又如果(mod_const > 1){
            设 l0 = new_label();
            设 l1 = new_label();
            emit("    mov rcx, " + mod_const);
            emit("    test rcx, rcx");
            emit("    jz __atl_L" + l0);
            emit("    cqo");
            emit("    idiv rcx");
            emit("    mov rax, rdx");
            emit("    jmp __atl_L" + l1);
            emit("__atl_L" + l0 + ":");
            emit("    xor rax, rax  ; mod by zero -> 0");
            emit("__atl_L" + l1 + ":");
        }否则{
            设 l0 = new_label();
            设 l1 = new_label();
            emit("    test rcx, rcx");
            emit("    jz __atl_L" + l0);
            emit("    cqo");
            emit("    idiv rcx");
            emit("    mov rax, rdx");
            emit("    jmp __atl_L" + l1);
            emit("__atl_L" + l0 + ":");
            emit("    xor rax, rax  ; mod by zero -> 0");
            emit("__atl_L" + l1 + ":");
        };
    }又如果(op == TOK_AMP){
        emit("    and rax, rcx");
    }又如果(op == TOK_BOR){
        emit("    or rax, rcx");
    }又如果(op == TOK_BXOR){
        emit("    xor rax, rcx");
    }又如果(op == TOK_SHL){
        emit("    shl rax, cl");
    }又如果(op == TOK_SHR){
        emit("    sar rax, cl");
    };
    返回值 0;
};

声明 gen_int_cmp(lhs, rhs, ctx){
    gen_int_value(lhs, ctx);
    如果(rhs != 空 && rhs.type == AST_LITERAL && rhs.op == LIT_INT){
        emit("    cmp rax, " + rhs.ival);
    }又如果(rhs != 空 && rhs.type == AST_LITERAL && rhs.op == LIT_TRUE){
        emit("    cmp rax, 1");
    }又如果(rhs != 空 && rhs.type == AST_LITERAL && rhs.op == LIT_FALSE){
        emit("    cmp rax, 0");
    }又如果(rhs != 空 && rhs.type == AST_VAR && rhs.sem != 空){
        创建 SemNode:rs;
        rs = rhs.sem;
        如果(rs.kind == SN_LOCAL && rs.type_kind == T_INT){
            如果(rs.offset == ctx.loop_counter_off){
                emit("    cmp rax, r12  ; " + rhs.sval + " (counter)");
            }否则{
                emit("    cmp rax, [rbp + " + rs.offset + "]  ; " + rhs.sval);
            };
        }否则{
            设 t = temp_alloc(ctx);
            emit("    mov [rbp + " + t + "], rax");
            gen_int_value(rhs, ctx);
            emit("    mov rcx, rax");
            emit("    mov rax, [rbp + " + t + "]");
            temp_free(ctx, 1);
            emit("    cmp rax, rcx");
        };
    }否则{
        设 t = temp_alloc(ctx);
        emit("    mov [rbp + " + t + "], rax");
        gen_int_value(rhs, ctx);
        emit("    mov rcx, rax");
        emit("    mov rax, [rbp + " + t + "]");
        temp_free(ctx, 1);
        emit("    cmp rax, rcx");
    };
    返回值 0;
};

声明 gen_cond_jmp_false(cond, ctx, l_false){
    如果(cond == 空 || cond.type != AST_BINARY){ 返回值 0; };
    创建 ASTNode:cn;
    cn = cond;
    设 lt = 0;
    如果(cn.lhs != 空 && cn.lhs.sem != 空){
        创建 SemNode:ln;
        ln = cn.lhs.sem;
        lt = ln.type_kind;
    };
    设 rt = 0;
    如果(cn.rhs != 空 && cn.rhs.sem != 空){
        创建 SemNode:rn;
        rn = cn.rhs.sem;
        rt = rn.type_kind;
    };
    如果(lt != T_INT || rt != T_INT){ 返回值 0; };
    设 jcc = 空;
    如果(cn.op == TOK_EQ){ jcc = "jne"; };
    如果(cn.op == TOK_NE){ jcc = "je"; };
    如果(cn.op == TOK_LT){ jcc = "jge"; };
    如果(cn.op == TOK_GT){ jcc = "jle"; };
    如果(cn.op == TOK_LE){ jcc = "jg"; };
    如果(cn.op == TOK_GE){ jcc = "jl"; };
    如果(jcc == 空){ 返回值 0; };
    gen_int_cmp(cn.lhs, cn.rhs, ctx);
    emit("    " + jcc + " __atl_L" + l_false + "  ; cond false");
    返回值 1;
};

声明 gen_expr(node, c){
    如果(node == 空){
        emit("    xor rax, rax  ; null node");
        返回值 0;
    };
    创建 ASTNode:n;
    n = node;
    创建 Ctx:ctx;
    ctx = c;

    如果(n.type == AST_WAIT_TASK){
        gen_expr(n.ret_value, ctx);
        emit("    mov rcx, rax");
        emit("    sub rsp, 32");
        emit("    call atl_task_wait");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_TRY_BUBBLE){
        gen_expr(n.operand, ctx);
        emit("    mov rcx, rax");
        emit("    mov eax, [rcx]  ; tag");
        emit("    cmp eax, 11");
        设 lbad = new_label();
        设 lok = new_label();
        设 lb_end = new_label();
        emit("    jne __atl_L" + lbad + "  ; 非 Result → 报错");
        emit("    mov rdx, [rcx + 8]  ; is_success");
        emit("    test rdx, rdx");
        emit("    jnz __atl_L" + lok + "  ; 成功 → 解包");
        emit("    mov rax, rcx        ; 失败 → 返回该 Result 给调用方");
        emit("    mov rsp, rbp");
        emit("    pop rbp");
        emit("    ret");
        emit("__atl_L" + lok + ":");
        emit("    mov rax, [rcx + 16]  ; 成功 → 取值");
        emit("    jmp __atl_L" + lb_end);
        emit("__atl_L" + lbad + ":");
        emit("    ; 非 Result 对象: 报错 + 返回原值(不崩)");
        emit("    mov rax, rcx");
        emit("    sub rsp, 48");
        emit("    mov [rsp + 40], rax  ; 保存原对象");
        设 cid_bb = add_strlit("切~ ?冒泡: 对象不是结果(tag=%d)——欧尼酱要对 成功()/失败() 返回的值用 ?");
        emit("    lea rcx, [__atl_str_" + cid_bb + "_data]");
        emit("    mov rdx, rax");
        emit("    mov eax, [rdx]");
        emit("    mov rdx, rax");
        emit("    sub rsp, 32");
        emit("    call atl_fprintf_stderr");
        emit("    add rsp, 32");
        emit("    mov rax, [rsp + 40]");
        emit("    add rsp, 48");
        emit("__atl_L" + lb_end + ":");
        返回值 0;
    };

    如果(n.type == AST_ASYNC){
        设 tseq = g_task_seq;
        g_task_seq = g_task_seq + 1;
        g_task_funcs.添加(n);
        emit("    lea rcx, [__atl_task_" + tseq + "]");
        emit("    sub rsp, 32");
        emit("    call atl_task_spawn");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_LITERAL){
        如果(n.op == LIT_INT){

            如果(n.ival == 0){
                emit("    lea rax, [__atl_int_0]  ; int 0 (static singleton)");
            }又如果(n.ival == 1){
                emit("    lea rax, [__atl_int_1]  ; int 1 (static singleton)");
            }否则{
                emit("    mov rcx, " + n.ival);
                emit("    sub rsp, 32");
                emit("    call atl_int");
                emit("    add rsp, 32");
            };
        }又如果(n.op == LIT_FLOAT){
            设 id = add_fplit(n.fval);
            emit("    movsd xmm0, [__atl_fp_" + id + "]");
            emit("    movq rcx, xmm0");
            emit("    sub rsp, 32");
            emit("    call atl_float");
            emit("    add rsp, 32");
        }又如果(n.op == LIT_STRING){
            设 id = add_strlit(n.sval);
            emit("    lea rax, [__atl_str_" + id + "]  ; string (static object)");
        }又如果(n.op == LIT_TRUE){
            emit("    mov rcx, 1");
            emit("    sub rsp, 32");
            emit("    call atl_bool");
            emit("    add rsp, 32");
        }又如果(n.op == LIT_FALSE){
            emit("    xor rcx, rcx");
            emit("    sub rsp, 32");
            emit("    call atl_bool");
            emit("    add rsp, 32");
        }又如果(n.op == LIT_NULL){
            emit("    sub rsp, 32");
            emit("    call atl_null");
            emit("    add rsp, 32");
        };
        返回值 0;
    };

    如果(n.type == AST_VAR){
        创建 SemNode:s;
        s = n.sem;
        如果(s == 空){
            emit("    xor rax, rax  ; unresolved var");
            返回值 0;
        };
        如果(s.kind == SN_LOCAL){
            创建 SemNode:lcs;
            lcs = s;
            如果(lcs.type_kind == T_INT){

                emit("    mov rcx, [rbp + " + lcs.offset + "]  ; " + n.sval + " (int local)");
                emit("    sub rsp, 32");
                emit("    call atl_int");
                emit("    add rsp, 32");
            }又如果(lcs.type_kind == T_FLOAT){

                emit("    movsd xmm0, [rbp + " + lcs.offset + "]  ; " + n.sval + " (float local)");
                emit("    movq rcx, xmm0");
                emit("    sub rsp, 32");
                emit("    call atl_float");
                emit("    add rsp, 32");
            }否则{
                emit("    mov rax, [rbp + " + lcs.offset + "]  ; " + n.sval);
            };
        }又如果(s.kind == SN_FIELD){
            设 off = ctx.this_offset;
            emit("    mov rax, [rbp + " + off + "]  ; this");
            emit("    mov rax, [rax + 8]   ; inst");
            emit("    mov rax, [rax + 8]   ; field_vals");
            emit("    mov rax, [rax + " + (s.offset * 8) + "]  ; field " + n.sval);
        }又如果(s.kind == SN_GLOBAL){
            emit("    mov rax, [" + global_label(s.offset) + "]  ; " + n.sval);
        }又如果(s.kind == SN_CLASS){
            emit("    mov rax, [" + singleton_label(s.cls) + "]  ; class " + n.sval + " singleton");
        }又如果(s.kind == SN_SPECIAL){
            emit("    xor rax, rax  ; special var");
        }又如果(s.kind == SN_BUILTIN_VAR){
            如果(n.sval == "时间"){
                emit("    sub rsp, 32");
                emit("    call atl_time_str");
                emit("    add rsp, 32");
            }否则{
                emit("    xor rax, rax  ; builtin var " + n.sval);
            };
        }否则{
            emit("    xor rax, rax  ; var kind " + s.kind);
        };
        返回值 0;
    };

    如果(n.type == AST_BINARY){
        设 op = n.op;

        如果(n.sem != 空){
            创建 SemNode:bsn;
            bsn = n.sem;
            如果(bsn.type_kind == T_INT){
                gen_int_binary_raw(n, ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_int");
                emit("    add rsp, 32");
                返回值 0;
            };
            如果(bsn.type_kind == T_FLOAT){

                gen_float_value(n, ctx);
                emit("    movq rcx, xmm0");
                emit("    sub rsp, 32");
                emit("    call atl_float");
                emit("    add rsp, 32");
                返回值 0;
            };
        };

        如果(op == TOK_AND || op == TOK_OR){
            设 l_false = new_label();
            设 l_end = new_label();
            gen_expr(n.lhs, ctx);
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_truthy");
            emit("    add rsp, 32");
            如果(op == TOK_AND){
                emit("    test eax, eax");
                emit("    jz __atl_L" + l_false);
                gen_expr(n.rhs, ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_truthy");
                emit("    add rsp, 32");
                emit("    test eax, eax");
                emit("    jz __atl_L" + l_false);
                emit("    mov rcx, 1");
                emit("    sub rsp, 32");
                emit("    call atl_bool");
                emit("    add rsp, 32");
                emit("    jmp __atl_L" + l_end);
                emit("__atl_L" + l_false + ":");
                emit("    xor rcx, rcx");
                emit("    sub rsp, 32");
                emit("    call atl_bool");
                emit("    add rsp, 32");
                emit("__atl_L" + l_end + ":");
            }否则{

                emit("    test eax, eax");
                emit("    jnz __atl_L" + l_false);
                gen_expr(n.rhs, ctx);
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_truthy");
                emit("    add rsp, 32");
                emit("    test eax, eax");
                emit("    jnz __atl_L" + l_false);
                emit("    xor rcx, rcx");
                emit("    sub rsp, 32");
                emit("    call atl_bool");
                emit("    add rsp, 32");
                emit("    jmp __atl_L" + l_end);
                emit("__atl_L" + l_false + ":");
                emit("    mov rcx, 1");
                emit("    sub rsp, 32");
                emit("    call atl_bool");
                emit("    add rsp, 32");
                emit("__atl_L" + l_end + ":");
            };
            返回值 0;
        };

        gen_expr(n.lhs, ctx);
        设 t_lhs = temp_alloc(ctx);
        emit("    mov [rbp + " + t_lhs + "], rax");
        gen_expr(n.rhs, ctx);
        设 t_rhs = temp_alloc(ctx);
        emit("    mov [rbp + " + t_rhs + "], rax");
        emit("    mov rcx, [rbp + " + t_lhs + "]");
        emit("    mov rdx, [rbp + " + t_rhs + "]");
        temp_free(ctx, 2);
        设 fn = 空;
        如果(op == TOK_PLUS){ fn = "atl_add"; };
        如果(op == TOK_MINUS){ fn = "atl_sub"; };
        如果(op == TOK_STAR){ fn = "atl_mul"; };
        如果(op == TOK_SLASH){ fn = "atl_div"; };
        如果(op == TOK_PERCENT){ fn = "atl_mod"; };
        如果(op == TOK_EQ){ fn = "atl_eq"; };
        如果(op == TOK_NE){ fn = "atl_ne"; };
        如果(op == TOK_LT){ fn = "atl_lt"; };
        如果(op == TOK_GT){ fn = "atl_gt"; };
        如果(op == TOK_LE){ fn = "atl_le"; };
        如果(op == TOK_GE){ fn = "atl_ge"; };
        如果(op == TOK_AMP){ fn = "atl_band"; };
        如果(op == TOK_BOR){ fn = "atl_bor"; };
        如果(op == TOK_BXOR){ fn = "atl_bxor"; };
        如果(op == TOK_SHL){ fn = "atl_shl"; };
        如果(op == TOK_SHR){ fn = "atl_shr"; };
        如果(fn != 空){
            emit("    sub rsp, 32");
            emit("    call " + fn);
            emit("    add rsp, 32");
        }否则{
            emit("    xor rax, rax  ; unknown op " + op);
        };
        返回值 0;
    };

    如果(n.type == AST_UNARY){
        设 op = n.op;

        如果(op == TOK_AMP){
            创建 ASTNode:operand;
            operand = n.operand;
            如果(operand != 空 && operand.type == AST_VAR){
                创建 SemNode:s;
                s = operand.sem;
                如果(s != 空 && s.kind == SN_LOCAL){
                    emit("    lea rax, [rbp + " + s.offset + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_ref_new");
                    emit("    add rsp, 32");
                    返回值 0;
                };
            };
            emit("    xor rax, rax  ; & unresolvable");
            返回值 0;
        };

        如果(op == TOK_INC || op == TOK_DEC){
            创建 ASTNode:operand;
            operand = n.operand;
            如果(operand != 空 && operand.type == AST_VAR){
                创建 SemNode:s;
                s = operand.sem;
                如果(s != 空 && (s.kind == SN_LOCAL || s.kind == SN_GLOBAL)){

                    设 addr = "[rbp + " + s.offset + "]";
                    如果(s.kind == SN_GLOBAL){
                        addr = "[" + global_label(s.offset) + "]";
                    };
                    如果(s.kind == SN_LOCAL && s.type_kind == T_INT){

                        如果(s.offset == ctx.loop_counter_off){
                            emit("    mov rcx, r12  ; return old (counter)");
                            如果(op == TOK_INC){
                                emit("    inc r12");
                            }否则{
                                emit("    dec r12");
                            };
                            emit("    mov [rbp + " + s.offset + "], r12  ; 保存点");
                            emit("    sub rsp, 32");
                            emit("    call atl_int");
                            emit("    add rsp, 32");
                            返回值 0;
                        };

                        设 t_old = temp_alloc(ctx);
                        emit("    mov rax, " + addr + "  ; " + operand.sval + " (int)");
                        emit("    mov [rbp + " + t_old + "], rax  ; save old");
                        如果(op == TOK_INC){
                            emit("    inc rax");
                        }否则{
                            emit("    dec rax");
                        };
                        emit("    mov " + addr + ", rax  ; " + operand.sval + " ++/-- (int)");

                        emit("    mov rcx, [rbp + " + t_old + "]  ; return old (int)");
                        emit("    sub rsp, 32");
                        emit("    call atl_int");
                        emit("    add rsp, 32");
                        temp_free(ctx, 1);
                        返回值 0;
                    };
                    设 t_old = temp_alloc(ctx);
                    emit("    mov rax, " + addr + "  ; " + operand.sval);
                    emit("    mov [rbp + " + t_old + "], rax  ; save old");
                    emit("    mov rcx, 1");
                    emit("    sub rsp, 32");
                    emit("    call atl_int");
                    emit("    add rsp, 32");
                    emit("    mov rdx, rax  ; rdx = AtlInt(1)");
                    emit("    mov rcx, [rbp + " + t_old + "]  ; rcx = old val");
                    emit("    sub rsp, 32");
                    设 fn2 = "atl_add";
                    如果(op == TOK_DEC){ fn2 = "atl_sub"; };
                    emit("    call " + fn2);
                    emit("    add rsp, 32");
                    emit("    mov " + addr + ", rax  ; " + operand.sval);
                    emit("    mov rax, [rbp + " + t_old + "]  ; return old");
                    temp_free(ctx, 1);
                    返回值 0;
                };
            };
            emit("    xor rax, rax  ; ++ unresolvable");
            返回值 0;
        };
        gen_expr(n.operand, ctx);
        设 fn = 空;
        如果(op == TOK_NOT){ fn = "atl_not"; };
        如果(op == TOK_MINUS){ fn = "atl_neg"; };
        如果(op == TOK_STAR){ fn = "atl_deref"; };
        如果(op == TOK_TILDE){ fn = "atl_bnot"; };
        如果(fn != 空){
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call " + fn);
            emit("    add rsp, 32");
        }否则{
            emit("    xor rax, rax  ; unknown unary " + op);
        };
        返回值 0;
    };

    如果(n.type == AST_MEMBER){
        创建 SemNode:s;
        s = n.sem;
        如果(s == 空){
            gen_expr(n.obj, ctx);
            返回值 0;
        };

        如果(n.is_null_safe == 1 && s.kind == SN_MEM_FIELD){
            gen_expr(n.obj, ctx);
            设 t_obj = temp_alloc(ctx);
            emit("    mov [rbp + " + t_obj + "], rax  ; ?. obj");
            设 l_null = new_label();
            设 l_end = new_label();
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_is_null");
            emit("    add rsp, 32");
            emit("    test eax, eax");
            emit("    jnz __atl_L" + l_null);
            如果(s.offset >= 0){
                emit("    mov rax, [rbp + " + t_obj + "]");
                emit("    mov rax, [rax + 8]   ; inst");
                emit("    mov rax, [rax + 8]   ; field_vals");
                emit("    mov rax, [rax + " + (s.offset * 8) + "]  ; field " + n.member);
            }否则{
                设 nid = add_strlit(n.member);
                emit("    mov rcx, [rbp + " + t_obj + "]");
                emit("    lea rdx, [__atl_str_" + nid + "_data]  ; field " + n.member);
                emit("    sub rsp, 32");
                emit("    call atl_field_get");
                emit("    add rsp, 32");
            };
            emit("    jmp __atl_L" + l_end);
            emit("__atl_L" + l_null + ":");
            emit("    sub rsp, 32");
            emit("    call atl_null");
            emit("    add rsp, 32");
            emit("__atl_L" + l_end + ":");
            temp_free(ctx, 1);
            返回值 0;
        };
        如果(s.kind == SN_MEM_ARGC){

            emit("    movsxd rcx, dword [g_argc]");
            emit("    sub rsp, 32");
            emit("    call atl_int");
            emit("    add rsp, 32");
        }又如果(s.kind == SN_MEM_ENUM){

            emit("    mov rcx, " + s.enum_val + "  ; enum member " + n.member);
            emit("    sub rsp, 32");
            emit("    call atl_int");
            emit("    add rsp, 32");
        }又如果(s.kind == SN_MEM_STATIC_FIELD){

            emit("    mov rax, [__atl_static_" + s.cls.id + "_" + s.offset + "]  ; static field " + n.member);
        }又如果(s.kind == SN_GLOBAL){

            emit("    mov rax, [" + global_label(s.offset) + "]  ; pkg global " + n.member);
        }又如果(s.kind == SN_MEM_STRLEN || s.kind == SN_MEM_LISTLEN){
            gen_expr(n.obj, ctx);
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_str_len");
            emit("    add rsp, 32");
        }又如果(s.kind == SN_MEM_FIELD){
            如果(s.offset >= 0){

                创建 ASTNode:obj_node;
                obj_node = n.obj;
                如果(obj_node != 空 && obj_node.type == AST_VAR){
                    创建 SemNode:os;
                    os = obj_node.sem;
                    如果(os != 空 && os.kind == SN_CLASS){
                        emit("    xor rax, rax");
                    }否则{
                        gen_expr(n.obj, ctx);

                        设 t_fobj2 = temp_alloc(ctx);
                        emit("    mov [rbp + " + t_fobj2 + "], rax  ; obj");
                        设 l_fnull2 = new_label();
                        设 l_fend2 = new_label();
                        emit("    mov rax, [rbp + " + t_fobj2 + "]");
                        emit("    test rax, rax");
                        emit("    jz __atl_L" + l_fnull2);
                        emit("    mov ecx, [rax]");
                        emit("    sub ecx, 7");
                        emit("    jnz __atl_L" + l_fnull2);
                        emit("    mov rax, [rbp + " + t_fobj2 + "]");
                        emit("    mov rax, [rax + 8]   ; inst");
                        emit("    mov rax, [rax + 8]   ; field_vals");
                        emit("    mov rax, [rax + " + (s.offset * 8) + "]  ; field " + n.member);
                        emit("    jmp __atl_L" + l_fend2);
                        emit("__atl_L" + l_fnull2 + ":");
                        emit("    sub rsp, 32");
                        emit("    call atl_null");
                        emit("    add rsp, 32");
                        emit("__atl_L" + l_fend2 + ":");
                        temp_free(ctx, 1);
                    };
                }否则{
                    gen_expr(n.obj, ctx);

                    设 t_fobj = temp_alloc(ctx);
                    emit("    mov [rbp + " + t_fobj + "], rax  ; obj");
                    设 l_fnull = new_label();
                    设 l_fend = new_label();
                    emit("    mov rax, [rbp + " + t_fobj + "]");
                    emit("    test rax, rax");
                    emit("    jz __atl_L" + l_fnull);
                    emit("    mov ecx, [rax]");
                    emit("    sub ecx, 7");
                    emit("    jnz __atl_L" + l_fnull);
                    emit("    mov rax, [rbp + " + t_fobj + "]");
                    emit("    mov rax, [rax + 8]   ; inst");
                    emit("    mov rax, [rax + 8]   ; field_vals");
                    emit("    mov rax, [rax + " + (s.offset * 8) + "]  ; field " + n.member);
                    emit("    jmp __atl_L" + l_fend);
                    emit("__atl_L" + l_fnull + ":");
                    emit("    sub rsp, 32");
                    emit("    call atl_null");
                    emit("    add rsp, 32");
                    emit("__atl_L" + l_fend + ":");
                    temp_free(ctx, 1);
                };
            }否则{

                gen_expr(n.obj, ctx);
                设 t_obj = temp_alloc(ctx);
                emit("    mov [rbp + " + t_obj + "], rax  ; obj");
                设 nid = add_strlit(n.member);
                emit("    mov rcx, [rbp + " + t_obj + "]");
                emit("    lea rdx, [__atl_str_" + nid + "_data]  ; field " + n.member);
                emit("    sub rsp, 32");
                emit("    call atl_field_get");
                emit("    add rsp, 32");
                temp_free(ctx, 1);
            };
        }否则{
            gen_expr(n.obj, ctx);
        };
        返回值 0;
    };

    如果(n.type == AST_INDEX){

        如果(n.obj != 空 && n.obj.type == AST_VAR && n.obj.sval == "参数"){
            gen_expr(n.index, ctx);
            emit("    mov rax, [rax + 8]   ; index (int)");
            emit("    mov rcx, rax");
            设 l_arg_out = new_label();
            设 l_arg_ok = new_label();
            设 l_arg_end = new_label();
            emit("    movsxd rdx, dword [g_argc]  ; argc");
            emit("    cmp rcx, rdx");
            emit("    jae __atl_L" + l_arg_out);
            emit("    mov rax, [g_argv]");
            emit("    mov rax, [rax + rcx*8]  ; argv[i]");
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_str");
            emit("    add rsp, 32");
            emit("    jmp __atl_L" + l_arg_end);
            emit("__atl_L" + l_arg_out + ":");
            emit("    xor rcx, rcx");
            emit("    sub rsp, 32");
            emit("    call atl_null");
            emit("    add rsp, 32");
            emit("__atl_L" + l_arg_end + ":");
            返回值 0;
        };
        gen_expr(n.obj, ctx);
        设 t_obj = temp_alloc(ctx);
        emit("    mov [rbp + " + t_obj + "], rax");
        gen_expr(n.index, ctx);

        emit("    mov rdx, rax");
        emit("    mov rcx, [rbp + " + t_obj + "]");
        temp_free(ctx, 1);
        emit("    sub rsp, 32");
        emit("    call atl_list_get");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_PAIR){
        gen_expr(n.pair_left, c);
        返回值 0;
    };

    如果(n.type == AST_COLOR_SUFFIX){
        如果(n.base_expr != 空){
            创建 ASTNode:base;
            base = n.base_expr;
            如果(base.args == 空){ base.ensure_args(); };
            设 orig_len = base.args.长度();
            base.args.添加(n.color_expr);
            创建 ASTNode:fill(AST_LITERAL, 0, 0);
            fill.op = LIT_INT;
            fill.ival = n.is_filled;
            base.args.添加(fill);
            设 has_extra = 0;
            如果(n.alpha_expr != 空){ has_extra = 1; };

            创建 ArrayList:na_l;
            na_l = n.named_args;
            如果(na_l != 空 && na_l.长度() > 0){ has_extra = 1; };
            如果(has_extra == 1){
                如果(n.alpha_expr != 空){
                    base.args.添加(n.alpha_expr);
                }否则{

                    创建 ASTNode:ad(AST_LITERAL, 0, 0);
                    ad.op = LIT_FLOAT;
                    ad.fval = 1.0;
                    base.args.添加(ad);
                };
                如果(na_l != 空){
                    设 ni = 0;
                    循环(ni < na_l.长度()){
                        创建 ASTNode:na;
                        na = na_l.获取(ni);

                        创建 ASTNode:nm(AST_LITERAL, 0, 0);
                        nm.op = LIT_STRING;
                        nm.sval = na.sval;
                        base.args.添加(nm);
                        base.args.添加(na.lhs);
                        ni = ni + 1;
                    };
                };
            };
            gen_expr(base, c);
            循环(base.args.长度() > orig_len){
                base.args.弹出();
            };
        }否则{
            gen_expr(n.base_expr, c);
        };
        返回值 0;
    };

    如果(n.type == AST_CALL || n.type == AST_METHODCALL || n.type == AST_HOOKCALL){

        gen_call(node, ctx);
        如果(n.sem != 空 && n.sem.type_kind == T_INT){
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_int");
            emit("    add rsp, 32");
        };
        返回值 0;
    };
    如果(n.type == AST_MODCALL){

        gen_call(node, ctx);

        如果(n.sem != 空 && n.sem.kind == SN_FUNC && n.sem.type_kind == T_INT){
            emit("    mov rcx, rax");
            emit("    sub rsp, 32");
            emit("    call atl_int");
            emit("    add rsp, 32");
        };
        返回值 0;
    };

    如果(n.type == AST_LIST_LIT){
        emit("    sub rsp, 32");
        emit("    call atl_list_new");
        emit("    add rsp, 32");
        设 t_list = temp_alloc(ctx);
        emit("    mov [rbp + " + t_list + "], rax");
        如果(n.children != 空){
            设 i = 0;
            循环(i < n.children.长度()){
                创建 ASTNode:ch;
                ch = n.children.获取(i);

                如果(ch != 空 && ch.type == AST_PAIR){
                    gen_expr(ch.pair_left, ctx);
                    设 t_pk = temp_alloc(ctx);
                    emit("    mov [rbp + " + t_pk + "], rax  ; pair key");
                    gen_expr(ch.pair_right, ctx);
                    设 t_pv = temp_alloc(ctx);
                    emit("    mov [rbp + " + t_pv + "], rax  ; pair val");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_new");
                    emit("    add rsp, 32");
                    设 t_pair = temp_alloc(ctx);
                    emit("    mov [rbp + " + t_pair + "], rax  ; pair list");
                    emit("    mov rcx, [rbp + " + t_pair + "]");
                    emit("    mov rdx, [rbp + " + t_pk + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_add");
                    emit("    add rsp, 32");
                    emit("    mov rcx, [rbp + " + t_pair + "]");
                    emit("    mov rdx, [rbp + " + t_pv + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_add");
                    emit("    add rsp, 32");
                    emit("    mov rdx, [rbp + " + t_pair + "]");
                    emit("    mov rcx, [rbp + " + t_list + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_add");
                    emit("    add rsp, 32");
                    temp_free(ctx, 3);
                }否则{
                    gen_expr(n.children.获取(i), ctx);
                    emit("    mov rdx, rax");
                    emit("    mov rcx, [rbp + " + t_list + "]");
                    emit("    sub rsp, 32");
                    emit("    call atl_list_add");
                    emit("    add rsp, 32");
                };
                i = i + 1;
            };
        };
        emit("    mov rax, [rbp + " + t_list + "]");
        temp_free(ctx, 1);
        返回值 0;
    };

    如果(n.type == AST_NEW){
        创建 SemNode:s;
        s = n.sem;
        如果(s != 空 && s.cls != 空){
            创建 SemClass:cls;
            cls = s.cls;
            设 id = add_strlit(cls.name);
            emit("    lea rcx, [__atl_str_" + id + "_data]");
            emit("    mov rdx, " + cls.nfields);
            emit("    sub rsp, 32");
            emit("    call atl_instance_new");
            emit("    add rsp, 32");
            设 t = temp_alloc(ctx);
            emit("    mov [rbp + " + t + "], rax  ; save instance");

            如果(s.target_id != 0){
                设 nargs = 0;
                如果(n.new_args != 空){
                    nargs = n.new_args.长度();
                };

                创建 ArrayList:slots;
                设 i = 0;
                循环(i < nargs){
                    gen_expr(n.new_args.获取(i), ctx);
                    设 off = temp_alloc(ctx);
                    emit("    mov [rbp + " + off + "], rax  ; ctor arg" + i);
                    slots.添加(off);
                    i = i + 1;
                };

                emit("    mov rcx, [rbp + " + t + "]  ; this");
                设 j = 0;
                循环(j < nargs && j < 3){
                    emit("    mov " + reg_name(j + 1) + ", [rbp + " + slots.获取(j) + "]  ; arg" + (j + 1));
                    j = j + 1;
                };

                设 stack_args = 0;
                如果(nargs > 3){ stack_args = nargs - 3; };
                设 total = align16(32 + stack_args * 8);
                emit("    sub rsp, " + total);
                设 k = 3;
                循环(k < nargs){
                    emit("    mov rax, [rbp + " + slots.获取(k) + "]");
                    emit("    mov [rsp + " + (32 + (k - 3) * 8) + "], rax");
                    k = k + 1;
                };
                emit("    call " + method_label_by_id(s.target_id));
                emit("    add rsp, " + total);
                temp_free(ctx, nargs);
            };
            emit("    mov rax, [rbp + " + t + "]  ; restore instance");
            temp_free(ctx, 1);
        }否则{
            如果(n.new_cls_name == "ArrayList" || n.new_cls_name == "列表"){

                emit("    sub rsp, 32");
                emit("    call atl_list_new");
                emit("    add rsp, 32");
            }否则{
                emit("    xor rax, rax  ; new unknown class");
            };
        };
        返回值 0;
    };

    如果(n.type == AST_REF){
        创建 ASTNode:rop;
        rop = n.operand;
        如果(rop != 空 && rop.type == AST_VAR && rop.sem != 空){
            创建 SemNode:rs;
            rs = rop.sem;
            如果(rs.kind == SN_LOCAL){
                emit("    lea rcx, [rbp + " + rs.offset + "]  ; &" + rop.sval);
            }又如果(rs.kind == SN_GLOBAL){
                emit("    lea rcx, [" + global_label(rs.offset) + "]  ; &" + rop.sval);
            }否则{
                emit("    xor rax, rax  ; & unsupported kind " + rs.kind);
                返回值 0;
            };
            emit("    sub rsp, 32");
            emit("    call atl_ref_new");
            emit("    add rsp, 32");
            返回值 0;
        };
        gen_expr(n.operand, ctx);
        返回值 0;
    };

    如果(n.type == AST_DEREF){
        gen_expr(n.operand, ctx);
        emit("    mov rcx, rax  ; ref");
        emit("    sub rsp, 32");
        emit("    call atl_deref");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(n.type == AST_RANGE){
        gen_expr(n.lhs, ctx);
        返回值 0;
    };

    如果(n.type == AST_FUNC){
        创建 SemNode:s;
        s = n.sem;
        如果(s != 空 && s.target_id != 0){
            emit("    lea rcx, [__atl_lambda_" + s.target_id + "]");
            设 id = add_strlit("<lambda>");
            emit("    lea rdx, [__atl_str_" + id + "_data]");
            emit("    sub rsp, 32");
            emit("    call atl_func_wrap");
            emit("    add rsp, 32");
        }否则{
            emit("    xor rax, rax  ; lambda no id");
        };
        返回值 0;
    };

    如果(n.type == AST_SHOW){

        gen_show_node(n, ctx);
    }否则{
        emit("    xor rax, rax  ; unhandled expr " + n.type);
    };
    返回值 0;
};

声明 gen_store(lhs, c){
    如果(lhs == 空){
        返回值 0;
    };
    创建 ASTNode:l;
    l = lhs;
    创建 Ctx:ctx;
    ctx = c;

    如果(l.type == AST_VAR){
        创建 SemNode:s;
        s = l.sem;
        如果(s == 空){
            emit("    ; store: no sem");
            返回值 0;
        };
        如果(s.kind == SN_LOCAL){
            如果(s.type_kind == T_FLOAT){

                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_tofloat");
                emit("    add rsp, 32");
                emit("    movq xmm0, [rax + 8]  ; unbox double for store");
                emit("    movsd [rbp + " + s.offset + "], xmm0  ; " + l.sval + " (float)");
            }否则{
                emit("    mov [rbp + " + s.offset + "], rax  ; " + l.sval);
            };
        }又如果(s.kind == SN_FIELD){
            设 off = ctx.this_offset;
            emit("    mov rdx, rax  ; save val");
            emit("    mov rax, [rbp + " + off + "]  ; this");
            emit("    mov rax, [rax + 8]   ; inst");
            emit("    mov rax, [rax + 8]   ; field_vals");
            emit("    mov [rax + " + (s.offset * 8) + "], rdx  ; field " + l.sval);
        }又如果(s.kind == SN_GLOBAL){
            emit("    mov [" + global_label(s.offset) + "], rax  ; " + l.sval);
        }否则{
            emit("    ; store: unhandled kind " + s.kind);
        };
        返回值 0;
    };

    如果(l.type == AST_DEREF){

        设 t_val = temp_alloc(ctx);
        emit("    mov [rbp + " + t_val + "], rax  ; val");
        gen_expr(l.operand, ctx);
        emit("    mov rdx, [rbp + " + t_val + "]  ; val");
        emit("    mov rcx, rax  ; ref");
        temp_free(ctx, 1);
        emit("    sub rsp, 32");
        emit("    call atl_deref_set");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(l.type == AST_INDEX){
        设 t_val = temp_alloc(ctx);
        emit("    mov [rbp + " + t_val + "], rax");
        gen_expr(l.obj, ctx);
        设 t_obj = temp_alloc(ctx);
        emit("    mov [rbp + " + t_obj + "], rax");
        gen_expr(l.index, ctx);
        设 t_idx = temp_alloc(ctx);
        emit("    mov [rbp + " + t_idx + "], rax");
        emit("    mov r9, [rbp + " + t_val + "]  ; val");
        emit("    mov r8, [rbp + " + t_idx + "]  ; idx");
        emit("    mov rdx, [rbp + " + t_obj + "] ; obj");
        emit("    mov rcx, rdx");
        emit("    mov rdx, r8");
        emit("    mov r8, r9");
        temp_free(ctx, 3);
        emit("    sub rsp, 32");
        emit("    call atl_list_set");
        emit("    add rsp, 32");
        返回值 0;
    };

    如果(l.type == AST_MEMBER){
        创建 SemNode:s;
        s = l.sem;
        如果(s != 空 && s.kind == SN_MEM_FIELD && s.offset >= 0){
            设 t_val = temp_alloc(ctx);
            emit("    mov [rbp + " + t_val + "], rax");
            gen_expr(l.obj, ctx);
            emit("    mov rdx, [rbp + " + t_val + "]  ; val");
            emit("    mov rax, [rax + 8]   ; inst");
            emit("    mov rax, [rax + 8]   ; field_vals");
            emit("    mov [rax + " + (s.offset * 8) + "], rdx  ; field " + l.member);
            temp_free(ctx, 1);
        }又如果(s != 空 && s.kind == SN_MEM_STATIC_FIELD){

            emit("    mov [__atl_static_" + s.cls.id + "_" + s.offset + "], rax  ; static field " + l.member);
        }又如果(s != 空 && s.kind == SN_GLOBAL){

            emit("    mov [" + global_label(s.offset) + "], rax  ; pkg global " + l.member);
        }又如果(s != 空 && s.kind == SN_MEM_FIELD){

            设 t_val = temp_alloc(ctx);
            emit("    mov [rbp + " + t_val + "], rax  ; val");
            gen_expr(l.obj, ctx);
            设 t_obj = temp_alloc(ctx);
            emit("    mov [rbp + " + t_obj + "], rax  ; obj");
            设 nid = add_strlit(l.member);
            emit("    mov rcx, [rbp + " + t_obj + "]");
                emit("    lea rdx, [__atl_str_" + nid + "_data]  ; field " + l.member);
            emit("    mov r8, [rbp + " + t_val + "]");
            emit("    sub rsp, 32");
            emit("    call atl_field_set");
            emit("    add rsp, 32");
            temp_free(ctx, 2);
        }否则{
            emit("    ; store member: unhandled");
        };
        返回值 0;
    };

    emit("    ; store: unhandled lhs " + l.type);
    返回值 0;
};

声明 gen_call_seq(ctx, target_label, n_args, arg_slots, is_method){
    创建 ArrayList:slots;
    slots = arg_slots;
    设 stack_args = 0;
    如果(n_args > 4){
        stack_args = n_args - 4;
    };
    设 stack_bytes = stack_args * 8;
    设 total = align16(32 + stack_bytes);
    emit("    sub rsp, " + total);

    设 i = 4;
    循环(i < n_args){
        emit("    mov rax, [rbp + " + slots.获取(i) + "]");
        emit("    mov [rsp + " + (32 + (i - 4) * 8) + "], rax");
        i = i + 1;
    };

    设 j = 0;
    循环(j < n_args && j < 4){
        emit("    mov " + reg_name(j) + ", [rbp + " + slots.获取(j) + "]");
        j = j + 1;
    };
    emit("    call " + target_label);
    emit("    add rsp, " + total);
    返回值 0;
};

声明 gen_pos_call(ctx, fn, n_args, arg_slots, start_idx){
    创建 ArrayList:slots;
    slots = arg_slots;
    设 stack_args = 0;
    如果(n_args > 4){
        stack_args = n_args - 4;
    };
    设 total = align16(32 + stack_args * 8);
    emit("    sub rsp, " + total);
    设 i = 4;
    循环(i < n_args){
        emit("    mov rax, [rbp + " + slots.获取(start_idx + i) + "]");
        emit("    mov [rsp + " + (32 + (i - 4) * 8) + "], rax");
        i = i + 1;
    };
    设 j = 0;
    循环(j < n_args && j < 4){
        emit("    mov " + reg_name(j) + ", [rbp + " + slots.获取(start_idx + j) + "]");
        j = j + 1;
    };
    emit("    call " + fn);
    emit("    add rsp, " + total);
    返回值 0;
};

声明 gen_call(node, c){
    创建 ASTNode:n;
    n = node;
    创建 Ctx:ctx;
    ctx = c;
    创建 SemNode:s;
    s = n.sem;
    设 n_args = 0;
    如果(n.args != 空){
        n_args = n.args.长度();
    };

    如果(n.type == AST_HOOKCALL){
        创建 SemMethod:h;
        h = 空;
        设 i = 0;
        循环(i < g_sem_hooks.长度()){
            创建 SemMethod:m;
            m = g_sem_hooks.获取(i);
            如果(m.name == n.method_name){
                h = m;
                跳出;
            };
            i = i + 1;
        };
        如果(h == 空){
            emit("    xor rax, rax  ; hook not found");
            返回值 0;
        };
        创建 ArrayList:slots;
        设 i = 0;
        循环(i < n_args){
            设 pk = 0;
            如果(h.sem_func != 空 && i < h.sem_func.nparams && i < h.sem_func.locals.长度()){

                创建 ArrayList:al;
                al = h.sem_func.locals;
                创建 SemLocal:ll;
                ll = al.获取(i);
                pk = ll.type_kind;
            };
            创建 ASTNode:arg;
            arg = n.args.获取(i);
            如果(pk == T_STR && arg.type == AST_VAR && arg.sem != 空 &&
               arg.sem.kind == SN_GLOBAL && arg.sem.offset == 0){
                设 sid = add_strlit(arg.sval);
                emit("    lea rax, [__atl_str_" + sid + "]  ; hook 字符串参数(裸标识符)");
            }又如果(pk == 1){
                gen_int_value(arg, ctx);
            }否则{
                gen_expr(arg, ctx);
            };
            设 off = temp_alloc(ctx);
            emit("    mov [rbp + " + off + "], rax");
            slots.添加(off);
            i = i + 1;
        };
        gen_call_seq(ctx, method_label(h), n_args, slots, 0);
        返回值 0;
    };

    如果(n.type == AST_MODCALL && (s == 空 || s.kind == SN_MODCALL)){
        如果(s == 空){
            emit("    xor rax, rax  ; modcall no sem");
            返回值 0;
        };

        设 n_second = 0;
        如果(n.second_args != 空){ n_second = n.second_args.长度(); };

        设 need_implicit_id = 0;
        如果(g_in_gfx_block == 1 && n_second == 0){
            如果(s.modcall_id == MC_GFX_DRAW_PIXEL){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_FILL_RECT){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_DRAW_LINE){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_DRAW_CIRCLE){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_DRAW_TRIANGLE){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_DRAW_TEXT){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_CLEAR){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_PRESENT){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_BEGIN_FRAME){ need_implicit_id = 1; };
            如果(s.modcall_id == MC_GFX_END_FRAME){ need_implicit_id = 1; };
        };
        创建 ArrayList:slots;
        设 i = 0;

        循环(i < n_second){
            gen_expr(n.second_args.获取(i), ctx);
            设 off2 = temp_alloc(ctx);
            emit("    mov [rbp + " + off2 + "], rax");
            slots.添加(off2);
            i = i + 1;
        };

        如果(need_implicit_id == 1){
            emit("    lea rax, [__atl_int_0]  ; implicit window id = 0 (use current)");
            设 off3 = temp_alloc(ctx);
            emit("    mov [rbp + " + off3 + "], rax");
            slots.添加(off3);
        };

        设 i = 0;
        循环(i < n_args){

            设 is_atomic_slot = 0;
            如果(i == 0 && (s.modcall_id == MC_ATOMIC_INC || s.modcall_id == MC_ATOMIC_DEC)){
                创建 ASTNode:an;
                an = n.args.获取(i);
                如果(an != 空 && an.type == AST_VAR && an.sem != 空){
                    创建 SemNode:as;
                    as = an.sem;
                    如果(as.kind == SN_LOCAL){
                        emit("    lea rax, [rbp + " + as.offset + "]  ; atomic slot " + an.sval);
                        is_atomic_slot = 1;
                    }又如果(as.kind == SN_GLOBAL){
                        emit("    lea rax, [" + global_label(as.offset) + "]  ; atomic slot " + an.sval);
                        is_atomic_slot = 1;
                    };
                };
            };
            如果(is_atomic_slot == 1){
                emit("    mov rcx, rax");
                emit("    sub rsp, 32");
                emit("    call atl_int");
                emit("    add rsp, 32");
            }否则{
                gen_expr(n.args.获取(i), ctx);
            };
            设 off = temp_alloc(ctx);
            emit("    mov [rbp + " + off + "], rax");
            slots.添加(off);
            i = i + 1;
        };
        设 fn = 空;
        如果(s.modcall_id == MC_MATH_ADD){ fn = "atl_math_add"; };
        如果(s.modcall_id == MC_MATH_SUB){ fn = "atl_math_sub"; };
        如果(s.modcall_id == MC_MATH_MUL){ fn = "atl_math_mul"; };
        如果(s.modcall_id == MC_MATH_DIV){ fn = "atl_math_div"; };
        如果(s.modcall_id == MC_MATH_ABS){ fn = "atl_math_abs"; };
        如果(s.modcall_id == MC_MATH_FLOOR){ fn = "atl_math_floor"; };
        如果(s.modcall_id == MC_MATH_MOD){ fn = "atl_math_mod"; };
        如果(s.modcall_id == MC_MATH_AVG){ fn = "atl_math_avg"; };
        如果(s.modcall_id == MC_MATH_MAX){ fn = "atl_math_max"; };
        如果(s.modcall_id == MC_MATH_MIN){ fn = "atl_math_min"; };
        如果(s.modcall_id == MC_NET_GET){ fn = "atl_net_get"; };
        如果(s.modcall_id == MC_NET_POST){ fn = "atl_net_post"; };
        如果(s.modcall_id == MC_NET_RESOLVE){ fn = "atl_net_resolve"; };
        如果(s.modcall_id == MC_NET_PING){ fn = "atl_net_ping"; };
        如果(s.modcall_id == MC_NET_ALIVE){ fn = "atl_net_alive"; };
        如果(s.modcall_id == MC_PROC_CREATE){ fn = "atl_proc_create"; };
        如果(s.modcall_id == MC_PROC_WAIT){ fn = "atl_proc_wait"; };
        如果(s.modcall_id == MC_PROC_JOIN){ fn = "atl_proc_join"; };
        如果(s.modcall_id == MC_SYNC_LOCK_CREATE){ fn = "atl_sync_lock_create"; };
        如果(s.modcall_id == MC_CHAN_NEW){ fn = "atl_chan_new"; };
        如果(s.modcall_id == MC_CHAN_SEND){ fn = "atl_chan_send"; };
        如果(s.modcall_id == MC_CHAN_RECV){ fn = "atl_chan_recv"; };
        如果(s.modcall_id == MC_SYNC_LOCK){ fn = "atl_sync_lock"; };
        如果(s.modcall_id == MC_SYNC_UNLOCK){ fn = "atl_sync_unlock"; };
        如果(s.modcall_id == MC_ATOMIC_INC){ fn = "atl_atomic_inc"; };
        如果(s.modcall_id == MC_ATOMIC_DEC){ fn = "atl_atomic_dec"; };
        如果(s.modcall_id == MC_THREAD_ID){ fn = "atl_thread_id"; };
        如果(s.modcall_id == MC_MEM_ALLOC){ fn = "atl_mem_alloc"; };
        如果(s.modcall_id == MC_MEM_FREE){ fn = "atl_mem_free"; };
        如果(s.modcall_id == MC_MEM_REALLOC){ fn = "atl_mem_realloc"; };
        如果(s.modcall_id == MC_MEM_ALLOC_EXEC){ fn = "atl_mem_alloc_exec"; };
        如果(s.modcall_id == MC_MEM_SET_EXEC){ fn = "atl_mem_set_exec"; };
