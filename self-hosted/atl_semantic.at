类 SemClass {
公开:
    设 name 存在;
    设 parent 存在;
    设 parent_cls 存在;
    设 fields 存在;
    设 field_types 存在;
    设 methods 存在;
    设 nfields 存在;
    设 id 存在;
    设 pkg_name 存在;
    设 enum_vals 存在;
    设 static_fields 存在;
    设 is_interface 存在;
    设 implements 存在;
    设 access 存在;

    构造(){
        name = 空;
        parent = 空;
        parent_cls = 空;
        fields = 创建 ArrayList;
        field_types = 创建 ArrayList;
        methods = 创建 ArrayList;
        nfields = 0;
        id = 0;
        pkg_name = 空;
        enum_vals = 创建 ArrayList;
        static_fields = 创建 ArrayList;
        is_interface = 0;
        implements = 创建 ArrayList;
        access = 0;
    };
};

类 SemMethod {
公开:
    设 name 存在;
    设 owner 存在;
    设 func 存在;
    设 nparams 存在;
    设 param_names 存在;
    设 id 存在;
    设 kind 存在;
    设 is_ctor 存在;
    设 is_static 存在;
    设 access 存在;
    设 pkg_name 存在;
    设 vararg 存在;
    设 param_defaults 存在;
    设 sem_func 存在;

    构造(){
        name = 空;
        owner = 空;
        func = 空;
        nparams = 0;
        id = 0;
        kind = 0;
        is_ctor = 0;
        is_static = 0;
        access = 1;
        pkg_name = 空;
        vararg = 0;
        param_defaults = 创建 ArrayList;
        sem_func = 空;
    };
};

类 SemLocal {
公开:
    设 name 存在;
    设 offset 存在;
    设 type_cls 存在;
    设 type_kind 存在;
    设 is_const 存在;

    构造(n){
        name = n;
        offset = 0;
        type_cls = 空;
        type_kind = 0;
        is_const = 0;
    };
};

类 SemFunc {
公开:
    设 owner_cls 存在;
    设 nparams 存在;
    设 frame_size 存在;
    设 locals 存在;
    设 ret_type_kind 存在;
    设 is_task_func 存在;
    设 is_top_func 存在;
    设 pkg_name 存在;
    设 param_names 存在;

    构造(){
        owner_cls = 空;
        nparams = 0;
        frame_size = 0;
        locals = 创建 ArrayList;
        ret_type_kind = 0;
        is_task_func = 0;
        is_top_func = 0;
        pkg_name = 空;
        param_names = "";
    };
};

类 SemNode {
公开:
    设 kind 存在;
    设 offset 存在;
    设 cls 存在;
    设 target_id 存在;
    设 n_args 存在;
    设 builtin_id 存在;
    设 strmethod_id 存在;
    设 modcall_id 存在;
    设 enum_val 存在;
    设 type_kind 存在;

    构造(k){
        kind = k;
        offset = 0;
        cls = 空;
        target_id = 0;
        n_args = 0;
        builtin_id = 0;
        strmethod_id = 0;
        modcall_id = 0;
        enum_val = 0;
        type_kind = 0;
    };
};

类 SemEntry {
公开:
    设 cls 存在;
    设 method 存在;

    构造(c, m){
        cls = c;
        method = m;
    };
};

设 g_sem_classes = [];
设 g_sem_funcs = [];
设 g_sem_hooks = [];
设 g_sem_lambdas = [];
设 g_sem_globals = [];
设 g_sem_global_decls = [];
设 g_sem_global_types = [];
设 g_sem_global_consts = [];
设 g_sem_top_exprs = [];
设 g_sem_top_func 存在;
设 g_sem_top_locals_n 存在;
设 g_sem_entries = [];
设 g_next_id = 1;

声明 sem_find_class(name){
    如果(name == 空){ 返回值 空; };
    设 i = 0;
    循环(i < g_sem_classes.长度()){
        创建 SemClass:c;
        c = g_sem_classes.获取(i);
        如果(c.name == name){ 返回值 c; };
        i = i + 1;
    };
    返回值 空;
};

声明 sem_resolve_class_name(name){
    如果(name == 空){ 返回值 空; };
    设 c = sem_find_class(name);
    如果(c != 空){ 返回值 c; };

    设 i = 0;
    循环(i < g_sem_classes.长度()){
        创建 SemClass:cl;
        cl = g_sem_classes.获取(i);
        如果(cl.pkg_name != 空){
            如果(cl.pkg_name + "." + cl.name == name){ 返回值 cl; };
        };
        i = i + 1;
    };
    返回值 空;
};

声明 sem_find_field(cls, name){
    如果(cls == 空 || name == 空){ 返回值 -1; };
    创建 SemClass:c;
    c = cls;
    创建 ArrayList:fields;
    fields = c.fields;
    设 i = 0;
    循环(i < fields.长度()){
        设 fn = fields.获取(i);
        如果(fn == name){ 返回值 i; };
        i = i + 1;
    };
    返回值 -1;
};

声明 sem_find_field_type(cls, fi){
    如果(cls == 空 || fi < 0){ 返回值 空; };
    创建 SemClass:c;
    c = cls;
    如果(fi >= c.field_types.长度()){ 返回值 空; };
    返回值 c.field_types.获取(fi);
};

声明 拼接形参名(node){
    设 s = "";
    设 i = 0;
    创建 ArrayList:fp;
    fp = node.fn_params;
    循环(i < fp.长度()){
        如果(i > 0){ s = s + "|"; };
        s = s + fp.获取(i);
        i = i + 1;
    };
    返回值 s;
};

声明 sem_set_field_type(cls, fi, type_cls){
    如果(cls == 空 || fi < 0){ 返回值 0; };
    创建 SemClass:c;
    c = cls;

    循环(c.field_types.长度() <= fi){
        c.field_types.添加(空);
    };
    c.field_types.设置(fi, type_cls);
    返回值 0;
};

声明 sem_find_method(cls, name){
    如果(cls == 空 || name == 空){ 返回值 空; };
    创建 SemClass:c;
    c = cls;

    设 i = 0;
    循环(i < c.methods.长度()){
        创建 SemMethod:m;
        m = c.methods.获取(i);
        如果(m.name == name){ 返回值 m; };
        i = i + 1;
    };

    如果(c.parent_cls != 空){
        返回值 sem_find_method(c.parent_cls, name);
    };
    返回值 空;
};

声明 sem_find_topfunc(name){
    如果(name == 空){ 返回值 空; };
    设 i = 0;
    循环(i < g_sem_funcs.长度()){
        创建 SemMethod:m;
        m = g_sem_funcs.获取(i);
        如果(m.name == name){ 返回值 m; };
        i = i + 1;
    };
    返回值 空;
};

声明 sem_find_hook(name){
    如果(name == 空){ 返回值 空; };
    设 i = 0;
    循环(i < g_sem_hooks.长度()){
        创建 SemMethod:m;
        m = g_sem_hooks.获取(i);
        如果(m.name == name){ 返回值 m; };
        i = i + 1;
    };
    返回值 空;
};

声明 sem_find_global(name){
    如果(name == 空){ 返回值 -1; };
    设 i = 0;
    循环(i < g_sem_globals.长度()){
        设 gn = g_sem_globals.获取(i);
        如果(gn == name){ 返回值 i + 1; };
        i = i + 1;
    };
    返回值 -1;
};

声明 sem_find_global_type(name){
    设 i = 0;
    循环(i < g_sem_globals.长度()){
        设 gn = g_sem_globals.获取(i);
        如果(gn == name){
            如果(i < g_sem_global_types.长度()){
                返回值 g_sem_global_types.获取(i);
            };
            返回值 空;
        };
        i = i + 1;
    };
    返回值 空;
};

声明 sem_recv_static_type(obj, func, cls){
    如果(obj == 空){ 返回值 空; };
    创建 ASTNode:ob;
    ob = obj;
    如果(ob.type == AST_VAR && ob.sval != 空){
        设 t1 = sem_find_local_type(func, ob.sval);
        如果(t1 != 空){ 返回值 t1; };
        设 t2 = sem_find_global_type(ob.sval);
        如果(t2 != 空){ 返回值 t2; };
        如果(cls != 空){
            设 fi = sem_find_field(cls, ob.sval);
            如果(fi >= 0){
                设 ft = sem_find_field_type(cls, fi);
                如果(ft != 空){ 返回值 ft; };
            };
        };
    }又如果(ob.type == AST_MEMBER && ob.sem != 空){
        创建 SemNode:osn;
        osn = ob.sem;
        如果(osn.kind == SN_MEM_FIELD && osn.cls != 空 && osn.offset >= 0){
            设 ft2 = sem_find_field_type(osn.cls, osn.offset);
            如果(ft2 != 空){ 返回值 ft2; };
        };
    };
    返回值 空;
};

声明 sem_set_global_type(name, type_cls){
    设 i = 0;
    循环(i < g_sem_globals.长度()){
        设 gn = g_sem_globals.获取(i);
        如果(gn == name){
            循环(g_sem_global_types.长度() <= i){
                g_sem_global_types.添加(空);
            };
            g_sem_global_types.设置(i, type_cls);
            返回值 0;
        };
        i = i + 1;
    };
    返回值 0;
};

声明 参数别名序号(name){
    如果(name == "参数一"){ 返回值 1; };
    如果(name == "参数二"){ 返回值 2; };
    如果(name == "参数三"){ 返回值 3; };
    如果(name == "参数四"){ 返回值 4; };
    如果(name == "参数五"){ 返回值 5; };
    如果(name == "参数六"){ 返回值 6; };
    如果(name == "参数七"){ 返回值 7; };
    如果(name == "参数八"){ 返回值 8; };
    如果(name == "参数九"){ 返回值 9; };
    如果(name == "参数十"){ 返回值 10; };
    返回值 0;
};

声明 sem_find_local(func, name){
    如果(func == 空){ 返回值 空; };
    创建 SemFunc:f;
    f = func;
    设 i = 0;
    循环(i < f.locals.长度()){
        创建 SemLocal:l;
        l = f.locals.获取(i);
        如果(l.name == name){ 返回值 l; };
        i = i + 1;
    };

    设 ai = 参数别名序号(name);
    如果(ai > 0){
        设 pname = "参数" + ai;
        设 j = 0;
        循环(j < f.locals.长度()){
            创建 SemLocal:l2;
            l2 = f.locals.获取(j);
            如果(l2.name == pname){ 返回值 l2; };
            j = j + 1;
        };
    };
    返回值 空;
};

声明 sem_add_local(func, name){
    创建 SemFunc:f;
    f = func;
    创建 SemLocal:l(name);
    f.locals.添加(l);
    返回值 l;
};

声明 sem_find_local_type(func, name){
    如果(func == 空){ 返回值 空; };
    设 l = sem_find_local(func, name);
    如果(l != 空){
        创建 SemLocal:local;
        local = l;
        返回值 local.type_cls;
    };
    返回值 空;
};

声明 lookup_builtin(name){
    如果(name == "打印"){ 返回值 B_PRINT; };
    如果(name == "错误打印"){ 返回值 B_ERRPRINT; };
    如果(name == "输入"){ 返回值 B_INPUT; };
    如果(name == "数值"){ 返回值 B_NUM; };
    如果(name == "字符"){ 返回值 B_CHR; };
    如果(name == "格式化"){ 返回值 B_FORMAT; };
    如果(name == "毫秒时间"){ 返回值 B_MILLIS; };
    如果(name == "微秒时间"){ 返回值 B_MICROS; };
    如果(name == "创建"){ 返回值 B_FILE_CREATE; };
    如果(name == "创建文件夹"){ 返回值 B_MKDIR; };
    如果(name == "文件"){ 返回值 B_FILE_READ; };
    如果(name == "打开文件"){ 返回值 B_FILE_OPEN; };
    如果(name == "关闭文件"){ 返回值 B_FILE_CLOSE; };
    如果(name == "写入文件"){ 返回值 B_FILE_WRITE; };
    如果(name == "读取文件"){ 返回值 B_FILE_READ; };
    如果(name == "二进制写入"){ 返回值 B_BIN_WRITE; };
    如果(name == "字节读取"){ 返回值 B_BIN_READ; };
    如果(name == "写入字节"){ 返回值 B_WRITE_BYTES; };
    如果(name == "读取字节"){ 返回值 B_READ_BYTES; };
    如果(name == "文件大小"){ 返回值 B_FILE_SIZE; };
    如果(name == "清空"){ 返回值 B_SB_CLEAR; };
    如果(name == "追加"){ 返回值 B_SB_APPEND; };
    如果(name == "字符串构建"){ 返回值 B_SB_BUILD; };
    如果(name == "监听"){ 返回值 B_LISTEN; };
    如果(name == "games"){ 返回值 B_GAMES; };
    如果(name == "分配"){ 返回值 B_MEM_ALLOC; };
    如果(name == "释放"){ 返回值 B_MEM_FREE; };
    如果(name == "再分配"){ 返回值 B_MEM_REALLOC; };
    如果(name == "分配可执行内存"){ 返回值 B_MEM_ALLOC_EXEC; };
    如果(name == "设为可执行"){ 返回值 B_MEM_SET_EXEC; };
    如果(name == "码点"){ 返回值 B_CODEPOINT; };
