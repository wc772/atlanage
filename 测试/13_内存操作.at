类 内存操作测试 {
公开:
    声明 测试基本分配释放(){
        打印("=== 基本内存分配与释放 ===");

        设 p = 内存.分配(64);
        如果(p != 0){
            打印("分配64字节成功，地址=0x" + p);
            内存.释放(p);
            打印("内存已释放");
        }否则{
            打印("内存分配失败");
        };

        返回值 0;
    };

    声明 测试再分配(){
        打印("=== 内存再分配 ===");

        设 p = 内存.分配(32);
        打印("初始分配32字节，地址=0x" + p);

        设 p2 = 内存.再分配(p, 128);
        打印("扩展到128字节，新地址=0x" + p2);

        内存.释放(p2);
        打印("内存已释放");

        返回值 0;
    };

    声明 测试分配可执行内存(){
        打印("=== 分配可执行内存 ===");

        设 code = 内存.分配可执行(4096);
        打印("可执行内存地址: 0x" + code);

        如果(code != 0){
            打印("可执行内存分配成功");

        }否则{
            打印("可执行内存分配失败");
        };

        返回值 0;
    };

    声明 测试设为可执行(){
        打印("=== 将已有内存设为可执行 ===");

        设 ptr = 内存.分配(4096);
        打印("普通内存地址: 0x" + ptr);

        设 execPtr = 内存.设为可执行(ptr, 4096);
        打印("设为可执行后地址: 0x" + execPtr);

        返回值 0;
    };

    声明 测试分配大块内存(){
        打印("=== 大块内存分配 ===");

        设 p = 内存.分配(1024);
        如果(p != 0){
            打印("分配1024字节成功");
            内存.释放(p);
        };

        设 p2 = 内存.分配(1048576);
        如果(p2 != 0){
            打印("分配1MB成功");
            内存.释放(p2);
        };

        返回值 0;
    };
};