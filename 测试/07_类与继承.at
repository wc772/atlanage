类 animal{
公开:
    设 age 存在;

    声明 发出声音(){
        打印("动物发出声音");
    };

    声明 一个数字(){
        打印("五");
    };
};

类 猫 继承 animal{
公开:
    声明 叫一声(){
        打印("喵");
    };
};

类 狗 继承 animal{
公开:
    声明 叫一声(){
        打印("汪");
    };

    声明 摇尾巴(){
        打印("摇尾巴中...");
    };
};

类 访问修饰符测试{
公开:
    设 a存在;
    设 b存在;
私有:
    设 c存在;
    设 d存在;
受保护的:
    设 e存在;
    设 f存在;
};

类 类继承测试 {
公开:
    声明 测试基本继承(){
        打印("=== 基本继承测试 ===");

        创建 猫:cat;
        cat.age=3;
        打印("猫的年龄: " + cat.age);
        cat.一个数字();
        cat.叫一声();

        返回值 0;
    };

    声明 测试多态(){
        打印("=== 多态测试 ===");

        创建 猫:cat1;
        创建 狗:dog1;

        cat1.age = 2;
        dog1.age = 4;

        打印("猫年龄: " + cat1.age);
        cat1.叫一声();

        打印("狗年龄: " + dog1.age);
        dog1.叫一声();
        dog1.摇尾巴();

        返回值 0;
    };

    声明 测试创建语法_冒号(){
        打印("=== 创建语法: 冒号形式 ===");

        创建 猫:myCat;
        myCat.age = 1;
        myCat.叫一声();

        返回值 0;
    };

    声明 测试创建语法_赋值(){
        打印("=== 创建语法: 赋值形式 ===");

        设 myDog = 创建 狗;
        myDog.age = 5;
        myDog.叫一声();

        返回值 0;
    };

    声明 测试访问修饰符(){
        打印("=== 访问修饰符测试 ===");

        创建 访问修饰符测试:obj;
        obj.a = 1;
        obj.b = 2;

        打印("a = " + obj.a);
        打印("b = " + obj.b);

        返回值 0;
    };
};