类 栈 {
私有:
    设 数据 存在;
    设 栈顶 存在;

公开:
    声明 初始化(){
        设 数据 = {};
        设 栈顶 = -1;
        打印("栈初始化完成");
        返回值 0;
    };

    声明 入栈(元素){
        栈顶 = 栈顶 + 1;
        数据[栈顶] = 元素;
        打印("入栈: " + 元素 + " (栈顶=" + 栈顶 + ")");
        返回值 0;
    };

    声明 出栈(){
        如果(栈顶 < 0){
            打印("栈为空");
            返回值 空;
        };

        设 元素 = 数据[栈顶];
        栈顶 = 栈顶 - 1;
        打印("出栈: " + 元素);
        返回值 元素;
    };

    声明 查看栈顶(){
        如果(栈顶 < 0){
            打印("栈为空");
            返回值 空;
        };
        返回值 数据[栈顶];
    };

    声明 是否为空(){
        返回值 栈顶 < 0;
    };
};

类 队列 {
私有:
    设 数据 存在;
    设 队头 存在;
    设 队尾 存在;

公开:
    声明 初始化(){
        设 数据 = {};
        设 队头 = 0;
        设 队尾 = 0;
        打印("队列初始化完成");
        返回值 0;
    };

    声明 入队(元素){
        数据[队尾] = 元素;
        队尾 = 队尾 + 1;
        打印("入队: " + 元素);
        返回值 0;
    };

    声明 出队(){
        如果(队头 == 队尾){
            打印("队列为空");
            返回值 空;
        };

        设 元素 = 数据[队头];
        队头 = 队头 + 1;
        打印("出队: " + 元素);
        返回值 元素;
    };

    声明 是否为空(){
        返回值 队头 == 队尾;
    };
};

类 数据结构测试 {
公开:
    声明 测试栈(){
        打印("=== 栈数据结构测试 ===");

        设 我的栈 = 创建 栈;
        我的栈.初始化();

        我的栈.入栈("第一");
        我的栈.入栈("第二");
        我的栈.入栈("第三");

        打印("栈顶元素: " + 我的栈.查看栈顶());

        我的栈.出栈();
        我的栈.出栈();
        我的栈.出栈();

        如果(我的栈.是否为空()){
            打印("栈已空");
        };

        返回值 0;
    };

    声明 测试队列(){
        打印("=== 队列数据结构测试 ===");

        设 我的队列 = 创建 队列;
        我的队列.初始化();

        我的队列.入队("A");
        我的队列.入队("B");
        我的队列.入队("C");

        我的队列.出队();
        我的队列.出队();

        我的队列.入队("D");

        我的队列.出队();
        我的队列.出队();

        如果(我的队列.是否为空()){
            打印("队列已空");
        };

        返回值 0;
    };

    声明 测试用组集实现LRU缓存(){
        打印("=== LRU缓存 (组集实现) ===");

        设 组集 cache = {};

        cache["key1"] = "数据1";
        cache["key2"] = "数据2";
        cache["key3"] = "数据3";

        打印("缓存key1: " + cache["key1"]);
        打印("缓存key2: " + cache["key2"]);

        如果(cache["key1"] != 空){
            打印("缓存命中: key1");
        };

        如果(cache["key4"] == 空){
            打印("缓存未命中: key4");
        };

        返回值 0;
    };
};