设 全局共享 = 0;
类 T {
公开:
    声明 测试(){

        设 t1 = 异步{
            设 x = 40;
            设 y = 2;
            返回值 x * y;
        };
        设 r1 = 等待 任务(t1);
        如果(r1 == 80){ 打印("OK1 异步计算: " + r1); }否则{ 打印("FAIL1: " + r1); };

        设 ta = 异步{ 返回值 100 + 1; };
        设 tb = 异步{ 返回值 200 + 2; };
        设 ra = 等待 任务(ta);
        设 rb = 等待 任务(tb);
        如果(ra == 101 && rb == 202){ 打印("OK2 双任务: " + ra + "/" + rb); }否则{ 打印("FAIL2: " + ra + "/" + rb); };

        设 tg = 异步{
            全局共享 = 全局共享 + 1;
            返回值 0;
        };
        设 rg = 等待 任务(tg);
        如果(全局共享 == 1){ 打印("OK3 全局共享: " + 全局共享); }否则{ 打印("FAIL3: " + 全局共享); };

        设 ts = 异步{ 返回值 7; };
        设 ts_str = ts + "";
        如果(ts_str == "<任务>"){ 打印("OK4 任务对象: " + ts_str); }否则{ 打印("FAIL4: " + ts_str); };
        设 rs = 等待 任务(ts);
        如果(rs == 7){ 打印("OK5 等待后结果: " + rs); }否则{ 打印("FAIL5: " + rs); };

        返回值 0;
    };
};