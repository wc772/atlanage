引用.文件("lib/atunity/引擎.at")

设 全局得分 = 0;
设 全局生命 = 3;
设 全局自动模式 = 假;
设 全局结束 = 假;
设 全局引擎 = 空;

类 玩家控制 继承 组件 {
公开:
    设 无敌帧 存在;
    设 冷却 存在;
    设 速度 存在;
    设 玩家形状 存在;

    构造(){
        无敌帧 = 0;
        冷却 = 0;
        速度 = 7;
        玩家形状 = 空;
    };

    声明 更新(){
        如果(全局结束 == 真){ 返回值 0; };
        如果(无敌帧 > 0){ 无敌帧 = 无敌帧 - 1; };
        如果(冷却 > 0){ 冷却 = 冷却 - 1; };
        如果(挂载对象 == 空){ 返回值 0; };

        如果(全局自动模式 == 假){
            如果(按住("w") || 按下(键上)){ 挂载对象.y = 挂载对象.y + 速度; };
            如果(按住("s") || 按下(键下)){ 挂载对象.y = 挂载对象.y - 速度; };
            如果(按住("a") || 按下(键左)){ 挂载对象.x = 挂载对象.x - 速度; };
            如果(按住("d") || 按下(键右)){ 挂载对象.x = 挂载对象.x + 速度; };
        };

        挂载对象.x = 限幅(挂载对象.x, -360, 360);
        挂载对象.y = 限幅(挂载对象.y, -260, 220);

        如果(全局自动模式 == 假 && 按下(键空格) && 冷却 == 0){
            冷却 = 15;
            发射();
        };
        如果(全局自动模式 == 真 && 帧数() % 12 == 0 && 冷却 == 0){
            冷却 = 15;
            发射();
        };

        如果(玩家形状 != 空){
            如果(无敌帧 > 0 && 无敌帧 % 4 < 2){
                玩家形状.设置隐藏(真);
            } 否则 {
                玩家形状.设置隐藏(假);
            };
        };

        如果(全局生命 <= 0 && 全局结束 == 假){
            全局结束 = 真;
            挂载对象.激活 = 假;
            打印("游戏结束 得分=" + 全局得分);
            如果(全局引擎 != 空){ 全局引擎.请求退出(); };
        };
        返回值 0;
    };

    声明 发射(){
        如果(挂载对象.场景引用 == 空){ 返回值 0; };
        设 子弹 = 创建 游戏对象;
        子弹.x = 挂载对象.x;
        子弹.y = 挂载对象.y + 30;
        子弹.标签 = "子弹";
        设 子弹刚体 = 创建 刚体;
        子弹刚体.设置速度(0, 14);
        子弹.添加部件(子弹刚体);
        设 子弹形状 = 创建 形状渲染器;
        子弹形状.设置形状(1);
        子弹形状.设置尺寸(4, 10);
        子弹形状.设置颜色(颜色黄);
        子弹.添加部件(子弹形状);
        设 子弹碰撞 = 创建 圆碰撞器;
        子弹碰撞.设置半径(6);
        子弹.添加部件(子弹碰撞);
        设 子弹逻辑 = 创建 子弹脚本;
        子弹.添加部件(子弹逻辑);
        挂载对象.场景引用.添加(子弹);
        返回值 0;
    };

    声明 碰撞事件(对方){
        如果(对方.标签 == "敌机" && 无敌帧 == 0 && 全局生命 > 0){
            全局生命 = 全局生命 - 1;
            无敌帧 = 90;
        };
        返回值 0;
    };
};

类 子弹脚本 继承 组件 {
公开:
    声明 更新(){
        如果(挂载对象 == 空){ 返回值 0; };
        如果(挂载对象.y > 340){ 挂载对象.删除(); };
        返回值 0;
    };

    声明 碰撞事件(对方){
        如果(对方.标签 == "敌机"){
            全局得分 = 全局得分 + 10;
            对方.删除();
            挂载对象.删除();
        };
        返回值 0;
    };
};

类 敌机脚本 继承 组件 {
公开:
    声明 更新(){
        如果(挂载对象 == 空){ 返回值 0; };
        如果(挂载对象.y < -340){ 挂载对象.删除(); };
        返回值 0;
    };

    声明 碰撞事件(对方){
        如果(对方.标签 == "玩家"){ 挂载对象.删除(); };
        返回值 0;
    };
};

类 星脚本 继承 组件 {
公开:
    设 速度 存在;
    构造(){
        速度 = 1;
    };
    声明 更新(){
        如果(挂载对象 == 空){ 返回值 0; };
        挂载对象.y = 挂载对象.y - 速度;
        如果(挂载对象.y < -320){
            挂载对象.y = 320;
            挂载对象.x = (帧数() * 97) % 700 - 350;
        };
        返回值 0;
    };
};

类 游戏场景 继承 场景 {
公开:
    设 得分文字 存在;
    设 生命文字 存在;

    声明 进入(){
        打印("游戏场景初始化");
        创建玩家();
        创建星星();
        创建UI();
        返回值 0;
    };

    声明 创建玩家(){
        设 玩家 = 创建 游戏对象;
        玩家.x = 0;
        玩家.y = -200;
        玩家.标签 = "玩家";

        设 机身 = 创建 形状渲染器;
        机身.设置形状(4);
        机身.设置起点(0, 35);
        机身.设置目标(-28, -28);
        机身.设置目标2(28, -28);
        机身.设置颜色(图元颜色(96, 200, 255));
        玩家.添加部件(机身);

        设 尾焰 = 创建 形状渲染器;
        尾焰.设置形状(2);
        尾焰.设置半径(10);
        尾焰.设置颜色(颜色橙);
        玩家.添加部件(尾焰);

        设 玩家碰撞 = 创建 圆碰撞器;
        玩家碰撞.设置半径(26);
        玩家.添加部件(玩家碰撞);

        设 控制 = 创建 玩家控制;
        控制.玩家形状 = 机身;
        玩家.添加部件(控制);
        添加(玩家);
        返回值 0;
    };

    声明 创建星星(){
        设 i = 0;
        循环(i < 14){
            设 星 = 创建 游戏对象;
            星.x = (i * 53) % 700 - 350;
            星.y = (i * 37) % 640 - 320;
            设 星点 = 创建 形状渲染器;
            星点.设置形状(5);
            星点.设置尺寸(2, 2);
            星点.设置颜色(颜色灰);
            星.添加部件(星点);
            设 星动 = 创建 星脚本;
            星.添加部件(星动);
            添加(星);
            i = i + 1;
        };
        返回值 0;
    };

    声明 创建UI(){

        设 得分对象 = 创建 游戏对象;
        得分对象.x = -350;
        得分对象.y = 280;
        得分文字 = 创建 文本渲染器;
        得分文字.设置字号(20);
        得分文字.设置颜色(文字颜色(255, 255, 255));
        得分文字.设置居中(假);
        得分对象.添加部件(得分文字);
        添加(得分对象);

        设 生命对象 = 创建 游戏对象;
        生命对象.x = 350;
        生命对象.y = 280;
        生命文字 = 创建 文本渲染器;
        生命文字.设置字号(20);
        生命文字.设置颜色(文字颜色(255, 120, 120));
        生命文字.设置居中(假);
        生命对象.添加部件(生命文字);
        添加(生命对象);

        设 标题对象 = 创建 游戏对象;
        标题对象.x = 0;
        标题对象.y = 280;
        设 标题文字 = 创建 文本渲染器;
        标题文字.设置文本("飞机大战 W/A/S/D移动 空格射击");
        标题文字.设置字号(16);
        标题文字.设置颜色(文字颜色(180, 180, 255));
        标题对象.添加部件(标题文字);
        添加(标题对象);
        返回值 0;
    };

    声明 更新(dt){

        如果(帧数() % 40 == 0 && 帧数() > 0){
            生成敌机();
        };
        如果(得分文字 != 空){
            得分文字.设置文本("得分: " + 全局得分);
            生命文字.设置文本("生命: " + 全局生命);
        };

        如果(帧数() % 120 == 0){
            打印("帧 " + 帧数() + " 得分=" + 全局得分 + " 生命=" + 全局生命);
        };
        返回值 0;
    };

    声明 生成敌机(){
        设 side = (帧数() / 40) % 2;
        设 x = 160 + (帧数() % 180);
        如果(side == 1){ x = 0 - 160 - (帧数() % 180); };
        设 敌机 = 创建 游戏对象;
        敌机.x = x;
        敌机.y = 300;
        敌机.标签 = "敌机";
        设 敌机刚体 = 创建 刚体;
        敌机刚体.设置速度(0, -2);
        敌机.添加部件(敌机刚体);
        设 敌机形状 = 创建 形状渲染器;
        敌机形状.设置形状(2);
        敌机形状.设置半径(18);
        敌机形状.设置颜色(颜色红);
        敌机.添加部件(敌机形状);
        设 敌机碰撞 = 创建 圆碰撞器;
        敌机碰撞.设置半径(18);
        敌机.添加部件(敌机碰撞);
        设 敌机逻辑 = 创建 敌机脚本;
        敌机.添加部件(敌机逻辑);
        添加(敌机);
        返回值 0;
    };
};

类 main {
公开:
    声明 运行(){
        设 游戏 = 创建 引擎(800, 600, "飞机大战");
        游戏.设置背景色(颜色深蓝);
        游戏.设置自动帧数(600);
        全局自动模式 = 真;
        全局引擎 = 游戏;
        游戏.启动(创建 游戏场景);
        返回值 0;
    };
};