引用.文件("lib/atl_ui.at")

类 main {
公开:
    声明 运行(){
        打印("=== AUI Layer 2 集成测试 ===");

        设 win = 0;
        图形.窗口.创建(640:480,"AUI Layer 2 测试"){

            图形.设备.清屏(深蓝);
            打印("窗口创建成功,清屏完成");

            图形.绘制.矩形(-200,150:60,40)[绿*];
            打印("画了填充矩形 [绿*]");

            图形.绘制.矩形(200,150:60,40)[红];
            打印("画了矩形轮廓 [红]");

            图形.绘制.线(-280,-200:280,200)[黄];
            打印("画了对角线 [黄]");

            图形.绘制.圆(-200,-150:50)[青];
            打印("画了圆轮廓 [青]");

            图形.绘制.圆(200,-150:50)[紫*];
            打印("画了填充圆 [紫*]");

            图形.绘制.三角形(0,80:-60,-20:60,-20)[白];
            打印("画了三角形轮廓 [白]");

            图形.绘制.三角形(-50,-80:50,-80:0,-160)[橙*];
            打印("画了填充三角形 [橙*]");

            图形.绘制.像素(0,0:3)[白];
            打印("画了中心像素点");

            图形.绘制.文本(-200,200,"AUI Layer 2",24,白);
            打印("画了文本");

            图形.设备.呈现;
        };
        win = 1000;

        打印("已呈现,等待事件...");
        打印("ESC 或关闭窗口退出");

        设 buf = 内存.分配(64);
        设 running = 真;
        循环(running){
            设 r = 图形.事件.轮询(win, buf, 1);
            如果(r == -1){ running = 假; };
            如果(r == 1){
                设 etype = 内存.读字节(buf, 0);
                设 ekey = 内存.读字节(buf, 4);
                如果(etype == 1){
                    打印("按键 code=" + ekey);
                    如果(ekey == 27){ running = 假; };
                };
                如果(etype == 2){
                    设 ex = 内存.读字节(buf, 8);
                    设 ey = 内存.读字节(buf, 12);
                    打印("鼠标移动 x=" + ex + " y=" + ey);
                };
                如果(etype == 3){
                    打印("鼠标按下");
                };
                如果(etype == 6){
                    打印("窗口关闭请求");
                    running = 假;
                };
            };
        };

        内存.释放(buf);
        图形.窗口.关闭(0);
        打印("窗口已关闭,程序退出");
        返回值 0;
    };
};