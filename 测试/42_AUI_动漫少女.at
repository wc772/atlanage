引用.文件("lib/atl_ui.at")

类 main {
公开:
    声明 运行(){
        打印("=== AUI 动漫少女 ===");

        图形.窗口.创建(800:600,"AUI 动漫少女"){

            图形.设备.清屏(深蓝);

            图形.绘制.矩形(0,-220:120,100)[紫*];

            图形.绘制.线(-40,-140:0,-170)[白];
            图形.绘制.线(40,-140:0,-170)[白];

            图形.绘制.矩形(0,-120:25,50)[粉*];

            图形.绘制.三角形(-150,80:-220,-200:-100,-80)[青*];
            图形.绘制.三角形(150,80:220,-200:100,-80)[青*];

            图形.绘制.圆(0,30:160)[青*];

            图形.绘制.圆(0,0:105)[粉*];

            图形.绘制.三角形(-100,100:-100,20:0,70)[青*];
            图形.绘制.三角形(-40,120:40,120:0,60)[青*];
            图形.绘制.三角形(100,100:100,20:0,70)[青*];

            图形.绘制.圆(-40,20:28)[白*];
            图形.绘制.圆(-40,20:20)[蓝*];
            图形.绘制.圆(-35,28:7)[白*];

            图形.绘制.圆(40,20:28)[白*];
            图形.绘制.圆(40,20:20)[蓝*];
            图形.绘制.圆(45,28:7)[白*];

            图形.绘制.线(-65,55:-20,58)[黑];
            图形.绘制.线(20,58:65,55)[黑];

            图形.绘制.像素(0,0:4)[黑];

            图形.绘制.线(-12,-30:12,-30)[红];

            图形.绘制.圆(-65,-5:10)[红*];
            图形.绘制.圆(65,-5:10)[红*];

            图形.绘制.三角形(-25,150:-20,130:0,145)[红*];
            图形.绘制.三角形(25,150:20,130:0,145)[红*];
            图形.绘制.圆(0,145:5)[红*];

            图形.设备.呈现;

            打印("绘制完成,按ESC或关闭窗口退出");
        };

        设 buf = 内存.分配(64);
        设 running = 真;
        循环(running){
            设 r = 图形.事件.轮询(1000, buf, 1);
            如果(r == -1){ running = 假; };
            如果(r == 1){
                设 etype = 内存.读字节(buf, 0);
                设 ekey = 内存.读字节(buf, 4);
                如果(etype == 1 && ekey == 27){ running = 假; };
                如果(etype == 6){ running = 假; };
            };
        };

        内存.释放(buf);
        图形.窗口.关闭(0);
        返回值 0;
    };
};