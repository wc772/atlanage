类 动物 {
公开:
    设 名字 存在;
    构造(名){
        名字 = 名;
    };
};
类 T {
公开:
    声明 测试(){

        选择(2){
            情况 1:
                打印("FAIL1");
                跳出;
            情况 2:
                打印("OK1 值匹配");
                跳出;
            默认:
                打印("FAIL1d");
                跳出;
        };

        选择(99){
            情况 _:
                打印("OK2 通配: " + 99);
                跳出;
            默认:
                打印("FAIL2");
                跳出;
        };

        设 x = 42;
        设 s = "abc";
        设 a = 创建 动物("旺财");
        选择(x){
            情况 是 整:
                打印("OK3 类型-整");
                跳出;
            默认:
                打印("FAIL3");
                跳出;
        };
        选择(s){
            情况 是 字:
                打印("OK4 类型-字");
                跳出;
            情况 是 整:
                打印("FAIL4");
                跳出;
            默认:
                打印("FAIL4d");
                跳出;
        };
        选择(a){
            情况 是 动物:
                打印("OK5 类型-类名: " + a.名字);
                跳出;
            默认:
                打印("FAIL5");
                跳出;
        };
        选择(a){
            情况 是 整:
                打印("FAIL5b");
                跳出;
            默认:
                打印("OK6 类型不匹配落默认");
                跳出;
        };

        选择(15){
            情况 10 (真):
                打印("FAIL7");
                跳出;
            情况 15 (x > 40):
                打印("OK7 守卫命中: " + 15);
                跳出;
            情况 15 (x < 10):
                打印("FAIL7b");
                跳出;
            默认:
                打印("FAIL7d");
                跳出;
        };

        选择(3){
            情况 1 | 2 | 3:
                打印("OK8 多模式: " + 3);
                跳出;
            默认:
                打印("FAIL8");
                跳出;
        };
        选择(7){
            情况 1 | 2 | 3:
                打印("FAIL8b");
                跳出;
            情况 5 | 7 | 9:
                打印("OK9 多模式第二组: " + 7);
                跳出;
            默认:
                打印("FAIL9");
                跳出;
        };

        选择("hello"){
            情况 "hi" | "hey":
                打印("FAIL10");
                跳出;
            情况 _:
                打印("OK10 多模式后通配");
                跳出;
            默认:
                打印("FAIL10d");
                跳出;
        };

        选择(3){
            情况 1, 2, 3:
                打印("OK11 逗号多模式");
                跳出;
            默认:
                打印("FAIL11");
                跳出;
        };

        返回值 0;
    };
};