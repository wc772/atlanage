公开:
创建引子 外引子(整数){
    返回值 参数1 + 1;
};
声明 外函数(参数){
    返回值 参数 + 10;
};
设 外变量 = 5;
包 内层{
    公开:
    创建引子 内引子(整数){
        返回值 参数1 * 2;
    };
    声明 内函数(参数){
        返回值 参数 + 100;
    };
    设 内变量 = 7;
    私有:
    创建引子 内私有引子(整数){
        返回值 参数1 - 1;
    };
    声明 内私有函数(参数){
        返回值 参数 - 100;
    };
};