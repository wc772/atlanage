设 VK_SUCCESS = 0;
设 VK_版本_1_0 = 4194304;
设 VK_结构_应用信息 = 0;
设 VK_结构_实例创建信息 = 1;

设 错误码 存在;

声明 载入(){
    设 r = VK.载入();
    如果(r == 1){ 错误码 = 0; }否则{ 错误码 = -1; };
    返回值 r;
};
声明 版本(){
    返回值 VK.版本();
};

声明 结构(大小){
    设 p = 内存.分配(大小);
    VK.内存.清零(p, 大小);
    返回值 p;
};
声明 写(指针, 偏移, 值, 字节数){
    返回值 VK.内存.写(指针, 偏移, 值, 字节数);
};
声明 读(指针, 偏移, 字节数){
    返回值 VK.内存.读(指针, 偏移, 字节数);
};
声明 清零(指针, 字节数){
    返回值 VK.内存.清零(指针, 字节数);
};
声明 写浮点(指针, 偏移, 值){
    返回值 VK.内存.写浮点(指针, 偏移, 值);
};
声明 写字符串(指针, 偏移, 字符串){
    返回值 VK.内存.写字符串(指针, 偏移, 字符串);
};

声明 应用信息(应用名){
    设 ai = 结构(48);
    写(ai, 0, VK_结构_应用信息, 4);

    设 名缓冲 = 结构(128);
    写字符串(名缓冲, 0, 应用名);
    写(ai, 16, 名缓冲, 8);
    设 引擎缓冲 = 结构(32);
    写字符串(引擎缓冲, 0, "Atlanage");
    写(ai, 32, 引擎缓冲, 8);
    写(ai, 44, VK_版本_1_0, 4);
    返回值 ai;
};

声明 实例创建信息(应用信息指针){
    设 ci = 结构(64);
    写(ci, 0, VK_结构_实例创建信息, 4);
    写(ci, 24, 应用信息指针, 8);
    返回值 ci;
};

声明 创建实例(应用名){
    设 ai = 应用信息(应用名);
    设 ci = 实例创建信息(ai);
    设 结果槽 = 内存.分配(8);
    设 实例槽 = 内存.分配(8);

    设 r = VK.调用原始("vkCreateInstance", 结果槽, ci, 0, 实例槽);
    错误码 = r;
    如果(r != VK_SUCCESS){
        返回值 0;
    };
    设 实例 = 读(实例槽, 0, 8);
    返回值 实例;
};
声明 销毁实例(实例){

    设 fn = VK.加载函数(实例, "vkDestroyInstance");
    设 r = VK.调用地址(fn, 实例, 0);
    错误码 = r;
    返回值 r;
};

设 设备缓冲 存在;
设 设备数量 存在;

声明 物理设备数量(实例){

    设 fn = VK.加载函数(实例, "vkEnumeratePhysicalDevices");
    如果(fn == 0){ 错误码 = -1; 返回值 0; };
    设 计数槽 = 内存.分配(4);
    设 r = VK.调用地址(fn, 实例, 计数槽, 0);
    错误码 = r;
    如果(r != VK_SUCCESS){ 返回值 0; };
    设 数量 = 读(计数槽, 0, 4);
    如果(数量 <= 0){ 返回值 0; };

    设 缓冲 = 内存.分配(数量 * 8);
    设 r2 = VK.调用地址(fn, 实例, 计数槽, 缓冲);
    错误码 = r2;
    如果(r2 != VK_SUCCESS){ 返回值 0; };
    设备缓冲 = 缓冲;
    设备数量 = 数量;
    返回值 数量;
};
声明 物理设备名称(实例, 索引){
    如果(索引 < 0 || 索引 >= 设备数量){
        返回值 "";
    };
    设 设备 = 读(设备缓冲, 索引 * 8, 8);
    设 属性 = 结构(2048);

    设 fn = VK.加载函数(实例, "vkGetPhysicalDeviceProperties");
    VK.调用地址(fn, 设备, 属性);
    错误码 = 0;
    返回值 字符串.从内存(属性 + 20, 255);
};