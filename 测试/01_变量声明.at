类 变量声明测试 {
公开:
    声明 测试基本声明(){

        设 a=15;
        打印("a = " + a);

        设 name="大王";
        打印("name = " + name);

        设 小数=23.763;
        打印("小数 = " + 小数);

        设 名字=True;
        设 flag=真;
        打印("名字 = " + 名字);
        打印("flag = " + flag);

        设 name2=False;
        设 flag2=假;
        打印("name2 = " + name2);
        打印("flag2 = " + flag2);

        返回值 0;
    };

    声明 测试多变量声明(){

        设 a=15,b=20,c=30;
        打印("a=" + a + " b=" + b + " c=" + c);

        设 x,y,z 存在;
        x=1;
        y=2;
        z=3;
        打印("x=" + x + " y=" + y + " z=" + z);

        返回值 0;
    };

    声明 测试变量重新赋值(){
        设 a=10;
        打印("初始 a=" + a);

        a=20;
        打印("重新赋值后 a=" + a);

        a=a+5;
        打印("自增后 a=" + a);

        返回值 0;
    };

    声明 测试空值(){
        设 a = 空;
        打印("空值 a = " + a);

        如果(a == 空){
            打印("a 是空值");
        };

        返回值 0;
    };
};