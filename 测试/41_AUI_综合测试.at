类 main {
公开:
    声明 运行(){
        打印("=== 新一代 AUI 综合测试 ===");
        设 win = GL.窗口.创建(640, 480, "AUI 综合测试");
        如果(win <= 0){ 打印("窗口创建失败"); 返回值 1; };

        GL.矩阵(5889);
        GL.单位矩阵();
        GL.正交(0.0, 640, 0.0, 480, -1.0, 1.0);
        GL.矩阵(5888);
        GL.单位矩阵();
        打印("开始动画(300帧)");
        设 buf = 内存.分配(32);
        设 t = 0;
        设 running = 真;
        设 frame_count = 0;
        循环(running){

            GL.清屏(红:10, 绿:10, 蓝:26, 透明度:255);

            设 x = t % 200;
            GL.开始(7);
            GL.颜色(255, 64, 32, 255);
            GL.顶点(x, 100, 0.0);
            GL.顶点(x + 40, 100, 0.0);
            GL.顶点(x + 40, 140, 0.0);
            GL.顶点(x, 140, 0.0);
            GL.结束();

            GL.开始(1);
            GL.颜色(128, 0, 255, 255);
            GL.顶点(0, 0, 0.0);
            GL.顶点(640, 480, 0.0);
            GL.结束();

            GL.文本.绘制(窗口:win, x:20, y:20, 字号:20, 红:255, 绿:255, 蓝:255, 透明度:255, 文本:"frame=" + frame_count);

            GL.呈现(win);

            设 r = GL.事件.轮询(win, buf, 0);
            如果(r == -1){ running = 假; };
            t = t + 2;
            frame_count = frame_count + 1;
            如果(frame_count >= 300){ running = 假; };
        };
        打印("动画结束,共渲染 " + frame_count + " 帧");

        GL.清屏(0, 0, 0, 255);
        GL.文本.绘制(窗口:win, x:20, y:20, 字号:32, 红:0, 绿:255, 蓝:0, 透明度:255, 文本:"AUI 测试完成");
        GL.呈现(win);
        内存.释放(buf);
        GL.窗口.关闭(win);
        打印("PASS 41");
        返回值 0;
    };
};