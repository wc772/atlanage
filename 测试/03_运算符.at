类 运算符测试 {
公开:
    声明 测试算术运算符(){
        设 a = 10 + 5;
        设 b = 20 - 3;
        设 c = 6 * 7;
        设 d = 10 / 3;
        设 e = 10 % 3;

        打印("10 + 5 = " + a);
        打印("20 - 3 = " + b);
        打印("6 * 7 = " + c)；
        打印("10 % 3 = " + e);

        返回值 0;
    };

    声明 测试自增自减(){
        设 i = 0;
        i++;
        打印("i++ 后 = " + i);

        i += 5;
        打印("i+=5 后 = " + i);

        i--;
        打印("i-- 后 = " + i);

        i -= 3;
        打印("i-=3 后 = " + i);

        返回值 0;
    };

    声明 测试比较运算符(){
        设 a = 10;
        设 b = 20;

        如果(a == b){
            打印("a 等于 b");
        };

        如果(a != b){
            打印("a 不等于 b");
        };

        如果(a < b){
            打印("a 小于 b");
        };

        如果(a <= b){
            打印("a 小于等于 b");
        };

        如果(b > a){
            打印("b 大于 a");
        };

        如果(b >= a){
            打印("b 大于等于 a");
        };

        返回值 0;
    };

    声明 测试逻辑运算符(){
        设 条件1 = 真;
        设 条件2 = 假;

        如果(条件1 && 条件2){
            打印("两个都真");
        }否则{
            打印("不是两个都真");
        };

        如果(条件1 || 条件2){
            打印("至少一个为真");
        };

        如果(!条件2){
            打印("条件2取反为真");
        };

        设 玩家生命 = 80;
        设 敌人生存 = 真;

        如果(敌人生存 && 玩家生命 > 0){
            打印("战斗继续中");
        };

        返回值 0;
    };

    声明 测试字符串拼接(){
        设 完整消息 = "你好，" + "大王";
        打印(完整消息);

        设 玩家名称 = "冒险者";
        打印("第" + 1 + "行测试数据, 玩家=" + 玩家名称);

        返回值 0;
    };
};