设 全局计数 = 0;

声明 图元颜色(r, g, b){
    返回值 (r << 16) | (g << 8) | b;
};

声明 读整数(addr, off){
    设 b0 = 内存.读字节(addr, off);
    设 b1 = 内存.读字节(addr, off + 1);
    设 b2 = 内存.读字节(addr, off + 2);
    设 b3 = 内存.读字节(addr, off + 3);
    返回值 (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
};

类 组件 {
公开:
    设 名称 存在;
    设 所属对象 存在;

    声明 挂载(obj){
        所属对象 = obj;
        返回值 0;
    };

    声明 更新(){
        返回值 0;
    };

    声明 描述(){
        返回值 名称;
    };
};

类 盒组件 继承 组件 {
公开:
    声明 更新(){
        打印("组件派发: 盒组件");
        返回值 0;
    };
};

类 圆组件 继承 组件 {
公开:
    声明 更新(){
        打印("组件派发: 圆组件");
        返回值 0;
    };
};

类 文字组件 继承 组件 {
公开:
    声明 更新(){
        打印("组件派发: 文字组件");
        返回值 0;
    };
};

类 编号组件 继承 组件 {
公开:
    设 编号 存在;

    声明 描述(){
        返回值 名称 + "#" + 编号;
    };
};

类 游戏对象 {
公开:
    设 x 存在;
    设 y 存在;
    设 组件列表 存在;

    构造(px, py){
        x = px;
        y = py;
        组件列表 = {};
        全局计数 = 全局计数 + 1;
    };

    声明 添加组件(comp){
        组件列表.添加(comp);
        返回值 comp;
    };

    声明 更新(){
        循环(设 部件 : 组件列表){
            部件.更新();
        };
        返回值 0;
    };

    声明 组件数量(){
        返回值 组件列表.长度();
    };
};

类 点 {
公开:
    设 x 存在;
    设 y 存在;

    构造(px, py){
        x = px;
        y = py;
    };

    声明 打印点(){
        打印("点(" + x + ", " + y + ")");
        返回值 0;
    };
};

类 main {
公开:
    声明 运行(){
        打印("=== AtUnity 引擎能力验证 ===");

        设 p1 = 创建 点(10, 20);
        设 p2 = 创建 点(30, 40);
        p1.打印点();
        p2.打印点();

        设 对象 = 创建 游戏对象(0, 0);
        设 盒 = 创建 盒组件;
        设 圆 = 创建 圆组件;
        设 文字 = 创建 文字组件;
        盒.名称 = "盒";
        圆.名称 = "圆";
        文字.名称 = "文字";
        盒.挂载(对象);
        圆.挂载(对象);
        文字.挂载(对象);
        盒.更新();
        圆.更新();
        文字.更新();

        对象.添加组件(盒);
        对象.添加组件(圆);
        对象.添加组件(文字);
        打印("--- 对象遍历派发(列表+foreach+多态) ---");
        对象.更新();

        打印("--- 运行时派发与返回值 ---");
        设 编 = 创建 编号组件;
        编.名称 = "编号";
        编.编号 = 3;
        对象.添加组件(编);
        循环(设 部件 : 对象.组件列表){
            打印("描述: " + 部件.描述());
        };

        打印("列表长度 = " + 对象.组件数量());

        设 对象2 = 创建 游戏对象(50, 60);
        设 场景列表 = {};
        场景列表.添加(对象);
        场景列表.添加(对象2);
        设 计数 = 0;
        循环(设 项 : 场景列表){
            项.更新();
            计数 = 计数 + 1;
        };
        打印("场景列表遍历: " + 计数);

        打印("颜色 = " + 格式化("0x%x", 图元颜色(255, 0, 128)));

        设 addr = 内存.分配(8);
        内存.写字节(addr, 0, 4);
        内存.写字节(addr, 1, 3);
        内存.写字节(addr, 2, 2);
        内存.写字节(addr, 3, 1);
        打印("读整数 = " + 格式化("0x%08x", 读整数(addr, 0)));
        内存.释放(addr);

        设 r = 2.5;
        打印("浮点 = " + r);

        打印("全局计数 = " + 全局计数);

        打印("=== 验证通过 ===");
        返回值 0;
    };
};