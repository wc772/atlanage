声明 worker(n) {
    原子.增加(全局任务数);
    返回值 0;
};

设 全局计数器 = 0;
设 全局锁 存在;
设 全局任务数 = 0;

声明 累加(){
    设 i = 0;
    循环(i < 1000){
        同步.锁获取(全局锁);
        全局计数器 = 全局计数器 + 1;
        同步.锁释放(全局锁);
        i = i + 1;
    };
};

类 多线程测试 {
公开:
    声明 测试基本线程创建(){
        打印("=== 基本线程创建 ===");

        全局任务数 = 0;

        设 t1 = 进程.创建("worker", 1);
        设 t2 = 进程.创建("worker", 2);

        打印("主线程继续工作");

        进程.等待(t1);
        进程.等待(t2);

        如果(全局任务数 == 2){
            打印("两个线程均已执行");
        }否则{
            打印("线程执行计数错误: " + 全局任务数);
        };
        返回值 0;
    };

    声明 测试互斥锁同步(){
        打印("=== 互斥锁同步测试 ===");

        全局计数器 = 0;
        全局锁 = 同步.锁创建();

        设 t1 = 进程.创建("累加");
        设 t2 = 进程.创建("累加");

        进程.等待(t1);
        进程.等待(t2);

        打印("计数器=" + 全局计数器);

        如果(全局计数器 == 2000){
            打印("互斥锁同步正确");
        }否则{
            打印("互斥锁同步错误！期望2000，实际=" + 全局计数器);
        };

        返回值 0;
    };

    声明 测试原子操作(){
        打印("=== 原子操作测试 ===");

        全局计数器 = 0;

        设 t1 = 进程.创建("累加_原子");
        设 t2 = 进程.创建("累加_原子");

        进程.等待(t1);
        进程.等待(t2);

        打印("计数器=" + 全局计数器);
        如果(全局计数器 == 2000){
            打印("原子操作同步正确");
        }否则{
            打印("原子操作同步错误！期望2000，实际=" + 全局计数器);
        };

        返回值 0;
    };

    声明 测试获取自身线程ID(){
        打印("=== 获取自身线程ID ===");

        设 myId = 进程.自身;
        如果(myId != 空 && myId > 0){
            打印("获取线程ID成功");
        }否则{
            打印("线程ID获取失败");
        };

        返回值 0;
    };
};

声明 累加_原子(){
    设 i = 0;
    循环(i < 1000){
        原子.增加(全局计数器);
        i = i + 1;
    };
};