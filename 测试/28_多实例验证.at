类 点 {
公开:
    设 x 存在;
    设 y 存在;

    声明 测试多实例(){
        创建 点:p1;
        创建 点:p2;
        p1.x = 10;
        p1.y = 20;
        p2.x = 99;
        p2.y = 88;
        打印("p1.x = " + p1.x);
        打印("p1.y = " + p1.y);
        打印("p2.x = " + p2.x);
        打印("p2.y = " + p2.y);
        如果(p1.x == p2.x){
            打印("错误: p1和p2是同一实例!");
        }否则{
            打印("正确: p1和p2是不同实例");
        };
        返回值 0;
    };

    声明 测试字段独立性(){
        创建 点:a;
        创建 点:b;
        创建 点:c;
        a.x = 1;
        b.x = 2;
        c.x = 3;
        打印("a.x=" + a.x + " b.x=" + b.x + " c.x=" + c.x);
        a.x = 100;
        打印("修改a.x后: a.x=" + a.x + " b.x=" + b.x + " c.x=" + c.x);
        返回值 0;
    };
};