创建引子 三数和(整数,整数,整数){
    返回值 参数1 + 参数2 + 参数3;
};

创建引子 平均分(浮点数,浮点数,浮点数){
    返回值 (参数1 + 参数2 + 参数3) / 3.0;
};

创建引子 交换(整数,整数){

    返回值 参数2 + "," + 参数1;
};

创建引子 拼接三(字符串,字符串,字符串){
    返回值 参数1 + 参数2 + 参数3;
};

创建引子 别名测试(整数,整数){
    返回值 参数一 + 参数二;
};

类 引子进阶测试 {
公开:
    声明 测试三参数(){
        打印("=== 三参数引子 ===");
        设 a = 0;
        引用.三数和(10, 20, 30)=a;
        打印("三数和(10,20,30) = " + a);

        设 b = 0;
        引用.三数和(1, 2, 3)=b;
        打印("三数和(1,2,3) = " + b);
        返回值 0;
    };

    声明 测试浮点数参数(){
        打印("=== 浮点数参数 ===");
        设 a = 0;
        引用.平均分(1.0, 2.0, 3.0)=a;
        打印("平均分(1.0,2.0,3.0) = " + a);

        设 b = 0;
        引用.平均分(4.0, 5.0, 6.0)=b;
        打印("平均分(4.0,5.0,6.0) = " + b);
        返回值 0;
    };

    声明 测试参数顺序(){
        打印("=== 参数顺序交换 ===");
        设 r = "";
        引用.交换(5, 9)=r;
        打印("交换(5,9) = " + r);
        返回值 0;
    };

    声明 测试三字符串拼接(){
        打印("=== 三字符串拼接 ===");
        设 r = "";
        引用.拼接三(Hello, World, Hey)=r;
        打印("拼接三(Hello, World, Hey) = " + r);
        返回值 0;
    };

    声明 测试文档别名(){

        设 r = 0;
        引用.别名测试(3, 4)=r;
        打印("别名测试(3,4) = " + r);
        返回值 0;
    };
};