类 显示弹窗测试 {
公开:
    声明 测试简单弹窗() {
        打印("=== 1. 简单弹窗（无返回值） ===");
        打印("即将弹出窗口，请输入后点确定...");
        显示<<"请输入你的名字："<<end;
        打印("弹窗已关闭");
        返回值 0;
    };

    声明 测试弹窗返回值() {
        打印("=== 2. 弹窗返回值 ===");
        设 名字 = 显示<<"请输入你的名字："<<end;
        打印("你输入了：" + 名字);
        返回值 0;
    };

    声明 测试指定尺寸弹窗() {
        打印("=== 3. 指定尺寸弹窗 ===");
        设 答案 = 显示(500, 300)<<"这是一个500x300的弹窗，请输入答案："<<end;
        打印("你的答案是：" + 答案);
        返回值 0;
    };
};