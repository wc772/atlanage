类 时间等待测试 {
公开:
    声明 测试获取当前时间(){
        打印("=== 获取当前时间 ===");

        打印(时间);

        设 当前时间 = 时间;
        打印("当前时间: " + 当前时间);

        返回值 0;
    };

    声明 测试等待_秒(){
        打印("=== 等待（秒） ===");

        打印("等待前: " + 时间);
        等待 2秒;
        打印("等待2秒后: " + 时间);

        返回值 0;
    };

    声明 测试等待_分(){
        打印("=== 等待（分） ===");

        打印("等待前: " + 时间);
        等待 1分;
        打印("等待1分后: " + 时间);

        返回值 0;
    };

    声明 测试等待_变量(){
        打印("=== 等待（变量延时） ===");

        设 a = 3;
        打印("等待 " + a + " 秒...");
        等待 a秒;

        打印("延时完成");
        返回值 0;
    };

    声明 测试时间差计算(){
        打印("=== 时间差计算 ===");

        设 开始时间 = 时间;
        等待 1秒;
        设 结束时间 = 时间;

        打印("开始: " + 开始时间);
        打印("结束: " + 结束时间);

        返回值 0;
    };

    声明 测试毫秒时间(){
        打印("=== 毫秒时间（用于性能计时） ===");

        设 开始 = 毫秒时间();

        设 sum = 0;
        循环(设 i=0; i<10000; i++){
            sum = sum + i;
        };

        设 结束 = 毫秒时间();
        打印("计算10000次累加耗时=" + (结束 - 开始) + "ms");

        返回值 0;
    };

    声明 测试毫秒时间精确计时(){
        打印("=== 精确性能计时 ===");

        设 开始 = 毫秒时间();

        循环(设 i=0; i<50000; i++){
            设 temp = i * i;
        };

        设 结束 = 毫秒时间();
        设 耗时 = 结束 - 开始;
        打印("50000次乘法运算耗时=" + 耗时 + "ms");

        如果(耗时 < 1000){
            打印("性能良好");
        };

        返回值 0;
    };

    声明 测试循环中的时间变化(){
        打印("=== 循环中观察时间变化 ===");

        设 开始 = 时间;
        循环(3){
            等待 1秒;
            打印(时间);
        };
        设 结束 = 时间;

        打印("开始时间: " + 开始);
        打印("结束时间: " + 结束);

        返回值 0;
    };
};