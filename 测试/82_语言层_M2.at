类 main {
公开:
    声明 运行(){
        打印("=== 语言层 M2 ===");

        设 p = (1, 2, 3);
        打印("元组个数=" + p.个数());
        打印("元组2=" + p[1]);

        设 pts = [(0, 0), (10, 20)];
        打印("点集个数=" + pts.个数());
        打印("点集1x=" + pts[1][0]);

        设 s = "hello world";
        打印("包含=" + 字符串.包含(s, "world"));
        打印("不包含=" + 字符串.包含(s, "xyz"));

        每帧{
            跳出;
        };
        打印("每帧=ok");

        打印("PASS 82");
        返回值 0;
    };
};