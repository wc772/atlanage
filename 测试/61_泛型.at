类 盒<T> {
公开:
    设 值 存在;
    构造(v){
        值 = v;
    };
    声明 取出(){
        返回值 值;
    };
};
类 组集<T> {
公开:
    设 数据 存在;
    构造(d){
        数据 = d;
    };
};
声明 双倍<T>(x){
    返回值 x * 2;
};
类 T {
公开:
    声明 测试(){

        设 b1 = 创建 盒<整>(21);
        如果(b1.取出() == 21){ 打印("OK1 泛型盒-整: " + b1.取出()); }否则{ 打印("FAIL1"); };

        设 b2 = 创建 盒<字>("hello");
        如果(b2.取出() == "hello"){ 打印("OK2 泛型盒-字: " + b2.取出()); }否则{ 打印("FAIL2"); };

        设 b3 = 创建 盒<小数>(3.5);
        如果(b3.取出() == 3.5){ 打印("OK3 泛型盒-小数: " + b3.取出()); }否则{ 打印("FAIL3"); };

        设 r = 双倍<整>(21);
        如果(r == 42){ 打印("OK4 泛型函数: " + r); }否则{ 打印("FAIL4: " + r); };

        设 g = 创建 组集<盒<整>>(b1);
        如果(g.数据 == b1){ 打印("OK5 嵌套泛型"); }否则{ 打印("FAIL5"); };

        设 a = 10;
        如果(a < 20){ 打印("OK6 小于不回归"); }否则{ 打印("FAIL6"); };
        如果(20 > a){ 打印("OK7 大于不回归"); }否则{ 打印("FAIL7"); };

        设 b4 = 创建 盒(99);
        如果(b4.取出() == 99){ 打印("OK8 无泛型等价: " + b4.取出()); }否则{ 打印("FAIL8"); };
        返回值 0;
    };
};