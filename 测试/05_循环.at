类 循环测试 {
公开:
    声明 测试次数循环(){
        打印("=== 次数循环：循环10次 ===")；
        循环(15){
            打印("你好");
        };

        返回值 0;
    };

    声明 测试条件循环(){
        打印("=== 条件 ===");

        设 i = 0;
        循环(i < 5){
            打印("i = " + i);
            i = i + 1;
        };

        返回值 0;
    };

    声明 测试C风格循环(){
        打印("=== C风格for循环 ===");

        循环(设 i=0; i<5; i++){
            打印("i = " + i);
        };

        返回值 0;
    };

    声明 测试Foreach循环(){
        打印("=== Foreach迭代循环 ===");

        设 列表 = {10, 20, 30, 40, 50};
        循环(设 项 : 列表){
            打印("项 = " + 项);
        };

        返回值 0;
    };

    声明 测试无限循环带跳出(){
        打印("=== 无限循环（带跳出） ===");

        设 count = 0;
        循环{
            打印("count = " + count);
            count = count + 1;
            如果(count >= 3){
                跳出;
            };
        };

        打印("退出无限循环，count = " + count);
        返回值 0;
    };

    声明 测试继续语句(){
        打印("=== 继续语句（跳过i=5） ===");

        设 i = 0;
        循环(i < 10){
            i = i + 1;
            如果(i == 5){
                继续;
            };
            如果(i > 8){
                跳出;
            };
            打印(i);
        };

        返回值 0;
    };

    声明 测试循环中的继续(){
        打印("=== C风格循环中使用继续 ===");

        循环(设 i=0; i<10; i++){
            如果(i == 5){
                继续;
            };
            打印(i);
        };

        返回值 0;
    };

    声明 测试斐波那契数列(){
        打印("=== 斐波那契数列 ===");

        列表 f[10]={1,1};
        设 i 存在;

        循环(i=2;i<=9;i++){
            f[i]=f[i-2]+f[i-1];
        };

        循环(i=0;i<=9;i++){
            打印(f[i]);
        };

        返回值 0;
    };
};