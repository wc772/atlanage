类 T {
公开:
    声明 测试(){
        设 a = 真;
        设 b = 假;

        如果(a 且 b){ 打印("FAIL: a且b 应为假"); }否则{ 打印("OK1 且: 假"); };
        如果(a 且 a){ 打印("OK2 且: 真"); }否则{ 打印("FAIL: a且a 应为真"); };

        如果(a 或 b){ 打印("OK3 或: 真"); }否则{ 打印("FAIL: a或b 应为真"); };
        如果(b 或 b){ 打印("FAIL: b或b 应为假"); }否则{ 打印("OK4 或: 假"); };

        如果(非 a){ 打印("FAIL: 非a 应为假"); }否则{ 打印("OK5 非: 假"); };
        如果(非 b){ 打印("OK6 非: 真"); }否则{ 打印("FAIL: 非b 应为真"); };

        设 c1 = (a && b) 或 (非 b);
        设 c2 = (a && b) || (!b);
        如果(c1 == c2){ 打印("OK7 混用等价: " + c1); }否则{ 打印("FAIL: 混用不等 " + c1 + " vs " + c2); };

        设 x = 5;
        设 y = 10;
        如果(x < y 且 x > 0 或 y == 10){ 打印("OK8 混合链: 真"); }否则{ 打印("FAIL: 混合链"); };

        设 非会员 = 42;
        设 会员数 = 非会员 + 1;
        如果(非会员 == 42 且 会员数 == 43){ 打印("OK9 非会员标识符: " + 会员数); }否则{ 打印("FAIL: 非会员标识符被误拆"); };

        设 次数 = 0;
        声明 副作用(){
            次数 = 次数 + 1;
            返回值 真;
        };
        如果(a 或 副作用()){ 打印("OK10 短路: 或右侧未执行(次数=" + 次数 + ")"); };
        如果(b 且 副作用()){ 打印("FAIL: b且副作用 不应执行"); };
        如果(次数 == 0){ 打印("OK11 短路: 且右侧未执行"); }否则{ 打印("FAIL: 且未短路 次数=" + 次数); };

        返回值 0;
    };
};