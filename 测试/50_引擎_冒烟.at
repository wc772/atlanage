引用.文件("lib/atunity/引擎.at")

类 冒烟场景 继承 场景 {
公开:
    声明 进入(){
        打印("场景进入");

        设 球 = 创建 游戏对象;
        球.x = 0;
        球.y = 100;
        设 圆碰撞 = 创建 圆碰撞器;
        圆碰撞.设置半径(30);
        球.添加部件(圆碰撞);
        设 圆形状 = 创建 形状渲染器;
        圆形状.设置形状(2);
        圆形状.设置半径(30);
        圆形状.设置颜色(图元颜色(255, 64, 64));
        球.添加部件(圆形状);
        添加(球);

        设 ui = 创建 游戏对象;
        ui.x = 0;
        ui.y = 250;
        设 标题文字 = 创建 文本渲染器;
        标题文字.设置文本("AtUnity 冒烟测试");
        标题文字.设置字号(24);
        标题文字.设置颜色(文字颜色(255, 255, 255));
        ui.添加部件(标题文字);
        添加(ui);
        返回值 0;
    };

    声明 更新(dt){
        如果(帧数() % 60 == 0){
            打印("帧 " + 帧数() + " 对象数=" + 对象数量());
        };
        返回值 0;
    };
};

类 main {
公开:
    声明 运行(){
        设 游戏 = 创建 引擎(800, 600, "AtUnity 冒烟测试");
        游戏.设置自动帧数(120);
        游戏.启动(创建 冒烟场景);
        返回值 0;
    };
};