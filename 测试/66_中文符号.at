类 测试 {
公开:
    声明 运行(){

        设 组集 字典 = {"键"： "值"}；
        打印("S1: " + 字典["键"])；

        设 a = 1；设 b = 2；
        打印("S2: " + (a + b))；

        设 s = “你好，世界”；
        打印("S3: " + s)；

        设 t = “他说"hello"”；
        打印("S4: " + t)；

        设 名 = "玄铁"；
        设 u = “名字：#{名}”；
        打印("S5: " + u)；

        设 组集 列表 = [10, 20, 30]；
        打印("S6: " + 列表【1】)；

        设 v = “引号\”内”；
        打印("S7: " + v)；

        选择(42){
            情况 42：打印("S8: 全角情况")；
            默认：打印("S8 FAIL")；
        }；

        设 混合 = "a" + “b”；
        如果(混合 == "ab"){ 打印("S9: " + 混合)； }否则{ 打印("S9 FAIL")； }；

        打印（"S10: 全角括号"）；
        设 十 = （5 + 5）；
        打印("S10b: " + 十)；

        打印（"S11: "， 42）；
        设 x＝1，y＝2；
        打印("S11b: " + (x + y))；

        设 全角赋值 存在；
        全角赋值＝99；
        打印("S12: " + 全角赋值)；

        设 四则 ＝ 10＋5＊2－8／4；
        打印("S13: " + 四则)；

        设 复合 ＝ 10；
        复合＋＝5；
        复合－＝3；
        打印("S14: " + 复合)；

        如果(真)｛
            打印("S15: 全角花括号")；
        ｝；

        返回值 0；
    }；
}；