引用.文件("lib/atunity/引擎.at")

设 得分 = 0;

类 弹球场景 继承 场景 {
公开:
    设 球 存在;
    设 球刚体 存在;
    设 挡板 存在;

    声明 进入(){

        球 = 创建 游戏对象;
        设 球形状 = 创建 形状渲染器;
        球形状.设置形状(2);
        球形状.设置半径(12);
        球形状.设置颜色(颜色黄);
        球.添加部件(球形状);
        球刚体 = 创建 刚体;
        球刚体.设置速度(4, 4);
        球.添加部件(球刚体);
        添加(球);

        挡板 = 创建 游戏对象;
        挡板.y = -260;
        设 板形状 = 创建 形状渲染器;
        板形状.设置形状(1);
        板形状.设置尺寸(50, 8);
        板形状.设置颜色(颜色青);
        挡板.添加部件(板形状);
        添加(挡板);
        返回值 0;
    };

    声明 更新(dt){
        挡板.x = 限幅(鼠标x(), -350, 350);

        如果(球.x > 370){ 球刚体.速度x = 0 - 球刚体.速度x; };
        如果(球.x < -370){ 球刚体.速度x = 0 - 球刚体.速度x; };
        如果(球.y > 280){ 球刚体.速度y = 0 - 球刚体.速度y; };

        如果(球.y < -245 && 球.y > -275 && 绝对值(球.x - 挡板.x) < 55){
            球刚体.速度y = 绝对值(球刚体.速度y);
            得分 = 得分 + 1;
        };

        如果(球.y < -310){ 球.y = 0; 球.x = 0; 得分 = 0; };
        返回值 0;
    };
};

类 main {
公开:
    声明 运行(){
        设 游戏 = 创建 引擎(800, 600, "弹球");
        游戏.设置自动帧数(0);
        游戏.启动(创建 弹球场景);
        返回值 0;
    };
};