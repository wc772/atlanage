类 T {
公开:
    声明 加一(n){
        返回值 n + 1;
    };
    声明 测试(){

        设 x = 42;
        设 s1 = "值是#{x}";
        如果(s1 == "值是42"){ 打印("OK1 基本: " + s1); }否则{ 打印("FAIL1: " + s1); };

        设 s2 = "#{x}";
        如果(s2 == "42"){ 打印("OK2 纯插值"); }否则{ 打印("FAIL2: " + s2); };

        设 a = "A"; 设 b = "B";
        设 s3 = "#{a}-#{b}";
        如果(s3 == "A-B"){ 打印("OK3 多插值: " + s3); }否则{ 打印("FAIL3: " + s3); };

        设 s4 = "1+1=#{1+1}";
        如果(s4 == "1+1=2"){ 打印("OK4 算术: " + s4); }否则{ 打印("FAIL4: " + s4); };
        设 s5 = "加一(41)=#{加一(41)}";
        如果(s5 == "加一(41)=42"){ 打印("OK5 函数调用: " + s5); }否则{ 打印("FAIL5: " + s5); };

        设 s6 = "#{"x}"}";
        如果(s6 == "x}"){ 打印("OK6 段内字符串: " + s6); }否则{ 打印("FAIL6: " + s6); };

        设 s7 = "\#{x}";
        如果(s7 == "\#{x}"){ 打印("OK7 转义插值: " + s7); }否则{ 打印("FAIL7: " + s7); };
        设 s8 = "a\#b";
        如果(s8 == "a#b"){ 打印("OK8 转义井号: " + s8); }否则{ 打印("FAIL8: " + s8); };

        设 s9 = "值是#{x}";
        设 s10 = "值是" + x;
        如果(s9 == s10){ 打印("OK9 与拼接等价"); }否则{ 打印("FAIL9: " + s9 + " vs " + s10); };

        设 s11 = "前#{a}中" + b + "后#{x}";
        如果(s11 == "前A中B后42"){ 打印("OK10 混合: " + s11); }否则{ 打印("FAIL10: " + s11); };

        设 s12 = "#{加一(加一(1))}";
        如果(s12 == "3"){ 打印("OK11 嵌套调用: " + s12); }否则{ 打印("FAIL11: " + s12); };

        返回值 0;
    };
};