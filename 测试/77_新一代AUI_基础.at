类 main {
公开:
    声明 运行(){
        打印("=== 新一代 AUI 基础 ===");

        设 win = GL.窗口.创建(320, 240, "AUI测试");
        打印("窗口创建=" + (win > 0));

        设 正交 = GL.正交(0.0, 320, 0.0, 240, -1.0, 1.0);
        打印("正交=" + 正交);

        设 文本 = GL.文本.绘制(窗口:win, x:10, y:10, 字号:20, 红:255, 绿:255, 蓝:255, 透明度:255, 文本:"Hello AUI");
        打印("文本绘制=" + 文本);

        设 清屏 = GL.清屏(红:10, 绿:10, 蓝:26, 透明度:255);
        打印("清屏=" + 清屏);

        设 呈现 = GL.呈现(win);
        打印("呈现=" + 呈现);
        设 关闭 = GL.窗口.关闭(win);
        打印("窗口关闭=" + 关闭);

        打印("PASS 77");
        返回值 0;
    };
};