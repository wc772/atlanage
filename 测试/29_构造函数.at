类 点 {
公开:
    设 x 存在;
    设 y 存在;

    构造(px, py){
        x = px;
        y = py;
    };

    声明 显示点(){
        打印("点(" + x + ", " + y + ")");
        返回值 0;
    };
};

类 计数器 {
公开:
    设 count 存在;

    构造(){
        count = 0;
    };

    声明 增加(){
        count = count + 1;
        返回值 count;
    };
};

类 构造测试 {
公开:
    声明 测试带参构造(){
        创建 点:p1(10, 20);
        创建 点:p2(30, 40);
        p1.显示点();
        p2.显示点();
        返回值 0;
    };

    声明 测试无参构造(){
        创建 计数器:c1;
        创建 计数器:c2;
        c1.增加();
        c1.增加();
        c1.增加();
        c2.增加();
        打印("c1.count = " + c1.count);
        打印("c2.count = " + c2.count);
        返回值 0;
    };
};