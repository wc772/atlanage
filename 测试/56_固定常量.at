类 测试固定常量 {
    声明 测试(){
        打印("=== 固定常量 ===");
        固定 税率 = 0.13;
        固定 版本 = "V2.0";
        设 价格 = 100;
        打印("税率=" + 税率);
        打印("版本=" + 版本);
        打印("价格*税率=" + 价格 * 税率);

        打印("=== 多变量 ===");
        固定 最大人数 = 100, 标题 = "游戏";
        打印("最大人数=" + 最大人数);
        打印("标题=" + 标题);
        返回值 0;
    };
};