类 字符串操作测试 {
公开:
    声明 测试字符串长度(){
        打印("=== 字符串长度 ===");

        设 消息 = "你好";
        打印("'你好' 的长度 = " + 消息.长度);

        设 英文 = "Hello";
        打印("'Hello' 的长度 = " + 英文.长度);

        设 空串 = "";
        打印("空字符串长度 = " + 空串.长度);

        返回值 0;
    };

    声明 测试检索方法_次数(){
        打印("=== .检索(s) - 统计出现次数 ===");

        设 a = "你好世界你好".检索("你好");
        打印("'你好' 在 '你好世界你好' 中出现次数: " + a);

        设 b = "abcabcabc".检索("abc");
        打印("'abc' 在 'abcabcabc' 中出现次数: " + b);

        返回值 0;
    };

    声明 测试检索方法_行号(){
        打印("=== .检索(h) - 返回所在行号 ===");

        设 b = "你好".检索行("你好");
        打印("'你好' 所在的行: " + b);

        返回值 0;
    };

    声明 测试检索方法_定位(){
        打印("=== .检索(h[0]) - 定位第一个出现位置 ===");

        设 a = "你好世界".检索行("不存在");
        打印("'你好' 第一个出现位置: " + a);

        返回值 0;
    };

    声明 测试包含判断(){
        打印("=== .包含() ===");

        设 请求数据 = "GET /index.html HTTP/1.1";

        如果(请求数据.包含("GET")){
            打印("这是GET请求");
        };

        如果(请求数据.包含("POST")){
            打印("这是POST请求");
        }否则{
            打印("不是POST请求");
        };

        如果(请求数据.包含("HTTP")){
            打印("包含HTTP协议标识");
        };

        返回值 0;
    };

    声明 测试子字符串(){
        打印("=== .子字符串() ===");

        设 全名 = "冒险者大王";
        设 简称 = 全名.子字符串(0, 3);
        打印("全名: " + 全名);
        打印("子字符串(0,3): " + 简称);

        设 从中间 = 全名.子字符串(3);
        打印("子字符串(3): " + 从中间);

        返回值 0;
    };

    声明 测试开头结尾判断(){
        打印("=== .以开始() / .以结束() ===");

        设 路径1 = "/usr/local/bin";
        设 路径2 = "data/config.txt";

        如果(路径1.以开始("/")){
            打印(路径1 + " 是绝对路径");
        };

        如果(!路径2.以开始("/")){
            打印(路径2 + " 可能是相对路径");
        };

        设 文件名 = "script.at";
        如果(文件名.以结束(".at")){
            打印(文件名 + " 是Atlanage源文件");
        };

        返回值 0;
    };
};