引用.模块导入("../工具/atp/atp.at");

类 依赖范围测试 {
公开:
    声明 运行(){

        打印("=== 依赖范围: 版本满足单元 ===");
        打印("s1=" + 引用.atp版本满足("^1.0.0", "1.2.0"));
        打印("s2=" + 引用.atp版本满足("^2.0.0", "1.2.0"));
        打印("s3=" + 引用.atp版本满足(">=1.0.0", "1.2.0"));
        打印("s4=" + 引用.atp版本满足("", "1.2.0"));
        打印("s5=" + 引用.atp版本满足("latest", "1.2.0"));
        打印("s6=" + 引用.atp版本满足("1.2.0", "1.2.0"));
        打印("s7=" + 引用.atp版本满足("1.2.0", "1.3.0"));

        打印("=== 依赖范围: 范围安装与冲突 ===");
        设 临时 = "_72atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);
        创建文件夹("仓库");
        创建文件夹("仓库/网络请求");
        二进制写入("仓库/网络请求/atp.json", 0, 引用.atp清单文本("网络请求", "2.0.0"));
        二进制写入("仓库/网络请求/入口.at", 0, "声明 f(参数){ 返回值 0; };\n");
        创建文件夹("仓库/依赖A");
        二进制写入("仓库/依赖A/atp.json", 0, "# A\n包名: 依赖A\n版本: 1.0.0\n入口: 入口.at\n依赖: 网络请求@>=1.0.0\n");
        二进制写入("仓库/依赖A/入口.at", 0, "声明 f(参数){ 返回值 0; };\n");
        创建文件夹("仓库/依赖B");
        二进制写入("仓库/依赖B/atp.json", 0, "# B\n包名: 依赖B\n版本: 1.0.0\n入口: 入口.at\n依赖: 网络请求@^1.0.0\n");
        二进制写入("仓库/依赖B/入口.at", 0, "声明 f(参数){ 返回值 0; };\n");

        设 c1 = 引用.atp安装("依赖A", "仓库", "包/", "");
        如果(c1 == 空){ 打印("A安装=false"); }否则{ 打印("A安装=true"); };

        二进制写入("仓库/网络请求/atp.json", 0, 引用.atp清单文本("网络请求", "1.0.0"));
        设 c2 = 引用.atp安装("依赖B", "仓库", "包/", "");
        如果(c2 == 空){ 打印("B安装=空"); }否则{ 打印("B安装=非空"); };

        设 已有 = 字节读取("依赖/网络请求/atp.json", 0, 1048576);
        如果(已有 == 空){
            打印("已装版本=无");
        }否则{
            打印("已装版本=" + 引用.atp清单取值(已有, "版本"));
        };

        返回值 0;
    };
};