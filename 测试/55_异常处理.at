声明 除(a, b) {
  如果(b == 0){ 抛出 "除数不能为零"; };
  返回值 a / b;
};

类 测试异常 {
    声明 测试(){
        打印("=== 基本捕获 ===");
        尝试{
            设 x = 除(10, 0);
        }捕获(错误){
            打印("出错了：" + 错误.信息);
            打印("行号=" + 错误.行号);
        }最终{
            打印("除法调用结束");
        };

        打印("=== 无异常 ===");
        尝试{
            设 y = 除(10, 5);
            打印("结果=" + y);
        }捕获(错误){
            打印("不应到这里");
        };
        打印("正常结束");

        打印("=== 嵌套 ===");
        尝试{
            尝试{
                抛出 "内部错误";
            }捕获(内错){
                打印("内层捕获: " + 内错.信息);
            };
            打印("外层继续");
        }捕获(外错){
            打印("不应到这里: " + 外错.信息);
        };

        打印("=== 捕获中抛出 ===");
        尝试{
            尝试{
                抛出 "原始错误";
            }捕获(一错){
                抛出 "重抛错误";
            };
        }捕获(二错){
            打印("二次捕获: " + 二错.信息);
        };

        打印("=== 最终总是执行 ===");
        尝试{
            尝试{
                抛出 "内部错误";
            }最终{
                打印("清理完成");
            };
        }捕获(错误){
            打印("重抛捕获: " + 错误.信息);
        };
        返回值 0;
    };
};