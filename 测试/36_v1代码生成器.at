引用.文件(../self-hosted/atl_ds.at);
引用.文件(../self-hosted/atl_lexer.at);
引用.文件(../self-hosted/atl_parser.at);
引用.文件(../self-hosted/atl_semantic.at);
引用.文件(../self-hosted/atl_codegen.at);

类 代码生成测试 {
公开:

    声明 编译并获取汇编(src){
        创建 ArrayList:tokens;
        tokens = lex(src);
        创建 Parser:p(tokens);
        创建 ArrayList:decls;
        decls = p.parse_program();
        sem_analyze(decls);
        codegen_reset();
        codegen_emit();
        返回值 codegen_get_output();
    };

    声明 检查1(){
        打印("=== 代码生成检查1: 简单变量和表达式 ===");
        设 src = "设 a = 1;\n设 b = a + 2;\n打印(b);";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查1结束 ---");
        返回值 0;
    };

    声明 检查2(){
        打印("=== 代码生成检查2: 函数定义和调用 ===");
        设 src = "声明 加法(a, b) {\n  返回值 a + b;\n};\n声明 主() {\n  设 s = 加法(3, 4);\n  返回值 s;\n};";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查2结束 ---");
        返回值 0;
    };

    声明 检查3(){
        打印("=== 代码生成检查3: 类和方法 ===");
        设 src = "类 点 {\n公开:\n  设 x 存在;\n  设 y 存在;\n  声明 距离() {\n    返回值 x + y;\n  };\n};";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查3结束 ---");
        返回值 0;
    };

    声明 检查4(){
        打印("=== 代码生成检查4: 字符串字面量 ===");
        设 src = "打印(\"hello\");\n打印(\"中文测试\");";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查4结束 ---");
        返回值 0;
    };

    声明 检查5(){
        打印("=== 代码生成检查5: 控制流 ===");
        设 src = "设 x = 10;\n如果(x > 5) {\n  打印(\"大\");\n} 否则 {\n  打印(\"小\");\n};\n循环(x > 0) {\n  打印(x);\n  x = x - 1;\n};";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查5结束 ---");
        返回值 0;
    };

    声明 检查6(){
        打印("=== 代码生成检查6: 函数内内置函数调用 ===");
        设 src = "声明 测试() {\n  打印(\"hello\");\n  设 n = 整数(\"42\");\n  设 cp = 码点(\"A\");\n  设 s = 字符(65);\n  返回值 n;\n};";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查6结束 ---");
        返回值 0;
    };

    声明 检查7(){
        打印("=== 代码生成检查7: 字符串方法调用 ===");
        设 src = "声明 测试() {\n  设 s = \"hello\";\n  设 n = s.长度;\n  设 sub = s.子字符串(0, 3);\n  设 found = s.包含(\"ell\");\n  返回值 n;\n};";
        设 asm = 编译并获取汇编(src);
        打印(asm);
        打印("--- 检查7结束 ---");
        返回值 0;
    };

    声明 测试运行(){
        检查1();
        检查2();
        检查3();
        检查4();
        检查5();
        检查6();
        检查7();
        打印("=== 代码生成器测试完成 ===");
        返回值 0;
    };
};