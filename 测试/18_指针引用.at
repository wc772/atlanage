类 指针引用测试 {
公开:
    声明 测试取引用(){
        打印("=== 取引用 & ===");

        设 a = 42;
        设 ptr = &a;

        打印("a 的值 = " + a);
        打印("ptr 持有 a 的引用");

        返回值 0;
    };

    声明 测试解引用读取(){
        打印("=== 解引用读取 * ===");

        设 a = 42;
        设 ptr = &a;
        设 b = *ptr;

        打印("通过引用读取的值 b = " + b);

        如果(b == 42){
            打印("解引用读取正确");
        };

        返回值 0;
    };

    声明 测试解引用写入(){
        打印("=== 解引用写入 ===");

        设 a = 42;
        设 ptr = &a;

        *ptr = 100;
        打印("通过引用写入后 a = " + a);

        如果(a == 100){
            打印("解引用写入正确");
        };

        返回值 0;
    };

    声明 测试引用传递(){
        打印("=== 模拟引用传递 ===");

        设 原始值 = 10;
        设 引用 = &原始值;

        *引用 = 999;
        打印("原始值变为: " + 原始值);

        如果(原始值 == 999){
            打印("引用传递修改成功");
        };

        返回值 0;
    };

    声明 测试多变量引用(){
        打印("=== 多变量引用 ===");

        设 x = 10;
        设 y = 20;
        设 z = 30;

        设 px = &x;
        设 py = &y;
        设 pz = &z;

        打印("x=" + x + " y=" + y + " z=" + z);

        设 temp = *px;
        *px = *py;
        *py = temp;

        打印("交换后 x=" + x + " y=" + y);

        返回值 0;
    };
};