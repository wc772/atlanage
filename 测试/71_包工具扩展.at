引用.模块导入("../工具/atp/atp.at");

类 atp工具扩展测试 {
公开:
    声明 运行(){
        设 临时 = "_71atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);

        打印("=== 包工具扩展: 遍历目录 ===");
        创建文件夹("_71d");
        创建文件夹("_71d/子目录");
        二进制写入("_71d/f1.txt", 0, "hi");
        设 l = 文件.遍历目录("_71d");
        打印("遍历个数=" + l.长度());
        设 i = 0;
        循环(i < l.长度()){
            打印("条目=" + l[i]);
            i = i + 1;
        };
        设 l2 = 文件.遍历目录("_71不存在");
        打印("空表个数=" + l2.长度());

        打印("=== 包工具扩展: 删除 ===");
        设 d1 = 文件.删除("_71d/f1.txt");
        打印("删除文件=" + d1);
        设 d1b = 文件.删除("_71d/f1.txt");
        打印("再删文件=" + d1b);
        设 dd = 文件.删除目录("_71d");
        打印("删除目录=" + dd);
        设 l3 = 文件.遍历目录("_71d");
        打印("删后个数=" + l3.长度());

        打印("=== 包工具扩展: 二进制原语 ===");
        二进制写入("_71m.bin", 0, "abc");
        设 h = 打开文件("_71m.bin");
        设 sz = 文件大小(h);
        关闭文件(h);
        打印("大小=" + sz);
        设 a = 文件.读入内存("_71m.bin");
        打印("读入成功=" + (a > 0));
        设 w = 文件.写入内存("_71m2.bin", 0, a, 3);
        打印("写入内存=" + w);
        设 back = 字节读取("_71m2.bin", 0, 3);
        打印("回读=" + back);

        打印("=== 包工具扩展: atp 搜索/卸载 ===");
        设 rc1 = 引用.atp搜索("请求", "测试/包");
        设 rc2 = 引用.atp安装("网络请求", "测试/包", "包/", "");
        设 rc3 = 引用.atp卸载("网络请求");
        设 l4 = 文件.遍历目录("包");
        打印("卸载后目录个数=" + l4.长度());

        返回值 0;
    };
};