创建引子 加法(整数,整数){

    返回值 参数1 + 参数2;
};

创建引子 乘法(整数,整数){
    返回值 参数1 * 参数2;
};

创建引子 连接(字符串,字符串){
    返回值 参数1 + 参数2;
};

创建引子 比较大小(整数,整数){
    如果(参数1 > 参数2){
        返回值 "大于";
    }又如果(参数1 < 参数2){
        返回值 "小于";
    }否则{
        返回值 "等于";
    };
};

类 引子测试 {
公开:
    声明 测试引子基本调用(){
        打印("=== 引子基本调用 ===");

        设 a = 0;
        引用.加法(1, 2)=a;
        打印("加法(1,2) = " + a);

        设 b = 0;
        引用.加法(10, 20)=b;
        打印("加法(10,20) = " + b);

        返回值 0;
    };

    声明 测试引子乘法(){
        打印("=== 引子乘法 ===");

        设 c = 0;
        引用.乘法(6, 7)=c;
        打印("乘法(6,7) = " + c);

        设 d = 0;
        引用.乘法(100, 3)=d;
        打印("乘法(100,3) = " + d);

        返回值 0;
    };

    声明 测试引子字符串(){
        打印("=== 引子字符串操作 ===");

        设 e = "";
        引用.连接("Hello", "World")=e;
        打印("连接(Hello, World) = " + e);

        返回值 0;
    };

    声明 测试引子条件判断(){
        打印("=== 引子条件判断 ===");

        设 结果 = "";
        引用.比较大小(10, 5)=结果;
        打印("10 和 5: " + 结果);

        引用.比较大小(3, 8)=结果;
        打印("3 和 8: " + 结果);

        引用.比较大小(7, 7)=结果;
        打印("7 和 7: " + 结果);

        返回值 0;
    };

    声明 测试引子组合使用(){
        打印("=== 引子组合使用 ===");

        设 sum1 = 0;
        引用.加法(1, 2)=sum1;

        设 sum2 = 0;
        引用.加法(3, 4)=sum2;

        设 最终结果 = 0;
        引用.乘法(sum1, sum2)=最终结果;

        打印("(1+2)*(3+4) = " + 最终结果);
        返回值 0;
    };
};