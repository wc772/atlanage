类 计数器 {
  静态:
  设 总数 = 0;

  公开:
  声明 增加(){
    计数器.总数 = 计数器.总数 + 1;
    返回值 0;
  };
};

类 测试静态 {
    声明 测试(){
        打印("=== 静态字段 ===");
        设 甲 = 创建 计数器;
        甲.增加();
        设 乙 = 创建 计数器;
        乙.增加();
        打印("总数=" + 计数器.总数);

        打印("=== 跨实例共享 ===");
        甲.增加();
        打印("甲增后=" + 计数器.总数);
        返回值 0;
    };
};