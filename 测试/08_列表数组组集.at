类 容器测试 {
公开:
    声明 测试列表基本操作(){
        打印("=== 列表基本操作 ===");

        列表 f[10] = {1, 1};

        f[0] = 10;
        f[1] = 20;
        f[2] = 30;

        打印("f[0] = " + f[0]);
        打印("f[1] = " + f[1]);
        打印("f[2] = " + f[2]);

        返回值 0;
    };

    声明 测试数组键值对(){
        打印("=== 数组键值对操作 ===");

        数组 用户 = {};
        用户["名字"] = "大王";
        用户["年龄"] = 18;
        用户["等级"] = 99;

        打印("名字: " + 用户["名字"]);
        打印("年龄: " + 用户["年龄"]);
        打印("等级: " + 用户["等级"]);

        返回值 0;
    };

    声明 测试数组背包(){
        打印("=== 背包系统示例 ===");

        数组 背包 = {};
        背包["药水"] = 3;
        背包["剑"] = 1;
        背包["盾牌"] = 1;
        背包["金币"] = 999;

        打印("药水数量: " + 背包["药水"]);
        打印("金币数量: " + 背包["金币"]);

        如果(背包["药水"] != 空){
            打印("背包中有药水");
        };

        返回值 0;
    };

    声明 测试组集_不可变(){
        打印("=== 组集：不可变形式（列表风格）===");

        设 组集 x = [];

        打印("创建了不可变组集");

        返回值 0;
    };

    声明 测试组集_可变(){
        打印("=== 组集：可变形式（数组/字典风格）===");

        设 组集 y = {};

        打印("创建了可变组集");

        返回值 0;
    };

    声明 测试列表字面量(){
        打印("=== 列表字面量 ===");

        设 arr = {10, 20, 30};
        打印("初始 arr = [10, 20, 30]");

        arr.添加(40);
        打印("添加40后");

        arr.添加(50);
        打印("添加50后");

        循环(设 项 : arr){
            打印("元素: " + 项);
        };

        返回值 0;
    };

    声明 测试数组添加方法(){
        打印("=== 数组.添加() ===");

        数组 数据 = {};
        数据.添加("key1", "值1");
        数据.添加("key2", "值2");
        数据.添加("key3", "值3");

        打印("key1 = " + 数据["key1"]);
        打印("key2 = " + 数据["key2"]);
        打印("key3 = " + 数据["key3"]);

        返回值 0;
    };
};