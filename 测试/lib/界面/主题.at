设 主题_主色值 = 0x3B6FE0;
设 主题_背景值 = 0x1E1E2E;
设 主题_文字值 = 0xE8E8E8;
设 主题_边框值 = 0x555577;
设 主题_悬停值 = 0x4F7FE8;
设 主题_输入背景值 = 0x23233A;
设 主题_占位值 = 0x666688;
设 主题_间距值 = 8;
设 主题_填充值 = 16;
设 主题_字号值 = 16;

声明 主题_主色(){ 返回值 主题_主色值; };
声明 主题_背景(){ 返回值 主题_背景值; };
声明 主题_文字(){ 返回值 主题_文字值; };
声明 主题_边框(){ 返回值 主题_边框值; };
声明 主题_悬停(){ 返回值 主题_悬停值; };
声明 主题_输入背景(){ 返回值 主题_输入背景值; };
声明 主题_占位(){ 返回值 主题_占位值; };
声明 主题_间距(){ 返回值 主题_间距值; };
声明 主题_填充(){ 返回值 主题_填充值; };
声明 主题_字号(){ 返回值 主题_字号值; };