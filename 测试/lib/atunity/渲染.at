类 精灵渲染器 继承 组件 {
公开:
    设 像素 存在;
    设 精灵宽 存在;
    设 精灵高 存在;
    设 隐藏 存在;

    构造(){
        像素 = 0;
        精灵宽 = 0;
        精灵高 = 0;
        隐藏 = 假;
    };

    声明 设置精灵(path){
        设 宽地址 = 内存.分配(8);
        设 高地址 = 内存.分配(8);
        设 结果 = 图像.创建(path, 宽地址, 高地址);
        如果(结果 == 0){
            打印("精灵加载失败: " + path);
            内存.释放(宽地址);
            内存.释放(高地址);
            返回值 0;
        };
        像素 = 结果;
        精灵宽 = 读整数(宽地址, 0);
        精灵高 = 读整数(高地址, 0);
        内存.释放(宽地址);
        内存.释放(高地址);
        返回值 0;
    };

    声明 渲染(){
        如果(隐藏 == 真){ 返回值 0; };
        如果(像素 == 0){ 返回值 0; };
        如果(挂载对象 == 空){ 返回值 0; };

        图像.绘制(引擎_窗口, 挂载对象.x - 精灵宽 / 2 - 引擎_相机x,
                   挂载对象.y - 精灵高 / 2 - 引擎_相机y, 像素, 精灵宽, 精灵高);
        返回值 0;
    };

    声明 设置隐藏(flag){
        隐藏 = flag;
        返回值 0;
    };
};

类 文本渲染器 继承 组件 {
公开:
    设 文字 存在;
    设 字号 存在;
    设 颜色值 存在;
    设 居中 存在;
    设 隐藏 存在;

    构造(){
        文字 = "";
        字号 = 16;
        颜色值 = 颜色白;
        居中 = 真;
        隐藏 = 假;
    };

    声明 设置文本(t){
        文字 = t;
        返回值 0;
    };
    声明 设置字号(n){
        字号 = n;
        返回值 0;
    };
    声明 设置颜色(c){
        颜色值 = c;
        返回值 0;
    };
    声明 设置居中(flag){
        居中 = flag;
        返回值 0;
    };
    声明 设置隐藏(flag){
        隐藏 = flag;
        返回值 0;
    };

    声明 渲染(){
        如果(挂载对象 == 空){ 返回值 0; };
        如果(隐藏 == 真){ 返回值 0; };
        如果(居中 == 真){
            设 宽地址 = 内存.分配(8);
            设 高地址 = 内存.分配(8);
            图像.尺寸(引擎_窗口, 文字, 字号, 宽地址, 高地址);
            设 宽 = 读整数(宽地址, 0);
            设 高 = 读整数(高地址, 0);
            内存.释放(宽地址);
            内存.释放(高地址);
            图形.绘制.文本(引擎_窗口, 挂载对象.x - 宽 / 2 - 引擎_相机x,
                             挂载对象.y - 高 / 2 - 引擎_相机y, 文字, 字号, 颜色值);
        } 否则 {
            图形.绘制.文本(引擎_窗口, 挂载对象.x - 引擎_相机x,
                             挂载对象.y - 引擎_相机y, 文字, 字号, 颜色值);
        };
        返回值 0;
    };
};

类 形状渲染器 继承 组件 {
公开:
    设 形状 存在;
    设 起点x 存在;
    设 起点y 存在;
    设 半宽 存在;
    设 半高 存在;
    设 半径 存在;
    设 目标x 存在;
    设 目标y 存在;
    设 目标2x 存在;
    设 目标2y 存在;
    设 颜色值 存在;
    设 填充 存在;
    设 隐藏 存在;

    构造(){
        形状 = 1;
        起点x = 0;
        起点y = 0;
        半宽 = 20;
        半高 = 20;
        半径 = 20;
        目标x = 0;
        目标y = 0;
        目标2x = 0;
        目标2y = 0;
        颜色值 = 颜色白;
        填充 = 真;
        隐藏 = 假;
    };

    声明 设置形状(kind){
        形状 = kind;
        返回值 0;
    };
    声明 设置尺寸(w, h){
        半宽 = w;
        半高 = h;
        半径 = w;
        返回值 0;
    };
    声明 设置半径(r){
        半径 = r;
        返回值 0;
    };
    声明 设置颜色(c){
        颜色值 = c;
        返回值 0;
    };
    声明 设置填充(flag){
        填充 = flag;
        返回值 0;
    };
    声明 设置起点(x, y){
        起点x = x;
        起点y = y;
        返回值 0;
    };
    声明 设置目标(x, y){
        目标x = x;
        目标y = y;
        返回值 0;
    };
    声明 设置目标2(x, y){
        目标2x = x;
        目标2y = y;
        返回值 0;
    };
    声明 设置隐藏(flag){
        隐藏 = flag;
        返回值 0;
    };

    声明 渲染(){
        如果(挂载对象 == 空){ 返回值 0; };
        如果(隐藏 == 真){ 返回值 0; };
        设 对象x = 挂载对象.x - 引擎_相机x;
        设 对象y = 挂载对象.y - 引擎_相机y;
        如果(形状 == 1){
            图形.绘制.矩形(引擎_窗口, 对象x, 对象y, 半宽, 半高, 颜色值, 填充);
        };
        如果(形状 == 2){
            图形.绘制.圆(引擎_窗口, 对象x, 对象y, 半径, 颜色值, 填充);
        };
        如果(形状 == 3){
            图形.绘制.线(引擎_窗口, 对象x, 对象y, 对象x + 目标x, 对象y + 目标y, 颜色值, 填充);
        };
        如果(形状 == 4){
            图形.绘制.三角形(引擎_窗口, 对象x + 起点x, 对象y + 起点y,
                               对象x + 目标x, 对象y + 目标y,
                               对象x + 目标2x, 对象y + 目标2y, 颜色值, 填充);
        };
        如果(形状 == 5){

            设 尺寸 = 半宽;
            如果(尺寸 < 1){ 尺寸 = 1; };
            图形.绘制.像素(引擎_窗口, 对象x, 对象y, 尺寸, 颜色值, 填充);
        };
        返回值 0;
    };
};