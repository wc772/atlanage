类 组件 {
公开:
    设 挂载对象 存在;
    设 组件启用 存在;
    设 碰撞类型 存在;

    声明 挂载(对象){
        挂载对象 = 对象;
        组件启用 = 真;
        返回值 0;
    };

    声明 更新(){
        返回值 0;
    };

    声明 碰撞事件(对方){
        返回值 0;
    };

    声明 物理更新(){
        返回值 0;
    };

    声明 渲染(){
        返回值 0;
    };
};

类 游戏对象 {
公开:
    设 x 存在;
    设 y 存在;
    设 角度 存在;
    设 缩放 存在;
    设 激活 存在;
    设 已删除 存在;
    设 标签 存在;
    设 名称 存在;
    设 部件列表 存在;
    设 场景引用 存在;

    构造(){
        x = 0;
        y = 0;
        角度 = 0;
        缩放 = 1;
        激活 = 真;
        已删除 = 假;
        标签 = "";
        名称 = "";
        部件列表 = {};
        场景引用 = 空;
    };

    声明 添加部件(comp){
        部件列表.添加(comp);
        返回值 comp;
    };

    声明 更新(){
        循环(设 部件 : 部件列表){
            如果(部件.组件启用 == 真){
                部件.更新();
            };
        };
        返回值 0;
    };

    声明 物理更新(){
        循环(设 部件 : 部件列表){
            如果(部件.组件启用 == 真){
                部件.物理更新();
            };
        };
        返回值 0;
    };

    声明 渲染(){
        循环(设 部件 : 部件列表){
            部件.渲染();
        };
        返回值 0;
    };

    声明 删除(){
        已删除 = 真;
        返回值 0;
    };

    声明 碰撞事件(对方){
        循环(设 部件 : 部件列表){
            部件.碰撞事件(对方);
        };
        返回值 0;
    };

    声明 部件数量(){
        返回值 部件列表.长度();
    };
    声明 部件(索引){
        返回值 部件列表[索引];
    };
};