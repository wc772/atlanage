引用.文件("../atl_ui.at")
引用.文件("核心.at")
引用.文件("对象.at")
引用.文件("渲染.at")
引用.文件("物理.at")
引用.文件("场景.at")

设 引擎_窗口 = 1000;
设 引擎_相机x = 0;
设 引擎_相机y = 0;

声明 相机x(){
    返回值 引擎_相机x;
};
声明 相机y(){
    返回值 引擎_相机y;
};

类 引擎 {
公开:
    设 窗口ID 存在;
    设 当前场景 存在;
    设 运行中 存在;
    设 背景色 存在;
    设 事件缓冲 存在;
    设 自动帧数 存在;
    设 标题 存在;

    构造(宽, 高, 标题文字){
        窗口ID = 1000;
        当前场景 = 空;
        运行中 = 真;
        背景色 = 颜色黑;
        事件缓冲 = 内存.分配(64);
        自动帧数 = 0;
        标题 = 标题文字;

        图形.窗口.创建(宽:高,标题文字){
            图形.设备.清屏(背景色);
            图形.设备.呈现;
        };
    };

    声明 启动(场景对象){
        打印("AtUnity 引擎启动: " + 标题);
        当前场景 = 场景对象;
        场景对象.进入();

        图形.窗口.帧率(60)(窗口ID);
        主循环();
        场景对象.退出();
        内存.释放(事件缓冲);
        图形.窗口.关闭(0);
        打印("AtUnity 引擎退出");
        返回值 0;
    };

    声明 主循环(){
        循环(运行中){

            时间更新();
            输入更新();

            设 r = 图形.事件.轮询(窗口ID, 事件缓冲, 0);
            循环(r == 1){
                输入处理事件(事件缓冲);
                r = 图形.事件.轮询(窗口ID, 事件缓冲, 0);
            };
            如果(r == -1){ 运行中 = 假; };
            如果(退出请求()){ 运行中 = 假; };
            如果(按下(键ESC)){ 运行中 = 假; };

            当前场景.附体(当前场景);
            当前场景.更新(增量());
            当前场景.引擎更新(增量());

            图形.设备.开始帧(窗口ID);
            图形.设备.清屏(窗口ID, 背景色);
            引擎_相机x = 当前场景.相机x;
            引擎_相机y = 当前场景.相机y;
            当前场景.渲染();
            当前场景.引擎渲染();
            图形.设备.结束帧(窗口ID);

            如果(自动帧数 > 0 && 帧数() >= 自动帧数){ 运行中 = 假; };
        };
        返回值 0;
    };

    声明 切换场景(新场景){
        当前场景.退出();
        当前场景 = 新场景;
        新场景.进入();
        返回值 0;
    };

    声明 请求退出(){
        运行中 = 假;
        返回值 0;
    };

    声明 设置背景色(c){
        背景色 = c;
        返回值 0;
    };

    声明 设置自动帧数(n){
        自动帧数 = n;
        返回值 0;
    };
};