Token类型{
    战士,
    法师,
    弓箭手
}职业类型;

Token结构{
    字符串 名字,
    整数 等级,
    整数 生命值,
    整数 攻击力,
    整数 职业
}角色数据;

创建引子 计算伤害(整数,整数){

    设 伤害 = 参数1 - 参数2;
    如果(伤害 < 1){
        返回值 1;
    };
    返回值 伤害;
};

类 游戏 {
公开:
    设 角色 存在;
    设 背包 存在;

    声明 初始化(){

        设 背包 = {};

        背包["生命药水"] = 5;
        背包["法力药水"] = 3;
        背包["金币"] = 100;
        背包["木剑"] = 1;

        打印("=== RPG游戏系统初始化 ===");
        打印("背包初始化完成");
        打印("生命药水 x" + 背包["生命药水"]);
        打印("金币 x" + 背包["金币"]);

        返回值 0;
    };

    声明 创建角色(名字, 职业){

        设 角色 = 创建 角色数据;

        角色.名字 = 名字;
        角色.等级 = 1;
        角色.生命值 = 100;
        角色.职业 = 职业;

        选择(职业){
            情况 职业类型.战士:
                角色.攻击力 = 15;
                打印(名字 + " 成为了一名战士！");
                跳出;
            情况 职业类型.法师:
                角色.攻击力 = 20;
                打印(名字 + " 成为了一名法师！");
                跳出;
            情况 职业类型.弓箭手:
                角色.攻击力 = 12;
                打印(名字 + " 成为了一名弓箭手！");
                跳出;
            默认:
                角色.攻击力 = 10;
                跳出;
        };

        打印("等级: " + 角色.等级);
        打印("生命值: " + 角色.生命值);
        打印("攻击力: " + 角色.攻击力);

        返回值 0;
    };

    声明 战斗(敌人攻击力, 敌人生命值){
        打印("=== 战斗开始 ===");

        循环(角色.生命值 > 0 && 敌人生命值 > 0){

            设 伤害1 = 0;
            引用.计算伤害(角色.攻击力, 0)=伤害1;
            敌人生命值 = 敌人生命值 - 伤害1;
            打印("你对敌人造成了 " + 伤害1 + " 点伤害，敌人剩余生命: " + 敌人生命值);

            如果(敌人生命值 <= 0){
                打印("敌人被击败！");
                跳出;
            };

            设 伤害2 = 0;
            引用.计算伤害(敌人攻击力, 0)=伤害2;
            角色.生命值 = 角色.生命值 - 伤害2;
            打印("敌人对你造成了 " + 伤害2 + " 点伤害，你的剩余生命: " + 角色.生命值);

            如果(角色.生命值 <= 0){
                打印("你被击败了...");
                跳出;
            };
        };

        如果(角色.生命值 <= 0){
            打印("游戏结束");
        }又如果(敌人生命值 <= 0){
            打印("胜利！");
            设 金币奖励 = 敌人攻击力 * 10;
            背包["金币"] = 背包["金币"] + 金币奖励;
            打印("获得了 " + 金币奖励 + " 金币！");
        };

        返回值 0;
    };

    声明 使用物品(物品名){
        如果(背包[物品名] == 空 || 背包[物品名] <= 0){
            打印("你没有 " + 物品名);
            返回值 0;
        };

        如果(物品名 == "生命药水"){
            角色.生命值 = 角色.生命值 + 30;
            背包["生命药水"] = 背包["生命药水"] - 1;
            打印("使用了生命药水，恢复了30点生命");
            打印("当前生命: " + 角色.生命值);
            打印("剩余药水: " + 背包["生命药水"]);
        };

        返回值 0;
    };
};

类 游戏主循环 {
公开:
    声明 运行(){
        游戏.初始化();

        打印("");
        打印("创建角色...");
        游戏.创建角色("大王", 职业类型.战士);

        打印("");
        打印("遭遇史莱姆！");
        游戏.战斗(8, 30);

        打印("");
        游戏.使用物品("生命药水");

        打印("");
        打印("遭遇哥布林！");
        游戏.战斗(15, 60);

        返回值 0;
    };
};