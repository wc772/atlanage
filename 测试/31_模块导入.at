引用.模块导入("lib/lib_math.at");

类 模块导入测试 {
公开:
    声明 测试模块导入基本(){
        打印("=== 模块导入基本测试 ===");

        设 a = 0;
        引用.加法(1, 2)=a;
        打印("加法(1,2) = " + a);

        设 b = 0;
        引用.减法(10, 3)=b;
        打印("减法(10,3) = " + b);

        设 c = 0;
        引用.乘法(6, 7)=c;
        打印("乘法(6,7) = " + c);

        返回值 0;
    };

    声明 测试引子作为表达式(){
        打印("=== 引子作为表达式 ===");

        打印("加法(100, 200) = " + 引用.加法(100, 200));
        打印("平方(9) = " + 引用.平方(9));
        打印("最大值(3, 8) = " + 引用.最大值(3, 8));

        打印("(3+4)*(5+6) = " + 引用.乘法(引用.加法(3,4), 引用.加法(5,6)));

        返回值 0;
    };

    声明 测试运行(){
        打印("=== 模块导入综合测试 ===");

        设 x = 0;
        引用.平方(12)=x;
        打印("平方(12) = " + x);

        打印("最大值(100, 200) = " + 引用.最大值(100, 200));

        返回值 0;
    };
};