类 基准 {
公开:

    声明 fib(n){
        如果(n < 2){ 返回值 n; };
        返回值 fib(n-1) + fib(n-2);
    };

    声明 测试_斐波那契(){
        设 t0 = 毫秒时间();
        设 r = fib(30);
        设 t1 = 毫秒时间();
        打印("  [1] fib(30)=" + r + "  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 测试_累加(){
        设 t0 = 毫秒时间();
        设 sum = 0;
        设 i = 1;
        循环(i <= 1000000){
            sum = sum + i;
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        打印("  [2] 累加(100万)=" + sum + "  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 测试_嵌套循环(){
        设 t0 = 毫秒时间();
        设 sum = 0;
        设 i = 0;
        循环(i < 500){
            设 j = 0;
            循环(j < 500){
                sum = sum + i * j;
                j = j + 1;
            };
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        打印("  [3] 嵌套500x500 sum=" + sum + "  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
        };

    声明 测试_分支(){
        设 t0 = 毫秒时间();
        设 a = 0;
        设 b = 0;
        设 i = 0;
        循环(i < 1000000){
            如果(i % 2 == 0){ a = a + 1; }否则{ b = b + 1; };
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        打印("  [4] 分支(100万) a=" + a + " b=" + b + "  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 空函数(){ 返回值 0; };

    声明 测试_函数调用(){
        设 t0 = 毫秒时间();
        设 i = 0;
        循环(i < 500000){
            空函数();
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        打印("  [5] 空调用(50万)  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 测试_字符串(){
        设 t0 = 毫秒时间();
        设 s = "";
        设 i = 0;
        循环(i < 1000){
            s = s + "x";
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        设 len = s.长度;
        打印("  [6] 字符串拼接x1000 len=" + len + "  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 测试_计算(){
        设 t0 = 毫秒时间();
        设 i = 0;
        循环(i < 1000000){
            设 x = i % 100;
            设 y = i / 100;
            设 d = (x * x + y * y) / 2;
            i = i + 1;
        };
        设 t1 = 毫秒时间();
        打印("  [7] 坐标运算(100万)  耗时=" + (t1-t0) + "ms");
        返回值 t1-t0;
    };

    声明 运行(){
        打印("╔════════════════════════════════╗");
        打印("║  Atlanage 性能基准测试 v2.0   ║");
        打印("╚════════════════════════════════╝");
        打印("(数值越大越好)");
        打印("");

        设 t1 = 测试_斐波那契();
        设 t2 = 测试_累加();
        设 t3 = 测试_嵌套循环();
        设 t4 = 测试_分支();
        设 t5 = 测试_函数调用();
        设 t6 = 测试_字符串();
        设 t7 = 测试_计算();
        设 总计 = t1 + t2 + t3 + t4 + t5 + t6 + t7;

        打印("");
        打印("────────────────────────────────");
        打印("  7项测试总计耗时=" + 总计 + "ms");
        打印("────────────────────────────────");
        返回值 0;
    };
};

设 b = 基准.创建();
b.运行();