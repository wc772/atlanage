类 T {
公开:
    声明 取数据(id){
        如果(id > 0){
            返回值 成功(100 + id);
        };
        返回值 失败("无效ID: " + id);
    };
    声明 测试(){

        设 r1 = 取数据(5);
        设 v1 = r1.接着(函数(值){
            返回值 值 * 2;
        });
        如果(v1 == 210){ 打印("OK1 接着(成功): " + v1); }否则{ 打印("FAIL1: " + v1); };

        设 r2 = 取数据(-1);
        设 v2 = r2.接着(函数(值){
            返回值 值 * 2;
        });
        如果(v2 == r2){ 打印("OK2 接着(失败)透传"); }否则{ 打印("FAIL2"); };

        设 r3 = 取数据(-2);
        设 v3 = r3.否则(函数(错误){
            返回值 "兜底: " + 错误;
        });
        如果(v3 == "兜底: 无效ID: -2"){ 打印("OK3 否则(失败): " + v3); }否则{ 打印("FAIL3: " + v3); };

        设 r4 = 取数据(7);
        设 v4 = r4.否则(函数(错误){
            返回值 "不应执行";
        });
        如果(v4 == r4){ 打印("OK4 否则(成功)透传"); }否则{ 打印("FAIL4"); };

        设 r5 = 取数据(9);
        设 r6 = 取数据(0);
        如果(r5.值 == 109){ 打印("OK5 结果.值: " + r5.值); }否则{ 打印("FAIL5: " + r5.值); };
        如果(r5.成功 == 真){ 打印("OK6 结果.成功: " + r5.成功); }否则{ 打印("FAIL6"); };
        如果(r6.成功 == 假){ 打印("OK7 结果.失败标志"); }否则{ 打印("FAIL7"); };
        如果(r6.错误 == "无效ID: 0"){ 打印("OK8 结果.错误: " + r6.错误); }否则{ 打印("FAIL8: " + r6.错误); };

        设 r7 = 取数据(3).接着(函数(值){
            返回值 "值=" + 值;
        }).否则(函数(错误){
            返回值 "错误=" + 错误;
        });
        如果(r7 == "值=103"){ 打印("OK9 链式成功: " + r7); }否则{ 打印("FAIL9: " + r7); };

        设 r8 = 取数据(-3).接着(函数(值){
            返回值 "值=" + 值;
        }).否则(函数(错误){
            返回值 "错误=" + 错误;
        });
        如果(r8 == "错误=无效ID: -3"){ 打印("OK10 链式失败: " + r8); }否则{ 打印("FAIL10: " + r8); };

        设 r9 = 成功(42);
        如果(r9 + "" == "成功(42)"){ 打印("OK11 成功字符串化: " + r9); }否则{ 打印("FAIL11: " + r9); };
        设 r10 = 失败("坏了");
        如果(r10 + "" == "失败(坏了)"){ 打印("OK12 失败字符串化: " + r10); }否则{ 打印("FAIL12: " + r10); };

        返回值 0;
    };
};