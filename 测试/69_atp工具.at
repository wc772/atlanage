引用.模块导入("../工具/atp/atp.at");

类 atp工具测试 {
公开:
    声明 运行(){

        打印("=== atp 工具: 清单生成 ===");
        设 清单 = 引用.atp清单文本("测试包", "1.0.0");
        打印(清单);

        打印("=== atp 工具: 文本含行 ===");
        设 含行 = 引用.atp文本含行("demo_lib\nother\n", "demo_lib");
        设 不含 = 引用.atp文本含行("demo_lib\n", "nope");
        打印("含行=" + 含行 + " 不含=" + 不含);

        打印("=== atp 工具: 安装 ===");
        设 临时 = "_69atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);
        设 rc = 引用.atp安装("网络请求", "测试/包", "包/", "");
        打印("安装返回=" + rc);
        设 读回 = 字节读取(临时 + "/包/网络请求/atp.json", 0, 1048576);
        如果(读回 == 空){
            打印("读回清单=空");
        }否则{
            设 含包名 = atp文本含行(读回, "包名: 网络请求");
            打印("读回清单含包名=" + 含包名);
        };
        系统.切换目录("测试");

        打印("=== atp 工具: 列表 ===");
        引用.atp列表("_69atp_tmp/空仓库");

        返回值 0;
    };
};