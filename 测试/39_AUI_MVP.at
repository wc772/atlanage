类 main {
公开:
    声明 运行(){
        打印("=== 新一代 AUI MVP ===");

        设 win = GL.窗口.创建(640, 480, "AUI MVP");
        打印("窗口创建=" + (win > 0));
        如果(win <= 0){ 返回值 1; };

        GL.矩阵(5889);
        GL.单位矩阵();
        GL.正交(0.0, 640, 0.0, 480, -1.0, 1.0);
        GL.矩阵(5888);
        GL.单位矩阵();

        设 cl = GL.清屏(红:10, 绿:10, 蓝:26, 透明度:255);
        打印("清屏=" + cl);

        GL.开始(7);
        GL.颜色(0, 255, 0, 255);
        GL.顶点(100, 100, 0.0);
        GL.顶点(200, 100, 0.0);
        GL.顶点(200, 200, 0.0);
        GL.顶点(100, 200, 0.0);
        GL.结束();
        打印("矩形=1");

        GL.开始(4);
        GL.颜色(255, 64, 32, 255);
        GL.顶点(300, 100, 0.0);
        GL.顶点(400, 300, 0.0);
        GL.顶点(250, 280, 0.0);
        GL.结束();
        打印("三角形=1");

        设 tr = GL.文本.绘制(窗口:win, x:20, y:20, 字号:24, 红:255, 绿:255, 蓝:255, 透明度:255, 文本:"Hello AUI GPU");
        打印("文本绘制=" + tr);

        设 pr = GL.呈现(win);
        打印("呈现=" + pr);

        设 buf = 内存.分配(32);
        设 ev = GL.事件.轮询(win, buf, 0);
        打印("事件轮询=" + ev);
        内存.释放(buf);

        设 cc = GL.窗口.关闭(win);
        打印("窗口关闭=" + cc);
        打印("PASS 39");
        返回值 0;
    };
};