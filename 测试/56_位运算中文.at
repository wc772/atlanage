类 T {
公开:
    声明 测试(){

        设 a = 0xC;
        设 b = 0xA;
        设 c1 = a 位与 b;
        设 c2 = a 位或 b;
        设 c3 = a 异或 b;
        如果(c1 == 0x8){ 打印("OK1 位与: " + c1); }否则{ 打印("FAIL 位与: " + c1); };
        如果(c2 == 0xE){ 打印("OK2 位或: " + c2); }否则{ 打印("FAIL 位或: " + c2); };
        如果(c3 == 0x6){ 打印("OK3 异或: " + c3); }否则{ 打印("FAIL 异或: " + c3); };

        设 s1 = 1 左移 8;
        设 s2 = 0x10 右移 4;
        设 n1 = 取反 0;
        如果(s1 == 256){ 打印("OK4 左移: " + s1); }否则{ 打印("FAIL 左移: " + s1); };
        如果(s2 == 1){ 打印("OK5 右移: " + s2); }否则{ 打印("FAIL 右移: " + s2); };
        如果(n1 == -1){ 打印("OK6 取反: " + n1); }否则{ 打印("FAIL 取反: " + n1); };

        设 x1 = a & b;
        设 x2 = a | b;
        设 x3 = a ^ b;
        设 x4 = 1 << 8;
        设 x5 = 0x10 >> 4;
        设 x6 = ~0;
        如果(c1 == x1 且 c2 == x2 且 c3 == x3){ 打印("OK7 位与/位或/异或 等价"); }否则{ 打印("FAIL 等价1"); };
        如果(s1 == x4 且 s2 == x5 且 n1 == x6){ 打印("OK8 移位/取反 等价"); }否则{ 打印("FAIL 等价2"); };

        设 m = (a 位与 b) 或 (a 位或 b) 且 非 (a 异或 b 位与 0);
        设 m2 = ((a & b) || (a | b)) && !((a ^ b) & 0);
        如果(m == m2){ 打印("OK9 混合链: " + m); }否则{ 打印("FAIL 混合链 " + m + " vs " + m2); };

        设 位置 = 5;
        设 位次 = 3;
        设 位置2 = 位置 位与 位次;
        如果(位置 == 5 且 位次 == 3 且 位置2 == 1){ 打印("OK10 位置/位次 标识符: " + 位置2); }否则{ 打印("FAIL 标识符边界"); };

        设 p = 1 位或 2 * 3;
        设 p2 = 1 | 2 * 3;
        如果(p == 7 且 p == p2){ 打印("OK11 优先级: " + p); }否则{ 打印("FAIL 优先级: " + p); };

        返回值 0;
    };
};