包 工具 {
    公开:
        声明 工具函数1(){
            打印("工具包中的函数1");
            返回值 0;
        };

        声明 工具函数2(){
            打印("工具包中的函数2");
            返回值 0;
        };
    私有:
        声明 内部函数(){
            打印("内部函数，仅包内可用");
            返回值 0;
        };
};

包 MyPackage{
    公开:
        类 MyClass{
        公开:
            声明 打招呼(){
                打印("MyPackage.MyClass.打招呼()");
                返回值 0;
            };
        };

        声明 包级函数(){
            打印("包级函数");
            返回值 0;
        };
    私有:
        设 内部变量 存在;
};

包 网络工具 {
    公开:
        声明 发送请求(url){
            打印("发送请求到: " + url);

            设 在线 = 网络.检活;
            如果(!在线){
                打印("网络不可用");
                返回值 "ERROR";
            };

            设 响应 = 网络.获取(url);
            返回值 响应;
        };

        声明 检查网络(){
            设 状态 = 网络.检活;
            如果(状态){
                打印("网络状态: 在线");
            }否则{
                打印("网络状态: 离线");
            };
            返回值 状态;
        };
};

类 包模块测试 {
公开:
    声明 测试包函数调用(){
        打印("=== 包函数调用 ===");

        工具.工具函数1();
        工具.工具函数2();

        返回值 0;
    };

    声明 测试包中类(){
        打印("=== 包中的类 ===");

        MyPackage.包级函数();

        创建 MyPackage.MyClass:obj;
        obj.打招呼();

        返回值 0;
    };

    声明 测试包组合使用(){
        打印("=== 包组合使用 ===");

        设 在线 = 网络工具.检查网络();
        如果(在线){
            设 响应 = 网络工具.发送请求("http://example.com");
            打印("响应: " + 响应);
        };

        返回值 0;
    };
};