类 测试字典遍历 {
    声明 测试(){
        打印("=== 键值遍历 ===");
        设 组集 背包 = {};
        背包.添加("甲", 1);
        背包.添加("乙", 2);
        背包.添加("丙", 3);

        设 计数 = 0;
        循环(设 键, 值 : 背包){
            打印(键 + "=" + 值);
            计数 = 计数 + 1;
        };

        打印("=== 计数 ===");
        打印("共" + 计数 + "项");
        返回值 0;
    };
};