引用.文件("lib/atunity/引擎.at")
引用.文件("lib/atunity/演示场景.at")

类 main {
公开:
    声明 运行(){

        设 桌面 = 创建 AtOS场景;
        桌面.进入();
        时间更新();

        打印("窗口数=" + 桌面.窗口数量());

        输入_鼠标x = -360; 输入_鼠标y = -278;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("菜单激活=" + 桌面.菜单激活);

        输入_鼠标x = -330; 输入_鼠标y = 240;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("窗口数=" + 桌面.窗口数量() + " 菜单激活=" + 桌面.菜单激活);

        输入_鼠标x = -360; 输入_鼠标y = -278;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        输入_鼠标x = -330; 输入_鼠标y = 180;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("窗口数=" + 桌面.窗口数量());

        输入_鼠标x = -200; 输入_鼠标y = 166;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("拖动中=" + 桌面.拖动中);

        输入_鼠标x = 0; 输入_鼠标y = 0;
        桌面.更新(0.016);
        打印("系统设置窗口x=" + 桌面.窗口(2).x);

        输入_鼠标抬起表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标抬起表 = {};

        输入_鼠标x = 166; 输入_鼠标y = 0;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("窗口数=" + 桌面.窗口数量());

        输入_鼠标x = -300; 输入_鼠标y = 230;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        输入_鼠标x = 0; 输入_鼠标y = 230;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("图标开窗 窗口数=" + 桌面.窗口数量());

        输入_鼠标x = -140; 输入_鼠标y = 126;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("置顶后 窗口数=" + 桌面.窗口数量());

        输入_鼠标抬起表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标抬起表 = {};
        输入_鼠标x = 16; 输入_鼠标y = 126;
        输入_鼠标按下表[1] = 真;
        桌面.更新(0.016);
        输入_鼠标按下表 = {};
        打印("关闭置顶窗口后 窗口数=" + 桌面.窗口数量());

        打印("逻辑测试通过");
        返回值 0;
    };
};