类 控制流测试 {
公开:
    声明 测试如果否则(){
        设 a=15;

        如果(a==15){
            打印("a 等于 15");
            设 a=16;
        };
        打印("现在 a = " + a);

        返回值 0;
    };

    声明 测试如果又如果否则(){
        设 a=25;

        如果(a==15){
            打印("a 等于 15");
        }又如果(a==25){
            打印("a 等于 25");
            设 a=30;
        }否则{
            设 a=40;
        };
        打印("最终 a = " + a);

        返回值 0;
    };

    声明 测试多重条件(){
        设 玩家生命 = 50;

        如果(玩家生命 <= 0){
            打印("游戏结束 - 玩家死亡");
        }又如果(玩家生命 <= 30){
            打印("警告 - 生命值过低");
        }又如果(玩家生命 <= 60){
            打印("注意 - 生命值偏低");
        }否则{
            打印("状态良好");
        };

        返回值 0;
    };

    声明 测试选择情况默认_值匹配(){
        设 a = 1;

        选择(a){
            情况 0:
                打印("情况0: a等于0");
                跳出;
            情况 1:
                打印("情况1: a等于1");
                跳出;
            情况 2:
                打印("情况2: a等于2");
                跳出;
            默认:
                打印("默认: a等于其他值");
                跳出;
        };

        返回值 0;
    };

    声明 测试选择情况默认_条件匹配(){
        设 a=2;

        选择(a>0){
            情况 0 (a==1):
                打印("a 等于 1");
                跳出;
            情况 1 (a==2):
                打印("a 等于 2");
                跳出;
            情况 2 (a==3):
                打印("a 等于 3");
                跳出;
            默认:
                打印("a 等于其他值");
                跳出;
        };

        返回值 0;
    };

    声明 测试选择无匹配走默认(){
        设 a = 99;

        选择(a){
            情况 0:
                打印("a=0");
                跳出;
            情况 1:
                打印("a=1");
                跳出;
            默认:
                打印("进入默认分支，a=" + a);
                跳出;
        };

        返回值 0;
    };
};