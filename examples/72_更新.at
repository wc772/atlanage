引用.模块导入("../工具/atp/atp.at");

类 更新测试 {
公开:
    声明 运行(){
        设 临时 = "_72atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);

        创建文件夹("仓库");
        创建文件夹("仓库/升级包");
        二进制写入("仓库/升级包/atp.json", 0, 引用.atp清单文本("升级包", "1.0.0"));
        二进制写入("仓库/升级包/入口.at", 0, "声明 f(参数){ 返回值 0; };\n");

        设 c1 = 引用.atp安装("升级包", "仓库", "包/", "");

        打印("=== 更新: 查最新版本并升级 ===");
        二进制写入("仓库/升级包/atp.json", 0, 引用.atp清单文本("升级包", "2.0.0"));
        设 c2 = 引用.atp升级("升级包", "仓库");
        设 已装 = 字节读取("包/升级包/atp.json", 0, 1048576);
        如果(已装 == 空){
            打印("升级后版本=无");
        }否则{
            打印("升级后版本=" + 引用.atp清单取值(已装, "版本"));
        };

        设 c3 = 引用.atp升级("升级包", "仓库");
        如果(c3 == ""){
            打印("再升级返回=空串");
        }否则{
            打印("再升级返回=非空串");
        };

        返回值 0;
    };
};