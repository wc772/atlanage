设 全局通道 存在;
类 T {
公开:
    声明 测试(){

        设 ch = 通道();
        通道.发送(ch, 42);
        设 v = 通道.接收(ch);
        如果(v == 42){ 打印("OK1 通道收发: " + v); }否则{ 打印("FAIL1: " + v); };

        通道.发送(ch, 1);
        通道.发送(ch, 2);
        通道.发送(ch, 3);
        设 a = 通道.接收(ch);
        设 b = 通道.接收(ch);
        设 c = 通道.接收(ch);
        如果(a == 1 && b == 2 && c == 3){ 打印("OK2 FIFO顺序: " + a + "/" + b + "/" + c); }否则{ 打印("FAIL2: " + a + "/" + b + "/" + c); };

        全局通道 = 通道();
        设 tp = 异步{
            设 i = 0;
            循环(i < 5){
                通道.发送(全局通道, i * 10);
                i = i + 1;
            };
            返回值 0;
        };
        设 sum = 0;
        设 j = 0;
        循环(j < 5){
            sum = sum + 通道.接收(全局通道);
            j = j + 1;
        };
        设 rd = 等待 任务(tp);
        如果(sum == 100){ 打印("OK3 生产者消费者: " + sum); }否则{ 打印("FAIL3: " + sum); };

        设 ch2 = 道();
        设 chs = ch2 + "";
        如果(chs == "<通道>"){ 打印("OK4 通道对象: " + chs); }否则{ 打印("FAIL4: " + chs); };

        返回值 0;
    };
};