设 GL_三角形 = 4;
设 GL_四边形 = 7;
设 GL_线 = 1;
设 GL_点 = 0;
设 GL_投影矩阵 = 5889;
设 GL_模型视图矩阵 = 5888;

声明 窗口(宽, 高, 标题){
    返回值 GL.窗口.创建(宽, 高, 标题);
};
声明 关闭(窗口){
    返回值 GL.窗口.关闭(窗口);
};
声明 窗口显示(窗口, 开关 = 1){
    返回值 GL.窗口.显示(窗口, 开关);
};
声明 标题(窗口, 标题){
    返回值 GL.窗口.标题(窗口, 标题);
};
声明 呈现(窗口){
    返回值 GL.呈现(窗口);
};
声明 清屏(红, 绿, 蓝, 透明度 = 255){
    返回值 GL.清屏(红, 绿, 蓝, 透明度);
};
声明 版本(){
    返回值 GL.版本();
};
声明 渲染器(){
    返回值 GL.渲染器();
};

声明 开始(模式){
    返回值 GL.开始(模式);
};
声明 结束(){
    返回值 GL.结束();
};
声明 顶点(x, y, z = 0.0){
    返回值 GL.顶点(x, y, z);
};
声明 颜色(红, 绿, 蓝, 透明度 = 255){
    返回值 GL.颜色(红, 绿, 蓝, 透明度);
};

声明 正交2D(宽, 高){
    GL.矩阵(GL_投影矩阵);
    GL.单位矩阵();
    GL.正交(0.0, 宽, 0.0, 高, -1.0, 1.0);
    GL.矩阵(GL_模型视图矩阵);
    GL.单位矩阵();
    返回值 1;
};
声明 旋转(角度, x, y, z){
    返回值 GL.旋转(角度, x, y, z);
};
声明 平移(x, y, z){
    返回值 GL.平移(x, y, z);
};
声明 缩放(x, y, z){
    返回值 GL.缩放(x, y, z);
};

声明 三角形(x1, y1, x2, y2, x3, y3, 红, 绿, 蓝){
    GL.开始(GL_三角形);
    GL.颜色(红, 绿, 蓝, 255);
    GL.顶点(x1, y1, 0.0);
    GL.顶点(x2, y2, 0.0);
    GL.顶点(x3, y3, 0.0);
    GL.结束();
    返回值 1;
};
声明 矩形(x, y, 宽, 高, 红, 绿, 蓝){
    GL.开始(GL_四边形);
    GL.颜色(红, 绿, 蓝, 255);
    GL.顶点(x, y, 0.0);
    GL.顶点(x + 宽, y, 0.0);
    GL.顶点(x + 宽, y + 高, 0.0);
    GL.顶点(x, y + 高, 0.0);
    GL.结束();
    返回值 1;
};
声明 线(x1, y1, x2, y2, 红, 绿, 蓝){
    GL.开始(GL_线);
    GL.颜色(红, 绿, 蓝, 255);
    GL.顶点(x1, y1, 0.0);
    GL.顶点(x2, y2, 0.0);
    GL.结束();
    返回值 1;
};

声明 轮询(窗口, 缓冲, 阻塞 = 0){
    返回值 GL.事件.轮询(窗口, 缓冲, 阻塞);
};

声明 获取函数(名称){
    返回值 GL.获取函数(名称);
};

声明 内存写(指针, 偏移, 值, 字节数){
    返回值 GL.内存.写(指针, 偏移, 值, 字节数);
};
声明 内存读(指针, 偏移, 字节数){
    返回值 GL.内存.读(指针, 偏移, 字节数);
};
声明 内存清零(指针, 字节数){
    返回值 GL.内存.清零(指针, 字节数);
};
声明 内存写浮点(指针, 偏移, 值){
    返回值 GL.内存.写浮点(指针, 偏移, 值);
};
声明 内存写字符串(指针, 偏移, 字符串){
    返回值 GL.内存.写字符串(指针, 偏移, 字符串);
};