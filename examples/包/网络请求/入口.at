设 请求次数 存在;

声明 发送(url){
    打印("网络请求.发送: " + url);
    返回值 "OK";
};

声明 请求(name){
    打印("网络请求.请求: " + name);
    返回值 0;
};

声明 记录请求(name){

    请求次数 = 请求次数 + 1;
    打印("网络请求.记录请求: " + name);
    返回值 请求次数;
};

类 响应 {
公开:
    声明 回应(){
        打印("网络请求.响应.回应()");
        返回值 0;
    };
};

创建引子 帮助(){
    打印("网络请求.帮助()");
    返回值 0;
};

私有:
声明 内部工具(){
    打印("网络请求.内部工具()");
    返回值 0;
};