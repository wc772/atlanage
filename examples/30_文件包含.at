引用.文件("lib/lib_included.at")
引用.文件("lib/lib_ranged.at"[3~8])

类 文件包含测试 {
公开:
    声明 测试文件包含(){
        打印("=== 文件包含测试 ===");
        打印("PI = " + 取PI());
        打印("G = " + 取G());
        打印("平方(5) = " + 平方(5));
        打印("立方(3) = " + 立方(3));
        打印("取常量() = " + 取常量());
        打印("双倍(21) = " + 双倍(21));
        返回值 0;
    };
};