类 文件操作测试 {
公开:
    声明 测试创建和打开文件(){
        打印("=== 创建和打开文件 ===");

        设 h = 创建(test.txt);
        关闭文件(h);

        打印("文件创建和打开/关闭测试完成");
        返回值 0;
    };

    声明 测试写入文件(){
        打印("=== 写入文件 ===");

        设 h = 创建(write_test.txt);
        设 sad = "Hello, Atlanage!";
        写入文件(h, sad);
        关闭文件(h);

        打印("写入完成");
        返回值 0;
    };

    声明 测试读取文件(){
        打印("=== 读取文件 ===");

        设 a = 文件(write_test.txt);
        打印("文件内容: " + a);

        返回值 0;
    };

    声明 测试检索文件内容(){
        打印("=== 在文件中检索 ===");

        读取文件(write_test.txt){
            设 a = s.检索("Hello");
            打印("行内容: " + s + "，'Hello'个数:" + a);
        };

        返回值 0;
    };

    声明 测试二进制写入(){
        打印("=== 二进制写入 ===");

        二进制写入("data.bin", 0, "hello");

        打印("二进制写入完成");
        返回值 0;
    };

    声明 测试字节读取(){
        打印("=== 字节读取 ===");

        设 data = 字节读取("data.bin", 0, 10);
        打印("读取的字节数据: " + data);

        返回值 0;
    };
    声明 测试文件路径写法(){
        打印("=== 文件路径写法 ===");

        打开文件(abb.txt);

        设 a = 文件(W:\date\abc.txt);

        设 b = 文件(W:\date\abc.txt[0~200]);
        打印("文件的内容是                                                       ："+a);
        打印("                                                                                     ");
        打印("                                                                                     ");
        打印("                                                                                     ");
        打印("                                                                                     ");
        打印("                                                                                     ");
        打印("0到200行的内容是:"+b);
        返回值 0;
    };
};