设 全局线宽 存在;

类 后缀测试 {
公开:

    声明 旧语法(){
        图形.绘制.矩形(0, 0:10, 10)[红];
        图形.绘制.圆(0, 0:10)[红*];
        返回值 0;
    };

    声明 透明度语法(){
        图形.绘制.矩形(0, 0:10, 10)[红, 0.5];
        图形.绘制.圆(0, 0:10)[红*, 0.5];
        图形.绘制.矩形(0, 0:10, 10)[蓝, 1.0];
        图形.绘制.圆(0, 0:10)[绿, 1];
        返回值 0;
    };

    声明 命名属性语法(){
        图形.绘制.圆(0, 0:10)[红*, 0.5, 线宽:3];
        图形.绘制.矩形(0, 0:10, 10)[绿, 0.25, 线宽:2, 发光:真];
        返回值 0;
    };

    声明 属性无透明度(){
        图形.绘制.圆(0, 0:10)[青, 线宽:2];
        返回值 0;
    };

    声明 表达式属性(){
        图形.绘制.圆(0, 0:10)[红*, 0.5, 线宽:全局线宽 + 1];
        图形.绘制.矩形(0, 0:10, 10)[紫, 0.5, 发光:全局线宽 > 0];
        返回值 0;
    };

    声明 测试(){
        打印("=== 后缀扩容 ===");
        打印("PASS 76");
        返回值 0;
    };
};