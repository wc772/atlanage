类 汇编测试 {
公开:
    声明 测试单行汇编(){
        打印("=== 单行汇编指令 ===");

        汇编("nop");
        打印("执行了 nop");

        汇编("cpu");
        打印("获取了CPU信息");

        汇编("time");
        打印("读取了时间戳计数器");

        返回值 0;
    };

    声明 测试多行汇编块(){
        打印("=== 多行汇编块 ===");

        汇编{
            nop;
            mov eax, 1;
            cpu;
            time;
        };

        打印("多行汇编块执行完毕");
        返回值 0;
    };

    声明 测试JIT编译执行(){
        打印("=== JIT编译执行 ===");

        设 code = 内存.分配可执行(64);

        code[0]=0x48;
        code[1]=0xC7;
        code[2]=0xC0;
        code[3]=0x2A;
        code[4]=0x00;
        code[5]=0x00;
        code[6]=0x00;
        code[7]=0xC3;

        设 answer = 系统.调用(code);
        打印("JIT生成代码返回: " + answer);

        如果(answer == 42){
            打印("JIT编译执行成功!");
        };

        返回值 0;
    };

    声明 测试汇编块内多条指令(){
        打印("=== 汇编块内多条指令 ===");

        汇编{
            nop;
            nop;
            mov eax, 0;
            mov ebx, 10;
        };

        打印("多条汇编指令执行完毕");
        返回值 0;
    };
};