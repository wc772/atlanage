类 位运算测试 {
公开:
    声明 测试位运算(){
        设 a = 0xFF;
        设 b = 0x0F;
        打印("a & b = " + (a & b));
        打印("a | b = " + (a | b));
        打印("a ^ b = " + (a ^ b));
        打印("~a = " + (~a));
        打印("a << 4 = " + (a << 4));
        打印("a >> 4 = " + (a >> 4));
        返回值 0;
    };

    声明 测试字节访问(){
        设 s = "Hello";
        设 len = s.长度;
        打印("长度 = " + len);
        设 i = 0;
        循环(i < len){
            设 b = s.字节(i);
            打印("字节[" + i + "] = " + b);
            i++;
        };
        返回值 0;
    };

    声明 测试内存字节(){
        设 p = 内存.分配(16);
        打印("分配地址 = " + p);
        内存.写字节(p, 0, 0x41);
        内存.写字节(p, 1, 0x42);
        内存.写字节(p, 2, 0x43);
        内存.写字节(p, 3, 0);
        设 b0 = 内存.读字节(p, 0);
        设 b1 = 内存.读字节(p, 1);
        设 b2 = 内存.读字节(p, 2);
        打印("b0 = " + b0);
        打印("b1 = " + b1);
        打印("b2 = " + b2);
        内存.释放(p);
        返回值 0;
    };

    声明 测试码点转换(){
        设 c = 码点("A");
        打印("码点('A') = " + c);
        设 c2 = 码点("你");
        打印("码点('你') = " + c2);
        设 n = 整数("12345");
        打印("整数('12345') = " + n);
        返回值 0;
    };
};