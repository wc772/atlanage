类 模块导入测试 {
公开:
    声明 测试数学模块(){
        打印("=== 标准库: 数学模块 ===");

        设 a = 0;
        设 b = 0;
        设 c = 0;
        设 d = 0;
        设 e = 0;
        设 f = 0;
        设 g = 0;
        设 h = 0;
        设 i = 0;
        设 j = 0;

        引用.数学.加(1, 2)=a;
        打印("加(1,2) = " + a);

        引用.数学.减(10, 3)=b;
        打印("减(10,3) = " + b);

        引用.数学.乘(6, 7)=c;
        打印("乘(6,7) = " + c);

        引用.数学.除(10, 2)=d;
        打印("除(10,2) = " + d);

        引用.数学.绝对值(-10)=e;
        打印("绝对值(-10) = " + e);

        引用.数学.取整(3.14)=f;
        打印("取整(3.14) = " + f);

        引用.数学.取余(10, 3)=g;
        打印("取余(10,3) = " + g);

        引用.数学.平均值(1, 2, 3)=h;
        打印("平均值(1,2,3) = " + h);

        引用.数学.最大值(1, 2, 3)=i;
        打印("最大值(1,2,3) = " + i);

        引用.数学.最小值(1, 2, 3)=j;
        打印("最小值(1,2,3) = " + j);

        返回值 0;
    };

    声明 测试JSON模块(){
        打印("=== 标准库: JSON模块 ===");

        设 数据对象 = {};
        数据对象["name"] = "大王";
        数据对象["age"] = 18;
        设 jsonStr = JSON.序列化(数据对象);
        打印("序列化: " + jsonStr);

        设 obj = JSON.解析("{\"name\": \"大王\"}");
        打印("解析完成");

        返回值 0;
    };

    声明 测试正则模块(){
        打印("=== 标准库: 正则模块 ===");

        设 是否匹配 = 正则.匹配("abc123def", "\\d+");
        打印("正则匹配结果: " + 是否匹配);

        返回值 0;
    };

    声明 测试系统模块_执行命令(){
        打印("=== 标准库: 系统.执行() ===");

        系统.执行("dir");
        打印("系统命令执行完毕");

        返回值 0;
    };

    声明 测试系统模块_调用函数指针(){
        打印("=== 标准库: 系统.调用() ===");

        设 MessageBoxA = 系统.获取函数("user32.dll", "MessageBoxA");

        如果(MessageBoxA != 0){
            设 result = 系统.调用(MessageBoxA, 0, "你好", "标题", 0);
            打印("MessageBoxA 返回值: " + result);
        }否则{
            打印("无法获取MessageBoxA函数");
        };

        返回值 0;
    };

    声明 测试模块导入文件(){
        打印("=== 模块导入（文件） ===");

        引用.模块导入("abc");

        引用.模块导入("W:\atlanage\31243\abc.at");

        打印("模块导入测试完成");
        返回值 0;
    };

    声明 测试标准库导入(){
        打印("=== 标准库导入 ===");

        引用.数学;
        引用.JSON;
        引用.正则;
        引用.系统;

        打印("标准库模块导入完成");
        返回值 0;
    };
};