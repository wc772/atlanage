类 复数 {
公开:
    设 实部 存在;
    设 虚部 存在;
    构造(r, i){
        实部 = r;
        虚部 = i;
    };
    声明 _加_(其他){
        返回值 创建 复数(实部 + 其他.实部, 虚部 + 其他.虚部);
    };
    声明 _减_(其他){
        返回值 创建 复数(实部 - 其他.实部, 虚部 - 其他.虚部);
    };
    声明 _等_(其他){
        返回值 实部 == 其他.实部 && 虚部 == 其他.虚部;
    };
};
类 向量 {
公开:
    设 x 存在;
    设 y 存在;
    构造(px, py){
        x = px;
        y = py;
    };
    声明 _乘_(s){
        返回值 创建 向量(x * s, y * s);
    };
    声明 _除_(s){
        返回值 创建 向量(x / s, y / s);
    };
    声明 _模_(s){
        返回值 创建 向量(x % s, y % s);
    };
};
类 裸类 {
公开:
    设 值 存在;
    构造(v){
        值 = v;
    };
};
类 T {
公开:
    声明 测试(){

        设 a = 创建 复数(1, 2);
        设 b = 创建 复数(3, 4);
        设 c = a + b;
        如果(c.实部 == 4 && c.虚部 == 6){ 打印("OK1 +重载: " + c.实部 + "+" + c.虚部 + "i"); }否则{ 打印("FAIL1"); };

        设 d = c - b;
        如果(d.实部 == 1 && d.虚部 == 2){ 打印("OK2 -重载: " + d.实部 + "+" + d.虚部 + "i"); }否则{ 打印("FAIL2"); };

        设 v = 创建 向量(2, 5);
        设 v2 = v * 3;
        如果(v2.x == 6 && v2.y == 15){ 打印("OK3 *重载: (" + v2.x + ", " + v2.y + ")"); }否则{ 打印("FAIL3"); };

        设 v3 = 创建 向量(10, 20);
        设 v4 = v3 / 4;
        如果(v4.x == 2 && v4.y == 5){ 打印("OK4 /重载: (" + v4.x + ", " + v4.y + ")"); }否则{ 打印("FAIL4"); };
        设 v5 = 创建 向量(10, 21);
        设 v6 = v5 % 6;
        如果(v6.x == 4 && v6.y == 3){ 打印("OK5 %重载: (" + v6.x + ", " + v6.y + ")"); }否则{ 打印("FAIL5"); };

        设 a2 = 创建 复数(1, 2);
        如果(a == a2){ 打印("OK6 ==值相等"); }否则{ 打印("FAIL6"); };
        如果(a != b){ 打印("OK7 !=继承"); }否则{ 打印("FAIL7"); };
        如果(!(a != a2)){ 打印("OK8 !=取反"); }否则{ 打印("FAIL8"); };

        设 n1 = 创建 裸类(5);
        设 n2 = 创建 裸类(5);
        如果(n1 == n1){ 打印("OK9 引用相同"); }否则{ 打印("FAIL9"); };
        如果(n1 != n2){ 打印("OK10 引用不同"); }否则{ 打印("FAIL10"); };

        设 x = 1 + 2;
        如果(x == 3){ 打印("OK11 内置+"); }否则{ 打印("FAIL11: " + x); };
        设 y = 6 * 7;
        如果(y == 42){ 打印("OK12 内置*"); }否则{ 打印("FAIL12: " + y); };

        设 s = "a" + "b";
        如果(s == "ab"){ 打印("OK13 字符串拼接"); }否则{ 打印("FAIL13: " + s); };

        返回值 0;
    };
};