引用.文件("lib/界面/界面.at")

设 g_计时 = 0;
设 g_运行 = 0;
设 g_按钮元素 = 空;

类 main {
公开:
    声明 运行(){
        打印("=== 控件按钮计时器 ===");
        设 win = GL.窗口.创建(320, 240, "Timer");
        打印("窗口创建=" + (win > 0));

        界面.创建(窗口:win){
            行(间距:8, 填充:16){
                标签(文本:"0", 字号:32);
                按钮(文字:"开始")[主题.主色*]{
                    当.点击{
                        g_运行 = 1 - g_运行;
                        如果(g_运行 == 1){
                            g_按钮元素.文本 = "停止";
                        };
                        如果(g_运行 == 0){
                            g_按钮元素.文本 = "开始";
                        };
                    };
                };
            };
        };

        设 根元素 = 界面_根;
        设 行元素 = 根元素.子列表[0];
        设 标签元素 = 行元素.子列表[0];
        设 按钮元素 = 行元素.子列表[1];
        g_按钮元素 = 按钮元素;

        打印("初始=" + g_计时);

        界面_触发(按钮元素, "点击", 空);
        打印("点击后按钮=" + 按钮元素.文本);

        设 i = 0;
        循环(i < 30){
            如果(g_运行 == 1){ g_计时 = g_计时 + 1; };
            i = i + 1;
        };
        打印("运行30帧后=" + g_计时);

        界面_触发(按钮元素, "点击", 空);
        打印("停止后按钮=" + 按钮元素.文本);
        设 j = 0;
        循环(j < 10){
            如果(g_运行 == 1){ g_计时 = g_计时 + 1; };
            j = j + 1;
        };
        打印("停止10帧后=" + g_计时);

        界面_触发(按钮元素, "点击", 空);
        打印("再次启动按钮=" + 按钮元素.文本);
        设 k = 0;
        循环(k < 5){
            如果(g_运行 == 1){ g_计时 = g_计时 + 1; };
            k = k + 1;
        };
        打印("再运行5帧后=" + g_计时);

        界面_布局();
        界面_渲染(win);
        GL.呈现(win);
        GL.窗口.关闭(win);
        打印("PASS 84");
        返回值 0;
    };
};