引用.文件("lib/lib_included.at"[2~4])

引用.文件("examples/lib/lib_ranged.at"[3~5])

引用.模块导入("lib/lib_advanced.at");

类 引用机制补充测试 {
公开:
    声明 测试标准库取模(){
        引用.数学;
        引用.JSON;
        引用.正则;
        引用.系统;

        打印("=== 标准库语句导入 + 取模 ===");
        设 a = 0;
        引用.数学.取模(10, 3)=a;
        打印("取模(10,3) = " + a);
        返回值 0;
    };

    声明 测试JSON往返(){
        打印("=== JSON 往返 ===");
        设 数据对象 = {};
        数据对象["name"] = "大王";
        设 jsonStr = JSON.序列化(数据对象);
        设 obj2 = JSON.解析(jsonStr);
        打印("name = " + obj2["name"]);
        返回值 0;
    };

    声明 测试文件包含(){
        打印("=== 文件包含(相对路径+行范围) ===");
        设 pi = 0.0;
        取PI()=pi;
        打印("取PI() = " + pi);

        打印("=== 文件包含(绝对路径+行范围) ===");
        设 c = 0.0;
        取常量()=c;
        打印("取常量() = " + c);
        返回值 0;
    };

    声明 测试模块导入进阶(){
        打印("=== 模块导入 lib_advanced ===");
        设 a = 0;
        引用.三数和(10, 20, 30)=a;
        打印("三数和(10,20,30) = " + a);

        设 b = 0;
        引用.平均分(4.0, 5.0, 6.0)=b;
        打印("平均分(4.0,5.0,6.0) = " + b);

        设 c = "";
        引用.交换(5, 9)=c;
        打印("交换(5,9) = " + c);

        设 d = "";
        引用.拼接三(Hello, World, Hey)=d;
        打印("拼接三(Hello, World, Hey) = " + d);
        返回值 0;
    };
};