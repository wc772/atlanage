类 网络操作测试 {
公开:
    声明 测试HTTP_GET请求(){
        打印("=== HTTP GET 请求 ===");

        设 响应 = 网络.获取("https://api-docs.deepseek.com/zh-cn/updates/");
        打印("GET返回:");
        打印(响应);

        返回值 0;
    };

    声明 测试HTTP_POST请求(){
        打印("=== HTTP POST 请求 ===");

        设 结果 = 网络.提交("https://api-docs.deepseek.com/zh-cn/updates/", "name=test&age=18");
        打印("POST返回:");
        打印(结果);

        返回值 0;
    };

    声明 测试DNS解析(){
        打印("=== DNS解析 ===");

        设 ip = 网络.解析("www.baidu.com");
        打印("百度IP=" + ip);

        返回值 0;
    };

    声明 测试网络延迟(){
        打印("=== 网络延迟测试 ===");

        设 延迟 = 网络.延时("www.baidu.com");
        打印("百度延迟=" + 延迟 + "ms");

        返回值 0;
    };

    声明 测试网络连通性(){
        打印("=== 网络连通性检查 ===");

        设 在线 = 网络.检活;
        如果(在线){
            打印("网络连接正常");
        }否则{
            打印("网络不可用");
        };

        返回值 0;
    };

    声明 测试完整网络请求流程(){
        打印("=== 完整网络请求流程 ===");

        设 在线 = 网络.检活;
        如果(!在线){
            打印("错误: 网络不可用");
            返回值 1;
        };

        设 ip = 网络.解析("api-docs.deepseek.com");
        打印("api-docs.deepseek.com IP = " + ip);

        设 延迟 = 网络.延时("api-docs.deepseek.com");
        打印("延迟 = " + 延迟 + "ms");

        设 响应 = 网络.获取("https://api-docs.deepseek.com/zh-cn/updates/");
        打印("响应: " + 响应);

        返回值 0;
    };
};