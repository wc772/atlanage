引用.文件("lib/界面/界面.at")

设 g_win = 0;
设 线程帧数 = 0;
设 线程运行 = 真;

声明 渲染循环(){
    GL.设置当前(窗口:g_win);
    循环(线程运行){
        界面.渲染(g_win);
        GL.呈现(g_win);
        线程帧数 = 线程帧数 + 1;
        如果(线程帧数 >= 30){ 线程运行 = 假; };
    };
    返回值 0;
};

类 main {
公开:
    声明 运行(){

        g_win = GL.窗口.创建(320, 240, "渲染线程测试");

        界面.创建(窗口:g_win){
            行(间距:8, 填充:16){
                标签(文本:"渲染线程", 字号:20);
                按钮(文字:"确定")[主题.主色*]{
                    当.点击{ 线程帧数 = 线程帧数 + 100; };
                };
            };
        };

        界面.线程模式设置(真);
        设 t = 进程.创建("渲染循环");

        循环(线程运行){
            GL.消息泵(g_win);
        };

        进程.等待(t);
        界面.线程模式设置(假);
        GL.窗口.关闭(g_win);
        打印("线程帧数=" + 线程帧数);
        打印("PASS 81");
        返回值 0;
    };
};