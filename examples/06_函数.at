类 函数测试 {
公开:

    声明 打招呼(){
        打印("你好，世界！");
        返回值 0;
    };

    声明 加法(a, b){
        返回值 a + b;
    };

    声明 阶乘(n){
        设 a 存在;
        如果(n<0){
            打印("n<0, data error!");
        }又如果(n==0||n==1){
            a=1;
        }否则{
            a=阶乘(n-1)*n;
        };
        返回值 a;
    };

    声明 累加求和(n){
        设 sum=0;
        设 i=1;
        循环(i<=n){
            sum=sum+i;
            i=i+1;
        };
        返回值 sum;
    };

    声明 测试简单函数(){
        打印("=== 简单函数 ===");
        打招呼();
        返回值 0;
    };

    声明 测试带参函数(){
        打印("=== 带参函数 ===");
        设 result = 加法(10, 20);
        打印("10 + 20 = " + result);

        设 r2 = 加法(100, 200);
        打印("100 + 200 = " + r2);

        返回值 0;
    };

    声明 测试递归函数(){
        打印("=== 递归函数：阶乘 ===");

        设 n = 6;
        设 result = 阶乘(n);
        打印(n + "! = " + result);

        打印("5! = " + 阶乘(5));
        打印("1! = " + 阶乘(1));
        打印("0! = " + 阶乘(0));

        返回值 0;
    };

    声明 测试累加求和(){
        打印("=== 累加求和 ===");
        打印("1到50的和 = " + 累加求和(50));
        打印("1到100的和 = " + 累加求和(100));

        返回值 0;
    };

    声明 测试匿名函数(){
        打印("=== 匿名函数 ===");

        设 平方 = 函数(x){
            返回值 x * x;
        };

        打印("5的平方 = " + 平方(5));
        打印("10的平方 = " + 平方(10));

        返回值 0;
    };

    声明 测试函数作为参数(){
        打印("=== 函数作为参数 ===");

        声明 应用(fn, val){
            返回值 fn(val);
        };

        设 加倍 = 函数(x){ 返回值 x * 2; };
        设 result = 应用(加倍, 21);
        打印("应用结果 = " + result);

        返回值 0;
    };
};