引用.模块导入("../工具/atp/atp.at");
引用.包导入("网络请求", "1.2.0");

类 atp依赖测试 {
公开:
    声明 运行(){

        打印("=== 依赖: 编译期版本检查 ===");
        设 r = 网络请求.发送("http://dep.example.com");
        打印("版本包调用: " + r);

        打印("=== 依赖: atp 递归安装 ===");
        设 临时 = "_70atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);
        设 清单 = 引用.atp安装("依赖演示", "examples/包", "包/", "");
        如果(清单 == 空){
            打印("安装失败");
        }否则{
            设 含本包 = 引用.atp文本含行(清单, "依赖演示@1.0.0");
            打印("安装返回含 依赖演示@1.0.0=" + 含本包);
            设 依赖文件 = 字节读取("依赖/网络请求/atp.json", 0, 1048576);
            设 已落盘 = 0;
            如果(依赖文件 != 空){
                设 含版本 = 引用.atp清单取值(依赖文件, "版本");
                如果(含版本 == "1.2.0"){ 已落盘 = 1; };
            };
            打印("依赖已落盘=" + 已落盘);
        };

        打印("=== 依赖: 版本不符 ===");
        设 不符 = 引用.atp安装("网络请求", "examples/包", "包/", "9.9.9");
        如果(不符 == 空){
            打印("不符返回=空");
        }否则{
            打印("不符返回=非空");
        };

        打印("=== 依赖: 锁文件 ===");
        引用.atp写锁(清单);
        设 锁 = 字节读取("包.lock", 0, 1048576);
        设 锁含 = 0;
        如果(锁 != 空){
            设 含网络 = 引用.atp文本含行(锁, "网络请求@1.2.0");
            如果(含网络 == 1){ 锁含 = 1; };
        };
        打印("锁文件含 网络请求@1.2.0=" + 锁含);
        设 rc = 引用.atp重装("examples/包");
        打印("重装返回=" + rc);

        返回值 0;
    };
};