类 输入输出测试 {
公开:
    声明 测试打印基本(){
        打印("=== 打印基本测试 ===");

        打印("你好，世界！");
        打印("数字: " + 123);
        打印("布尔: " + 真);

        返回值 0;
    };

    声明 测试打印多个值(){
        打印("=== 打印多个值 ===");

        设 sum = 15;
        打印("sum=" + sum);

        打印("%d*%d=%-4d", 1, 2, 2);

        返回值 0;
    };

    声明 测试错误打印(){
        打印("=== 错误打印（stderr） ===");

        错误打印("这是一条错误信息");
        错误打印("错误: 语法错误在第5行");
        错误打印("警告: 变量未初始化");

        返回值 0;
    };

    声明 测试输入_引用方式(){
        打印("=== 输入（引用方式 &） ===");

        设 n 存在;
        设 b 存在;

        输入("input an integer number:\n", &n);

        打印("你输入了: " + n);

        返回值 0;
    };

    声明 测试输入_返回值方式(){
        打印("=== 输入（返回值方式） ===");

        设 名字 = 输入("请输入名字：");
        打印("你输入的名字: " + 名字);

        设 年龄 = 输入("请输入年龄：");
        打印("你输入的年龄: " + 年龄);

        返回值 0;
    };

    声明 测试格式化(){
        打印("=== 格式化函数 ===");

        设 str1 = 格式化("第%d名:%s", 1, "小明");
        打印(str1);

        设 str2 = 格式化("成绩: %.2f分", 98.5);
        打印(str2);

        设 str3 = 格式化("十六进制: 0x%x", 255);
        打印(str3);

        设 str4 = 格式化("字符: %c", 65);
        打印(str4);

        返回值 0;
    };

    声明 测试显示操作符(){
        打印("=== 显示操作符 << ===");

        显示<<"欢迎使用Atlanage";
        显示<<"请输入命令"<<end;

        返回值 0;
    };

    声明 测试字符串构建(){
        打印("=== 字符串构建器 ===");

        字符串构建.清空();

        字符串构建.追加("第一行\n");
        字符串构建.追加("第二行: ");
        字符串构建.追加(123);
        字符串构建.追加("\n第三行: ");
        字符串构建.追加(真);

        设 bigStr = 字符串构建.构建();
        打印("构建的字符串: ");
        打印(bigStr);

        字符串构建.清空();
        打印("构建器已清空");

        返回值 0;
    };

    声明 测试综合输入输出(){
        打印("=== 综合输入输出流程 ===");

        设 用户名 = 输入("请输入用户名：");

        设 欢迎信息 = 格式化("欢迎, %s!", 用户名);
        打印(欢迎信息);

        显示<<欢迎信息;

        返回值 0;
    };
};