类 动物 {
公开:
    设 名字 存在;
    构造(n){
        名字 = n;
    };
};
类 猫 {
公开:
    设 名字 存在;
    构造(n){
        名字 = n;
    };
};
类 T {
公开:
    声明 测试(){

        设 x = 42;
        选择(x){
            情况 是 整|字:
                打印("OK1 整命中: " + x);
                跳出;
            默认:
                打印("FAIL1");
                跳出;
        };

        设 s = "abc";
        选择(s){
            情况 是 整|字:
                打印("OK2 字命中: " + s);
                跳出;
            默认:
                打印("FAIL2");
                跳出;
        };

        设 f = 2.5;
        选择(f){
            情况 是 整|字:
                打印("FAIL3");
                跳出;
            默认:
                打印("OK3 小数落默认");
                跳出;
        };

        设 a = 创建 动物("旺财");
        选择(a){
            情况 是 动物|猫:
                打印("OK4 动物命中: " + a.名字);
                跳出;
            默认:
                打印("FAIL4");
                跳出;
        };
        设 c = 创建 猫("咪咪");
        选择(c){
            情况 是 动物|猫:
                打印("OK5 猫命中: " + c.名字);
                跳出;
            默认:
                打印("FAIL5");
                跳出;
        };

        设 y = 7;
        选择(y){
            情况 是 整:
                打印("OK6 单类型回归");
                跳出;
            默认:
                打印("FAIL6");
                跳出;
        };

        选择(x){
            情况 是 整|动物:
                打印("OK7 混合命中: " + x);
                跳出;
            默认:
                打印("FAIL7");
                跳出;
        };
        选择(a){
            情况 是 整|动物:
                打印("OK8 混合类名命中: " + a.名字);
                跳出;
            默认:
                打印("FAIL8");
                跳出;
        };
        返回值 0;
    };
};