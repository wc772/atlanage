引用.模块导入("../工具/atp/atp.at");

类 zip发布测试 {
公开:
    声明 运行(){
        设 临时 = "_73atp_tmp";
        创建文件夹("" + 临时);
        系统.切换目录(临时);

        打印("=== zip: stored 解压 ===");
        设 rc1 = 引用.atp解压("examples/夹具/stored.zip", "s_out");
        设 清单1 = 字节读取("s_out/atp.json", 0, 1048576);
        如果(清单1 == 空){
            打印("stored 清单=空");
        }否则{
            打印("stored 清单版本=" + 引用.atp清单取值(清单1, "版本"));
        };
        设 hs = 打开文件("s_out/数据.txt");
        设 数据大小1 = 0;
        如果(hs != 0){
            数据大小1 = 文件大小(hs);
            关闭文件(hs);
        };
        打印("stored 数据大小=" + 数据大小1);

        打印("=== zip: deflate 解压 ===");
        设 rc2 = 引用.atp解压("examples/夹具/deflate.zip", "d_out");
        设 清单2 = 字节读取("d_out/atp.json", 0, 1048576);
        如果(清单2 == 空){
            打印("deflate 清单=空");
        }否则{
            打印("deflate 清单版本=" + 引用.atp清单取值(清单2, "版本"));
        };
        设 入口 = 字节读取("d_out/入口.at", 0, 4096);
        如果(入口 == 空){
            打印("deflate 入口=空");
        }否则{
            设 首行含 = 引用.atp文本含行(入口, "// 夹具入口: 重复文本用于 deflate LZ77 压缩验证");
            打印("deflate 首行含=" + 首行含);
            打印("deflate 入口行数=" + 引用.atp行数(入口));
        };

        设 hd = 打开文件("d_out/数据.txt");
        设 数据大小2 = 0;
        如果(hd != 0){
            数据大小2 = 文件大小(hd);
            关闭文件(hd);
        };
        打印("deflate 数据大小=" + 数据大小2);

        打印("=== publish: 打包→解回 闭环 ===");
        创建文件夹("包");
        创建文件夹("包/演示包");
        二进制写入("包/演示包/atp.json", 0, 引用.atp清单文本("演示包", "1.0.0"));
        二进制写入("包/演示包/入口.at", 0, "// 演示包入口\n声明 f(参数){ 返回值 0; };\n");
        创建文件夹("发布");
        设 rc3 = 引用.atp打包("演示包", "包/演示包", "发布/演示包.zip");
        设 rc4 = 引用.atp解压("发布/演示包.zip", "p_out");
        设 清单3 = 字节读取("p_out/atp.json", 0, 1048576);
        如果(清单3 == 空){
            打印("回解清单=空");
        }否则{
            设 含包名 = atp文本含行(清单3, "包名: 演示包");
            打印("回解清单含包名=" + 含包名);
        };
        设 入口3 = 字节读取("p_out/入口.at", 0, 256);
        如果(入口3 == 空){
            打印("回解入口=空");
        }否则{
            设 含入口 = atp文本含行(入口3, "// 演示包入口");
            打印("回解入口含=" + 含入口);
        };

        返回值 0;
    };
};