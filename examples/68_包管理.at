引用.包导入("网络请求");
引用.包导入("工具");

类 包管理测试 {
公开:
    声明 测试包函数(){
        打印("=== 包导入: 包函数 ===");

        设 r = 网络请求.发送("http://example.com");
        打印("返回: " + r);

        网络请求.请求("请求A");
        工具.请求("请求A");

        设 g = 工具.生成(21);
        打印("生成结果: " + g);

        返回值 0;
    };

    声明 测试包内全局变量(){
        打印("=== 包导入: 包内全局变量 ===");

        设 n = 网络请求.记录请求("请求B");
        打印("记录返回: " + n);

        打印("包内变量: " + 网络请求.请求次数);

        返回值 0;
    };

    声明 测试包内类(){
        打印("=== 包导入: 包内类 ===");

        创建 网络请求.响应:resp;
        resp.回应();

        返回值 0;
    };

    声明 测试包内引子(){
        打印("=== 包导入: 包内引子 ===");

        引用.网络请求.帮助();

        返回值 0;
    };
};