类 测试容器方法 {
    声明 测试(){
        打印("=== 列表方法 ===");
        设 组集 分数 = [2, 1, 4, 3];
        分数.删除(1);
        打印("删除后=" + 分数);
        分数.添加(9);
        分数.排序();
        打印("排序后=" + 分数);
        分数.反转();
        打印("反转后=" + 分数);
        打印("包含3=" + 分数.包含(3));
        打印("查找3=" + 分数.查找(3));
        打印("个数=" + 分数.个数);

        打印("=== 字典方法 ===");
        设 组集 字典 = {};
        字典.添加("甲", 1);
        字典.添加("乙", 2);
        打印("存在键甲=" + 字典.存在键("甲"));
        打印("键列表=" + 字典.键列表());
        打印("值列表=" + 字典.值列表());
        字典.删除键("甲");
        打印("删除键后不存在=" + 字典.存在键("甲"));

        打印("=== 字符串方法 ===");
        打印("大写=" + "abc".大写());
        打印("小写=" + "ABC".小写());
        打印("替换=" + "abc".替换("b", "x"));
        打印("分割后=" + "1,2,3".分割(","));
        打印("去除空白=" + "  ab  ".去除空白());
        打印("重复=" + "哈".重复(2));
        打印("等值=" + "abc".等值("abc"));

        打印("=== 函数式方法 ===");
        设 组集 数字 = [1, 2, 3, 4];
        设 翻倍 = 数字.映射(函数(项){ 返回值 项 * 2; });
        打印("映射=" + 翻倍);
        设 大数 = 数字.过滤(函数(项){ 返回值 项 > 2; });
        打印("过滤=" + 大数);
        设 总和 = 数字.归并(0, 函数(累加, 项){ 返回值 累加 + 项; });
        打印("归并=" + 总和);
        返回值 0;
    };
};