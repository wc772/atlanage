类 main {
公开:
    声明 运行(){
        打印("=== 事件订阅 ===");

        设 win = GL.窗口.创建(320, 240, "事件测试");
        打印("窗口创建=" + (win > 0));

        监听(事件:输入.键盘按下, 键:"w"){
            打印("订阅触发");
        };

        监听(事件:输入.滚轮){
            打印("滚轮触发");
        };

        设 输入处理 = 输入.处理();
        打印("输入处理=" + 输入处理);

        设 按键按下 = 输入.按键按下(键:"w");
        打印("按键按下=" + 按键按下);
        设 同步 = 输入.同步();
        打印("同步=" + 同步);

        设 关闭 = GL.窗口.关闭(win);
        打印("窗口关闭=" + 关闭);

        打印("PASS 79");
        返回值 0;
    };
};