引用.包导入("Vulkan");

类 main {
公开:
    声明 运行(){
        打印("=== Vulkan 支持包 ===");

        设 载入 = Vulkan.载入();
        打印("载入=" + 载入);
        打印("载入成功=" + (载入 == 1));
        设 版本 = Vulkan.版本();
        打印("版本=" + 版本);
        打印("版本可用=" + (版本 >= 4194304));

        设 实例 = Vulkan.创建实例("AtlanageVulkan包");
        打印("实例错误码=" + Vulkan.错误码);
        打印("实例创建成功=" + (实例 > 0 && Vulkan.错误码 == 0));

        设 设备数 = Vulkan.物理设备数量(实例);
        打印("设备数=" + 设备数);
        打印("物理设备存在=" + (设备数 >= 1 && Vulkan.错误码 == 0));

        设 名称 = Vulkan.物理设备名称(实例, 0);
        打印("设备名称=" + 名称);

        设 销毁结果 = Vulkan.销毁实例(实例);
        打印("实例销毁成功=" + (销毁结果 == 0));

        返回值 0;
    };
};