类 类型转换参数测试 {
公开:
    声明 测试数值转换_整数(){
        打印("=== 数值()转换 - 整数 ===");

        设 n = 数值("123");
        打印("数值('123') = " + n);

        如果(n == 123){
            打印("整数转换正确");
        };

        返回值 0;
    };

    声明 测试数值转换_浮点数(){
        打印("=== 数值()转换 - 浮点数 ===");

        设 f = 数值("3.14");
        打印("数值('3.14') = " + f);

        如果(f == 3.14){
            打印("浮点数转换正确");
        };

        返回值 0;
    };

    声明 测试数值转换_无效字符串(){
        打印("=== 数值()转换 - 无效字符串 ===");

        设 z = 数值("abc");
        打印("数值('abc') = " + z);

        如果(z == 0){
            打印("无效字符串正确返回0");
        };

        返回值 0;
    };

    声明 测试数值转换_十六进制(){
        打印("=== 数值()转换 - 十六进制 ===");

        设 h = 数值("0xFF");
        打印("数值('0xFF') = " + h);

        如果(h == 255){
            打印("十六进制转换正确");
        };

        设 h2 = 数值("0x1A");
        打印("数值('0x1A') = " + h2);

        返回值 0;
    };

    声明 测试字符转换(){
        打印("=== 字符()转换 ===");

        设 c = 字符(65);
        打印("字符(65) = " + c);
        如果(c == "A"){
            打印("ASCII 65 -> 'A' 正确");
        };

        设 s = 字符(97);
        打印("字符(97) = " + s);
        如果(s == "a"){
            打印("ASCII 97 -> 'a' 正确");
        };

        设 space = 字符(32);
        打印("字符(32) = '" + space + "'");

        返回值 0;
    };

    声明 测试命令行参数_获取个数(){
        打印("=== 命令行参数 ===");

        设 个数 = 参数.个数;
        打印("参数个数: " + 个数);

        打印("程序名 (参数[0]): " + 参数[0]);

        返回值 0;
    };

    声明 测试命令行参数_遍历(){
        打印("=== 遍历命令行参数 ===");

        设 个数 = 参数.个数;
        设 i = 0;

        循环(i < 个数){
            打印("参数[" + i + "] = " + 参数[i]);
            i = i + 1;
        };

        返回值 0;
    };

    声明 测试命令行参数_解析(){
        打印("=== 解析命令行参数 ===");

        设 个数 = 参数.个数;
        如果(个数 < 2){
            打印("用法: 程序 <参数1> <参数2> ...");
            返回值 1;
        };

        设 i = 1;
        循环(i < 个数){
            设 值 = 数值(参数[i]);
            打印("参数[" + i + "] = " + 参数[i] + " (数值=" + 值 + ")");
            i = i + 1;
        };

        返回值 0;
    };
};