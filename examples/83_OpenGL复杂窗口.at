设 g_winB = 0;
设 g_线程帧数 = 0;
设 g_线程运行 = 真;

声明 读整数(addr, off){
    设 b0 = 内存.读字节(addr, off);
    设 b1 = 内存.读字节(addr, off + 1);
    设 b2 = 内存.读字节(addr, off + 2);
    设 b3 = 内存.读字节(addr, off + 3);
    返回值 (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
};

声明 渲染辅助(){
    GL.设置当前(窗口:g_winB);
    GL.矩阵(5889);
    GL.单位矩阵();
    GL.正交(0.0, 320, 0.0, 240, -1.0, 1.0);
    GL.矩阵(5888);
    GL.单位矩阵();
    循环(g_线程运行){
        GL.清屏(红:10, 绿:20, 蓝:40, 透明度:255);
        GL.开始(7);
        GL.颜色(0, 200, 255, 255);
        GL.顶点(40, 40, 0.0);
        GL.顶点(120, 40, 0.0);
        GL.顶点(120, 120, 0.0);
        GL.顶点(40, 120, 0.0);
        GL.结束();
        GL.文本.绘制(窗口:g_winB, x:10, y:10, 字号:20, 红:255, 绿:255, 蓝:255, 透明度:255, 文本:"B");
        GL.呈现(g_winB);
        g_线程帧数 = g_线程帧数 + 1;
        如果(g_线程帧数 >= 10){ g_线程运行 = 假; };
    };
    返回值 0;
};

类 main {
公开:
    声明 运行(){
        打印("=== 复杂 OpenGL 窗口 ===");

        设 winA = GL.窗口.创建(640, 480, "ComplexA");
        设 winB = GL.窗口.创建(320, 240, "ComplexB");
        打印("窗口A创建=" + (winA > 0));
        打印("窗口B创建=" + (winB > 0));

        设 bufA = 内存.分配(8);
        设 bufB = 内存.分配(8);
        设 okA = GL.窗口.大小(窗口:winA, 缓冲:bufA);
        设 okB = GL.窗口.大小(窗口:winB, 缓冲:bufB);
        打印("窗口A尺寸=" + 读整数(bufA, 0) + "," + 读整数(bufA, 4));
        打印("窗口B尺寸=" + 读整数(bufB, 0) + "," + 读整数(bufB, 4));

        GL.设置当前(窗口:winA);
        GL.矩阵(5889);
        GL.单位矩阵();
        GL.正交(0.0, 640, 0.0, 480, -1.0, 1.0);
        GL.矩阵(5888);
        GL.单位矩阵();
        GL.清屏(红:20, 绿:20, 蓝:40, 透明度:255);
        GL.开始(7);
        GL.颜色(255, 64, 32, 255);
        GL.顶点(80, 80, 0.0);
        GL.顶点(240, 80, 0.0);
        GL.顶点(240, 200, 0.0);
        GL.顶点(80, 200, 0.0);
        GL.结束();
        GL.开始(4);
        GL.颜色(0, 200, 255, 255);
        GL.顶点(360, 80, 0.0);
        GL.顶点(460, 240, 0.0);
        GL.顶点(280, 240, 0.0);
        GL.结束();
        GL.开始(1);
        GL.颜色(255, 255, 0, 255);
        GL.顶点(40, 300, 0.0);
        GL.顶点(200, 360, 0.0);
        GL.结束();
        GL.文本.绘制(窗口:winA, x:20, y:20, 字号:28, 红:255, 绿:255, 蓝:255, 透明度:255, 文本:"ComplexA");
        GL.呈现(winA);
        打印("绘制A=1");

        GL.设置当前(窗口:winB);
        GL.矩阵(5889);
        GL.单位矩阵();
        GL.正交(0.0, 320, 0.0, 240, -1.0, 1.0);
        GL.矩阵(5888);
        GL.单位矩阵();
        GL.清屏(红:10, 绿:10, 蓝:20, 透明度:255);
        GL.开始(4);
        GL.颜色(255, 255, 255, 255);
        GL.顶点(160, 40, 0.0);
        GL.顶点(260, 180, 0.0);
        GL.顶点(60, 180, 0.0);
        GL.结束();
        GL.呈现(winB);
        打印("绘制B=1");

        设 evBuf = 内存.分配(32);
        设 poll = GL.事件.轮询(窗口:winA, 缓冲:evBuf, 阻塞:0);
        打印("事件轮询=" + poll);
        输入.同步();

        g_winB = winB;
        g_线程帧数 = 0;
        g_线程运行 = 真;
        设 t = 进程.创建("渲染辅助");
        循环(g_线程运行){
            GL.消息泵(winA);
        };
        进程.等待(t);

        GL.窗口.关闭(winA);
        GL.窗口.关闭(winB);
        内存.释放(bufA);
        内存.释放(bufB);
        内存.释放(evBuf);
        打印("线程帧数=" + g_线程帧数);
        打印("PASS 83");
        返回值 0;
    };
};