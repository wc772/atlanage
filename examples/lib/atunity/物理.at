类 刚体 继承 组件 {
公开:
    设 速度x 存在;
    设 速度y 存在;
    设 重力 存在;
    设 摩擦 存在;

    构造(){
        速度x = 0;
        速度y = 0;
        重力 = 0;
        摩擦 = 0;
    };

    声明 设置速度(vx, vy){
        速度x = vx;
        速度y = vy;
        返回值 0;
    };
    声明 设置重力(g){
        重力 = g;
        返回值 0;
    };

    声明 物理更新(){
        如果(挂载对象 == 空){ 返回值 0; };
        速度y = 速度y - 重力;
        挂载对象.x = 挂载对象.x + 速度x;
        挂载对象.y = 挂载对象.y + 速度y;
        如果(摩擦 > 0){
            速度x = 速度x - 速度x * 摩擦;
            速度y = 速度y - 速度y * 摩擦;
        };
        返回值 0;
    };
};

类 盒碰撞器 继承 组件 {
公开:
    设 碰撞类型 存在;
    设 半宽 存在;
    设 半高 存在;

    构造(){
        碰撞类型 = 1;
        半宽 = 20;
        半高 = 20;
    };

    声明 设置尺寸(w, h){
        半宽 = w;
        半高 = h;
        返回值 0;
    };
};

类 圆碰撞器 继承 组件 {
公开:
    设 碰撞类型 存在;
    设 半径 存在;

    构造(){
        碰撞类型 = 2;
        半径 = 20;
    };

    声明 设置半径(r){
        半径 = r;
        返回值 0;
    };
};

声明 盒盒相交(甲, 甲部件, 乙, 乙部件){
    设 dx = 绝对值(甲.x - 乙.x);
    设 dy = 绝对值(甲.y - 乙.y);
    如果(dx < 甲部件.半宽 + 乙部件.半宽 && dy < 甲部件.半高 + 乙部件.半高){
        返回值 真;
    };
    返回值 假;
};

声明 圆圆相交(甲, 甲部件, 乙, 乙部件){
    设 半径和 = 甲部件.半径 + 乙部件.半径;
    如果(距离平方(甲.x, 甲.y, 乙.x, 乙.y) < 半径和 * 半径和){
        返回值 真;
    };
    返回值 假;
};

声明 盒圆相交(甲, 甲部件, 乙, 乙部件){
    设 最近x = 限幅(乙.x, 甲.x - 甲部件.半宽, 甲.x + 甲部件.半宽);
    设 最近y = 限幅(乙.y, 甲.y - 甲部件.半高, 甲.y + 甲部件.半高);
    如果(距离平方(乙.x, 乙.y, 最近x, 最近y) < 乙部件.半径 * 乙部件.半径){
        返回值 真;
    };
    返回值 假;
};

声明 检测碰撞(甲, 乙){
    如果(甲.激活 == 假 || 乙.激活 == 假){ 返回值 0; };
    如果(甲.已删除 == 真 || 乙.已删除 == 真){ 返回值 0; };
    设 甲数量 = 甲.部件数量();
    设 乙数量 = 乙.部件数量();
    设 i = 0;
    循环(i < 甲数量){
        设 甲部件 = 甲.部件(i);
        设 j = 0;
        循环(j < 乙数量){
            设 乙部件 = 乙.部件(j);
            如果(甲部件.碰撞类型 == 1 && 乙部件.碰撞类型 == 1){
                如果(盒盒相交(甲, 甲部件, 乙, 乙部件)){
                    甲.碰撞事件(乙);
                    乙.碰撞事件(甲);
                };
            };
            如果(甲部件.碰撞类型 == 1 && 乙部件.碰撞类型 == 2){
                如果(盒圆相交(甲, 甲部件, 乙, 乙部件)){
                    甲.碰撞事件(乙);
                    乙.碰撞事件(甲);
                };
            };
            如果(甲部件.碰撞类型 == 2 && 乙部件.碰撞类型 == 1){
                如果(盒圆相交(乙, 乙部件, 甲, 甲部件)){
                    甲.碰撞事件(乙);
                    乙.碰撞事件(甲);
                };
            };
            如果(甲部件.碰撞类型 == 2 && 乙部件.碰撞类型 == 2){
                如果(圆圆相交(甲, 甲部件, 乙, 乙部件)){
                    甲.碰撞事件(乙);
                    乙.碰撞事件(甲);
                };
            };
            j = j + 1;
        };
        i = i + 1;
    };
    返回值 0;
};