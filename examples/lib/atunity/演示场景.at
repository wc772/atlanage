设 全局自动模式 = 假;

设 AtOS_桌面 = 0x23273C;
设 AtOS_窗口面 = 0x2E3350;
设 AtOS_标题栏 = 0x4A5FA5;
设 AtOS_任务栏 = 0x1A1D30;
设 AtOS_高亮 = 0x5A6FBF;
设 AtOS_图标 = 0x3D4A7A;
设 AtOS_关闭 = 0xC05050;

类 窗口记录 {
公开:
    设 x 存在;
    设 y 存在;
    设 宽 存在;
    设 高 存在;
    设 标题 存在;
    设 内容 存在;

    构造(px, py, w, h, 标题文字, 内容文字){
        x = px;
        y = py;
        宽 = w;
        高 = h;
        标题 = 标题文字;
        内容 = 内容文字;
    };
};

类 图标记录 {
公开:
    设 x 存在;
    设 y 存在;
    设 名称 存在;
    设 窗口标题 存在;

    构造(px, py, 图标名, 目标标题){
        x = px;
        y = py;
        名称 = 图标名;
        窗口标题 = 目标标题;
    };
};

声明 点在矩形内(px, py, cx, cy, hw, hh){
    如果(px > cx - hw && px < cx + hw && py > cy - hh && py < cy + hh){
        返回值 真;
    };
    返回值 假;
};

类 AtOS场景 继承 场景 {
公开:
    设 窗口列表 存在;
    设 图标列表 存在;
    设 菜单激活 存在;
    设 菜单项 存在;
    设 菜单项数量 存在;
    设 拖动中 存在;
    设 拖动索引 存在;
    设 拖动偏移x 存在;
    设 拖动偏移y 存在;
    设 光标 存在;

    构造(){
        窗口列表 = {};
        图标列表 = {};
        菜单激活 = 假;
        菜单项 = ["记事本", "画图板", "系统设置", "关于 AtOS"];
        菜单项数量 = 4;
        拖动中 = 假;
        拖动索引 = 0;
        拖动偏移x = 0;
        拖动偏移y = 0;
        光标 = 空;
    };

    声明 进入(){
        打印("AtOS 1.0 桌面初始化");

        光标 = 创建 游戏对象;
        设 指针 = 创建 形状渲染器;
        指针.设置形状(4);
        指针.设置起点(0, 12);
        指针.设置目标(0, -8);
        指针.设置目标2(16, -8);
        指针.设置颜色(颜色白);
        光标.添加部件(指针);
        添加(光标);

        创建图标(-300, 230, "我的电脑", "我的电脑");
        创建图标(-200, 230, "记事本", "记事本");
        创建图标(-100, 230, "画图板", "画图板");
        创建图标(0, 230, "回收站", "回收站");
        创建图标(100, 230, "系统设置", "系统设置");

        打开窗口(-140, 30, 340, 220, "关于 AtOS", "AtOS 1.0 — 基于 AtUnity 引擎的桌面系统");
        打印("AtOS 系统启动完成");
        返回值 0;
    };

    声明 创建图标(x, y, 名称, 目标标题){
        设 图标 = 创建 图标记录(x, y, 名称, 目标标题);
        图标列表.添加(图标);
        返回值 0;
    };

    声明 打开窗口(x, y, w, h, 标题, 内容){
        设 窗口 = 创建 窗口记录(x, y, w, h, 标题, 内容);
        窗口列表.添加(窗口);
        返回值 0;
    };

    声明 窗口数量(){
        返回值 窗口列表.长度();
    };

    声明 窗口(索引){
        返回值 窗口列表[索引];
    };

    声明 更新(dt){

        如果(光标 != 空){
            光标.x = 鼠标x();
            光标.y = 鼠标y();
        };

        如果(拖动中){
            如果(拖动索引 >= 0 && 拖动索引 < 窗口数量()){
                设 被拖窗口 = 窗口列表[拖动索引];
                被拖窗口.x = 鼠标x() - 拖动偏移x;
                被拖窗口.y = 鼠标y() - 拖动偏移y;
            };
        };

        如果(鼠标抬起(1)){ 拖动中 = 假; };
        如果(鼠标按下(1) && 全局自动模式 == 假){ 处理点击(); };

        如果(帧数() % 300 == 0){
            打印("帧 " + 帧数() + " 窗口数=" + 窗口数量());
        };
        返回值 0;
    };

    声明 处理点击(){
        设 mx = 鼠标x();
        设 my = 鼠标y();

        如果(点在矩形内(mx, my, -360, -278, 38, 16)){
            菜单激活 = !菜单激活;
            返回值 0;
        };

        如果(菜单激活 == 真){
            设 i = 0;
            循环(i < 菜单项数量){
                如果(点在矩形内(mx, my, -330, 240 - i * 30, 150, 14)){
                    打开菜单项(i);
                    菜单激活 = 假;
                    返回值 0;
                };
                i = i + 1;
            };
        };

        设 n = 窗口数量();
        设 i = n - 1;
        循环(i >= 0){
            设 窗口 = 窗口列表[i];

            如果(点在矩形内(mx, my, 窗口.x + 窗口.宽 / 2 - 14, 窗口.y + 窗口.高 / 2 - 14, 10, 10)){
                移除窗口(i);
                返回值 0;
            };

            如果(点在矩形内(mx, my, 窗口.x, 窗口.y + 窗口.高 / 2 - 14, 窗口.宽 / 2, 14)){
                置顶窗口(i);
                拖动中 = 真;
                拖动索引 = i;
                拖动偏移x = mx - 窗口.x;
                拖动偏移y = my - 窗口.y;
                返回值 0;
            };
            i = i - 1;
        };

        循环(设 图标 : 图标列表){
            如果(点在矩形内(mx, my, 图标.x, 图标.y, 36, 36)){
                打开窗口(鼠标x() - 170, 鼠标y() + 120, 340, 200, 图标.窗口标题, 图标内容(图标.窗口标题));
                返回值 0;
            };
        };
        返回值 0;
    };

    声明 图标内容(标题){
        如果(标题 == "我的电脑"){ 返回值 "我的电脑 — CPU: AtLanage V2  内存: 64MB"; };
        如果(标题 == "记事本"){ 返回值 "记事本 — 纯文本编辑器(演示版)"; };
        如果(标题 == "画图板"){ 返回值 "画图板 — 图形绘制演示"; };
        如果(标题 == "回收站"){ 返回值 "回收站 — 已清空"; };
        如果(标题 == "系统设置"){ 返回值 "系统设置 — 分辨率 800x600  FPS 60"; };
        返回值 "AtOS 1.0 — 基于 AtUnity 引擎的桌面系统";
    };

    声明 打开菜单项(索引){
        如果(索引 == 0){ 打开窗口(-200, 80, 360, 200, "记事本", "记事本 — 纯文本编辑器(演示版)"); };
        如果(索引 == 1){ 打开窗口(-200, 80, 360, 200, "画图板", "画图板 — 图形绘制演示"); };
        如果(索引 == 2){ 打开窗口(-200, 80, 360, 200, "系统设置", "系统设置 — 分辨率 800x600  FPS 60"); };
        如果(索引 == 3){ 打开窗口(-140, 30, 340, 220, "关于 AtOS", "AtOS 1.0 — 基于 AtUnity 引擎的桌面系统"); };
        返回值 0;
    };

    声明 置顶窗口(索引){
        设 目标 = 窗口列表[索引];
        移除窗口(索引);
        窗口列表.添加(目标);
        返回值 0;
    };

    声明 移除窗口(索引){
        设 新列表 = {};
        设 i = 0;
        循环(i < 窗口列表.长度()){
            如果(i != 索引){ 新列表.添加(窗口列表[i]); };
            i = i + 1;
        };
        窗口列表 = 新列表;
        返回值 0;
    };

    声明 渲染(){

        循环(设 图标 : 图标列表){
            图形.绘制.矩形(引擎_窗口, 图标.x, 图标.y, 30, 30, AtOS_图标, 真);
            图形.绘制.矩形(引擎_窗口, 图标.x, 图标.y, 30, 30, 颜色白, 假);
            图形.绘制.文本(引擎_窗口, 图标.x - 40, 图标.y - 48, 图标.名称, 12, 颜色白);
        };

        循环(设 窗口 : 窗口列表){
            绘制窗口(窗口);
        };

        如果(菜单激活 == 真){
            图形.绘制.矩形(引擎_窗口, -330, 225, 150, 60, AtOS_任务栏, 真);
            图形.绘制.矩形(引擎_窗口, -330, 225, 150, 60, 颜色白, 假);
            设 i = 0;
            循环(i < 菜单项数量){

                如果(点在矩形内(鼠标x(), 鼠标y(), -330, 240 - i * 30, 150, 14)){
                    图形.绘制.矩形(引擎_窗口, -330, 240 - i * 30, 148, 13, AtOS_高亮, 真);
                };
                图形.绘制.文本(引擎_窗口, -390, 232 - i * 30, 菜单项[i], 14, 颜色白);
                i = i + 1;
            };
        };

        图形.绘制.矩形(引擎_窗口, 0, -278, 400, 22, AtOS_任务栏, 真);
        图形.绘制.矩形(引擎_窗口, -360, -278, 38, 16, AtOS_标题栏, 真);
        图形.绘制.文本(引擎_窗口, -376, -288, "开始", 14, 颜色白);
        图形.绘制.文本(引擎_窗口, 330, -290, 时间, 14, 颜色白);
        返回值 0;
    };

    声明 绘制窗口(窗口){

        图形.绘制.矩形(引擎_窗口, 窗口.x, 窗口.y, 窗口.宽 / 2, 窗口.高 / 2, AtOS_窗口面, 真);
        图形.绘制.矩形(引擎_窗口, 窗口.x, 窗口.y, 窗口.宽 / 2, 窗口.高 / 2, 颜色白, 假);

        图形.绘制.矩形(引擎_窗口, 窗口.x, 窗口.y + 窗口.高 / 2 - 14, 窗口.宽 / 2, 14, AtOS_标题栏, 真);

        图形.绘制.矩形(引擎_窗口, 窗口.x + 窗口.宽 / 2 - 14, 窗口.y + 窗口.高 / 2 - 14, 10, 10, AtOS_关闭, 真);
        图形.绘制.文本(引擎_窗口, 窗口.x + 窗口.宽 / 2 - 20, 窗口.y + 窗口.高 / 2 - 20, "X", 12, 颜色白);

        图形.绘制.文本(引擎_窗口, 窗口.x - 窗口.宽 / 2 + 10, 窗口.y + 窗口.高 / 2 - 20, 窗口.标题, 14, 颜色白);
        图形.绘制.文本(引擎_窗口, 窗口.x - 窗口.宽 / 2 + 16, 窗口.y - 20, 窗口.内容, 14, 图元颜色(200, 210, 240));
        返回值 0;
    };
};