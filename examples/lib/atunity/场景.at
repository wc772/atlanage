类 场景 {
公开:
    设 对象列表 存在;
    设 相机x 存在;
    设 相机y 存在;
    设 场景名称 存在;

    构造(){
        对象列表 = {};
        相机x = 0;
        相机y = 0;
        场景名称 = "";
    };

    声明 添加(对象){
        对象列表.添加(对象);
        返回值 对象;
    };

    声明 附体(场景对象){
        循环(设 对象 : 对象列表){
            对象.场景引用 = 场景对象;
            设 数量 = 对象.部件数量();
            设 i = 0;
            循环(i < 数量){
                设 部件 = 对象.部件(i);
                部件.挂载(对象);
                i = i + 1;
            };
        };
        返回值 0;
    };

    声明 对象数量(){
        返回值 对象列表.长度();
    };
    声明 获取对象(索引){
        返回值 对象列表[索引];
    };

    声明 清空(){
        对象列表 = {};
        返回值 0;
    };

    声明 进入(){
        返回值 0;
    };

    声明 更新(dt){
        返回值 0;
    };

    声明 渲染(){
        返回值 0;
    };
    声明 退出(){
        返回值 0;
    };

    声明 引擎更新(dt){
        清除已删除();
        循环(设 对象 : 对象列表){
            如果(对象.激活 == 真){
                对象.更新();
            };
        };
        物理步进();
        碰撞检测();
        返回值 0;
    };

    声明 引擎渲染(){
        循环(设 对象 : 对象列表){
            如果(对象.激活 == 真){
                对象.渲染();
            };
        };
        返回值 0;
    };

    声明 物理步进(){
        循环(设 对象 : 对象列表){
            如果(对象.激活 == 真){
                对象.物理更新();
            };
        };
        返回值 0;
    };

    声明 碰撞检测(){
        设 数量 = 对象列表.长度();
        设 i = 0;
        循环(i < 数量){
            设 甲 = 对象列表[i];
            设 j = i + 1;
            循环(j < 数量){
                设 乙 = 对象列表[j];
                检测碰撞(甲, 乙);
                j = j + 1;
            };
            i = i + 1;
        };
        返回值 0;
    };

    声明 清除已删除(){
        设 新列表 = {};
        循环(设 对象 : 对象列表){
            如果(对象.已删除 == 假){
                新列表.添加(对象);
            };
        };
        对象列表 = 新列表;
        返回值 0;
    };
};