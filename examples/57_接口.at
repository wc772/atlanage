接口 会叫 {
  声明 叫();
};

接口 会跑 继承 会叫 {
  声明 跑();
};

类 狗 实现 会跑 {
  公开:
  声明 叫(){ 打印("汪"); };
  声明 跑(){ 打印("跑"); };
};

类 猫 实现 会叫 {
  公开:
  声明 叫(){ 打印("喵"); };
};

类 测试接口 {
    声明 测试(){
        打印("=== 基本接口 ===");
        设 动物 = 创建 狗;
        动物.叫();
        设 动物2 = 创建 猫;
        动物2.叫();

        打印("=== 接口继承 ===");
        设 动物3 = 创建 狗;
        动物3.叫();
        动物3.跑();
        返回值 0;
    };
};