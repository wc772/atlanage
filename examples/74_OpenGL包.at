引用.包导入("OpenGL");

类 main {
公开:
    声明 运行(){
        打印("=== OpenGL 支持包 ===");

        设 版本 = OpenGL.版本();
        打印("版本=" + 版本);
        打印("版本非空=" + (版本.长度() > 0));
        设 渲染器 = OpenGL.渲染器();
        打印("渲染器=" + 渲染器);
        打印("渲染器非空=" + (渲染器.长度() > 0));

        设 win = OpenGL.窗口(320, 240, "OpenGL包测试");
        打印("窗口创建=" + (win > 0));
        设 正交 = OpenGL.正交2D(320, 240);
        打印("正交=" + 正交);
        设 清屏结果 = OpenGL.清屏(10, 10, 26, 255);
        打印("清屏=" + 清屏结果);
        设 绘制结果 = OpenGL.三角形(10, 10, 300, 10, 150, 220, 255, 64, 32);
        打印("三角形绘制=" + 绘制结果);
        设 呈现结果 = OpenGL.呈现(win);
        打印("呈现=" + 呈现结果);

        设 buf = 内存.分配(32);
        设 ev = OpenGL.轮询(win, buf, 0);
        打印("事件轮询=" + ev);

        设 关闭结果 = OpenGL.关闭(win);
        打印("窗口关闭=" + 关闭结果);

        返回值 0;
    };
};