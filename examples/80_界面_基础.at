引用.文件("lib/界面/界面.at")

设 点击次数 = 0;

类 main {
公开:
    声明 运行(){
        打印("=== 界面基础 ===");

        设 win = GL.窗口.创建(320, 240, "界面测试");
        打印("窗口创建=" + (win > 0));

        界面.创建(窗口:win){
            行(间距:8, 填充:16){
                列(权重:1){
                    标签(文本:"用户名", 字号:16);
                    按钮(文字:"登录")[主题.主色*]{
                        当.点击{
                            点击次数 = 点击次数 + 1;
                        };
                    };
                };
                列(权重:2){
                    输入框(占位:"请输入", 字号:16);
                };
            };
        };

        界面_布局();
        设 根元素 = 界面_根;
        设 行元素 = 根元素.子列表[0];
        设 列1元素 = 行元素.子列表[0];
        设 列2元素 = 行元素.子列表[1];
        设 标签元素 = 列1元素.子列表[0];
        设 按钮元素 = 列1元素.子列表[1];
        设 输入框元素 = 列2元素.子列表[0];
        打印("布局 根=" + 根元素.位置x + "," + 根元素.位置y + "," + 根元素.宽 + "," + 根元素.高);
        打印("布局 行=" + 行元素.位置x + "," + 行元素.位置y + "," + 行元素.宽 + "," + 行元素.高);
        打印("布局 列1=" + 列1元素.位置x + "," + 列1元素.位置y + "," + 列1元素.宽 + "," + 列1元素.高);
        打印("布局 列2=" + 列2元素.位置x + "," + 列2元素.位置y + "," + 列2元素.宽 + "," + 列2元素.高);
        打印("布局 标签=" + 标签元素.位置x + "," + 标签元素.位置y + "," + 标签元素.宽 + "," + 标签元素.高);
        打印("布局 按钮=" + 按钮元素.位置x + "," + 按钮元素.位置y + "," + 按钮元素.宽 + "," + 按钮元素.高);
        打印("布局 输入框=" + 输入框元素.位置x + "," + 输入框元素.位置y + "," + 输入框元素.宽 + "," + 输入框元素.高);

        设 h1 = 界面_命中(40, 45);
        打印("命中(40,45)=" + h1.类型);
        设 h2 = 界面_命中(20, 20);
        打印("命中(20,20)=" + h2.类型);
        设 h3 = 界面_命中(200, 30);
        打印("命中(200,30)=" + h3.类型);
        设 h4 = 界面_命中(5, 230);
        打印("命中(5,230)=" + h4.类型);

        界面_触发(h1, "点击", 空);
        打印("点击后次数=" + 点击次数);

        输入框元素.文本 = 输入框元素.文本 + 字符(97);
        输入框元素.文本 = 输入框元素.文本 + 字符(20013);
        打印("输入框文本=" + 输入框元素.文本);
        输入框元素.文本 = 输入框元素.文本.子字符串(0, 输入框元素.文本.长度() - 1);
        打印("输入框删尾=" + 输入框元素.文本);

        设 渲染 = 界面_渲染(win);
        GL.呈现(win);
        打印("渲染=" + (渲染 == 0));

        GL.窗口.关闭(win);
        打印("PASS 80");
        返回值 0;
    };
};