类 main {
公开:
    声明 运行(){
        打印("=== 输入状态查询 ===");

        设 win = GL.窗口.创建(320, 240, "输入测试");
        打印("窗口创建=" + (win > 0));

        设 buf = 内存.分配(8);
        设 鼠标位置 = 输入.鼠标位置(缓冲:buf);
        打印("鼠标位置=" + 鼠标位置);

        设 按键按下 = 输入.按键按下(键:"a");
        打印("按键按下=" + 按键按下);
        设 按键按下瞬间 = 输入.按键按下瞬间("a");
        打印("按键按下瞬间=" + 按键按下瞬间);

        设 鼠标按钮 = 输入.鼠标按钮(1);
        打印("鼠标按钮=" + 鼠标按钮);

        设 同步 = 输入.同步();
        打印("同步=" + 同步);

        设 关闭 = GL.窗口.关闭(win);
        打印("窗口关闭=" + 关闭);

        打印("PASS 78");
        返回值 0;
    };
};