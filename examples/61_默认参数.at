声明 打招呼(名字, 问候 = "你好"){
  打印(问候 + 名字);
  返回值 0;
};

声明 求和(数字...){
  设 总和 = 0;
  循环(设 i=0; i < 数字.个数; i++){
    总和 = 总和 + 数字[i];
  };
  返回值 总和;
};

类 测试参数 {
    声明 测试(){
        打印("=== 默认参数 ===");
        打招呼("小王");
        打招呼("小王", "早上好");

        打印("=== 可变参数 ===");
        设 总和 = 求和(1, 2, 3, 4, 5);
        打印("总和=" + 总和);
        返回值 0;
    };
};