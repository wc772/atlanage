类 系统编程示例 {
公开:
    声明 测试JIT编译器(){
        打印("=== JIT编译器示例 ===");

        设 codeSize = 64;
        设 code = 内存.分配可执行(codeSize);

        如果(code == 0){
            打印("分配可执行内存失败");
            返回值 1;
        };

        打印("可执行内存地址: 0x" + code);

        设 ofs = 0;
        code[ofs]=0x48; ofs=ofs+1;
        code[ofs]=0x89; ofs=ofs+1;
        code[ofs]=0xC8; ofs=ofs+1;
        code[ofs]=0x48; ofs=ofs+1;
        code[ofs]=0x01; ofs=ofs+1;
        code[ofs]=0xD0; ofs=ofs+1;
        code[ofs]=0xC3; ofs=ofs+1;

        打印("机器码长度: " + ofs + " 字节");

        设 result = 系统.调用(code, 10, 20);
        打印("JIT: 10 + 20 = " + result);

        如果(result == 30){
            打印("JIT编译执行成功！");
        };

        返回值 0;
    };

    声明 测试二进制文件操作(){
        打印("=== 二进制文件读写 ===");

        设 文件名 = "test_output.bin";

        二进制写入[32](文件名, 0, 0x46464952);
        二进制写入[32](文件名, 4, 100);
        二进制写入[32](文件名, 8, 0x45564157);

        打印("二进制头写入完成");

        设 data = 字节读取(文件名, 0, 12);
        打印("读取的头部数据: " + data);

        返回值 0;
    };

    声明 测试内存池(){
        打印("=== 简单内存池 ===");

        设 池大小 = 4096;
        设 池 = 内存.分配(池大小);

        如果(池 == 0){
            打印("内存池分配失败");
            返回值 1;
        };

        打印("内存池分配成功: " + 池大小 + " 字节");

        内存.释放(池);
        打印("内存池已释放");

        返回值 0;
    };

    声明 测试系统调用(){
        打印("=== Windows API 调用 ===");

        设 kernel32 = "kernel32.dll";
        打印("系统调用演示完成");

        返回值 0;
    };
};