类 用户 {
  公开:
  设 名字 存在;
  声明 说话(){
    打印("说话: 你好");
    返回值 0;
  };
};

类 测试空安全 {
    声明 测试(){
        打印("=== 空对象访问 ===");
        设 用户 = 空;
        用户?.说话();
        打印("用户为空，跳过");
        设 字段 = 用户?.名字;
        打印("字段=" + 字段);

        打印("=== 非空对象 ===");
        设 用户2 = 创建 用户;
        用户2.名字 = "小明";
        打印("名字=" + 用户2?.名字);
        用户2?.说话();
        返回值 0;
    };
};