设 界面_栈 = [];
设 界面_根 = 空;
设 界面_窗口 = 0;
设 界面_焦点 = 空;
设 界面_窗口宽 = 800;
设 界面_窗口高 = 600;
设 界面_线程模式 = 假;

声明 界面_读整数(addr, off){
    设 b0 = 内存.读字节(addr, off);
    设 b1 = 内存.读字节(addr, off + 1);
    设 b2 = 内存.读字节(addr, off + 2);
    设 b3 = 内存.读字节(addr, off + 3);
    返回值 (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
};
声明 界面_写整数(addr, off, v){
    内存.写字节(addr, off, v & 0xFF);
    内存.写字节(addr, off + 1, (v >> 8) & 0xFF);
    内存.写字节(addr, off + 2, (v >> 16) & 0xFF);
    内存.写字节(addr, off + 3, (v >> 24) & 0xFF);
    返回值 0;
};

声明 界面_栈顶(){
    设 stk = 界面_栈;
    设 n = stk.个数();
    如果(n <= 0){ 返回值 空; };
    返回值 stk[n - 1];
};
声明 界面_压栈(控件){
    设 stk2 = 界面_栈;
    stk2.添加(控件);
    返回值 0;
};
声明 界面_弹栈(){
    设 stk3 = 界面_栈;
    设 n = stk3.个数();
    如果(n > 0){ stk3.删除(n - 1); };
    返回值 0;
};

类 控件 {
公开:
    设 类型 存在;
    设 位置x 存在;
    设 位置y 存在;
    设 宽 存在;
    设 高 存在;
    设 可见 存在;
    设 权重 存在;
    设 间距 存在;
    设 填充 存在;
    设 父 存在;
    设 子列表 存在;
    设 事件表 存在;
    设 文本 存在;
    设 占位 存在;
    设 字号 存在;
    设 颜色 存在;
    设 填充标记 存在;
    设 聚焦标记 存在;

    构造(类型名){
        类型 = 类型名;
        位置x = 0; 位置y = 0; 宽 = 0; 高 = 0;
        可见 = 真; 权重 = 0; 间距 = 0; 填充 = 0;
        子列表 = []; 事件表 = [];
        文本 = ""; 占位 = ""; 字号 = 16;
        颜色 = 0x3B6FE0; 填充标记 = 0; 聚焦标记 = 假;
    };
};

声明 界面_加入父(父控件, 子控件){
    子控件.父 = 父控件;
    父控件.子列表.添加(子控件);
    返回值 0;
};

声明 __控件块结束(){
    界面_弹栈();
    返回值 0;
};

声明 __控件事件(事件名, 回调){
    设 当前 = 界面_栈顶();
    如果(当前 != 空){
        当前.事件表.添加([事件名, 回调]);
    };
    返回值 0;
};

声明 界面_创建(窗口){
    设 根 = 创建 控件("根");
    界面_根 = 根;
    界面_窗口 = 窗口;
    界面_栈 = [];
    界面_压栈(根);
    返回值 根;
};

声明 界面_刷新窗口尺寸(){
    设 buf = 内存.分配(8);
    设 ok = GL.窗口.大小(窗口:界面_窗口, 缓冲:buf);
    如果(ok == 1){
        界面_窗口宽 = 界面_读整数(buf, 0);
        界面_窗口高 = 界面_读整数(buf, 4);
    };
    内存.释放(buf);
    返回值 0;
};

声明 界面_自然宽(控件){
    如果(控件.类型 == "标签"){ 返回值 界面_文本宽(控件.文本, 控件.字号) + 2; };
    如果(控件.类型 == "按钮"){ 返回值 界面_文本宽(控件.文本, 控件.字号) + 16; };
    如果(控件.类型 == "输入框"){ 返回值 120; };

    设 n = 控件.子列表.个数();
    如果(n == 0){ 返回值 控件.填充 * 2; };
    设 total = 控件.填充 * 2 + 控件.间距 * (n - 1);
    设 i = 0;
    循环(i < n){
        设 c = 控件.子列表[i];
        如果(c.权重 <= 0){ total = total + 界面_自然宽(c); };
        i = i + 1;
    };
    返回值 total;
};
声明 界面_自然高(控件){
    如果(控件.类型 == "标签"){ 返回值 控件.字号 + 6; };
    如果(控件.类型 == "按钮"){ 返回值 控件.字号 + 12; };
    如果(控件.类型 == "输入框"){ 返回值 控件.字号 + 12; };

    设 n = 控件.子列表.个数();
    如果(n == 0){ 返回值 控件.填充 * 2; };
    设 maxh = 0;
    设 i = 0;
    循环(i < n){
        设 c = 控件.子列表[i];
        设 ch = 界面_自然高(c);
        如果(ch > maxh){ maxh = ch; };
        i = i + 1;
    };
    返回值 maxh + 控件.填充 * 2;
};

声明 界面_布局行(控件, 分配x, 分配y, 分配宽, 分配高){
    设 n = 控件.子列表.个数();
    如果(n == 0){ 返回值 0; };
    设 fixed = 0;
    设 weight_sum = 0;
    设 i = 0;
    循环(i < n){
        设 c = 控件.子列表[i];
        如果(c.权重 > 0){ weight_sum = weight_sum + c.权重; }
        否则{ fixed = fixed + 界面_自然宽(c); };
        i = i + 1;
    };
    设 可用 = 分配宽 - 控件.填充 * 2 - 控件.间距 * (n - 1) - fixed;
    如果(可用 < 0){ 可用 = 0; };
    设 内高 = 分配高 - 控件.填充 * 2;
    如果(内高 < 0){ 内高 = 0; };
    设 游标 = 分配x + 控件.填充;
    设 i2 = 0;
    循环(i2 < n){
        设 c = 控件.子列表[i2];
        设 cw = 界面_自然宽(c);
        如果(c.权重 > 0 && weight_sum > 0){
            cw = 可用 * c.权重 / weight_sum;
        };
        界面_布局内(c, 游标, 分配y + 控件.填充, cw, 内高);
        游标 = 游标 + cw + 控件.间距;
        i2 = i2 + 1;
    };
    返回值 0;
};

声明 界面_布局列(控件, 分配x, 分配y, 分配宽, 分配高){
    设 n = 控件.子列表.个数();
    如果(n == 0){ 返回值 0; };
    设 fixed = 0;
    设 weight_sum = 0;
    设 i = 0;
    循环(i < n){
        设 c = 控件.子列表[i];
        如果(c.权重 > 0){ weight_sum = weight_sum + c.权重; }
        否则{ fixed = fixed + 界面_自然高(c); };
        i = i + 1;
    };
    设 可用 = 分配高 - 控件.填充 * 2 - 控件.间距 * (n - 1) - fixed;
    如果(可用 < 0){ 可用 = 0; };
    设 内宽 = 分配宽 - 控件.填充 * 2;
    如果(内宽 < 0){ 内宽 = 0; };
    设 游标 = 分配y + 控件.填充;
    设 i2 = 0;
    循环(i2 < n){
        设 c = 控件.子列表[i2];
        设 ch = 界面_自然高(c);
        如果(c.权重 > 0 && weight_sum > 0){
            ch = 可用 * c.权重 / weight_sum;
        };
        界面_布局内(c, 分配x + 控件.填充, 游标, 内宽, ch);
        游标 = 游标 + ch + 控件.间距;
        i2 = i2 + 1;
    };
    返回值 0;
};

声明 界面_布局内(控件, x, y, w, h){
    控件.位置x = x; 控件.位置y = y; 控件.宽 = w; 控件.高 = h;
    如果(控件.类型 == "行"){ 界面_布局行(控件, x, y, w, h); 返回值 0; };
    如果(控件.类型 == "列"){ 界面_布局列(控件, x, y, w, h); 返回值 0; };

    如果(控件.类型 == "根"){ 界面_布局行(控件, x, y, w, h); };
    返回值 0;
};
声明 界面_布局(){
    如果(界面_根 == 空){ 返回值 0; };
    界面_刷新窗口尺寸();
    界面_布局内(界面_根, 0, 0, 界面_窗口宽, 界面_窗口高);
    返回值 0;
};

声明 界面_命中内(控件, px, py){
    如果(控件.可见 == 假){ 返回值 空; };
    如果(px < 控件.位置x || px >= 控件.位置x + 控件.宽){ 返回值 空; };
    如果(py < 控件.位置y || py >= 控件.位置y + 控件.高){ 返回值 空; };
    设 n = 控件.子列表.个数();
    设 i = n - 1;
    循环(i >= 0){
        设 c = 控件.子列表[i];
        设 h = 界面_命中内(c, px, py);
        如果(h != 空){ 返回值 h; };
        i = i - 1;
    };
    返回值 控件;
};
声明 界面_命中(px, py){
    如果(界面_根 == 空){ 返回值 空; };
    返回值 界面_命中内(界面_根, px, py);
};

声明 界面_绘制矩形(窗口, x, y, 宽, 高, 颜色, 透明度){
    如果(透明度 <= 0){ 返回值 0; };
    设 r = (颜色 >> 16) & 0xFF;
    设 g = (颜色 >> 8) & 0xFF;
    设 b = 颜色 & 0xFF;
    设 gy = 界面_窗口高 - y - 高;
    GL.开始(7);
    GL.颜色(r, g, b, 透明度);
    GL.顶点(x, gy, 0.0);
    GL.顶点(x + 宽, gy, 0.0);
    GL.顶点(x + 宽, gy + 高, 0.0);
    GL.顶点(x, gy + 高, 0.0);
    GL.结束();
    返回值 1;
};
声明 界面_绘制文本(窗口, x, y, 字号, 文本, 颜色){
    设 r = (颜色 >> 16) & 0xFF;
    设 g = (颜色 >> 8) & 0xFF;
    设 b = 颜色 & 0xFF;
    设 gy = 界面_窗口高 - y - 字号;
    GL.文本.绘制(窗口:窗口, x:x, y:gy, 字号:字号, 红:r, 绿:g, 蓝:b, 透明度:255, 文本:文本);
    返回值 1;
};

声明 界面_文本宽(文本, 字号){
    设 n = 文本.长度();
    返回值 n * 字号 + 2;
};

声明 界面_绘制内(控件, 窗口){
    如果(控件.可见 == 假){ 返回值 0; };
    设 t = 控件.类型;
    如果(t == "标签"){
        如果(控件.文本 != ""){
            界面_绘制文本(窗口, 控件.位置x, 控件.位置y, 控件.字号, 控件.文本, 控件.颜色);
        };
        返回值 0;
    };
    如果(t == "按钮"){
        设 底色 = 控件.颜色;
        如果(控件.聚焦标记 == 真){ 底色 = 主题_悬停(); };
        界面_绘制矩形(窗口, 控件.位置x, 控件.位置y, 控件.宽, 控件.高, 底色, 255);
        界面_绘制矩形(窗口, 控件.位置x, 控件.位置y + 控件.高 - 2, 控件.宽, 2, 0xFFFFFF, 90);
        设 文字宽 = 界面_文本宽(控件.文本, 控件.字号);
        设 文字x = 控件.位置x + (控件.宽 - 文字宽) / 2;
        设 文字y = 控件.位置y + (控件.高 - 控件.字号) / 2;
        如果(文字x < 控件.位置x){ 文字x = 控件.位置x + 2; };
        如果(文字y < 控件.位置y){ 文字y = 控件.位置y + 2; };
        界面_绘制文本(窗口, 文字x, 文字y, 控件.字号, 控件.文本, 0xFFFFFF);
        返回值 0;
    };
    如果(t == "输入框"){
        设 边框色 = 主题_边框();
        如果(控件.聚焦标记 == 真){ 边框色 = 主题_主色(); };
        界面_绘制矩形(窗口, 控件.位置x, 控件.位置y, 控件.宽, 控件.高, 主题_输入背景(), 255);
        界面_绘制矩形(窗口, 控件.位置x, 控件.位置y, 控件.宽, 1, 边框色, 255);
        如果(控件.文本 == ""){
            界面_绘制文本(窗口, 控件.位置x + 6, 控件.位置y + 5, 控件.字号, 控件.占位, 主题_占位());
        }否则{
            界面_绘制文本(窗口, 控件.位置x + 6, 控件.位置y + 5, 控件.字号, 控件.文本, 主题_文字());
        };
        如果(控件.聚焦标记 == 真){
            设 光标x = 控件.位置x + 6 + 界面_文本宽(控件.文本, 控件.字号) + 2;
            界面_绘制矩形(窗口, 光标x, 控件.位置y + 6, 2, 控件.字号 + 2, 主题_文字(), 255);
        };
        返回值 0;
    };

    设 n = 控件.子列表.个数();
    设 i = 0;
    循环(i < n){
        界面_绘制内(控件.子列表[i], 窗口);
        i = i + 1;
    };
    返回值 0;
};

声明 界面_触发(控件, 事件名, 参数){
    设 et = 控件.事件表;
    设 i = 0;
    循环(i < et.个数()){
        设 rec = et[i];
        如果(rec[0] == 事件名){
            设 cb = rec[1];
            如果(参数 == 空){ cb(); }否则{ cb(参数); };
        };
        i = i + 1;
    };
    返回值 0;
};
声明 界面_分发事件(){
    如果(界面_窗口 == 0){ 返回值 0; };
    设 buf = 内存.分配(32);
    循环{
        设 r = 0;
        如果(界面_线程模式 == 真){
            r = GL.事件.取出(窗口:界面_窗口, 缓冲:buf);
        }否则{
            r = GL.事件.轮询(窗口:界面_窗口, 缓冲:buf, 阻塞:0);
        };
        如果(r == 0){ 跳出; };
        如果(r == -1){ 内存.释放(buf); 返回值 -1; };
        设 etype = 内存.读字节(buf, 0);
        设 ekey = 内存.读字节(buf, 4);
        设 mx = 界面_读整数(buf, 8);
        设 my = 界面_读整数(buf, 12);
        如果(etype == 3){
            设 目标 = 界面_命中(mx, my);
            如果(目标 != 空){
                如果(目标.类型 == "输入框"){ 界面_焦点 = 目标; }否则{ 界面_焦点 = 空; };
                界面_触发(目标, "点击", 空);
            }否则{
                界面_焦点 = 空;
            };
        };
        如果(etype == 8){
            如果(界面_焦点 != 空 && 界面_焦点.类型 == "输入框"){
                设 ch = 界面_读整数(buf, 20);
                如果(ch > 0 && ch < 0x10000 && ch != 13 && ch != 9){
                    界面_焦点.文本 = 界面_焦点.文本 + 字符(ch);
                    界面_触发(界面_焦点, "输入", 界面_焦点.文本);
                };
            };
        };
        如果(etype == 1 && ekey == 8){
            如果(界面_焦点 != 空 && 界面_焦点.类型 == "输入框"){
                设 n = 界面_焦点.文本.长度();
                如果(n > 0){
                    界面_焦点.文本 = 界面_焦点.文本.子字符串(0, n - 1);
                    界面_触发(界面_焦点, "输入", 界面_焦点.文本);
                };
            };
        };
    };
    输入.同步();
    内存.释放(buf);
    返回值 0;
};

声明 界面_渲染(窗口){
    如果(窗口 != 界面_窗口 && 窗口 != 0){
        界面_窗口 = 窗口;
    };
    如果(界面_根 == 空){ 返回值 0; };
    GL.设置当前(窗口:窗口);
    GL.矩阵(5889);
    GL.单位矩阵();
    GL.正交(0.0, 界面_窗口宽, 0.0, 界面_窗口高, -1.0, 1.0);
    GL.矩阵(5888);
    GL.单位矩阵();
    界面_布局();
    界面_绘制内(界面_根, 窗口);
    设 r = 界面_分发事件();
    返回值 r;
};

声明 界面_线程模式设置(开关){
    界面_线程模式 = 开关;
    返回值 0;
};

声明 界面_关闭(窗口){
    界面_根 = 空;
    界面_焦点 = 空;
    界面_栈 = [];
    如果(窗口 > 0){ GL.窗口.关闭(窗口:窗口); };
    返回值 0;
};